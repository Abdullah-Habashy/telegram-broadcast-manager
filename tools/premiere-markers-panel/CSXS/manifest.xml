<?xml version="1.0" encoding="UTF-8"?>
<!--
  لوحة «مراجعة الفيديوهات» جوه بريمير.

  بتظهر في: Window ← Extensions ← مراجعة الفيديوهات

  ⚠️ اللوحة **مش موقّعة** (unsigned)، فبريمير مابيحمّلهاش إلا لو PlayerDebugMode متفعّل —
  الأمر موجود في README.md. ده وضع عادي للوحات الداخلية اللي مش متنشرة على Adobe Exchange.

  نطاق الإصدارات واسع عن قصد: اللوحة بتستخدم نداءين بس من واجهة بريمير
  (createMarker و setColorByIndex) وهما موجودين من إصدارات قديمة، فمفيش سبب نقفل الباب
  على إصدار بعينه ونخلي المونتير يقعد يعدّل في الملف ده.
-->
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.habashy.videoreview.markers"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Video Review Markers">
  <ExtensionList>
    <Extension Id="com.habashy.videoreview.markers.panel" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[12.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="6.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.habashy.videoreview.markers.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- بريمير بيحمّل الملف ده لوحده عند فتح اللوحة -->
          <ScriptPath>./host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>مراجعة الفيديوهات</Menu>
          <Geometry>
            <Size>
              <Height>460</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
