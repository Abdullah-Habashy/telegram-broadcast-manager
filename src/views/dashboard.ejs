    function updateSelectedContactsUi() {
      const count = selectedContactIds.size;
      document.getElementById('selected-contacts-count').textContent = `المحدد: ${count}`;
      document.getElementById('message-selected-btn').disabled = count === 0;
      document.getElementById('selected-tafra-students-count').textContent = `المحدد: ${count}`;
      document.getElementById('message-selected-tafra-students-btn').disabled = count === 0;
      const tafraAssignSelect = document.getElementById('tafra-assign-to-select');
      const tafraAssignBtn = document.getElementById('assign-selected-tafra-students-btn');
