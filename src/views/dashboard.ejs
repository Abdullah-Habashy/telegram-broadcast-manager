        ${(data.sms_logs && data.sms_logs.length) ? `
        <div class="card" id="student-sms-logs-panel" style="margin-block:12px">
          <b style="display:block; margin-bottom:8px">📨 رسايل SMS المُرسلة (${data.sms_logs.length})</b>
          ${data.sms_logs.map((log) => `
            <div class="call-log-entry">
              <div class="row-between">
                <span class="ticket-muted">${escapeHtml(log.phone)}</span>
