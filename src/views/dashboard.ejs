<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>لوحة التحكم — Broadcast Manager</title>
  <%- include('partials/layout-head') %>
</head>
<body class="role-<%= userRole %>">
  <div class="app-shell">
    <aside class="sidebar">
      <div class="auth-brand">
        <span class="dot"></span>
        <span>Broadcast Manager</span>
      </div>

      <% if (userRole === 'admin') { %>
        <div class="nav-item active" data-tab="overview"><span class="ind"></span> نظرة عامة</div>
      <% } %>
      <div class="nav-item <%= userRole === 'agent' ? 'active' : '' %>" data-tab="tickets"><span class="ind"></span> صندوق الدعم</div>
      <% if (userRole === 'admin') { %>
        <div class="nav-item" data-tab="contacts"><span class="ind"></span> جهات الاتصال والإرسال</div>
        <div class="nav-item" data-tab="tafra-students"><span class="ind"></span> طلاب المنصة</div>
        <div class="nav-item" data-tab="templates"><span class="ind"></span> القوالب</div>
        <div class="nav-item" data-tab="settings"><span class="ind"></span> الإعدادات</div>
      <% } %>

      <div class="sidebar-footer">
        <div class="user-name">👋 <%= userName %></div>
        <form method="POST" action="/logout">
          <button type="submit" class="btn btn-ghost btn-sm" style="width:100%">تسجيل الخروج</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <!-- ===== نظرة عامة ===== -->
      <section class="tab-panel" id="tab-overview" style="<%= userRole === 'agent' ? 'display:none' : '' %>">
        <div class="page-header">
          <h1>نظرة عامة</h1>
          <p>ملخص سريع لحالة البوت وجهات الاتصال</p>
        </div>
        <div class="stats-grid" id="stats-grid">
          <div class="stat-card"><div class="label">إجمالي جهات الاتصال</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">متفاعلين آخر أسبوع</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">رسائل مُرسلة</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">معدل الرد التقريبي</div><div class="value">—</div></div>
        </div>
        <div class="card">
          <h2>الخطوات الأولى</h2>
          <p class="card-desc">علشان البوت يشتغل، لازم الآتي بالترتيب:</p>
          <ol style="margin:0; padding-inline-start: 20px; color: var(--text-muted); font-size: 13.5px; line-height: 2;">
            <li>روح <b>الإعدادات</b> وسجّل توكن البوت (من BotFather)</li>
            <li>تأكد إن <code>PUBLIC_URL</code> متحدد في ملف <code>.env</code> عشان الـ Webhook يشتغل</li>
            <li>ابعت <code>/start</code> للبوت من حسابك على تليجرام للتجربة</li>
          </ol>
        </div>
      </section>

      <!-- ===== صندوق الدعم ===== -->
      <section class="tab-panel" id="tab-tickets" style="<%= userRole === 'admin' ? 'display:none' : '' %>">
        <div class="page-header">
          <h1>صندوق الدعم</h1>
          <p>استقبال رسائل الطلاب، توزيعها على الموظفين، والرد من مكان واحد</p>
        </div>

        <div class="ticket-toolbar card">
          <input type="search" id="ticket-search" class="compact-input" placeholder="بحث بالاسم، اليوزر، الهاتف أو Chat ID">
          <% if (userRole === 'agent') { %>
            <button type="button" class="btn btn-ghost btn-sm agent-filter-toggle" id="agent-filter-toggle" title="إظهار الفلاتر" aria-label="إظهار الفلاتر">⚲</button>
          <% } %>
          <div class="ticket-advanced-filters" id="ticket-advanced-filters">
          <select id="ticket-status-filter" class="compact-select">
            <option value="">كل الحالات</option>
            <option value="new">جديدة</option>
            <option value="in_progress">قيد المتابعة</option>
            <option value="waiting_student">بانتظار الطالب</option>
            <option value="resolved">مكتملة</option>
            <option value="closed">مغلقة</option>
          </select>
          <select id="ticket-subtitle-filter" class="compact-select">
            <option value="">كل العناوين الفرعية</option>
          </select>
          <select id="ticket-priority-filter" class="compact-select">
            <option value="">كل الأولويات</option>
            <option value="urgent">عاجلة</option>
            <option value="normal">عادية</option>
            <option value="low">منخفضة</option>
          </select>
          <select id="ticket-category-filter" class="compact-select">
            <option value="">كل التصنيفات</option>
            <option value="general">عام</option>
            <option value="registration">تسجيل</option>
            <option value="fees">مصروفات</option>
            <option value="results">نتائج</option>
            <option value="platform">المنصة</option>
            <option value="complaint">شكوى</option>
            <option value="technical">تقني</option>
          </select>
          <select id="ticket-assignee-filter" class="compact-select"><option value="">كل الموظفين</option></select>
          <select id="ticket-follow-up-filter" class="compact-select">
            <option value="">كل مواعيد المتابعة</option>
            <option value="due">حان موعد التواصل</option>
            <option value="today">متابعات اليوم</option>
            <option value="upcoming">مواعيد قادمة</option>
            <option value="none">بدون موعد متابعة</option>
          </select>
          <select id="ticket-sent-filter" class="compact-select">
            <option value="">آخر إرسال: أي وقت</option>
            <option value="1">آخر إرسال أقدم من يوم</option>
            <option value="3">آخر إرسال أقدم من 3 أيام</option>
            <option value="7">آخر إرسال أقدم من أسبوع</option>
          </select>
          <select id="ticket-received-filter" class="compact-select">
            <option value="">آخر استقبال: أي وقت</option>
            <option value="1">آخر استقبال أقدم من يوم</option>
            <option value="3">آخر استقبال أقدم من 3 أيام</option>
            <option value="7">آخر استقبال أقدم من أسبوع</option>
          </select>
          <select id="ticket-idea-filter" class="compact-select">
            <option value="">كل الأفكار</option>
            <option value="0">لم يُحدَّد بعد</option>
          </select>
          <label class="row ticket-unread-filter"><input type="checkbox" id="ticket-unread-filter"> غير المقروء فقط</label>
          </div>
          <button class="btn btn-ghost btn-sm" id="refresh-tickets-btn">تحديث</button>
          <% if (userRole === 'agent') { %>
            <form method="POST" action="/logout" class="agent-logout-form">
              <button type="submit" class="btn btn-ghost btn-sm" title="تسجيل الخروج" aria-label="تسجيل الخروج">⇥</button>
            </form>
          <% } %>
        </div>

        <div class="ticket-workspace">
          <div class="ticket-list-panel card">
            <div class="row-between"><b id="ticket-count">التذاكر</b><span id="ticket-page-label" class="ticket-muted"></span></div>
            <div id="ticket-list"><div class="empty-state">بيتحمّل...</div></div>
            <div class="ticket-pagination">
              <button class="btn btn-ghost btn-sm" id="tickets-prev">السابق</button>
              <button class="btn btn-ghost btn-sm" id="tickets-next">التالي</button>
            </div>
          </div>

          <div class="ticket-conversation-panel card" id="ticket-conversation-panel">
            <div class="empty-state">اختر تذكرة لعرض المحادثة والرد</div>
          </div>
        </div>
      </section>

      <!-- ===== جهات الاتصال ===== -->
      <section class="tab-panel" id="tab-contacts" style="display:none">
        <div class="page-header">
          <h1>جهات الاتصال والإرسال الجماعي</h1>
          <p>فلترة الجمهور وتحديده ثم إنشاء الرسالة من مكان واحد</p>
        </div>

        <div class="card">
          <details class="audience-filters" open>
            <summary>فلاتر جمهور الإرسال</summary>
            <div class="audience-filter-grid">
              <select id="contact-status-filter" class="compact-select">
                <option value="">كل الحالات</option>
                <option value="new">جديدة</option><option value="in_progress">قيد المتابعة</option>
                <option value="waiting_student">بانتظار الطالب</option><option value="resolved">مكتملة</option>
                <option value="closed">مغلقة</option>
              </select>
              <select id="contact-subtitle-filter" class="compact-select"><option value="">كل العناوين الفرعية</option></select>
              <select id="contact-priority-filter" class="compact-select">
                <option value="">كل الأولويات</option><option value="urgent">عاجلة</option>
                <option value="normal">عادية</option><option value="low">منخفضة</option>
              </select>
              <select id="contact-category-filter" class="compact-select">
                <option value="">كل التصنيفات</option><option value="general">عام</option>
                <option value="registration">تسجيل</option><option value="fees">مصروفات</option>
                <option value="results">نتائج</option><option value="platform">المنصة</option>
                <option value="complaint">شكوى</option><option value="technical">تقني</option>
              </select>
              <select id="contact-assignee-filter" class="compact-select"><option value="">كل الموظفين</option></select>
              <select id="contact-follow-up-filter" class="compact-select">
                <option value="">كل مواعيد المتابعة</option><option value="due">حان موعد التواصل</option>
                <option value="today">متابعات اليوم</option><option value="upcoming">مواعيد قادمة</option>
                <option value="none">بدون موعد متابعة</option>
              </select>
              <select id="filter-sent" class="compact-select">
                <option value="">آخر إرسال: أي وقت</option>
                <option value="1">آخر إرسال أقدم من يوم</option>
                <option value="3">آخر إرسال أقدم من 3 أيام</option>
                <option value="7">آخر إرسال أقدم من أسبوع</option>
                <option value="never">لم نرسل له مطلقًا</option>
              </select>
              <select id="filter-received" class="compact-select">
                <option value="">آخر استقبال: أي وقت</option>
                <option value="1">آخر استقبال أقدم من يوم</option>
                <option value="3">آخر استقبال أقدم من 3 أيام</option>
                <option value="7">آخر استقبال أقدم من أسبوع</option>
                <option value="never">لم يرسل لنا مطلقًا</option>
              </select>
              <label class="row ticket-unread-filter"><input type="checkbox" id="contact-unread-filter"> غير المقروء فقط</label>
            </div>
          </details>
          <div class="row-between audience-actions">
            <div class="row">
              <button type="button" class="btn btn-ghost btn-sm" id="select-filtered-contacts-btn">تحديد كل النتائج المفلترة</button>
              <button type="button" class="btn btn-ghost btn-sm" id="clear-selected-contacts-btn">إلغاء التحديد</button>
            </div>
            <div class="row">
              <span id="selected-contacts-count" class="badge badge-muted">المحدد: 0</span>
              <button type="button" class="btn btn-primary btn-sm" id="message-selected-btn" style="width:auto" disabled>مراسلة المحددين</button>
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">
                استيراد CSV
                <input type="file" id="csv-input" accept=".csv" style="display:none" />
              </label>
              <a href="/api/contacts/export" class="btn btn-ghost btn-sm">تصدير CSV</a>
            </div>
          </div>
          <div id="contacts-table-wrap">
            <div class="empty-state">بيتحمّل...</div>
          </div>
        </div>

      <!-- ===== إرسال جماعي ===== -->
        <div class="page-header merged-section-header" id="broadcast-compose">
          <h1>إنشاء رسالة جماعية</h1>
          <p>ابعت رسالة لكل جهات الاتصال أو لمجموعة مفلترة، فورًا أو في وقت محدد</p>
        </div>

        <div class="card">
          <h2>رسالة جديدة</h2>
          <div class="field">
            <label>المحتوى</label>
            <textarea id="broadcast-content" placeholder="اكتب نص الرسالة هنا..."></textarea>
          </div>
          <div class="field">
            <label>صورة (اختياري — JPG أو PNG، بحد أقصى 10MB)</label>
            <div class="image-picker-row">
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">
                اختيار صورة
                <input type="file" id="broadcast-image" accept="image/jpeg,image/png" style="display:none">
              </label>
              <span id="broadcast-image-name" class="image-file-name">لم يتم اختيار صورة</span>
              <button type="button" id="clear-broadcast-image" class="btn btn-danger-ghost btn-sm" style="display:none">إزالة</button>
            </div>
          </div>
          <div class="row" style="gap:16px">
            <div class="field" style="flex:1; min-width:180px">
              <label>إرسال لـ</label>
              <select id="broadcast-tag"><option value="">كل جهات الاتصال</option></select>
              <div id="selected-audience-hint" class="selection-hint" style="display:none"></div>
            </div>
            <div class="field" style="flex:1; min-width:180px">
              <label>جدولة (اختياري)</label>
              <input type="datetime-local" id="broadcast-schedule" />
            </div>
          </div>
          <button class="btn btn-primary" id="send-broadcast-btn" style="width:auto; padding-inline:24px">إرسال</button>
        </div>

        <div class="card">
          <h2>سجل عمليات الإرسال</h2>
          <div id="broadcasts-table-wrap">
            <div class="empty-state">بيتحمّل...</div>
          </div>
        </div>
      </section>

      <!-- ===== القوالب ===== -->
      <section class="tab-panel" id="tab-templates" style="display:none">
        <div class="page-header">
          <h1>القوالب</h1>
          <p>رسائل جاهزة تقدر تعيد استخدامها في أي إرسال جماعي</p>
        </div>
        <div class="card">
          <h2>قالب جديد</h2>
          <div class="row" style="gap:16px">
            <div class="field" style="flex:1"><label>اسم القالب</label><input type="text" id="template-name" /></div>
          </div>
          <div class="field"><label>المحتوى</label><textarea id="template-content"></textarea></div>
          <button class="btn btn-primary" id="add-template-btn" style="width:auto; padding-inline:24px">إضافة القالب</button>
        </div>
        <div class="card">
          <h2>القوالب الحالية</h2>
          <div id="templates-list"><div class="empty-state">بيتحمّل...</div></div>
        </div>
      </section>

      <!-- ===== طلاب منصة طفرة ===== -->
      <section class="tab-panel" id="tab-tafra-students" style="display:none">
        <div class="page-header">
          <h1>طلاب منصة طفرة</h1>
          <p>بيانات الطلاب المحفوظة محليًا من آخر تحديث للمنصة</p>
        </div>
        <div class="card tafra-student-filters">
          <input type="search" id="tafra-student-search" placeholder="بحث بالاسم أو الهاتف أو الكود أو رقم المحادثة">
          <select id="tafra-level-filter"><option value="">كل الصفوف</option></select>
          <select id="tafra-education-type-filter">
            <option value="">كل أنواع التعليم</option>
            <option value="general">عام</option>
            <option value="azhar">أزهري</option>
          </select>
          <select id="tafra-telegram-filter">
            <option value="">الكل حسب تيليجرام</option>
            <option value="linked">مرتبط بتيليجرام</option>
            <option value="unlinked">غير مرتبط</option>
          </select>
          <select id="tafra-status-filter"><option value="">كل الحالات</option></select>
          <select id="tafra-bootcamp-filter"><option value="">كل الأبواب والكورسات</option></select>
          <select id="tafra-idea-filter">
            <option value="">كل الأفكار</option>
            <option value="0">لم يُحدَّد بعد</option>
          </select>
          <input type="date" id="tafra-enrolled-from" title="تاريخ الاشتراك من">
          <input type="date" id="tafra-enrolled-to" title="تاريخ الاشتراك إلى">
          <button type="button" class="btn btn-ghost" id="clear-tafra-filters">مسح الفلاتر</button>
        </div>
        <div class="card" style="padding-block:12px">
          <div class="row-between" style="gap:12px; flex-wrap:wrap">
            <span id="tafra-enrollment-sync-status" class="card-desc">لم يتم تحديث اشتراكات الأبواب بعد.</span>
            <div class="row" style="gap:8px; flex-wrap:wrap">
              <button type="button" class="btn btn-ghost btn-sm" id="sync-tafra-bootcamp-names">تحديث أسماء الأبواب</button>
              <button type="button" class="btn btn-primary btn-sm" id="sync-tafra-enrollments">تحديث اشتراكات الأبواب</button>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="row-between" style="margin-bottom:12px">
            <b id="tafra-student-count">الطلاب</b>
            <span id="tafra-student-page-label" class="ticket-muted"></span>
          </div>
          <div id="tafra-students-table"><div class="empty-state">جارٍ التحميل...</div></div>
          <div class="ticket-pagination">
            <button type="button" class="btn btn-ghost btn-sm" id="tafra-students-prev">السابق</button>
            <button type="button" class="btn btn-ghost btn-sm" id="tafra-students-next">التالي</button>
          </div>
        </div>
      </section>

      <!-- ===== الإعدادات ===== -->
      <section class="tab-panel" id="tab-settings" style="display:none">
        <div class="page-header">
          <h1>الإعدادات</h1>
          <p>توكن البوت والرد التلقائي</p>
        </div>

        <div class="card">
          <h2>ربط منصة طفرة</h2>
          <p class="card-desc">قراءة بيانات الطلاب إلى قاعدة بيانات المشروع فقط. لا يضيف هذا الربط أو يعدّل أو يحذف أي بيانات على المنصة.</p>
          <div id="tafra-connection-status" class="badge badge-muted" style="margin-bottom:14px">جارٍ التحقق...</div>
          <div class="bot-profile-create">
            <input type="text" id="tafra-identifier" autocomplete="username" placeholder="رقم الهاتف أو البريد الإلكتروني">
            <input type="password" id="tafra-password" autocomplete="new-password" placeholder="كلمة مرور حساب المنصة">
            <button type="button" class="btn btn-primary" id="save-tafra-credentials" style="width:auto">فحص وحفظ الربط</button>
          </div>
          <div id="tafra-sync-details" class="card-desc" style="margin-top:14px">لم تتم مزامنة الطلاب بعد.</div>
          <button type="button" class="btn btn-primary" id="sync-tafra-students" style="width:auto; margin-top:12px">تحديث بيانات الطلاب الآن</button>
        </div>

        <div class="card">
          <h2>إدارة وتبديل البوتات</h2>
          <p class="card-desc">احفظ أكثر من بوت ثم بدّل بينها بضغطة واحدة. يتم فحص التوكن قبل الحفظ، وتظل كل التوكنات مشفّرة.</p>
          <div id="token-status" class="badge badge-muted" style="margin-bottom:14px">بيتحقق...</div>
          <div id="bot-profiles-list" class="bot-profiles-list"><div class="empty-state">بيتحمّل...</div></div>
          <div class="bot-profile-create">
            <input type="text" id="bot-profile-label" maxlength="100" placeholder="اسم داخل اللوحة، مثال: بوت الطلاب الجديد">
            <input type="password" id="bot-token-input" placeholder="توكن البوت من BotFather">
            <button class="btn btn-primary" id="add-bot-profile-btn" style="width:auto; padding-inline:24px">فحص وحفظ البوت</button>
          </div>
          <p class="card-desc" style="margin-top:10px">عند تفعيل بوت، ينتقل Webhook إليه ويتوقف المشروع عن استقبال رسائل البوت السابق. قاعدة البيانات لا تتغير.</p>
        </div>

        <div class="card">
          <h2>الرد التلقائي</h2>
          <p class="card-desc">لو مفعّل، البوت هيرد تلقائيًا على أي رسالة نصية واردة</p>
          <label class="row" style="gap:8px; margin-bottom:14px; cursor:pointer">
            <input type="checkbox" id="auto-reply-enabled" style="width:auto" />
            <span>تفعيل الرد التلقائي</span>
          </label>
          <div class="field"><label>نص الرد</label><textarea id="auto-reply-message"></textarea></div>
          <button class="btn btn-primary" id="save-auto-reply-btn" style="width:auto; padding-inline:24px">حفظ</button>
        </div>

        <div class="card">
          <h2>تحويل الرسائل إلى حساب تيليجرام</h2>
          <p class="card-desc">من الحساب المطلوب، افتح البوت واضغط Start ثم أرسل أمر الربط الظاهر أدناه.</p>
          <div id="forward-target-status" class="badge badge-muted" style="margin-bottom:14px">بيتحقق...</div>
          <div class="link-command-box">
            <code id="forward-link-command">بيتحمّل...</code>
            <button type="button" class="btn btn-ghost btn-sm" id="copy-forward-command">نسخ الأمر</button>
          </div>
          <label class="row" style="gap:8px; margin-top:14px; cursor:pointer">
            <input type="checkbox" id="forwarding-enabled" style="width:auto">
            <span>تفعيل تحويل الرسائل الواردة</span>
          </label>
          <button class="btn btn-primary" id="save-forwarding-btn" style="width:auto; padding-inline:24px; margin-top:10px">حفظ</button>
        </div>

        <div class="card">
          <h2>رسالة المتابعة التلقائية</h2>
          <p class="card-desc">تُرسل تلقائيًا عندما يحين موعد التواصل المحدد داخل التذكرة، ثم يُغلق الموعد تلقائيًا.</p>
          <label class="row" style="gap:8px; margin-bottom:14px; cursor:pointer">
            <input type="checkbox" id="follow-up-auto-enabled" style="width:auto">
            <span>تفعيل الإرسال التلقائي عند حلول الموعد</span>
          </label>
          <div class="field">
            <label>نص رسالة المتابعة</label>
            <textarea id="follow-up-auto-message" maxlength="4096" placeholder="اكتب الرسالة التي ستصل للعميل..."></textarea>
          </div>
          <button class="btn btn-primary" id="save-follow-up-auto-btn" style="width:auto; padding-inline:24px">حفظ الرسالة</button>
        </div>

        <div class="card">
          <h2>تعريف الموظف للطالب</h2>
          <p class="card-desc">تُرسل قبل أول رد للموظف خلال اليوم. إذا تغيّر الموظف تُرسل مجددًا باسمه.</p>
          <label class="row" style="gap:8px; margin-bottom:14px; cursor:pointer">
            <input type="checkbox" id="agent-intro-enabled" style="width:auto">
            <span>تفعيل رسالة تعريف الموظف</span>
          </label>
          <div class="field">
            <label>نص التعريف — استخدم <code>{name}</code> مكان اسم الموظف</label>
            <textarea id="agent-intro-message" maxlength="4096"></textarea>
          </div>
          <button class="btn btn-primary" id="save-agent-intro-btn" style="width:auto; padding-inline:24px">حفظ التعريف</button>
        </div>

        <div class="card">
          <h2>إدارة حسابات الفريق</h2>
          <p class="card-desc">أنشئ حسابًا مستقلًا لكل مدير أو موظف دعم. موظف الدعم يرى صندوق التذاكر فقط.</p>
          <div class="staff-create-form">
            <input type="text" id="staff-name" placeholder="الاسم">
            <input type="email" id="staff-email" placeholder="البريد الإلكتروني">
            <input type="password" id="staff-password" placeholder="كلمة المرور (8 أحرف على الأقل)">
            <select id="staff-role"><option value="agent">موظف دعم</option><option value="admin">مدير</option></select>
            <button type="button" class="btn btn-primary" id="create-staff-btn" style="width:auto">إنشاء الحساب</button>
          </div>
          <div id="staff-users-list"><div class="empty-state">بيتحمّل...</div></div>
        </div>

        <div class="card">
          <h2>إعدادات تتبع الأفكار</h2>
          <p class="card-desc">حدد العدد الأقصى للأفكار في المنهج. يمكن للموظفين تسجيل رقم الفكرة التي وصل إليها كل طالب.</p>
          <div class="field" style="max-width:240px">
            <label>عدد الأفكار في المنهج (الحد الأقصى)</label>
            <input type="number" id="max-idea-number" min="1" max="999" value="20">
          </div>
          <button class="btn btn-primary" id="save-idea-settings-btn" style="width:auto; padding-inline:24px">حفظ</button>
        </div>
      </section>
    </main>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const currentUserRole = '<%= userRole %>';
    const selectedContactIds = new Set();
    let currentFilteredContactIds = [];
    let ticketsMeta = null;
    let currentTicketId = null;
    let ticketsPage = 1;
    let ticketsTotalPages = 1;
    let ticketSearchTimer = null;
    let tafraStudentsPage = 1;
    let tafraStudentsPages = 1;
    let tafraStudentSearchTimer = null;
    let tafraFiltersLoaded = false;

    // ---------- أدوات مساعدة عامة ----------
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2800);
    }

    async function api(url, options = {}) {
      const res = await fetch(url, {
        headers: { 'Content-Type': 'application/json' },
        ...options,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'حصل خطأ');
      return data;
    }

    function fmtDate(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
    }

    function fmtDay(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleDateString('ar-EG', { dateStyle: 'medium' });
    }

    function toDateTimeLocal(iso) {
      if (!iso) return '';
      const date = new Date(iso);
      const localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return localDate.toISOString().slice(0, 16);
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[character]));
    }

    function firstEmployeeName(fullName) {
      return String(fullName || '').trim().split(/\s+/)[0] || '';
    }

    function employeeBadgeClass(userId) {
      return `employee-color-${Math.abs(Number(userId) || 0) % 6}`;
    }

    // ---------- التنقل بين التابات ----------
    const navItems = document.querySelectorAll('.nav-item');
    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navItems.forEach((i) => i.classList.remove('active'));
        item.classList.add('active');
        document.querySelectorAll('.tab-panel').forEach((p) => (p.style.display = 'none'));
        document.getElementById('tab-' + item.dataset.tab).style.display = 'block';
        loadTabData(item.dataset.tab);
      });
    });

    function loadTabData(tab) {
      if (tab === 'overview') loadStats();
      if (tab === 'tickets') initTickets();
      if (tab === 'contacts') initContactsAndBroadcasts();
      if (tab === 'tafra-students') initTafraStudents();
      if (tab === 'templates') loadTemplates();
      if (tab === 'settings') loadSettings();
    }

    // ---------- طلاب منصة طفرة ----------
    async function loadTafraStudentFilters() {
      if (tafraFiltersLoaded) return;
      const filters = await api('/api/tafra/student-filters');
      const levelSelect = document.getElementById('tafra-level-filter');
      const statusSelect = document.getElementById('tafra-status-filter');
      const bootcampSelect = document.getElementById('tafra-bootcamp-filter');
      levelSelect.innerHTML = '<option value="">كل الصفوف</option>' +
        filters.levels.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('');
      const statusNames = { active: 'نشط', inactive: 'غير نشط', suspended: 'موقوف' };
      statusSelect.innerHTML = '<option value="">كل الحالات</option>' +
        filters.statuses.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(statusNames[value] || value)}</option>`).join('');
      bootcampSelect.innerHTML = '<option value="">كل الأبواب والكورسات</option>' +
        filters.bootcamps.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
      const ideaSelect = document.getElementById('tafra-idea-filter');
      const maxIdea = filters.max_idea_number || 20;
      ideaSelect.innerHTML = '<option value="">كل الأفكار</option><option value="0">لم يُحدَّد بعد</option>' +
        Array.from({ length: maxIdea }, (_, i) => i + 1)
          .map((n) => `<option value="${n}">فكرة ${n}</option>`).join('');
      renderTafraEnrollmentSync(filters.enrollment_sync);
      tafraFiltersLoaded = true;
    }

    function renderTafraEnrollmentSync(sync) {
      const status = document.getElementById('tafra-enrollment-sync-status');
      const button = document.getElementById('sync-tafra-enrollments');
      button.disabled = sync?.status === 'running';
      if (sync?.status === 'running') {
        status.textContent = `جارٍ تحديث الاشتراكات: الباب ${sync.current_bootcamp || 0} من ${sync.total_bootcamps || '...'} — ${sync.synced_enrollments || 0} سجل`;
      } else if (sync?.status === 'completed') {
        status.textContent = `آخر تحديث للاشتراكات: ${fmtDate(sync.completed_at)} — ${sync.synced_enrollments || 0} سجل`;
      } else if (sync?.status === 'failed') {
        status.textContent = `توقف آخر تحديث للاشتراكات: ${sync.error_message || 'تعذر الاتصال بالمنصة'}`;
      } else {
        status.textContent = 'يلزم تحديث اشتراكات الأبواب مرة واحدة لتشغيل الفلتر.';
      }
    }

    function tafraStudentQuery() {
      const params = new URLSearchParams({ page: tafraStudentsPage, limit: 50 });
      const fields = {
        search: 'tafra-student-search', level: 'tafra-level-filter',
        education_type: 'tafra-education-type-filter', telegram: 'tafra-telegram-filter',
        status: 'tafra-status-filter', bootcamp: 'tafra-bootcamp-filter',
        idea_number: 'tafra-idea-filter',
        enrolled_from: 'tafra-enrolled-from', enrolled_to: 'tafra-enrolled-to'
      };
      Object.entries(fields).forEach(([key, id]) => {
        const value = document.getElementById(id).value.trim();
        if (value) params.set(key, value);
      });
      return params.toString();
    }

    async function loadTafraStudents() {
      const wrap = document.getElementById('tafra-students-table');
      wrap.innerHTML = '<div class="empty-state">جارٍ تحميل الطلاب...</div>';
      try {
        const result = await api('/api/tafra/students?' + tafraStudentQuery());
        tafraStudentsPages = result.meta.pages;
        document.getElementById('tafra-student-count').textContent = `الطلاب: ${result.meta.total}`;
        document.getElementById('tafra-student-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('tafra-students-prev').disabled = result.meta.page <= 1;
        document.getElementById('tafra-students-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.students.length) {
          wrap.innerHTML = '<div class="empty-state">لا يوجد طلاب مطابقون للفلاتر</div>';
          return;
        }
        wrap.innerHTML = `<div class="tafra-students-table-wrap"><table>
          <thead><tr><th>الطالب</th><th>الهاتف</th><th>هاتف ولي الأمر</th><th>الصف</th><th>التعليم</th><th>الحالة</th><th>الفكرة الحالية</th><th>تيليجرام</th></tr></thead>
          <tbody>${result.students.map((student) => `<tr>
            <td><div class="tafra-student-name">${escapeHtml(student.name || 'بدون اسم')}</div><div class="tafra-student-sub">رقم الطالب: ${escapeHtml(student.tafra_student_id)} — الكود: ${escapeHtml(student.student_code || '—')}</div></td>
            <td>${escapeHtml(student.phone || '—')}</td>
            <td>${escapeHtml(student.parent_phone || '—')}</td>
            <td>${escapeHtml(student.educational_level || 'غير محدد')}</td>
            <td>${student.education_type === 'azhar' ? '<span class="badge badge-warning">أزهري</span>' : '<span class="badge badge-muted">عام</span>'}</td>
            <td>${student.status === 'active' ? '<span class="badge badge-success">نشط</span>' : `<span class="badge badge-muted">${escapeHtml(student.status || 'غير محدد')}</span>`}</td>
            <td>${student.current_idea_number ? `<span class="idea-badge">💡 فكرة ${student.current_idea_number}</span>` : '<span class="badge badge-muted">—</span>'}</td>
            <td>${student.telegram_chat_id ? `<span class="badge badge-success">مرتبط</span><div class="tafra-student-sub">${escapeHtml(student.telegram_username ? '@' + student.telegram_username : student.telegram_chat_id)}</div>` : '<span class="badge badge-muted">غير مرتبط</span>'}</td>
          </tr>`).join('')}</tbody>
        </table></div>`;
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function initTafraStudents() {
      try {
        await loadTafraStudentFilters();
        await loadTafraStudents();
      } catch (error) { showToast(error.message); }
    }

    ['tafra-level-filter', 'tafra-education-type-filter', 'tafra-telegram-filter', 'tafra-status-filter', 'tafra-bootcamp-filter', 'tafra-idea-filter', 'tafra-enrolled-from', 'tafra-enrolled-to'].forEach((id) => {
      document.getElementById(id).addEventListener('change', () => {
        tafraStudentsPage = 1;
        loadTafraStudents();
      });
    });
    document.getElementById('tafra-student-search').addEventListener('input', () => {
      clearTimeout(tafraStudentSearchTimer);
      tafraStudentSearchTimer = setTimeout(() => { tafraStudentsPage = 1; loadTafraStudents(); }, 350);
    });
    document.getElementById('clear-tafra-filters').addEventListener('click', () => {
      ['tafra-student-search', 'tafra-level-filter', 'tafra-education-type-filter', 'tafra-telegram-filter', 'tafra-status-filter', 'tafra-bootcamp-filter', 'tafra-idea-filter', 'tafra-enrolled-from', 'tafra-enrolled-to']
        .forEach((id) => { document.getElementById(id).value = ''; });
      tafraStudentsPage = 1;
      loadTafraStudents();
    });
    document.getElementById('tafra-students-prev').addEventListener('click', () => {
      if (tafraStudentsPage > 1) { tafraStudentsPage -= 1; loadTafraStudents(); }
    });
    document.getElementById('tafra-students-next').addEventListener('click', () => {
      if (tafraStudentsPage < tafraStudentsPages) { tafraStudentsPage += 1; loadTafraStudents(); }
    });

    document.getElementById('sync-tafra-enrollments').addEventListener('click', async () => {
      if (!window.confirm('بدء قراءة اشتراكات الطلاب في الأبواب والكورسات؟ لن يتم تعديل منصة طفرة.')) return;
      const button = document.getElementById('sync-tafra-enrollments');
      button.disabled = true;
      try {
        const result = await api('/api/tafra/sync-enrollments', { method: 'POST' });
        showToast(result.message);
        const poll = async () => {
          tafraFiltersLoaded = false;
          const filters = await api('/api/tafra/student-filters');
          renderTafraEnrollmentSync(filters.enrollment_sync);
          if (filters.enrollment_sync?.status === 'running') setTimeout(poll, 3000);
          else {
            tafraFiltersLoaded = false;
            await loadTafraStudentFilters();
            await loadTafraStudents();
          }
        };
        setTimeout(poll, 1500);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    });

    document.getElementById('sync-tafra-bootcamp-names').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-bootcamp-names');
      button.disabled = true;
      try {
        const result = await api('/api/tafra/sync-bootcamps', { method: 'POST' });
        showToast(result.message);
        tafraFiltersLoaded = false;
        await loadTafraStudentFilters();
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
      }
    });

    // ---------- نظرة عامة ----------
    async function loadStats() {
      try {
        const s = await api('/api/stats');
        const grid = document.getElementById('stats-grid');
        grid.innerHTML = `
          <div class="stat-card"><div class="label">إجمالي جهات الاتصال</div><div class="value">${s.total_contacts}</div></div>
          <div class="stat-card"><div class="label">متفاعلين آخر أسبوع</div><div class="value">${s.active_last_week}</div></div>
          <div class="stat-card"><div class="label">رسائل مُرسلة</div><div class="value">${s.total_messages_sent}</div></div>
          <div class="stat-card"><div class="label">معدل الرد التقريبي</div><div class="value">${s.response_rate}%</div></div>
        `;
      } catch (e) { showToast(e.message); }
    }

    // ---------- صندوق الدعم ----------
    const ticketLabels = {
      status: {
        new: 'جديدة', in_progress: 'قيد المتابعة', waiting_student: 'بانتظار الطالب',
        resolved: 'مكتملة', closed: 'مغلقة'
      },
      priority: { low: 'منخفضة', normal: 'عادية', urgent: 'عاجلة' },
      category: {
        general: 'عام', registration: 'تسجيل', fees: 'مصروفات', results: 'نتائج',
        platform: 'المنصة', complaint: 'شكوى', technical: 'تقني'
      }
    };

    async function ensureTicketsMeta() {
      if (!ticketsMeta) ticketsMeta = await api('/api/tickets/meta');
      return ticketsMeta;
    }

    async function initTickets() {
      initLiveEvents();
      try {
        await ensureTicketsMeta();
        const assigneeFilter = document.getElementById('ticket-assignee-filter');
        assigneeFilter.innerHTML = '<option value="">كل الموظفين</option><option value="unassigned">غير معيّنة</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
        const subtitleFilter = document.getElementById('ticket-subtitle-filter');
        subtitleFilter.innerHTML = '<option value="">كل العناوين الفرعية</option>' +
          ticketsMeta.subtitles.map((subtitle) => `<option value="${subtitle.id}">${escapeHtml(subtitle.name)}</option>`).join('');
        const maxIdea = ticketsMeta.max_idea_number || 20;
        const ideaFilter = document.getElementById('ticket-idea-filter');
        if (ideaFilter) {
          ideaFilter.innerHTML = '<option value="">كل الأفكار</option><option value="0">لم يُحدَّد بعد</option>' +
            Array.from({ length: maxIdea }, (_, i) => i + 1)
              .map((n) => `<option value="${n}">فكرة ${n}</option>`).join('');
        }
      } catch (error) {
        return showToast(error.message);
      }
      loadTickets();
    }

    function ticketQueryString() {
      const query = new URLSearchParams({ page: String(ticketsPage) });
      const values = {
        q: document.getElementById('ticket-search').value.trim(),
        status: document.getElementById('ticket-status-filter').value,
        subtitle_id: document.getElementById('ticket-subtitle-filter').value,
        priority: document.getElementById('ticket-priority-filter').value,
        category: document.getElementById('ticket-category-filter').value,
        assigned_to: document.getElementById('ticket-assignee-filter').value,
        follow_up: document.getElementById('ticket-follow-up-filter').value,
        sent_older_than: document.getElementById('ticket-sent-filter').value,
        received_older_than: document.getElementById('ticket-received-filter').value,
        idea_number: document.getElementById('ticket-idea-filter') ? document.getElementById('ticket-idea-filter').value : '',
      };
      Object.entries(values).forEach(([key, value]) => { if (value) query.set(key, value); });
      if (document.getElementById('ticket-unread-filter').checked) query.set('unread', 'true');
      return query.toString();
    }

    async function loadTickets(silent = false) {
      const list = document.getElementById('ticket-list');
      if (!silent) {
        list.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      }
      try {
        const data = await api('/api/tickets?' + ticketQueryString());
        ticketsTotalPages = data.pages;
        document.getElementById('ticket-count').textContent = `التذاكر (${data.total})`;
        document.getElementById('ticket-page-label').textContent = `صفحة ${data.page} من ${data.pages}`;
        document.getElementById('tickets-prev').disabled = data.page <= 1;
        document.getElementById('tickets-next').disabled = data.page >= data.pages;

        if (!data.tickets.length) {
          list.innerHTML = '<div class="empty-state">لا توجد تذاكر مطابقة</div>';
          return;
        }

        list.innerHTML = data.tickets.map((ticket) => {
          const name = [ticket.first_name, ticket.last_name].filter(Boolean).join(' ') || ticket.telegram_username || ticket.chat_id;
          const preview = ticket.last_message_preview || 'لا توجد رسالة';
          const followUpDue = ticket.next_follow_up_at && new Date(ticket.next_follow_up_at) <= new Date()
            && !['resolved', 'closed'].includes(ticket.status);
          const ideaBadge = ticket.current_idea_number
            ? `<span class="idea-badge" title="رقم الفكرة الحالية">💡${ticket.current_idea_number}</span>`
            : '';
          const hasUnread = Boolean(ticket.unread_count && ticket.unread_count > 0);
          return `
            <button type="button" class="ticket-list-item ${Number(ticket.id) === Number(currentTicketId) ? 'active' : ''} ${hasUnread ? 'has-unread' : ''}" data-ticket-id="${ticket.id}">
              <div class="ticket-list-title">
                <span class="ticket-name-with-subtitle">
                  <span>${escapeHtml(name)}</span>
                  <span class="ticket-subtitle-badge">${escapeHtml(ticket.subtitle_name || 'مطلوب المتابعة')}</span>
                  ${ideaBadge}
                  ${ticket.assigned_name ? `<span class="ticket-employee-badge ${employeeBadgeClass(ticket.assigned_to)}" title="الموظف المسؤول: ${escapeHtml(ticket.assigned_name)}">${escapeHtml(firstEmployeeName(ticket.assigned_name))}</span>` : ''}
                </span>
                ${ticket.unread_count ? `<span class="unread-count" title="${ticket.unread_count} رسائل غير مقروءة">${ticket.unread_count}</span>` : ''}
              </div>
              <div class="ticket-preview">${ticket.last_message_direction === 'outgoing' ? '↩ ' : ''}${escapeHtml(preview)}</div>
              <div class="ticket-list-meta">
                <span>${ticketLabels.status[ticket.status] || ticket.status}</span>
                <span>${ticketLabels.priority[ticket.priority] || ticket.priority}</span>
                <span>${fmtDate(ticket.last_message_at)}</span>
              </div>
              ${ticket.next_follow_up_at ? `<div class="follow-up-badge ${followUpDue ? 'due' : ''}">📅 ${followUpDue ? 'حان الموعد: ' : 'المتابعة: '}${fmtDate(ticket.next_follow_up_at)}</div>` : ''}
            </button>`;
        }).join('');
        list.querySelectorAll('[data-ticket-id]').forEach((button) => {
          button.addEventListener('click', () => loadTicket(Number(button.dataset.ticketId)));
        });
      } catch (error) {
        if (!silent) list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function buildOptions(values, current, labels, emptyLabel) {
      const empty = emptyLabel ? `<option value="">${emptyLabel}</option>` : '';
      return empty + values.map((value) =>
        `<option value="${value}" ${value === current ? 'selected' : ''}>${escapeHtml(labels[value] || value)}</option>`
      ).join('');
    }

    async function loadTicket(ticketId) {
      currentTicketId = ticketId;
      document.querySelector('.ticket-workspace').classList.add('ticket-open');
      document.getElementById('tab-tickets').classList.add('ticket-open-view');
      const panel = document.getElementById('ticket-conversation-panel');
      panel.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api('/api/tickets/' + ticketId);
        const ticket = data.ticket;
        const name = [ticket.first_name, ticket.last_name].filter(Boolean).join(' ') || ticket.telegram_username || ticket.chat_id;
        const assignedUser = ticketsMeta.users.find((user) => Number(user.id) === Number(ticket.assigned_to));
        const usersOptions = '<option value="">غير معيّنة</option>' + ticketsMeta.users.map((user) =>
          `<option value="${user.id}" ${Number(user.id) === Number(ticket.assigned_to) ? 'selected' : ''}>${escapeHtml(user.name)}</option>`
        ).join('');
        const subtitlesOptions = ticketsMeta.subtitles.map((subtitle) =>
          `<option value="${subtitle.id}" ${Number(subtitle.id) === Number(ticket.subtitle_id) ? 'selected' : ''}>${escapeHtml(subtitle.name)}</option>`
