    document.getElementById('sync-tafra-exams').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-exams');
      if (!window.confirm('بدء قراءة كل الاختبارات (أونلاين وورقي) ودرجات الطلاب فيها؟ لن يتم تعديل منصة طفرة. المنصة بترجّع أحدث 10 اختبارات بس في القائمة العادية، فبنمسح كل رقم لوحده للتأكد إننا هنجيب كل الاختبارات — العملية ممكن تاخد كام دقيقة.')) return;
      button.disabled = true;
      try {
        const result = await api('/api/tafra/sync-exams', { method: 'POST' });
        showToast(result.message);
        const poll = async () => {
          const sync = await loadTafraExamSyncStatus();
          if (sync?.status === 'running' || sync?.status === 'discovering') setTimeout(poll, 3000);
          else if (sync?.status === 'completed') showToast(`اكتمل تحديث الاختبارات — ${sync.synced_marks || 0} درجة`);
          else if (sync?.status === 'failed') showToast('فشل تحديث الاختبارات، راجع التفاصيل');
        };
        setTimeout(poll, 1500);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    });

    document.getElementById('sync-tafra-students').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-students');
      if (!window.confirm('بدء قراءة وتحديث جميع الطلاب داخل قاعدة بيانات المشروع؟ لن يتم تعديل منصة طفرة.')) return;
      button.disabled = true;
      button.textContent = 'جارٍ تحديث الطلاب...';
      try {
        const result = await api('/api/tafra/sync', { method: 'POST' });
        showToast(result.message || 'بدأ تحديث الطلاب في الخلفية');
        const waitForCompletion = async () => {
          await loadTafraStatus();
          const status = await api('/api/tafra/status');
          if (status.sync?.status === 'running') {
            setTimeout(waitForCompletion, 3000);
          } else if (status.sync?.status === 'completed') {
            showToast(`اكتمل تحديث ${status.sync.synced_students} طالب`);
          } else if (status.sync?.status === 'failed') {
            showToast('فشل تحديث الطلاب، راجع حالة الربط');
          }
        };
        setTimeout(waitForCompletion, 1500);
      } catch (error) {
        showToast(error.message);
      } finally {
        button.textContent = 'تحديث بيانات الطلاب الآن';
        await loadTafraStatus();
      }
    });

