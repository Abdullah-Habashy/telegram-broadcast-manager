    const broadcastImageInput = document.getElementById('broadcast-image');
    const broadcastImageName = document.getElementById('broadcast-image-name');
    const clearBroadcastImage = document.getElementById('clear-broadcast-image');

    broadcastImageInput.addEventListener('change', () => {
      const file = broadcastImageInput.files[0];
      broadcastImageName.textContent = file ? file.name : 'لم يتم اختيار صورة';
