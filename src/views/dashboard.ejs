          <button class="btn btn-primary" id="save-idea-settings-btn" style="width:auto; padding-inline:24px">حفظ</button>
        </div>
        </div>
      </section>
    </main>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const currentUserRole = '<%= userRole %>';
    const currentUserTeam = <%- userTeam ? JSON.stringify(userTeam) : 'null' %>;
    // نفس تعريف utils/teams.js — أي تيم جديد بيتضاف في الاتنين
    const TEAM_INFO = {
      science: { label: 'التيم العلمي', icon: '🧪', tone: 'science', transferTitle: 'تحويل السؤال للتيم العلمي' },
      tech: { label: 'الدعم الفني', icon: '🛠️', tone: 'tech', transferTitle: 'تحويل المشكلة للدعم الفني' },
      whatsapp: { label: 'موظف واتساب', icon: '💬', tone: 'whatsapp', transferTitle: 'تحويل الطالب لموظف واتساب', canHandOff: true },
    };
    const currentUserId = Number('<%= userId %>');
    const canAssignCalls = <%- canAssignCalls ? 'true' : 'false' %>;
    const canViewCalls = <%- canViewCalls ? 'true' : 'false' %>;
    const selectedContactIds = new Set();
    let currentFilteredContactIds = [];
    let currentFilteredTafraStudentContactIds = [];
    let ticketsMeta = null;
    let activityPage = 1;
    let activityPages = 1;
    let currentTicketId = null;
    let ticketsPage = 1;
    let ticketsTotalPages = 1;
    // **مش زيادة على ticketsTotalPages — بديل عنه في القرار.** السيرفر بيبعت شكلين مختلفين:
    // الأدمن بياخد pages، والموظف بياخد has_more (عشان مايقدرش يقدّر عدد الطلاب من الإجمالي).
    // حارس زرار "التالي" كان بيقارن بـ pages وبس، وهي undefined عند الموظف — و`1 < undefined`
    // بترجّع false دايمًا، فالزرار كان **مفعّل ومابيعملش حاجة**، والموظف محبوس في أول ٥٠ تذكرة
    // من ٦٥٠. العلم ده بيتحسب من الشكلين، فأي تغيير في رد السيرفر مايكسرش التنقّل تاني
    let ticketsHasMore = false;
    let ticketSearchTimer = null;
    let tafraStudentsPage = 1;
    let tafraStudentsPages = 1;
    let tafraStudentSearchTimer = null;
    let reportSearchTimer = null;
    let reportStudentsPage = 1;
    let reportStudentsPages = 1;
    let tafraSort = { key: '', dir: 'desc' };
    let reportSort = { key: '', dir: 'desc' };
    let tafraFiltersLoaded = false;
    // آخر نسخة من خيارات الفلاتر المشتركة — متخزّنة عشان شاشة بتتفتح بعد التانية تقدر تتعبّى منها،
    // لأن loadTafraStudentFilters بيرجع من غير ما يعمل حاجة بعد أول نداء ناجح
    let tafraFilterOptions = null;
    let pendingDeepLinkTicketId = new URLSearchParams(location.search).get('ticket');
    let callsPage = 1;
    let callsPages = 1;
    let callsSearchTimer = null;
    let callOutcomes = [];
    let callAssignees = [];
    let currentCallStudentId = null;
    const selectedCallStudentIds = new Set();

    // ---------- أدوات مساعدة عامة ----------
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2800);
    }

    async function api(url, options = {}) {
      const res = await fetch(url, {
        headers: { 'Content-Type': 'application/json' },
        ...options,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const error = new Error(data.error || 'حصل خطأ');
        error.status = res.status;
        error.data = data; // بيوصل البيانات الإضافية (زي needs_confirmation) للكود اللي محتاجها
        throw error;
      }
      return data;
    }

    function fmtDate(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
    }

    function fmtDay(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleDateString('ar-EG', { dateStyle: 'medium' });
    }

    // ---------- حفظ الفلاتر واسترجاعها بعد الريفريش ----------
    // كل شاشة ليها مجموعة فلاتر بتتخزن في localStorage تحت مفتاح خاص بيها. الاسترجاع لازم يتنادى
    // بعد ما قوايم الاختيارات تتملى (الموظفين/العناوين/الأبواب...)، لأن select مابيقبلش قيمة
    // لخيار لسه مش موجود. بيرجّع hasSaved عشان الشاشة تعرف تتجاهل قيمها الافتراضية لو المستخدم
    // كان ضابط فلاتره بنفسه قبل كده.
    const FILTER_STORE_PREFIX = 'tbm.filters.';
    const CONTACT_FILTER_IDS = ['contact-status-filter','contact-subtitle-filter','contact-priority-filter','contact-category-filter','contact-assignee-filter','contact-bootcamp-filter','contact-enrolled-from','contact-enrolled-to','contact-exam-filter','contact-exam-attendance-filter','contact-exam-mark-range-filter','contact-follow-up-filter','filter-sent','filter-received','filter-start-status','contact-unread-filter'];
    const filterGroups = {};

    function readFilterElements(ids) {
      return ids.map((id) => document.getElementById(id)).filter(Boolean);
    }

    function registerFilterGroup(key, ids, { onReset } = {}) {
      const elements = readFilterElements(ids);
      if (!elements.length) return { hasSaved: false, reset: () => {} };

      const storageKey = FILTER_STORE_PREFIX + key;
      const snapshot = () => {
        const state = {};
        elements.forEach((el) => { state[el.id] = el.type === 'checkbox' ? el.checked : el.value; });
        return state;
      };
      const save = () => {
        try { localStorage.setItem(storageKey, JSON.stringify(snapshot())); } catch (_) { /* الخزنة مليانة أو متقفلة */ }
      };

      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch (_) { saved = null; }
      if (saved && typeof saved === 'object') {
        elements.forEach((el) => {
          if (!Object.prototype.hasOwnProperty.call(saved, el.id)) return;
          if (el.type === 'checkbox') el.checked = Boolean(saved[el.id]);
          else el.value = saved[el.id] ?? '';
          // الفلاتر متعددة الاختيار عبارة عن input مخفي + واجهة منفصلة، فمحتاجة تحديث يدوي للعرض
          multiSelectControllers[el.id]?.refresh();
        });
      }

      elements.forEach((el) => {
        el.addEventListener('change', save);
        if (el.type === 'search' || el.type === 'text') el.addEventListener('input', save);
      });

      const group = {
        hasSaved: Boolean(saved),
        save,
        reset: () => {
          try { localStorage.removeItem(storageKey); } catch (_) { /* تجاهل */ }
          if (onReset) onReset();
        },
      };
      filterGroups[key] = group;
      return group;
    }

    // بيرجّع الفلاتر لقيمها الافتراضية وبيمسح المحفوظ — بيستخدمه زرار "إعادة ضبط الفلاتر"
    function resetFilterGroup(key, ids, reload, defaults = {}) {
      readFilterElements(ids).forEach((el) => {
        if (el.type === 'checkbox') el.checked = Boolean(defaults[el.id]);
        else el.value = defaults[el.id] ?? '';
        multiSelectControllers[el.id]?.refresh();
      });
      filterGroups[key]?.reset();
      if (reload) reload();
    }

    // مدة بالثواني → أوضح وحدة تعبّر عنها (ثانية/دقيقة/ساعة/يوم) من غير كسور مالهاش لازمة
    function fmtDuration(seconds) {
      if (seconds === null || seconds === undefined) return '—';
      const value = Math.max(0, Math.round(Number(seconds)));
      if (value < 60) return `${value} ثانية`;
      if (value < 3600) return `${Math.round(value / 60)} دقيقة`;
      if (value < 86400) {
        const hours = Math.floor(value / 3600);
        const minutes = Math.round((value % 3600) / 60);
        return minutes ? `${hours} ساعة و${minutes} دقيقة` : `${hours} ساعة`;
      }
      const days = Math.floor(value / 86400);
      const hours = Math.round((value % 86400) / 3600);
      return hours ? `${days} يوم و${hours} ساعة` : `${days} يوم`;
    }

    function toDateTimeLocal(iso) {
      if (!iso) return '';
      const date = new Date(iso);
      const localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return localDate.toISOString().slice(0, 16);
    }

    // اسم الطالب في كل اللوحة بيتاخد من منصة طفرة الأول — ده الاسم الحقيقي المسجّل، أما اسم
    // تيليجرام فبيكتبه الطالب بنفسه وساعات بيبقى لقب أو إنجليزي. بنرجع لتيليجرام بس لو الطالب
    // مش مربوط بحساب على المنصة. (سبق ولخبط: اللوج كان بيعرض "amin elofy" والترحيب "محمد")
    // شارة "عاجل" — نفس الشكل في المتابعة وصندوق الدعم
    function urgentBadge(isUrgent) {
      return isUrgent ? '<span class="badge badge-danger" title="حالة عاجلة">🚨 عاجل</span>' : '';
    }

    // **نسخة من src/utils/studentName.js — نفس الترتيب بالحرف.** الاسم على منصة طفرة هو
    // الاسم الحقيقي، واسم تيليجرام بيكتبه الطالب بنفسه وساعات بيبقى لقب أو رموز.
    // أي تعديل هنا لازم يتعمل هناك، وإلا الطالب يظهر باسمين مختلفين في شاشتين
    function studentDisplayName(row) {
      if (!row) return 'بدون اسم';
      const platform = String(row.tafra_name || row.platform_name || '').trim();
      if (platform) return platform;
      const telegram = [row.first_name, row.last_name].filter(Boolean).join(' ').trim();
      return telegram || String(row.telegram_username || row.username || '').trim() || String(row.chat_id || 'بدون اسم');
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[character]));
    }

    // ---------- فلتر اختيار متعدد (checkbox dropdown) ----------
    // القيم المحددة بتتخزن كـ comma-separated جوه نفس الـ input اللي كان <select> عادي، عشان كل كود
    // بناء الاستعلام والمزامنة بين التابات ومسح الفلاتر يفضل شغال زي ما هو من غير أي تعديل
    const multiSelectControllers = {};

    // ===================== تعريف موحّد لفلاتر الطلاب =====================
    // مصدر واحد للحقيقة: شاشة "طلاب المنصة" وشاشة "المتابعة التليفونية" بيترسموا منه، فأي فلتر
    // يتضاف هنا بيظهر في الاتنين تلقائيًا. الـ id بيفضل زي ما هو لكل شاشة عشان الكود اللي بيناديه
    // بالاسم مايكسرش. الباك إند بيقبل نفس الأسماء في الشاشتين عن طريق buildTafraStudentFilters
    const STUDENT_FILTER_DEFS = [
      { key: 'search', type: 'search', ids: { tafra: 'tafra-student-search', calls: 'calls-search' },
        placeholder: 'بحث بالاسم أو الهاتف أو الكود أو رقم المحادثة' },
      { key: 'level', type: 'hidden', ids: { tafra: 'tafra-level-filter', calls: 'calls-level-filter' } },
      { key: 'education_type', type: 'select', ids: { tafra: 'tafra-education-type-filter', calls: 'calls-education-type-filter' },
        options: [['', 'كل أنواع التعليم'], ['general', 'عام'], ['azhar', 'أزهري']] },
      { key: 'gender', type: 'select', ids: { tafra: 'tafra-gender-filter', calls: 'calls-gender-filter' },
        title: 'نوع الطالب متخمّن من اسمه، مش بيانات مؤكدة من المنصة',
        options: [['', 'كل الأنواع (ولد/بنت)'], ['male', 'ولد'], ['female', 'بنت'], ['unknown', 'غير محدد']] },
      { key: 'telegram', type: 'select', ids: { tafra: 'tafra-telegram-filter', calls: 'calls-telegram-filter' },
        options: [['', 'الكل حسب تيليجرام'], ['started', 'بدأ محادثة (يمكن مراسلته)'],
          ['linked_not_started', 'مرتبط ولم يبدأ محادثة'], ['linked', 'كل المرتبطين بتيليجرام'], ['unlinked', 'غير مرتبط']] },
      { key: 'conversation_status', type: 'select', ids: { tafra: 'tafra-conversation-filter', calls: 'calls-conversation-filter' },
        options: [['', 'كل حالات التواصل'], ['start_only', 'ضغط Start بس (لسه مفيش محادثة)'],
          ['chatted', 'تمت محادثة (بدون موعد متابعة)'], ['chatted_with_follow_up', 'تمت محادثة + موعد متابعة محدد']] },
      { key: 'assigned_to', type: 'select', ids: { tafra: 'tafra-assignee-filter', calls: 'calls-assignee-filter' },
        title: 'الموظف المسؤول عن تذكرة الطالب في صندوق الدعم',
        options: [['', 'كل الموظفين'], ['unassigned', 'غير مسند']] },
      { key: 'status', type: 'hidden', ids: { tafra: 'tafra-status-filter', calls: 'calls-status-filter' } },
      { key: 'bootcamp', type: 'hidden', ids: { tafra: 'tafra-bootcamp-filter', calls: 'calls-bootcamp-filter' } },
      { key: 'exam', type: 'hidden', ids: { tafra: 'tafra-exam-filter', calls: 'calls-exam-filter' } },
      { key: 'attendance', type: 'select', ids: { tafra: 'tafra-exam-attendance-filter', calls: 'calls-exam-attendance-filter' },
        options: [['entered', 'دخل الاختبار'], ['not_entered', 'لم يدخل الاختبار']] },
      { key: 'mark_range', type: 'select', ids: { tafra: 'tafra-exam-mark-range-filter', calls: 'calls-exam-mark-range-filter' },
        options: [['', 'كل الدرجات'], ['over_90', 'فوق 90%'], ['over_75', 'فوق 75%'], ['over_50', 'فوق 50%'],
          ['under_75', 'تحت 75%'], ['under_50', 'تحت 50%']] },
      { key: 'idea_number', type: 'select', ids: { tafra: 'tafra-idea-filter', calls: 'calls-idea-filter' },
        options: [['', 'كل الأفكار'], ['0', 'لم يُحدَّد بعد']] },
      { key: 'enrolled_from', type: 'date', ids: { tafra: 'tafra-enrolled-from', calls: 'calls-enrolled-from' }, title: 'تاريخ الاشتراك من' },
      { key: 'enrolled_to', type: 'date', ids: { tafra: 'tafra-enrolled-to', calls: 'calls-enrolled-to' }, title: 'تاريخ الاشتراك إلى' },
      { key: 'welcome_status', type: 'select', ids: { tafra: 'tafra-welcome-status-filter', calls: 'calls-welcome-status-filter' },
        title: 'حالة رسالة الترحيب — كل الحالات مشروطة بأن الطالب دخل البوت فعلاً',
        options: [['', 'حالة رسالة الترحيب'], ['no_welcome', 'دخل البوت ومجاش له ترحيب'],
          ['welcome_no_reply', 'وصله ترحيب ومردّش'], ['welcome_replied', 'وصله ترحيب ورد']] },
      { key: 'silent_week', type: 'checkbox', ids: { tafra: 'tafra-silent-week', calls: 'calls-silent-week', tickets: 'ticket-silent-week-filter' },
        label: 'مردش من أسبوع',
        title: 'فيه رسالة مننا اتبعتت له بعد آخر كلام منه وعدّى عليها أسبوع من غير أي رد — الحملات الجماعية مش محسوبة' },
      { key: 'silent_calls_week', type: 'checkbox',
        ids: { tafra: 'tafra-silent-calls-week', calls: 'calls-silent-calls-week', tickets: 'ticket-silent-calls-week-filter' },
        label: 'مردش ع التليفون من أسبوع',
        title: 'اتصلنا بيه خلال آخر أسبوع ومفيش ولا مكالمة وصلنا فيها له — "رقم غير صحيح" محسوب هنا لأن التواصل فعلًا محصلش' },
      { key: 'follow_up', type: 'select', ids: { tafra: 'tafra-follow-up-filter', calls: 'calls-follow-up-filter' },
        options: [['', 'كل المواعيد'], ['due', 'حان موعد المتابعة'], ['none', 'لسه متعملهاش مكالمة'], ['called', 'تم الاتصال بهم']] },
      { key: 'call_outcome', type: 'select', ids: { tafra: 'tafra-outcome-filter', calls: 'calls-outcome-filter' },
        title: 'نتيجة آخر مكالمة اتسجّلت للطالب', options: [['', 'كل نتائج المكالمات']] },
      { key: 'unreached_streak', type: 'select', ids: { tafra: 'tafra-unreached-filter', calls: 'calls-unreached-filter' },
        title: 'محاولات متتالية معرفناش نوصله فيها — لم يرد أو الخط مشغول. أي نتيجة تانية بتكسر السلسلة',
        options: [['', 'كل حالات الوصول'], ['1', 'معرفناش نوصله مرة'], ['2', 'معرفناش نوصله مرتين ورا بعض'],
          ['3plus', 'معرفناش نوصله ٣ مرات أو أكثر ورا بعض']] },
      { key: 'last_sent_from', type: 'date', ids: { tafra: 'tafra-last-sent-from', calls: 'calls-last-sent-from' }, title: 'آخر إرسال من' },
      { key: 'last_sent_to', type: 'date', ids: { tafra: 'tafra-last-sent-to', calls: 'calls-last-sent-to' }, title: 'آخر إرسال إلى' },
      { key: 'last_received_from', type: 'date', ids: { tafra: 'tafra-last-received-from', calls: 'calls-last-received-from' }, title: 'آخر استقبال من' },
      { key: 'last_received_to', type: 'date', ids: { tafra: 'tafra-last-received-to', calls: 'calls-last-received-to' }, title: 'آخر استقبال إلى' },
      { key: 'assigned', type: 'select', adminOnly: true, ids: { tafra: 'tafra-scope-filter', calls: 'calls-scope-filter' },
        options: [['', 'كل الطلاب'], ['unassigned', 'غير مسند']] },
      { key: 'called_by', type: 'select', adminOnly: true, ids: { tafra: 'tafra-called-by-filter', calls: 'calls-called-by-filter' },
        options: [['', 'أي موظف اتصل']] },
      { key: 'exclude_sent_today', type: 'checkbox', ids: { tafra: 'tafra-exclude-sent-today', calls: 'calls-exclude-sent-today' },
        label: 'استبعاد من أُرسل له اليوم',
        title: 'استبعاد من اتبعتله رسالة جماعية اليوم بالفعل، لتفادي تكرار الإرسال لنفس الطالب مرتين في نفس اليوم' },
    ];

    function filterId(def, prefix) { return (def.ids && def.ids[prefix]) || (prefix + '-' + def.key + '-filter'); }

    // صندوق الدعم عنده فلاتر خاصة بيه بنفس المعنى بالظبط (البحث، الموظف المسؤول، رقم الفكرة)،
    // فبنستبعد نظيرها من الفلاتر المشتركة — وإلا يبقى في نفس الشريط عنصرين بيعملوا نفس الحاجة
    const TICKETS_SKIPPED_STUDENT_FILTERS = new Set(['search', 'assigned_to', 'idea_number']);
    // اسمين معناهم مختلف في الشاشتين: status (حالة التذكرة مقابل حالة الطالب على المنصة) و
    // follow_up (موعد متابعة التذكرة مقابل موعد آخر مكالمة). لو اتبعتوا بنفس الاسم الشرطين
    // بيتطبقوا مع بعض والنتيجة بتقل غلط، فبيتبعتوا بأسماء مختلفة و buildTicketFilters بيرجّعهم
    // لأسمائهم الأصلية قبل ما يمرّرهم للـ builder المشترك
    const TICKETS_FILTER_PARAM_ALIASES = { status: 'student_status', follow_up: 'student_follow_up' };

    function paramNameFor(prefix, def) {
      return (prefix === 'tickets' && TICKETS_FILTER_PARAM_ALIASES[def.key]) || def.key;
    }

    // عنصر فلتر مشترك بمفتاحه في شاشة معيّنة — بيغني عن تكرار الـ id في كل مكان محتاجه
    function studentFilterElement(prefix, key) {
      const def = STUDENT_FILTER_DEFS.find((item) => item.key === key);
      return def ? document.getElementById(filterId(def, prefix)) : null;
    }

    // الفلاتر المتاحة لشاشة معيّنة بعد استبعاد اللي محتاج صلاحية إسناد
    function filtersFor(prefix) {
      const canAssign = currentUserRole === 'admin' || canAssignCalls;
      return STUDENT_FILTER_DEFS.filter((def) => (!def.adminOnly || canAssign)
        && !(prefix === 'tickets' && TICKETS_SKIPPED_STUDENT_FILTERS.has(def.key)));
    }

    // بيرسم بار الفلاتر لشاشة معيّنة من التعريف الموحّد
    function renderStudentFilterBar(prefix) {
      const bar = document.getElementById(prefix + '-filter-bar');
      if (!bar) return;
      const html = filtersFor(prefix).map((def) => {
        const id = filterId(def, prefix);
        const title = def.title ? ' title="' + escapeHtml(def.title) + '"' : '';
        if (def.type === 'hidden') return '<input type="hidden" id="' + id + '" value="">';
        if (def.type === 'search') return '<input type="search" id="' + id + '" class="compact-input" placeholder="' + escapeHtml(def.placeholder || '') + '"' + title + '>';
        // خانة التاريخ الفاضية مابتعرضش أي نص، والـ title مابيظهرش على التليفون — فالاسم بيتحط
        // كليبل جنبها. الـ id بيفضل على الـ input نفسه عشان كل الربط الموجود مايتأثرش
        if (def.type === 'date') {
          return '<label class="row" style="gap:6px; align-items:center; white-space:nowrap; flex-wrap:nowrap"' + title + '>'
            + '<span style="font-size:12px; color:var(--text-muted)">' + escapeHtml(def.title || '') + '</span>'
            + '<input type="date" id="' + id + '" class="compact-input" style="width:auto"></label>';
        }
        if (def.type === 'checkbox') {
          return '<label class="row" style="gap:8px; cursor:pointer; white-space:nowrap; flex-wrap:nowrap"' + title + '>'
            + '<input type="checkbox" id="' + id + '" style="width:auto"><span>' + escapeHtml(def.label || '') + '</span></label>';
        }
        const options = (def.options || []).map((pair) =>
          '<option value="' + escapeHtml(pair[0]) + '">' + escapeHtml(pair[1]) + '</option>').join('');
        return '<select id="' + id + '" class="compact-select"' + title + '>' + options + '</select>';
      }).join('\n');
      // صندوق الدعم شريطه فيه زراري "مسح الفلاتر" و"تحديث" بتوعه أصلًا، فمابنزودش نسخة تانية
      bar.innerHTML = html
        + (prefix === 'tickets' ? ''
          : '\n<button type="button" class="btn btn-ghost" id="clear-' + prefix + '-filters">مسح الفلاتر</button>')
        + (prefix === 'calls' ? '\n<button type="button" class="btn btn-ghost btn-sm" id="refresh-calls-btn">تحديث</button>' : '');
    }

    // بناء الباراميترز من التعريف الموحّد — الشاشتين بيستخدموه، فأي فلتر يتضاف للتعريف بيتبعت
    // تلقائيًا من غير ما نفتكر نضيفه في كل شاشة على حدة (ده كان مصدر النسيان المتكرر)
    function studentFilterParams(prefix, params) {
      filtersFor(prefix).forEach((def) => {
        const el = document.getElementById(filterId(def, prefix));
        if (!el) return;
        if (def.type === 'checkbox') {
          if (el.checked) params.set(paramNameFor(prefix, def), 'true');
          return;
        }
        const value = String(el.value || '').trim();
        if (!value) return;
        // الحضور ومدى الدرجة مالهمش معنى من غير اختبار محدد
        if ((def.key === 'attendance' || def.key === 'mark_range')
          && !String(studentFilterElement(prefix, 'exam')?.value || '').trim()) return;
        if (def.key === 'mark_range'
          && String(studentFilterElement(prefix, 'attendance')?.value || '') === 'not_entered') return;
        params.set(paramNameFor(prefix, def), value);
      });
      return params;
    }

    // مستمعي التغيير لكل فلاتر الشاشة — من نفس التعريف
    function bindStudentFilterEvents(prefix, onChange) {
      filtersFor(prefix).forEach((def) => {
        const el = document.getElementById(filterId(def, prefix));
        // الحارس ده مهم: بعض الفلاتر ليها مستمعين مكتوبين بالإيد من قبل التوحيد، والربط مرتين
        // معناه تحميل القائمة مرتين مع كل تغيير
        if (!el || el.dataset.filterBound === '1') return;
        el.dataset.filterBound = '1';
        const evt = def.type === 'search' ? 'input' : 'change';
        el.addEventListener(evt, () => onChange(def));
      });
    }

    // تصفير كل الفلاتر — نفس المصدر برضه
    function resetStudentFilters(prefix) {
      filtersFor(prefix).forEach((def) => {
        const el = document.getElementById(filterId(def, prefix));
        if (!el) return;
        if (def.type === 'checkbox') { el.checked = false; return; }
        el.value = def.key === 'attendance' ? 'entered' : '';
        if (multiSelectControllers[filterId(def, prefix)]) multiSelectControllers[filterId(def, prefix)].refresh();
      });
    }

    // الشاشتين بيترسموا فورًا عند تحميل الصفحة — قبل أي تهيئة بتدوّر على العناصر بالـ id
    renderStudentFilterBar('tafra');
    renderStudentFilterBar('calls');
    renderStudentFilterBar('tickets');

    function createMultiSelectFilter(hiddenInputId, placeholder) {
      if (multiSelectControllers[hiddenInputId]) return multiSelectControllers[hiddenInputId];
      const hiddenInput = document.getElementById(hiddenInputId);
      if (!hiddenInput) return null;

      const wrap = document.createElement('div');
      wrap.className = 'multiselect-wrap';
      wrap.innerHTML = `
        <button type="button" class="btn btn-ghost compact-select multiselect-toggle"></button>
        <div class="multiselect-panel" style="display:none"></div>
      `;
      hiddenInput.insertAdjacentElement('afterend', wrap);

      const toggle = wrap.querySelector('.multiselect-toggle');
      const panel = wrap.querySelector('.multiselect-panel');
      let currentOptions = [];

      function selectedValues() {
        return hiddenInput.value ? hiddenInput.value.split(',').filter(Boolean) : [];
      }
      function renderPanel() {
        const selected = new Set(selectedValues());
        panel.innerHTML = currentOptions.length
          ? currentOptions.map((opt) => `
              <label class="multiselect-option">
                <input type="checkbox" value="${escapeHtml(String(opt.value))}" ${selected.has(String(opt.value)) ? 'checked' : ''}>
                <span>${escapeHtml(opt.label)}</span>
              </label>`).join('')
          : '<div class="ticket-muted" style="padding:8px">لا يوجد خيارات متاحة</div>';
        panel.querySelectorAll('input[type=checkbox]').forEach((checkbox) => {
          checkbox.addEventListener('change', (event) => {
            event.stopPropagation();
            const values = Array.from(panel.querySelectorAll('input[type=checkbox]:checked')).map((c) => c.value);
            hiddenInput.value = values.join(',');
            hiddenInput.dispatchEvent(new Event('change'));
          });
        });
      }
      function updateToggleLabel() {
        const count = selectedValues().length;
        toggle.textContent = count ? `${placeholder} (${count})` : placeholder;
        toggle.classList.toggle('has-value', count > 0);
      }
      function refresh() { renderPanel(); updateToggleLabel(); }

      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = panel.style.display !== 'none';
        document.querySelectorAll('.multiselect-panel').forEach((p) => { p.style.display = 'none'; });
        panel.style.display = isOpen ? 'none' : 'block';
      });
      document.addEventListener('click', (event) => {
        if (!wrap.contains(event.target)) panel.style.display = 'none';
      });
      // بيتنادى برضه لما القيمة تتغيّر برمجيًا من برّة (مزامنة بين التابات، مسح الفلاتر)
      hiddenInput.addEventListener('change', refresh);

      const controller = {
        setOptions(options) { currentOptions = options; refresh(); },
        refresh,
      };
      multiSelectControllers[hiddenInputId] = controller;
      updateToggleLabel();
      return controller;
    }

    function firstEmployeeName(fullName) {
      return String(fullName || '').trim().split(/\s+/)[0] || '';
    }

    function employeeBadgeClass(userId) {
      return `employee-color-${Math.abs(Number(userId) || 0) % 6}`;
    }

    // علامة الباب البسيطة جنب اسم الطالب — مستخدمة في كل شاشة بتعرض بيانات الطلاب (تذاكر/طلاب/تقارير/جهات اتصال)
    // ---------- ترتيب أي جدول بالنقر على عنوان عمود ----------
    // العمود القابل للترتيب لازم <th data-sort-key="..."> على العنوان، و<td data-sort-value="رقم أو epoch">
    // في كل صف لنفس العمود. الترتيب بيحصل على صفوف الجدول المعروضة حاليًا بس (من غير طلب جديد للسيرفر).
    // onSort اختياري: لو موجود، النقر بيستدعيه بدل الترتيب المحلي (لجداول فيها تقسيم صفحات، عشان الترتيب
    // يشمل كل النتائج مش بس الصفحة المعروضة — الكولباك مسؤول إنه يعيد الطلب من السيرفر بترتيب الـ sort الجديد)
    function enableTableSort(wrapEl, { onSort } = {}) {
      const table = wrapEl.querySelector('table');
      if (!table) return;
      const headers = table.querySelectorAll('th[data-sort-key]');
      headers.forEach((th) => {
        th.classList.add('sortable-th');
        th.addEventListener('click', async () => {
          const nextDir = th.dataset.sortDir === 'asc' ? 'desc' : 'asc';
          headers.forEach((h) => { h.dataset.sortDir = ''; h.classList.remove('sort-asc', 'sort-desc'); });
          th.dataset.sortDir = nextDir;
          th.classList.add(nextDir === 'asc' ? 'sort-asc' : 'sort-desc');

          if (onSort) return onSort(th.dataset.sortKey, nextDir);

          const colIndex = Array.from(th.parentElement.children).indexOf(th);
          const tbody = table.querySelector('tbody');
          const rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort((rowA, rowB) => {
            const rawA = rowA.children[colIndex]?.dataset.sortValue;
            const rawB = rowB.children[colIndex]?.dataset.sortValue;
            const valueA = rawA === undefined || rawA === '' ? null : Number(rawA);
            const valueB = rawB === undefined || rawB === '' ? null : Number(rawB);
            if (valueA === null && valueB === null) return 0;
            if (valueA === null) return 1; // الفاضي دايمًا في الآخر بغض النظر عن الاتجاه
            if (valueB === null) return -1;
            return nextDir === 'asc' ? valueA - valueB : valueB - valueA;
          });
          rows.forEach((row) => tbody.appendChild(row));
        });
      });
    }

    // تابات عرضية للتنقل بين أقسام نفس الصفحة (مش تابات القائمة الجانبية) — كل الأقسام محمّلة
    // أصلًا في الـ DOM، فمجرد إظهار/إخفاء بدون أي طلب بيانات إضافي
    function initSubTabs(containerId) {
      const container = document.getElementById(containerId);
      const panel = container?.closest('.tab-panel');
      if (!container || !panel) return;
      const buttons = container.querySelectorAll('.subtab-btn');
      const sections = panel.querySelectorAll(':scope > .subtab-section');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.subtab;
          buttons.forEach((b) => b.classList.toggle('active', b === button));
          sections.forEach((section) => {
            section.style.display = section.dataset.subtab === key ? '' : 'none';
          });
        });
      });
    }
    initSubTabs('settings-subtabs');
    initSubTabs('contacts-subtabs');
    initSubTabs('tickets-subtabs');
    initSubTabs('new-bot-subtabs');
    initTicketsBulkAssign();

    // ---------- متابعة أداء الموظفين (الأدمن يشوف الكل، والموظف يشوف نشاطه هو بس) ----------
    async function initStaffActivity() {
      const activityList = document.getElementById('activity-list');
      if (!activityList) return;
      // فلتر "كل الموظفين" للأدمن بس — الموظف بيشوف نشاطه هو بس أصلاً، مش محتاج يختار حد
      const userFilter = document.getElementById('activity-user-filter');
      if (userFilter) {
        await ensureTicketsMeta();
        userFilter.innerHTML = '<option value="">كل الموظفين</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
      }

      registerFilterGroup('activity', ['activity-user-filter','activity-from-filter','activity-to-filter']);

      function activityQuery() {
        const params = new URLSearchParams({ page: activityPage });
        const userId = userFilter ? userFilter.value : '';
        const from = document.getElementById('activity-from-filter').value;
        const to = document.getElementById('activity-to-filter').value;
        if (userId) params.set('user_id', userId);
        if (from) params.set('from', from);
        if (to) params.set('to', to);
        return params.toString();
      }

      async function loadStaffActivity() {
        const list = document.getElementById('activity-list');
        list.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
        try {
          const data = await api('/api/admin/staff-activity?' + activityQuery());
          activityPages = data.meta.pages;
          document.getElementById('activity-count').textContent = `نشاط الموظفين (${data.meta.total})`;
          document.getElementById('activity-page-label').textContent = `صفحة ${data.meta.page} من ${data.meta.pages}`;
          document.getElementById('activity-prev').disabled = data.meta.page <= 1;
          document.getElementById('activity-next').disabled = data.meta.page >= data.meta.pages;
          if (!data.activity.length) {
            list.innerHTML = '<div class="empty-state">لا يوجد نشاط مطابق</div>';
            return;
          }
          list.innerHTML = data.activity.map((a) => {
            const studentName = escapeHtml(a.student_name?.trim() || 'طالب');
            const userName = escapeHtml(a.user_name || '—');
            const followUp = a.next_follow_up_at
              ? `<span class="stat-pill" title="آخر موعد متابعة معروف">📅 ${fmtDate(a.next_follow_up_at)}</span>` : '';
            let summary;
            if (a.activity_type === 'call') {
              summary = `📞 <b>${userName}</b> اتصل بـ ${studentName} — ${escapeHtml(a.detail || 'بدون نتيجة')}`;
            } else {
              summary = `💡 <b>${userName}</b> حدّث فكرة ${studentName} إلى فكرة ${a.idea_number}`;
            }
            const notes = a.notes ? `<div class="tafra-student-sub">📝 ${escapeHtml(a.notes)}</div>` : '';
            return `
              <div class="ticket-list-item" style="cursor:default">
                <div class="ticket-list-title">
                  <span class="ticket-name-with-subtitle">${summary}</span>
                  <span class="ticket-muted">${fmtDate(a.occurred_at)}</span>
                </div>
                ${notes}
                ${followUp ? `<div style="margin-top:4px">${followUp}</div>` : ''}
              </div>`;
          }).join('');
        } catch (error) {
          list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
        }
      }

      if (userFilter) userFilter.addEventListener('change', () => { activityPage = 1; loadStaffActivity(); });
      document.getElementById('activity-from-filter').addEventListener('change', () => { activityPage = 1; loadStaffActivity(); });
      document.getElementById('activity-to-filter').addEventListener('change', () => { activityPage = 1; loadStaffActivity(); });
      document.getElementById('refresh-activity-btn').addEventListener('click', loadStaffActivity);
      document.getElementById('clear-activity-filters').addEventListener('click', () => {
        filterGroups.activity?.reset();
        if (userFilter) userFilter.value = '';
        document.getElementById('activity-from-filter').value = '';
        document.getElementById('activity-to-filter').value = '';
        activityPage = 1;
        loadStaffActivity();
      });
      document.getElementById('activity-prev').addEventListener('click', () => {
        if (activityPage > 1) { activityPage--; loadStaffActivity(); }
      });
      document.getElementById('activity-next').addEventListener('click', () => {
        if (activityPage < activityPages) { activityPage++; loadStaffActivity(); }
      });

      const activitySubtabBtn = document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="activity"]');
      if (activitySubtabBtn) {
        activitySubtabBtn.addEventListener('click', () => { activityPage = 1; loadStaffActivity(); });
      }
    }
    initStaffActivity();

    // ---------- سرعة الرد (تبويب مستقل: تذاكر مستنية رد + متوسط/وسيط مدة الرد على الرسائل الجديدة) ----------
    async function initResponseStats() {
      const list = document.getElementById('response-stats-list');
      if (!list) return;
      const note = document.getElementById('response-stats-note');
      // فلتر "كل الموظفين" للأدمن بس — الموظف بيشوف أرقامه هو بس، مش محتاج يختار حد
      const userFilter = document.getElementById('response-user-filter');
      if (userFilter) {
        await ensureTicketsMeta();
        userFilter.innerHTML = '<option value="">كل الموظفين</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
      }

      // فلتر التاريخ بيأثر على أرقام مدة الرد بس، أما "مستنية رد" و"أقدم انتظار" فحالة اللحظة دي
      // مهما كان الفلتر — عشان كده بنكتب ده صريح في السطر اللي جنب عنوان الكارت
      registerFilterGroup('response', ['response-user-filter','response-from-filter','response-to-filter']);

      async function loadResponseStats() {
        list.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
        const from = document.getElementById('response-from-filter').value;
        const to = document.getElementById('response-to-filter').value;
        try {
          const params = new URLSearchParams();
          const userId = userFilter ? userFilter.value : '';
          if (userId) params.set('user_id', userId);
          if (from) params.set('from', from);
          if (to) params.set('to', to);
          const data = await api('/api/admin/staff-response-stats?' + params.toString());
          if (note) {
            note.textContent = from || to
              ? `مدة الرد محسوبة من ${from || 'البداية'} لـ ${to || 'النهاية'} — "مستنية رد" دلوقتي`
              : 'مدة الرد على كل الفترة — "مستنية رد" دلوقتي';
          }
          if (!data.staff.length) {
            list.innerHTML = '<div class="empty-state">مفيش بيانات رد لعرضها</div>';
            return;
          }
          const teamRow = data.staff.length > 1 ? `
            <div class="staff-card" style="background:var(--surface-sunken)">
              <b style="min-width:120px">👥 الفريق كله</b>
              <div class="staff-card-body">
                <span class="stat-pill ${data.team.awaiting_tickets > 0 ? 'stat-warning' : 'stat-success'}" title="تذاكر مفتوحة آخر رسالة فيها من الطالب ولسه محدش رد">🟠 مستنية رد: ${data.team.awaiting_tickets}</span>
                <span class="stat-pill" title="متوسط الوقت بين أول رسالة جديدة من الطالب وأول رد من الفريق">⏱️ متوسط الرد: ${fmtDuration(data.team.avg_response_seconds)}</span>
                <span class="stat-pill" title="نص الردود كانت أسرع من كده — مؤشر أدق من المتوسط لأنه مابيتأثرش بالحالات الشاذة">📊 الوسيط: ${fmtDuration(data.team.median_response_seconds)}</span>
                <span class="stat-pill stat-muted" title="عدد الردود اللي المتوسط اتحسب عليها">💬 ${data.team.responses_count} رد</span>
              </div>
            </div>` : '';
          list.innerHTML = `<div class="staff-cards">${teamRow}${data.staff.map((row) => {
            const oldest = row.oldest_waiting_seconds !== null
              ? `<span class="stat-pill stat-warning" title="أقدم تذكرة مستنية رد من إمتى">⌛ أقدم انتظار: ${fmtDuration(row.oldest_waiting_seconds)}</span>` : '';
            return `
              <div class="staff-card">
                <b style="min-width:120px">${escapeHtml(row.name)}${row.is_active ? '' : ' <span class="ticket-muted" title="الحساب موقوف لكن لسه وراه أرقام">(موقوف)</span>'}</b>
                <div class="staff-card-body">
                  <span class="stat-pill ${row.awaiting_tickets > 0 ? 'stat-warning' : 'stat-success'}" title="تذاكر مسندة له، مفتوحة، وآخر رسالة فيها من الطالب من غير رد">🟠 مستنية رد: ${row.awaiting_tickets}</span>
                  ${oldest}
                  <span class="stat-pill" title="متوسط الوقت بين أول رسالة جديدة من الطالب وأول رد منه هو">⏱️ متوسط الرد: ${fmtDuration(row.avg_response_seconds)}</span>
                  <span class="stat-pill" title="نص ردوده كانت أسرع من كده — مؤشر أدق من المتوسط لأنه مابيتأثرش بالحالات الشاذة">📊 الوسيط: ${fmtDuration(row.median_response_seconds)}</span>
                  <span class="stat-pill stat-muted" title="عدد الردود اللي المتوسط اتحسب عليها">💬 ${row.responses_count} رد</span>
                </div>
              </div>`;
          }).join('')}</div>`;
        } catch (error) {
          list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
        }
      }

      if (userFilter) userFilter.addEventListener('change', loadResponseStats);
      document.getElementById('response-from-filter').addEventListener('change', loadResponseStats);
      document.getElementById('response-to-filter').addEventListener('change', loadResponseStats);
      document.getElementById('refresh-response-btn').addEventListener('click', loadResponseStats);
      document.getElementById('clear-response-filters').addEventListener('click', () => {
        filterGroups.response?.reset();
        if (userFilter) userFilter.value = '';
        document.getElementById('response-from-filter').value = '';
        document.getElementById('response-to-filter').value = '';
        loadResponseStats();
      });

      // بيتحمّل أول ما التبويب يتفتح بس — مش مع كل فتح للوحة، عشان الاستعلام تقيل شوية
      document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="response"]')
        ?.addEventListener('click', loadResponseStats);
    }
    initResponseStats();

    // ---------- الرسائل المميزة (رسائل حلوة/شكاوى مجمّعة من كل التذاكر — أدمن فقط) ----------
    function initFlaggedMessages() {
      const typeFilter = document.getElementById('flagged-type-filter');
      if (!typeFilter) return;
      let flaggedPage = 1;
      let flaggedPages = 1;

      async function loadFlaggedMessages() {
        const list = document.getElementById('flagged-list');
        list.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
        try {
          const params = new URLSearchParams({ page: flaggedPage });
          if (typeFilter.value) params.set('flag', typeFilter.value);
          const data = await api('/api/tickets/flagged-messages?' + params.toString());
          flaggedPages = data.meta.pages;
          document.getElementById('flagged-count').textContent = `الرسائل المميزة (${data.meta.total})`;
          document.getElementById('flagged-page-label').textContent = `صفحة ${data.meta.page} من ${data.meta.pages}`;
          document.getElementById('flagged-prev').disabled = data.meta.page <= 1;
          document.getElementById('flagged-next').disabled = data.meta.page >= data.meta.pages;
          if (!data.messages.length) {
            list.innerHTML = '<div class="empty-state">لا يوجد رسائل مميّزة</div>';
            return;
          }
          list.innerHTML = data.messages.map((m) => {
            const name = studentDisplayName(m);
            const icon = m.flag === 'star' ? '⭐' : '❌';
            return `
              <div class="ticket-list-item" style="cursor:default">
                <div class="ticket-list-title">
                  <span class="ticket-name-with-subtitle">${icon} <b>${escapeHtml(name)}</b></span>
                  <button type="button" class="btn btn-ghost btn-sm" data-open-ticket="${m.ticket_id}">فتح التذكرة</button>
                </div>
                ${m.content ? `<div class="ticket-preview">${escapeHtml(m.content)}</div>` : ''}
                ${m.image_path ? `<img class="ticket-message-image" style="max-width:160px; margin-top:6px" src="/${escapeHtml(m.image_path)}" alt="صورة مرفقة">` : ''}
                <div class="ticket-list-meta"><span>${fmtDate(m.received_at)}</span></div>
              </div>`;
          }).join('');
          list.querySelectorAll('[data-open-ticket]').forEach((btn) => {
            btn.addEventListener('click', () => {
              document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="conversations"]')?.click();
              loadTicket(Number(btn.dataset.openTicket));
            });
          });
        } catch (error) {
          list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
        }
      }

      registerFilterGroup('flagged', ['flagged-type-filter']);
      document.getElementById('clear-flagged-filters')?.addEventListener('click', () => {
        flaggedPage = 1;
        resetFilterGroup('flagged', ['flagged-type-filter'], loadFlaggedMessages);
      });
      typeFilter.addEventListener('change', () => { flaggedPage = 1; loadFlaggedMessages(); });
      document.getElementById('refresh-flagged-btn').addEventListener('click', loadFlaggedMessages);
      document.getElementById('flagged-prev').addEventListener('click', () => {
        if (flaggedPage > 1) { flaggedPage--; loadFlaggedMessages(); }
      });
      document.getElementById('flagged-next').addEventListener('click', () => {
        if (flaggedPage < flaggedPages) { flaggedPage++; loadFlaggedMessages(); }
      });

      const flaggedSubtabBtn = document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="flagged"]');
      if (flaggedSubtabBtn) {
        flaggedSubtabBtn.addEventListener('click', () => { flaggedPage = 1; loadFlaggedMessages(); });
      }
    }
    initFlaggedMessages();

    const stopImpersonationBtn = document.getElementById('stop-impersonation-btn');
    if (stopImpersonationBtn) {
      stopImpersonationBtn.addEventListener('click', async () => {
        stopImpersonationBtn.disabled = true;
        try {
          const response = await fetch('/stop-impersonation', { method: 'POST' });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'تعذر الرجوع لحسابك');
          window.location.href = '/';
        } catch (error) {
          showToast(error.message);
          stopImpersonationBtn.disabled = false;
        }
      });
    }

    // ---------- تغيير كلمة المرور الذاتي ----------
    const changePasswordOverlay = document.getElementById('change-password-overlay');
    function closeChangePasswordModal() {
      changePasswordOverlay.style.display = 'none';
      document.getElementById('change-password-current').value = '';
      document.getElementById('change-password-new').value = '';
      document.getElementById('change-password-confirm').value = '';
    }
    function openChangePasswordModal() {
      changePasswordOverlay.style.display = 'flex';
      document.getElementById('change-password-current').focus();
    }
    document.getElementById('open-change-password-btn').addEventListener('click', openChangePasswordModal);
    document.getElementById('mobile-open-change-password-btn').addEventListener('click', () => {
      document.getElementById('account-menu-dropdown').style.display = 'none';
      openChangePasswordModal();
    });
    document.getElementById('close-change-password-btn').addEventListener('click', closeChangePasswordModal);

    // ---------- قائمة الحساب على الموبايل ----------
    const accountMenuToggleBtn = document.getElementById('account-menu-toggle-btn');
    const accountMenuDropdown = document.getElementById('account-menu-dropdown');
    accountMenuToggleBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      accountMenuDropdown.style.display = accountMenuDropdown.style.display === 'none' ? 'flex' : 'none';
    });
    document.addEventListener('click', (event) => {
      if (!event.target.closest('.account-menu-wrap')) accountMenuDropdown.style.display = 'none';
    });
    const mobileOpenActivityBtn = document.getElementById('mobile-open-activity-btn');
    if (mobileOpenActivityBtn) {
      mobileOpenActivityBtn.addEventListener('click', () => {
        accountMenuDropdown.style.display = 'none';
        document.querySelector('.nav-item[data-tab="tickets"]')?.click();
        document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="activity"]')?.click();
      });
    }
    const mobileOpenResponseBtn = document.getElementById('mobile-open-response-btn');
    if (mobileOpenResponseBtn) {
      mobileOpenResponseBtn.addEventListener('click', () => {
        accountMenuDropdown.style.display = 'none';
        document.querySelector('.nav-item[data-tab="tickets"]')?.click();
        document.querySelector('#tickets-subtabs .subtab-btn[data-subtab="response"]')?.click();
      });
    }
    changePasswordOverlay.querySelectorAll('[data-toggle-for]').forEach((toggleBtn) => {
      toggleBtn.addEventListener('click', () => {
        const input = document.getElementById(toggleBtn.dataset.toggleFor);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        toggleBtn.textContent = isHidden ? '🙈' : '👁';
        toggleBtn.title = isHidden ? 'إخفاء كلمة المرور' : 'إظهار كلمة المرور';
        toggleBtn.setAttribute('aria-label', toggleBtn.title);
      });
    });
    changePasswordOverlay.addEventListener('click', (event) => {
      if (event.target === changePasswordOverlay) closeChangePasswordModal();
    });
    document.getElementById('submit-change-password-btn').addEventListener('click', async () => {
      const button = document.getElementById('submit-change-password-btn');
      const currentPassword = document.getElementById('change-password-current').value;
      const newPassword = document.getElementById('change-password-new').value;
      const confirmPassword = document.getElementById('change-password-confirm').value;
      if (!currentPassword || !newPassword) return showToast('من فضلك املأ كل الحقول');
      if (newPassword.length < 8) return showToast('كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل');
      if (newPassword !== confirmPassword) return showToast('تأكيد كلمة المرور مش مطابق');
      button.disabled = true;
      try {
        const response = await fetch('/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'تعذر تغيير كلمة المرور');
        showToast('تم تغيير كلمة المرور — سجّل دخول تاني بكلمة المرور الجديدة');
        setTimeout(() => { window.location.href = '/login'; }, 1200);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    });

    // تحديد أول عدد (N) من عناصر التحديد الموجودة حاليًا في الصفحة، بترتيب ظهورهم — العدد قابل
    // للتغيير من الموظف نفسه في الخانة المجاورة للزرار
    function selectFirstN(checkboxSelector, countInputId, selectedSet, updateUiFn) {
      const countInput = document.getElementById(countInputId);
      const count = Math.max(1, Math.floor(Number(countInput.value)) || 0);
      if (!count) return showToast('اكتب عدد صحيح أكبر من صفر');
      const checkboxes = Array.from(document.querySelectorAll(checkboxSelector)).slice(0, count);
      if (!checkboxes.length) return showToast('لا يوجد نتائج لتحديدها');
      checkboxes.forEach((checkbox) => {
        checkbox.checked = true;
        selectedSet.add(Number(checkbox.value));
      });
      updateUiFn();
      showToast(`تم تحديد أول ${checkboxes.length} نتيجة`);
    }

    // زي selectFirstN بالظبط بس بتاخد أول N من إجمالي النتائج المطابقة للفلتر على كل الصفحات (مش
    // بس الصفحة الحالية المعروضة) — بتجيب كل المعرّفات المرتبة من السيرفر وتاخد أول عدد منها
    async function selectFirstNAcrossPages(fetchIdsUrl, countInputId, checkboxSelector, selectedSet, updateUiFn) {
      const countInput = document.getElementById(countInputId);
      const count = Math.max(1, Math.floor(Number(countInput.value)) || 0);
      if (!count) return showToast('اكتب عدد صحيح أكبر من صفر');
      try {
        const result = await api(fetchIdsUrl);
        const ids = result.ids.slice(0, count);
        if (!ids.length) return showToast('لا يوجد نتائج لتحديدها');
        ids.forEach((id) => selectedSet.add(id));
        document.querySelectorAll(checkboxSelector).forEach((checkbox) => {
          if (selectedSet.has(Number(checkbox.value))) checkbox.checked = true;
        });
        updateUiFn();
        showToast(`تم تحديد أول ${ids.length} نتيجة من إجمالي النتائج المطابقة للفلتر`);
      } catch (error) {
        showToast(error.message);
      }
    }

    function bootcampMarksHtml(row, sizeClass = '') {
      const cls = `bootcamp-mark-badge${sizeClass ? ' ' + sizeClass : ''}`;
      return (row.in_chapter_one ? `<span class="${cls}" title="مشترك في: الباب الأول (العناصر الانتقالية)">1</span>` : '')
        + (row.in_full_curriculum ? `<span class="${cls}" title="مشترك في: المنهج كاملا">***</span>` : '');
    }

    // علامة صغيرة جنب اسم الطالب توضّح هل بدأ محادثة مع البوت على تيليجرام (يمكن مراسلته) ولا لسه —
    // مفيدة للموظف أثناء المكالمة عشان يعرف يوجّه الطالب يدوس Start على البوت لو لسه ما عملهاش
    function telegramReachBadge(canMessage) {
      return canMessage
        ? '<span class="tg-reach-dot tg-reach-yes" title="بدأ محادثة مع البوت — يمكن مراسلته على تيليجرام">✅</span>'
        : '<span class="tg-reach-dot tg-reach-no" title="لسه ما بدأش محادثة مع البوت — لا يمكن مراسلته على تيليجرام">⛔</span>';
    }

    // ---------- رسم رسائل المحادثة (مستخدم في العرض الأول وفي التحديث المباشر) ----------
    function messageKeyOf(message) {
      return message.message_key || (message.direction + '-' + message.occurred_at);
    }

    // أي حد ليه صلاحية يفتح التذكرة (الأدمن، أو الموظف المسند ليه التذكرة، أو أي موظف لو التذكرة
    // لسه مش مسندة لحد) يقدر يتحكم في أي رسالة جواها — حتى لو مبعوتة تلقائيًا أو من موظف سابق
    // تعامل مع نفس التذكرة، مش بس رسائله هو. نفس شرط صلاحية فتح التذكرة أصلاً في الباك اند.
    // **نفس قاعدة السيرفر بالظبط** (loadManageableMessage): صاحب الرسالة أو الأدمن.
    // الزراير بتختفي عن اللي مش بتاعه بدل ما يدوس وياخد ٤٠٣ — والمنع الحقيقي على السيرفر
    // مش هنا، ده عشان الشكل يقول الحقيقة بس
    function canManageMessage(message) {
      return message.direction === 'outgoing' && Boolean(message.message_id)
        && (currentUserRole === 'admin'
          || (message.sent_by !== null && Number(message.sent_by) === currentUserId));
    }

    // إيموجيز الـ reaction المسموح بيها فعليًا على تيليجرام — نفس القايمة المسموحة في الباك اند
    const REACTION_EMOJIS = ['👍', '❤', '🔥', '🎉', '😁', '🤔', '😢', '🙏'];

    function reactionPickerHtml(incomingId, current) {
      return `<div class="reaction-picker" data-incoming-id="${incomingId}" style="display:none">
        ${REACTION_EMOJIS.map((emoji) => `
          <button type="button" class="reaction-option ${current === emoji ? 'active' : ''}" data-react-emoji="${emoji}">${emoji}</button>
        `).join('')}
      </div>`;
    }

    function ticketMessageHtml(message) {
      // الرسالة الآلية بتتنسب صراحةً لـ "رد آلي" مش لفريق الدعم — الموظف اللي بيراجع الصبح
      // لازم يفرّق بين اللي زميله كتبه واللي النموذج قاله
      const senderPrefix = message.direction === 'outgoing'
        ? escapeHtml(message.is_ai ? '🤖 رد آلي' : (message.sender_name || 'فريق الدعم')) + ' · ' : '';
      // تمييز رسائل الطالب (نجمة = رسالة حلوة، إكس = شكوى)، والرد (quote) والتفاعل بإيموجي — كلهم
      // بيشتغلوا على رسائل الطالب الواردة بس
      const replyPreviewText = (message.content ? message.content : (message.image_path ? '📷 صورة' : '')).slice(0, 120);
      const incomingTools = message.direction === 'incoming' && message.incoming_message_id ? `
        <div class="msg-tools">
          <button type="button" class="msg-tool-btn ${message.flag === 'star' ? 'active-star' : ''}" data-flag-action="star"
            data-incoming-id="${message.incoming_message_id}" title="تمييز كرسالة حلوة" aria-label="تمييز كرسالة حلوة">⭐</button>
          <button type="button" class="msg-tool-btn ${message.flag === 'complaint' ? 'active-complaint' : ''}" data-flag-action="complaint"
            data-incoming-id="${message.incoming_message_id}" title="تمييز كشكوى" aria-label="تمييز كشكوى">❌</button>
          <button type="button" class="msg-tool-btn" data-reply-action data-incoming-id="${message.incoming_message_id}"
            data-reply-preview="${escapeHtml(replyPreviewText)}" title="رد على هذه الرسالة" aria-label="رد على هذه الرسالة">↩</button>
          <button type="button" class="msg-tool-btn ${message.agent_reaction ? 'active-reaction' : ''}" data-react-toggle
            data-incoming-id="${message.incoming_message_id}" title="تفاعل بإيموجي" aria-label="تفاعل بإيموجي">${message.agent_reaction || '🙂'}</button>
        </div>
        ${reactionPickerHtml(message.incoming_message_id, message.agent_reaction)}` : '';
      // الاقتباس بيتعرض للاتجاهين: الموظف بيرد على رسالة الطالب، والطالب بيعمل Reply من تليجرام.
      // السطر اللي فوق الاقتباس بيقول بيرد على مين، عشان الاقتباس لوحده ملبّس — نص مقتبس جوه
      // فقاعة واردة ممكن يتقرا على إنه كلام الطالب مش كلامنا
      const replyQuoteHtml = (() => {
        if (message.reply_to_preview) {
          const who = message.direction === 'incoming'
            ? (message.reply_to_direction === 'outgoing' ? 'رد على رسالتكم' : 'رد على رسالته')
            : 'رد على';
          return `<div class="ticket-message-reply-quote">
            <span class="reply-quote-who">↩ ${who}</span>
            <span class="reply-quote-text">${escapeHtml(message.reply_to_preview.slice(0, 100))}</span>
          </div>`;
        }
        // اتعمل عليها Reply بس الرسالة الأصلية مش عندنا — نقولها بدل ما نسيب الموظف يخمّن
        if (message.is_reply) {
          return `<div class="ticket-message-reply-quote is-missing">
            <span class="reply-quote-who">↩ رد على رسالة أقدم مش متسجّلة عندنا</span>
          </div>`;
        }
        return '';
      })();
      return `
        <div class="ticket-message ${message.direction} ${message.is_ai ? 'is-ai' : ''}" data-message-key="${escapeHtml(messageKeyOf(message))}"
          data-message-id="${message.message_id || ''}" data-edited-at="${message.edited_at || ''}">
          ${canManageMessage(message) ? `
            <div class="msg-tools">
              <button type="button" class="msg-tool-btn" data-msg-action="edit" title="تعديل الرسالة" aria-label="تعديل الرسالة">✎</button>
              <button type="button" class="msg-tool-btn danger" data-msg-action="delete" title="حذف الرسالة" aria-label="حذف الرسالة">🗑</button>
            </div>` : ''}
          ${incomingTools}
          ${replyQuoteHtml}
          ${message.image_path ? `<img class="ticket-message-image" src="/${escapeHtml(message.image_path)}" alt="صورة مرفقة">` : ''}
          ${message.voice_path ? `<audio class="ticket-message-voice" controls preload="none" src="/${escapeHtml(message.voice_path)}"></audio>` : ''}
          ${message.content ? `<div class="ticket-message-content">${escapeHtml(message.content)}</div>` : ''}
          <div class="ticket-message-meta">${senderPrefix}${fmtDate(message.occurred_at)}${message.edited_at ? ' · معدّلة' : ''}</div>
        </div>`;
    }

    function handleMessageToolsClick(event) {
      const flagButton = event.target.closest('[data-flag-action]');
      if (flagButton) return toggleMessageFlag(flagButton);

      const reactToggle = event.target.closest('[data-react-toggle]');
      if (reactToggle) return toggleReactionPicker(reactToggle);

      const reactOption = event.target.closest('[data-react-emoji]');
      if (reactOption) return setMessageReaction(reactOption);

      const replyButton = event.target.closest('[data-reply-action]');
      if (replyButton) return setReplyContext(replyButton.dataset.incomingId, replyButton.dataset.replyPreview);

      const button = event.target.closest('[data-msg-action]');
      if (!button) return;
      const bubble = button.closest('.ticket-message');
      const messageId = Number(bubble?.dataset.messageId);
      if (!messageId) return;
      if (button.dataset.msgAction === 'delete') deleteTicketMessage(bubble, messageId);
      else startMessageEdit(bubble, messageId);
    }

    // مربّع فتح/قفل picker التفاعل بتاع رسالة معيّنة — واحد بس مفتوح في نفس الوقت
    function closeReactionPickers() {
      document.querySelectorAll('.reaction-picker').forEach((p) => { p.style.display = 'none'; });
    }

    // القائمة position:fixed، فمكانها بيتحسب من مكان الزرار وقت الفتح. بتتقفل مع أي تمرير أو
    // تغيير حجم بدل ما نلاحق الزرار — fixed مابتتحركش مع الحاوية اللي بتتمرّر، فلو سيبناها
    // مفتوحة كانت هتفضل واقفة في الهوا بعيد عن رسالتها
    function positionReactionPicker(picker, anchor) {
      const box = anchor.getBoundingClientRect();
      const width = picker.offsetWidth;
      const height = picker.offsetHeight;
      const margin = 8;
      // نهاية القائمة تحاذي نهاية الزرار، مع منعها تخرج من أي جنب من الشاشة
      const left = Math.min(Math.max(box.right - width, margin), window.innerWidth - width - margin);
      // تحت الزرار، وفوقه لو مفيش مكان تحت (آخر رسالة في المحادثة)
      const below = box.bottom + 6;
      const top = below + height > window.innerHeight - margin ? box.top - height - 6 : below;
      picker.style.left = Math.max(left, margin) + 'px';
      picker.style.top = Math.max(top, margin) + 'px';
    }

    function toggleReactionPicker(toggleButton) {
      const bubble = toggleButton.closest('.ticket-message');
      const picker = bubble?.querySelector('.reaction-picker');
      if (!picker) return;
      const isOpen = picker.style.display !== 'none';
      closeReactionPickers();
      if (isOpen) return;
      // العرض قبل القياس: عنصر display:none مقاساته أصفار
      picker.style.display = 'flex';
      positionReactionPicker(picker, toggleButton);
    }
    document.addEventListener('click', (event) => {
      if (!event.target.closest('.msg-tools') && !event.target.closest('.reaction-picker')) {
        closeReactionPickers();
      }
    });
    window.addEventListener('resize', closeReactionPickers);
    document.addEventListener('scroll', closeReactionPickers, true);

    // اختيار نفس الإيموجي التفاعل الحالي بيلغيه، واختيار إيموجي تاني بيستبدله — حقيقي على تيليجرام
    async function setMessageReaction(optionButton) {
      const picker = optionButton.closest('.reaction-picker');
      const incomingId = picker?.dataset.incomingId;
      const emoji = optionButton.dataset.reactEmoji;
      const isActive = optionButton.classList.contains('active');
      const newEmoji = isActive ? null : emoji;
      const bubble = optionButton.closest('.ticket-message');
      try {
        await api(`/api/tickets/incoming-messages/${incomingId}/react`, {
          method: 'PATCH', body: JSON.stringify({ emoji: newEmoji }),
        });
        picker.querySelectorAll('[data-react-emoji]').forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.reactEmoji === newEmoji);
        });
        const toggleButton = bubble.querySelector('[data-react-toggle]');
        toggleButton.textContent = newEmoji || '🙂';
        toggleButton.classList.toggle('active-reaction', Boolean(newEmoji));
        picker.style.display = 'none';
      } catch (error) {
        showToast(error.message);
      }
    }

    // ---------- الرد (quote) على رسالة معينة من الطالب ----------
    let currentReplyToMessageId = null;

    function setReplyContext(incomingId, previewText) {
      currentReplyToMessageId = incomingId;
      const context = document.getElementById('ticket-reply-context');
      const preview = document.getElementById('ticket-reply-context-preview');
      preview.textContent = previewText || '';
      context.style.display = 'flex';
      document.getElementById('ticket-reply-content').focus();
    }

    function clearReplyContext() {
      currentReplyToMessageId = null;
      document.getElementById('ticket-reply-context').style.display = 'none';
    }

    // الضغط على نفس علامة التمييز مرة تانية بيلغيها، والضغط على العلامة التانية بيبدّلها
    async function toggleMessageFlag(button) {
      const incomingId = button.dataset.incomingId;
      const action = button.dataset.flagAction;
      const isActive = button.classList.contains(`active-${action}`);
      const newFlag = isActive ? null : action;
      const bubble = button.closest('.ticket-message');
      try {
        await api(`/api/tickets/incoming-messages/${incomingId}/flag`, {
          method: 'PATCH', body: JSON.stringify({ flag: newFlag }),
        });
        bubble.querySelectorAll('[data-flag-action]').forEach((btn) => {
          btn.classList.toggle(`active-${btn.dataset.flagAction}`, btn.dataset.flagAction === newFlag);
        });
      } catch (error) {
        showToast(error.message);
      }
    }

    // التعديل بيحصل جوّه الفقاعة نفسها من غير ما ياخد مساحة زيادة من الشاشة
    function startMessageEdit(bubble, messageId) {
      if (bubble.querySelector('.msg-edit-box')) return;
      const meta = bubble.querySelector('.ticket-message-meta');
      // لو الرسالة صورة من غير تعليق بننشئ عنصر النص عشان يستقبل التعليق الجديد
      let contentElement = bubble.querySelector('.ticket-message-content');
      if (!contentElement) {
        contentElement = document.createElement('div');
        contentElement.className = 'ticket-message-content';
        bubble.insertBefore(contentElement, meta);
      }
      const box = document.createElement('div');
      box.className = 'msg-edit-box';
      box.innerHTML = `
        <textarea class="msg-edit-input" rows="2"></textarea>
        <div class="msg-edit-actions">
          <button type="button" class="btn btn-primary btn-sm" data-edit-save>حفظ</button>
          <button type="button" class="btn btn-ghost btn-sm" data-edit-cancel>إلغاء</button>
        </div>`;
      const textarea = box.querySelector('.msg-edit-input');
      textarea.value = contentElement ? contentElement.textContent : '';
      if (contentElement) contentElement.style.display = 'none';
      bubble.insertBefore(box, meta);
      textarea.focus();
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);

      const close = () => {
        box.remove();
        if (contentElement) contentElement.style.display = '';
      };

      box.querySelector('[data-edit-cancel]').addEventListener('click', close);
      box.querySelector('[data-edit-save]').addEventListener('click', async () => {
        const content = textarea.value.trim();
        if (!content) return showToast('اكتب نص الرسالة بعد التعديل');
        const saveButton = box.querySelector('[data-edit-save]');
        saveButton.disabled = true;
        try {
          const updated = await api('/api/tickets/messages/' + messageId, {
            method: 'PATCH', body: JSON.stringify({ content }),
          });
          if (contentElement) contentElement.textContent = content;
          bubble.dataset.editedAt = updated.edited_at || '';
          const metaText = meta.textContent.replace(' · معدّلة', '');
          meta.textContent = metaText + (updated.edited_at ? ' · معدّلة' : '');
          close();
          showToast('تم تعديل الرسالة');
          loadTickets(true);
        } catch (error) {
          saveButton.disabled = false;
          showToast(error.message);
        }
      });
      textarea.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
        if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) box.querySelector('[data-edit-save]').click();
      });
    }

    async function deleteTicketMessage(bubble, messageId) {
      if (!confirm('هتتحذف الرسالة من المحادثة ومن تيليجرام كمان. تأكيد؟')) return;
      try {
        const result = await api('/api/tickets/messages/' + messageId, { method: 'DELETE' });
        renderedMessageKeys.delete(bubble.dataset.messageKey);
        bubble.remove();
        showToast(result.warning || 'تم حذف الرسالة');
        loadTickets(true);
      } catch (error) { showToast(error.message); }
    }


    // ===================== متابعة الأداء =====================
    // مفيش مكتبة رسم في المشروع ولا خطوة build، والمخططات المطلوبة بسيطة كفاية إنها تتكتب
    // بالإيد: SVG وعناصر CSS نصّية جوه innerHTML زي باقي الواجهة. كل عنصر فيه title عشان
    // القيمة تبان بمجرد المرور عليه من غير أي كود إضافي، والمخططات بتتمدد على عرض الحاوية
    const PERF_PALETTE = ['#3648d1', '#1f9d63', '#c17f14', '#d1453b', '#7c3aed', '#0891b2', '#db2777', '#65a30d'];
    // الأسبوع بيبدأ السبت في العرض، لكن PostgreSQL بيرجّع 0 للأحد — فده ترتيب العرض مش القيم
    const PERF_WEEK_ORDER = [6, 0, 1, 2, 3, 4, 5];
    const PERF_WEEK_LABELS = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

    // شرايح عدم التفاعل. كل شريحة عندها filters = نفس شرط الفلتر المقابل في شاشة طلاب المنصة،
    // فالعدد اللي بيظهر هنا بيطابق عدد الصفوف اللي بتطلع هناك لما تدوس "افتح القايمة".
    // التلات شرايح الأخيرة معندهاش زرار عن قصد: مفيش فلتر جاهز يعبّر عنها بالظبط، وربطها بأقرب
    // فلتر كان هيدّي رقم مختلف عن اللي مكتوب — ورقم مايتطابقش أسوأ من رقم من غير زرار
    const PERF_SEGMENTS = [
      { key: 'seg_unlinked', label: 'غير مرتبطين بتيليجرام', tone: 'danger',
        hint: 'مفيش حساب تيليجرام مربوط — البوت مايقدرش يوصلهم أصلًا',
        filters: { telegram: 'unlinked' } },
      { key: 'seg_linked_not_started', label: 'مرتبطين وما بدأوش البوت', tone: 'danger',
        hint: 'الحساب مربوط لكن عمرهم ما فتحوا محادثة مع البوت',
        filters: { telegram: 'linked_not_started' } },
      { key: 'seg_never_wrote', label: 'دخلوا البوت وما ردّوا على أي رسالة', tone: 'warn',
        hint: 'دوسوا Start ومبعتوش ولا رسالة واحدة لحد دلوقتي',
        filters: { conversation_status: 'start_only' } },
      { key: 'seg_no_welcome', label: 'دخلوا البوت ومجاش لهم ترحيب', tone: 'warn',
        hint: 'محتاجين تواصل يدوي — رسالة الترحيب مااتبعتلهمش',
        filters: { welcome_status: 'no_welcome' } },
      { key: 'seg_welcome_no_reply', label: 'وصلهم ترحيب ومردّوش', tone: 'warn',
        hint: 'الرسالة وصلت فعلًا ومحدش رد عليها',
        filters: { welcome_status: 'welcome_no_reply' } },
      { key: 'seg_silent_7d', label: 'كانوا بيردّوا وسكتوا من أكتر من أسبوع', tone: 'warn',
        hint: 'اتكلموا قبل كده، وآخر رسالة منهم بقالها أكتر من ٧ أيام', silentDays: 7 },
      { key: 'seg_silent_14d', label: 'سكتوا من أكتر من أسبوعين', tone: 'warn', silentDays: 14 },
      { key: 'seg_silent_30d', label: 'سكتوا من أكتر من شهر', tone: 'danger', silentDays: 30 },
      { key: 'seg_broadcast_no_reply', label: 'اتبعتلهم إرسال جماعي ومردّوش خالص', tone: 'muted',
        hint: 'وصلتهم رسالة جماعية واحدة على الأقل وعمرهم ما كتبوا حاجة' },
      { key: 'seg_assigned_never_called', label: 'مسندين لمتابعة تليفونية ومحدش اتصل بيهم', tone: 'muted',
        hint: 'الطالب متوزّع على موظف بس مفيش ولا مكالمة متسجّلة له' },
      { key: 'seg_called_never_reached', label: 'اتصلنا بيهم ومعرفناش نوصلهم ولا مرة', tone: 'muted',
        hint: 'كل المكالمات المسجّلة ليهم كانت "لم يرد" أو "الخط مشغول" أو رقم غلط' },
    ];

    let perfSummaryData = null;
    let perfStaffData = null;
    let perfStaffSort = { key: 'replies', dir: 'desc' };
    let perfInitialised = false;

    const perfNum = (value) => Number(value || 0).toLocaleString('en-US');
    const perfPct = (part, whole) => (whole ? Math.round((Number(part) / whole) * 1000) / 10 : 0);
    const perfPctText = (part, whole) => {
      const value = perfPct(part, whole);
      return value === 0 && Number(part) > 0 ? 'أقل من 0.1%' : value + '%';
    };
    const perfDur = (seconds) => (seconds === null || seconds === undefined ? '—' : fmtDuration(seconds));

    function perfNiceCeil(value) {
      if (value <= 5) return 5;
      const magnitude = Math.pow(10, Math.floor(Math.log10(value)));
      return Math.ceil(value / (magnitude / 2)) * (magnitude / 2);
    }

    // المحور السيني بيعرض عدد محدود من التواريخ عشان مايتزحمش على فترة طويلة. آخر تاريخ بيتعرض
    // دايمًا، فاللي قبله بيتشال لو قريب منه أوي — من غير كده الاتنين بيتراكبوا فوق بعض
    function perfThinLabels(labels, maxLabels) {
      const step = Math.max(1, Math.ceil(labels.length / maxLabels));
      const last = labels.length - 1;
      return labels.map((label, index) => {
        if (index === last) return label;
        if (index % step !== 0) return '';
        return last - index < step * 0.7 ? '' : label;
      });
    }

    function perfEmpty(text) {
      return `<div class="empty-state">${escapeHtml(text)}</div>`;
    }

    function perfLegend(items, column) {
      return `<div class="perf-legend ${column ? 'perf-legend-column' : ''}">` + items.map((item, index) =>
        `<span class="perf-legend-item"><i style="background:${item.color || PERF_PALETTE[index % PERF_PALETTE.length]}"></i>`
        + `${escapeHtml(item.label)}${item.extra || ''}</span>`).join('') + '</div>';
    }

    // ---------- مخطط خطي متعدد السلاسل ----------
    function perfLineChart({ labels, series, height = 240, formatValue = perfNum }) {
      if (!labels.length) return perfEmpty('مفيش بيانات في الفترة دي.');
      const width = 780;
      const pad = { top: 14, right: 14, bottom: 38, left: 54 };
      const innerW = width - pad.left - pad.right;
      const innerH = height - pad.top - pad.bottom;
      const maxValue = perfNiceCeil(Math.max(1, ...series.flatMap((line) => line.values)));
      const px = (index) => pad.left + (labels.length === 1 ? innerW / 2 : (index / (labels.length - 1)) * innerW);
      const py = (value) => pad.top + innerH - (Math.max(0, Number(value) || 0) / maxValue) * innerH;

      const grid = [0, 0.25, 0.5, 0.75, 1].map((ratio) => {
        const value = Math.round(maxValue * ratio);
        return `<line x1="${pad.left}" y1="${py(value)}" x2="${width - pad.right}" y2="${py(value)}" class="perf-grid"/>`
          + `<text x="${pad.left - 8}" y="${py(value) + 4}" text-anchor="end" class="perf-axis">${formatValue(value)}</text>`;
      }).join('');

      const xAxis = perfThinLabels(labels, 9).map((label, index) => (label
        ? `<text x="${px(index)}" y="${height - 12}" text-anchor="middle" class="perf-axis">${escapeHtml(label.slice(5))}</text>`
        : '')).join('');

      const plotted = series.map((line) => {
        const points = line.values.map((value, index) => `${px(index).toFixed(1)},${py(value).toFixed(1)}`);
        const area = `M ${px(0).toFixed(1)},${py(0).toFixed(1)} L ${points.join(' L ')} L ${px(labels.length - 1).toFixed(1)},${py(0).toFixed(1)} Z`;
        const dots = line.values.map((value, index) =>
          `<circle cx="${px(index).toFixed(1)}" cy="${py(value).toFixed(1)}" r="2.6" fill="${line.color}">`
          + `<title>${escapeHtml(line.name)} — ${escapeHtml(labels[index])}: ${formatValue(value)}</title></circle>`).join('');
        return `<path d="${area}" fill="${line.color}" opacity="0.07"/>`
          + `<polyline points="${points.join(' ')}" fill="none" stroke="${line.color}" stroke-width="2"
             stroke-linejoin="round" stroke-linecap="round"/>${dots}`;
      }).join('');

      return `<div class="perf-chart"><svg viewBox="0 0 ${width} ${height}" width="100%" role="img"
        aria-label="مخطط زمني">${grid}${plotted}${xAxis}</svg></div>`
        + perfLegend(series.map((line) => ({ label: line.name, color: line.color })));
    }

    // ---------- أعمدة أفقية (بتقرا أحسن من العمودية مع النصوص العربية) ----------
    function perfBarChart({ items, formatValue = perfNum, emptyText = 'مفيش بيانات في الفترة دي.', showPercentOf }) {
      const rows = items.filter((item) => item && item.label !== undefined);
      if (!rows.length || rows.every((item) => !Number(item.value))) return perfEmpty(emptyText);
      const max = Math.max(1, ...rows.map((item) => Number(item.value) || 0));
      return '<div class="perf-bars">' + rows.map((item, index) => {
        const value = Number(item.value) || 0;
        const width = value ? Math.max(1.5, (value / max) * 100) : 0;
        const color = item.color || PERF_PALETTE[index % PERF_PALETTE.length];
        const percent = showPercentOf ? `<em>${perfPct(value, showPercentOf)}%</em>` : '';
        return `<div class="perf-bar-row" title="${escapeHtml(item.label)}: ${formatValue(value)}">
            <span class="perf-bar-label">${escapeHtml(item.label)}</span>
            <span class="perf-bar-track"><span class="perf-bar-fill" style="width:${width.toFixed(2)}%;background:${color}"></span></span>
            <span class="perf-bar-value">${formatValue(value)}${percent}</span>
          </div>`;
      }).join('') + '</div>';
    }

    // ---------- حلقة (donut) ----------
    function perfArcPath(cx, cy, innerR, outerR, start, sweepAngle) {
      // الحلقة الكاملة نقطة بدايتها = نهايتها فمابترسمش، فبنقص شعرة من الدورة الكاملة
      const sweep = Math.min(sweepAngle, Math.PI * 2 - 0.0001);
      const end = start + sweep;
      const large = sweep > Math.PI ? 1 : 0;
      const point = (radius, angle) =>
        `${(cx + radius * Math.cos(angle)).toFixed(2)},${(cy + radius * Math.sin(angle)).toFixed(2)}`;
      return `M ${point(outerR, start)} A ${outerR} ${outerR} 0 ${large} 1 ${point(outerR, end)}`
        + ` L ${point(innerR, end)} A ${innerR} ${innerR} 0 ${large} 0 ${point(innerR, start)} Z`;
    }

    function perfDonut({ items, size = 186, centerLabel = '' }) {
      const rows = items.filter((item) => Number(item.value) > 0);
      const total = rows.reduce((sum, item) => sum + Number(item.value), 0);
      if (!total) return perfEmpty('مفيش بيانات في الفترة دي.');
      let angle = -Math.PI / 2;
      const arcs = rows.map((item, index) => {
        const color = item.color || PERF_PALETTE[index % PERF_PALETTE.length];
        const path = perfArcPath(size / 2, size / 2, size * 0.28, size / 2 - 5, angle, (Number(item.value) / total) * Math.PI * 2);
        angle += (Number(item.value) / total) * Math.PI * 2;
        return `<path d="${path}" fill="${color}"><title>${escapeHtml(item.label)}: ${perfNum(item.value)} (${perfPct(item.value, total)}%)</title></path>`;
      }).join('');
      const legend = perfLegend(rows.map((item, index) => ({
        label: item.label,
        color: item.color || PERF_PALETTE[index % PERF_PALETTE.length],
        extra: ` <b>${perfNum(item.value)}</b> <em>${perfPct(item.value, total)}%</em>`,
      })), true);
      return `<div class="perf-donut-wrap">
        <svg viewBox="0 0 ${size} ${size}" width="${size}" height="${size}" role="img" aria-label="توزيع">
          ${arcs}
          <text x="${size / 2}" y="${size / 2 - 1}" text-anchor="middle" class="perf-donut-total">${perfNum(total)}</text>
          <text x="${size / 2}" y="${size / 2 + 17}" text-anchor="middle" class="perf-axis">${escapeHtml(centerLabel)}</text>
        </svg>${legend}</div>`;
    }

    // ---------- خريطة حرارية: أيام الأسبوع × ساعات اليوم ----------
    function perfHeatmap(matrix, title, rgb) {
      const max = Math.max(1, ...matrix.flat());
      const hours = Array.from({ length: 24 }, (_, hour) => hour);
      const head = '<div class="perf-heat-row"><span class="perf-heat-day"></span>'
        + hours.map((hour) => `<span class="perf-heat-hour">${hour % 3 === 0 ? hour : ''}</span>`).join('') + '</div>';
      const rows = PERF_WEEK_ORDER.map((dow) => {
        const cells = hours.map((hour) => {
          const value = matrix[dow][hour];
          const intensity = value ? (0.14 + (value / max) * 0.86).toFixed(3) : 0;
          return `<span class="perf-heat-cell" style="background:rgba(${rgb},${intensity})"
            title="${PERF_WEEK_LABELS[dow]} — الساعة ${hour}: ${perfNum(value)}"></span>`;
        }).join('');
        return `<div class="perf-heat-row"><span class="perf-heat-day">${PERF_WEEK_LABELS[dow]}</span>${cells}</div>`;
      }).join('');
      return `<div class="perf-heat"><div class="perf-heat-title">${escapeHtml(title)}
        <span class="perf-heat-scale">الأغمق = أكتر (الأقصى ${perfNum(max)})</span></div>${head}${rows}</div>`;
    }

    function perfKpi(label, value, hint, tone) {
      return `<div class="stat-card perf-kpi${tone ? ' perf-kpi-' + tone : ''}">
        <div class="label">${escapeHtml(label)}</div>
        <div class="value">${value}</div>
        ${hint ? `<div class="perf-kpi-hint">${hint}</div>` : ''}</div>`;
    }

    // ---------- تحميل البيانات ----------
    function perfQueryString() {
      const params = new URLSearchParams();
      const from = document.getElementById('perf-from').value;
      const to = document.getElementById('perf-to').value;
      const bootcamp = document.getElementById('perf-bootcamp-filter').value;
      if (from) params.set('from', from);
      if (to) params.set('to', to);
      if (bootcamp) params.set('bootcamp', bootcamp);
      return params.toString();
    }

    function perfSetRange(days) {
      const today = new Date();
      const toText = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      const fromDate = new Date(`${toText}T00:00:00Z`);
      fromDate.setUTCDate(fromDate.getUTCDate() - (days - 1));
      document.getElementById('perf-from').value = fromDate.toISOString().slice(0, 10);
      document.getElementById('perf-to').value = toText;
    }

    function perfScopeLabel(scope) {
      const names = (scope && scope.bootcamps ? scope.bootcamps : []).map((row) => row.name.trim()).filter(Boolean);
      if (!names.length) return 'كل الأبواب';
      return names.length <= 2 ? names.join(' + ') : `${names.length} أبواب مختارة`;
    }

    function perfRangeNote(data) {
      const note = document.getElementById('perf-range-note');
      if (!note) return;
      const range = data.range;
      const period = range.capped
        ? `الفترة اتقصّت لـ ${range.days} يوم (${range.from} → ${range.to}) — ده أقصى مدى معروض`
        : `${range.from} → ${range.to} (${range.days} يوم)`;
      note.textContent = `${period} · ${perfScopeLabel(data.scope)}`;
      note.classList.toggle('perf-note-warning', Boolean(range.capped));
    }

    async function loadPerformance() {
      const query = perfQueryString();
      document.getElementById('perf-kpis').innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const [summary, staff] = await Promise.all([
          api('/api/performance/summary?' + query),
          api('/api/performance/staff?' + query),
        ]);
        perfSummaryData = summary;
        perfStaffData = staff;
        perfRangeNote(summary);
        renderPerfPlatform(summary);
        renderPerfStaff(staff);
        perfFillEmployeeSelect(staff.staff);
        const selected = document.getElementById('perf-employee').value;
        if (selected) loadPerfMember(selected);
      } catch (error) {
        document.getElementById('perf-kpis').innerHTML = perfEmpty(error.message);
        showToast(error.message);
      }
    }

    // ---------- نبض المنصة ----------
    function renderPerfPlatform(data) {
      const volume = data.volume;
      const tickets = data.tickets;
      const calls = data.calls;
      const response = data.response;
      const replyRatio = perfPct(volume.agent_replies, volume.incoming_messages);

      document.getElementById('perf-kpis').innerHTML = [
        perfKpi('رسايل الطلاب', perfNum(volume.incoming_messages),
          `من ${perfNum(volume.active_students)} طالب متفاعل`),
        perfKpi('ردود الفريق', perfNum(volume.agent_replies),
          `${replyRatio}% من الوارد · ${perfNum(volume.conversations_touched)} محادثة`),
        perfKpi('وسيط سرعة الرد', perfDur(response.median_seconds),
          `متوسط ${perfDur(response.avg_seconds)} · ٩٠% خلال ${perfDur(response.p90_seconds)}`,
          response.median_seconds !== null && response.median_seconds <= 900 ? 'good' : 'warn'),
        perfKpi('مستنية رد دلوقتي', perfNum(tickets.awaiting_reply),
          tickets.oldest_waiting_seconds ? `أطول انتظار ${perfDur(tickets.oldest_waiting_seconds)}` : 'مفيش تأخير',
          tickets.awaiting_reply ? 'warn' : 'good'),
        perfKpi('المكالمات', perfNum(calls.total),
          `${perfNum(calls.students_called)} طالب · ${perfNum(calls.with_notes)} فيها ملاحظات`),
        perfKpi('مكالمات وصلنا فيها', perfNum(calls.reached),
          `${perfPct(calls.reached, calls.total)}% من المكالمات · ${perfNum(calls.unreached)} مردّوش`,
          perfPct(calls.reached, calls.total) >= 50 ? 'good' : 'warn'),
        perfKpi('المسافة بين رسالتين', perfDur(data.reply_gap.median_seconds),
          `وسيط التواصل التالي في نفس المحادثة (الدفعة الواحدة مستبعدة)`),
        perfKpi('المسافة بين مكالمتين', perfDur(data.call_gap.median_seconds),
          'وسيط الوقت لحد المكالمة الجاية لنفس الطالب'),
        perfKpi('محادثات جديدة', perfNum(volume.new_conversations),
          `${perfNum(volume.welcome_messages)} رسالة ترحيب اتبعتت`),
        perfKpi('رسايل تلقائية', perfNum(volume.auto_follow_ups),
          `متابعات تلقائية · ${perfNum(volume.broadcast_sent)} إرسال جماعي`),
      ].join('');

      const labels = data.timeseries.map((row) => row.day);
      document.getElementById('perf-trend').innerHTML = perfLineChart({
        labels,
        series: [
          { name: 'رسايل واردة', color: PERF_PALETTE[0], values: data.timeseries.map((row) => row.incoming) },
          { name: 'ردود الفريق', color: PERF_PALETTE[1], values: data.timeseries.map((row) => row.replies) },
          { name: 'مكالمات', color: PERF_PALETTE[2], values: data.timeseries.map((row) => row.calls) },
          { name: 'محادثات جديدة', color: PERF_PALETTE[4], values: data.timeseries.map((row) => row.new_conversations) },
        ],
      });

      document.getElementById('perf-response-hist').innerHTML =
        (response.count
          ? `<p class="perf-inline-note">${perfNum(response.count)} موجة رد مقيسة · أطول رد ${perfDur(response.max_seconds)}</p>`
          : '')
        + perfBarChart({
          items: response.buckets.map((bucket, index) => ({
            label: bucket.label,
            value: bucket.count,
            color: index <= 1 ? PERF_PALETTE[1] : index <= 3 ? PERF_PALETTE[2] : PERF_PALETTE[3],
          })),
          emptyText: 'مفيش ردود مقيسة في الفترة دي.',
          showPercentOf: response.count,
        });

      document.getElementById('perf-outcomes').innerHTML = perfDonut({
        items: data.call_outcomes.map((row) => ({ label: row.name, value: row.count })),
        centerLabel: 'مكالمة',
      });

      const reach = data.reach;
      document.getElementById('perf-reach').innerHTML = `
        <div class="perf-two-col">
          <div>
            <h3 class="perf-subhead">مسار البوت</h3>
            ${perfBarChart({
              items: [
                { label: 'كل طلاب المنصة', value: reach.students_total, color: PERF_PALETTE[5] },
                { label: 'مرتبطين بتيليجرام', value: reach.linked_telegram, color: PERF_PALETTE[0] },
                { label: 'بدأوا محادثة مع البوت', value: reach.started_bot, color: PERF_PALETTE[0] },
                { label: 'كتبوا ولو رسالة واحدة', value: reach.wrote_at_least_once, color: PERF_PALETTE[1] },
                { label: 'وصلهم ترحيب', value: reach.got_welcome, color: PERF_PALETTE[1] },
                { label: 'ردّوا بعد الترحيب', value: reach.replied_after_welcome, color: PERF_PALETTE[1] },
                { label: 'لم يردّوا على أي رسالة', value: reach.seg_never_wrote, color: PERF_PALETTE[3] },
              ],
              showPercentOf: reach.students_total,
            })}
            <p class="perf-inline-note">من ${perfNum(reach.started_bot)} طالب دخلوا البوت:
              <b>${perfNum(reach.wrote_at_least_once)}</b> كتبوا لنا،
              و<b>${perfNum(reach.seg_never_wrote)}</b> ما ردّوش على أي رسالة</p>
          </div>
          <div>
            <h3 class="perf-subhead">مسار التليفون</h3>
            ${perfBarChart({
              items: [
                { label: 'كل طلاب المنصة', value: reach.students_total, color: PERF_PALETTE[5] },
                { label: 'مسندين لمتابعة تليفونية', value: reach.assigned_for_calls, color: PERF_PALETTE[2] },
                { label: 'اتعمل معاهم مكالمة', value: reach.called_at_least_once, color: PERF_PALETTE[2] },
                { label: 'وصلنا لهم فعلًا', value: reach.reached_by_phone, color: PERF_PALETTE[1] },
              ],
              showPercentOf: reach.students_total,
            })}
          </div>
        </div>
        <p class="perf-inline-note">إجمالي اللي وصلنا له بأي وسيلة (بوت أو تليفون):
          <b>${perfNum(reach.reached_any_channel)}</b> طالب — ${perfPct(reach.reached_any_channel, reach.students_total)}% من طلاب المنصة</p>`;

      renderPerfDisengaged(data);

      const movesByIdea = new Map(data.idea_moves.map((row) => [Number(row.idea_number), row]));
      document.getElementById('perf-ideas').innerHTML = perfBarChart({
        items: data.ideas.map((row) => {
          const moves = movesByIdea.get(Number(row.idea_number));
          const base = row.idea_number === 0 ? 'لم تُحدَّد بعد' : `فكرة ${row.idea_number}`;
          return {
            // عدد اللي اتنقلوا للفكرة دي في الفترة بيتحط جنب اسمها — بيفرّق بين فكرة واقف عندها
            // كتير لأنها صعبة، وفكرة واقف عندها كتير لأنهم لسه واصلينها دلوقتي
            label: moves ? `${base} · +${perfNum(moves.students)} في الفترة` : base,
            value: row.conversations,
            color: row.idea_number === 0 ? PERF_PALETTE[3] : PERF_PALETTE[0],
          };
        }),
        emptyText: 'مفيش محادثات لسه.',
      });

      const statusItems = [
        { label: 'جديدة', value: tickets.status_new, color: PERF_PALETTE[0] },
        { label: 'قيد المتابعة', value: tickets.status_in_progress, color: PERF_PALETTE[2] },
        { label: 'بانتظار الطالب', value: tickets.status_waiting_student, color: PERF_PALETTE[5] },
        { label: 'مكتملة', value: tickets.status_resolved, color: PERF_PALETTE[1] },
        { label: 'مغلقة', value: tickets.status_closed, color: PERF_PALETTE[6] },
      ];
      document.getElementById('perf-inbox-state').innerHTML = perfBarChart({
        items: statusItems, showPercentOf: tickets.total,
      }) + `<div class="perf-pill-row">
        <span class="stat-pill ${tickets.awaiting_reply ? 'stat-warning' : 'stat-success'}">مستنية رد: ${perfNum(tickets.awaiting_reply)}</span>
        <span class="stat-pill stat-muted">غير مقروءة: ${perfNum(tickets.unread)}</span>
        <span class="stat-pill stat-muted">غير مسندة: ${perfNum(tickets.unassigned)}</span>
        <span class="stat-pill ${tickets.urgent ? 'stat-warning' : 'stat-muted'}">عاجلة: ${perfNum(tickets.urgent)}</span>
        <span class="stat-pill stat-muted">متابعة حان موعدها: ${perfNum(tickets.follow_up_due)}</span>
        <span class="stat-pill stat-muted">الإجمالي: ${perfNum(tickets.total)}</span>
      </div>` + (data.subtitles.length > 1
        ? `<h3 class="perf-subhead">العناوين الفرعية</h3>${perfBarChart({ items: data.subtitles.map((row) => ({ label: row.name, value: row.count })) })}`
        : '');

      document.getElementById('perf-heatmap').innerHTML =
        perfHeatmap(data.heatmap.incoming, 'رسايل الطلاب الواردة', '54,72,209')
        + perfHeatmap(data.heatmap.replies, 'ردود الفريق', '31,157,99');
    }

    // ---------- مين مش متفاعل ----------
    function renderPerfDisengaged(data) {
      const reach = data.reach;
      const total = reach.students_total;
      const rows = PERF_SEGMENTS.map((segment) => ({ segment, value: Number(reach[segment.key]) || 0 }))
        .filter((row) => row.value > 0);
      const wrap = document.getElementById('perf-disengaged');
      if (!rows.length) { wrap.innerHTML = perfEmpty('كل الطلاب في النطاق ده متفاعلين — مفيش شريحة تستاهل انتباه.'); return; }

      const max = Math.max(...rows.map((row) => row.value));
      wrap.innerHTML = '<div class="perf-segments">' + rows.map(({ segment, value }) => {
        const width = Math.max(1.5, (value / max) * 100);
        const canOpen = Boolean(segment.filters || segment.silentDays);
        return `<div class="perf-segment perf-segment-${segment.tone}">
          <div class="perf-segment-main">
            <div class="perf-segment-title">${escapeHtml(segment.label)}</div>
            ${segment.hint ? `<div class="perf-segment-hint">${escapeHtml(segment.hint)}</div>` : ''}
            <span class="perf-bar-track"><span class="perf-bar-fill" style="width:${width.toFixed(2)}%"></span></span>
          </div>
          <div class="perf-segment-side">
            <div class="perf-segment-value">${perfNum(value)}</div>
            <div class="perf-segment-pct">${perfPctText(value, total)} من ${perfNum(total)}</div>
            ${canOpen
              ? `<button type="button" class="btn btn-ghost btn-sm perf-segment-open" data-perf-segment="${escapeHtml(segment.key)}">افتح القايمة</button>`
              : '<span class="perf-segment-note">مفيش فلتر مطابق</span>'}
          </div>
        </div>`;
      }).join('') + '</div>';

      wrap.querySelectorAll('[data-perf-segment]').forEach((button) => {
        button.addEventListener('click', () => {
          const segment = PERF_SEGMENTS.find((item) => item.key === button.dataset.perfSegment);
          if (!segment) return;
          const filters = { ...(segment.filters || {}) };
          // "سكت من أكتر من N يوم" = آخر استقبال قبل (النهارده - N). فلتر "آخر استقبال إلى"
          // معناه "أقل من نهاية اليوم ده"، فبنطرح يوم زيادة عشان الحد يطلع مطابق للرقم المعروض
          if (segment.silentDays) {
            filters.last_received_to = perfShiftDay(data.range.today, -(segment.silentDays + 1));
          }
          perfOpenStudentSegment(filters, segment.label);
        });
      });
    }

    function perfShiftDay(dayText, days) {
      const date = new Date(`${dayText}T00:00:00Z`);
      date.setUTCDate(date.getUTCDate() + days);
      return date.toISOString().slice(0, 10);
    }

    // بينقل لشاشة طلاب المنصة ويحط عليها فلاتر الشريحة (زائد نطاق الأبواب المختار هنا).
    // بننقل التاب بالإيد مش بـ click عشان نقدر ننتظر تحميل خيارات الفلاتر قبل ما نكتب القيم —
    // لو كتبناها قبله، loadTafraStudentFilters كان هيسترجع المحفوظ من قبل ويدوس على اختيارنا
    async function perfOpenStudentSegment(filters, label) {
      const nav = document.querySelector('.nav-item[data-tab="tafra-students"]');
      const panel = document.getElementById('tab-tafra-students');
      if (!nav || !panel) return showToast('شاشة طلاب المنصة مش متاحة');
      document.querySelectorAll('.nav-item').forEach((item) => item.classList.remove('active'));
      nav.classList.add('active');
      document.querySelectorAll('.tab-panel').forEach((section) => (section.style.display = 'none'));
      panel.style.display = 'block';
      try {
        await loadTafraStudentFilters();
        applyStudentFilterOptions('tafra', tafraFilterOptions);
        resetStudentFilters('tafra');
        const scoped = { ...filters };
        const bootcamp = document.getElementById('perf-bootcamp-filter').value;
        if (bootcamp) scoped.bootcamp = bootcamp;
        Object.entries(scoped).forEach(([key, value]) => {
          const element = studentFilterElement('tafra', key);
          if (!element) return;
          element.value = value;
          multiSelectControllers[element.id]?.refresh();
        });
        bindStudentFilterEvents('tafra', () => { tafraStudentsPage = 1; loadTafraStudents(); });
        tafraStudentsPage = 1;
        await loadTafraStudents();
        showToast(`اتفلترت شاشة طلاب المنصة على: ${label}`);
      } catch (error) {
        showToast(error.message);
      }
    }

    // ---------- مقارنة الفريق ----------
    const PERF_STAFF_COLUMNS = [
      { key: 'name', label: 'الموظف', sortable: true, value: (row) => row.name, cell: (row) =>
        `<b>${escapeHtml(row.name)}</b>${row.is_active ? '' : ' <span class="badge badge-muted">متوقف</span>'}` },
      { key: 'replies', label: 'ردود', value: (row) => row.chat.replies_sent, cell: (row) => perfNum(row.chat.replies_sent) },
      { key: 'conversations', label: 'محادثات', value: (row) => row.chat.conversations_touched, cell: (row) => perfNum(row.chat.conversations_touched) },
      { key: 'median', label: 'وسيط الرد', value: (row) => (row.chat.median_seconds === null ? Infinity : row.chat.median_seconds),
        cell: (row) => perfDur(row.chat.median_seconds), asc: true },
      { key: 'fast', label: 'خلال ١٥ دقيقة', value: (row) => row.chat.within_15m,
        cell: (row) => (row.chat.responses_measured
          ? `${perfNum(row.chat.within_15m)} <em>${perfPct(row.chat.within_15m, row.chat.responses_measured)}%</em>` : '—') },
      { key: 'slow', label: 'فوق يوم', value: (row) => row.chat.over_24h, cell: (row) => perfNum(row.chat.over_24h) },
      { key: 'awaiting', label: 'مستنية رد الآن', value: (row) => row.chat.awaiting_tickets,
        cell: (row) => (row.chat.awaiting_tickets
          ? `<span class="badge badge-warning">${perfNum(row.chat.awaiting_tickets)}</span>` : '0') },
      { key: 'oldest', label: 'أطول انتظار', value: (row) => row.chat.oldest_waiting_seconds || 0,
        cell: (row) => perfDur(row.chat.oldest_waiting_seconds) },
      { key: 'calls', label: 'مكالمات', value: (row) => row.calls.total, cell: (row) => perfNum(row.calls.total) },
      { key: 'reached', label: 'وصلنا لهم', value: (row) => row.calls.reached, cell: (row) => perfNum(row.calls.reached) },
      { key: 'reach_rate', label: 'نسبة الوصول', value: (row) => (row.calls.reach_rate === null ? -1 : row.calls.reach_rate),
        cell: (row) => (row.calls.reach_rate === null ? '—' : `${row.calls.reach_rate}%`) },
      { key: 'coverage', label: 'تغطية المسندين', value: (row) => (row.calls.coverage_rate === null ? -1 : row.calls.coverage_rate),
        cell: (row) => (row.calls.students_assigned
          ? `${perfNum(row.calls.students_done)}/${perfNum(row.calls.students_assigned)} <em>${row.calls.coverage_rate}%</em>` : '—') },
      { key: 'ideas', label: 'تحرّك أفكار', value: (row) => row.ideas.moves, cell: (row) => perfNum(row.ideas.moves) },
      { key: 'days', label: 'أيام نشاط', value: (row) => Math.max(row.chat.active_days, row.calls.active_days),
        cell: (row) => perfNum(Math.max(row.chat.active_days, row.calls.active_days)) },
      { key: 'last', label: 'آخر نشاط', value: (row) => (row.last_activity_at ? Date.parse(row.last_activity_at) : 0),
        cell: (row) => (row.last_activity_at ? fmtDate(row.last_activity_at) : '—') },
    ];

    function renderPerfStaff(data) {
      // الموظف اللي مالوش أي أثر في الفترة ولا حِمل قايم دلوقتي مابيتعرضش — الجدول للمقارنة
      // مش لسرد الحسابات، والصفوف الفاضية بتشتت النظر عن اللي شغال فعلاً
      const rows = data.staff.filter((row) => row.chat.replies_sent || row.calls.total || row.ideas.moves
        || row.chat.awaiting_tickets || row.chat.tickets_total || row.calls.students_assigned);
      const table = document.getElementById('perf-staff-table');
      if (!rows.length) { table.innerHTML = `<tbody><tr><td>${escapeHtml('مفيش نشاط في الفترة دي.')}</td></tr></tbody>`; return; }

      const column = PERF_STAFF_COLUMNS.find((item) => item.key === perfStaffSort.key) || PERF_STAFF_COLUMNS[1];
      const direction = perfStaffSort.dir === 'asc' ? 1 : -1;
      const sorted = [...rows].sort((a, b) => {
        const left = column.value(a);
        const right = column.value(b);
        if (typeof left === 'string') return left.localeCompare(right, 'ar') * direction;
        return (left - right) * direction;
      });

      const head = PERF_STAFF_COLUMNS.map((item) =>
        `<th class="perf-sortable${perfStaffSort.key === item.key ? ' perf-sorted' : ''}" data-perf-sort="${item.key}">
          ${escapeHtml(item.label)}${perfStaffSort.key === item.key ? (perfStaffSort.dir === 'asc' ? ' ▲' : ' ▼') : ''}</th>`).join('');
      const body = sorted.map((row) =>
        `<tr>${PERF_STAFF_COLUMNS.map((item) => `<td>${item.cell(row)}</td>`).join('')}</tr>`).join('');
      table.innerHTML = `<thead><tr>${head}</tr></thead><tbody>${body}</tbody>`;

      table.querySelectorAll('[data-perf-sort]').forEach((cell) => {
        cell.addEventListener('click', () => {
          const key = cell.dataset.perfSort;
          const target = PERF_STAFF_COLUMNS.find((item) => item.key === key);
          if (perfStaffSort.key === key) perfStaffSort.dir = perfStaffSort.dir === 'asc' ? 'desc' : 'asc';
          else perfStaffSort = { key, dir: target && target.asc ? 'asc' : 'desc' };
          renderPerfStaff(perfStaffData);
        });
      });

      document.getElementById('perf-staff-volume').innerHTML = perfBarChart({
        items: sorted.flatMap((row) => [
          ...(row.chat.replies_sent ? [{ label: `${row.name} · ردود`, value: row.chat.replies_sent, color: PERF_PALETTE[0] }] : []),
          ...(row.calls.total ? [{ label: `${row.name} · مكالمات`, value: row.calls.total, color: PERF_PALETTE[2] }] : []),
        ]),
        emptyText: 'مفيش شغل مسجّل في الفترة دي.',
      });

      document.getElementById('perf-staff-speed').innerHTML = perfBarChart({
        items: sorted.filter((row) => row.chat.median_seconds !== null)
          .sort((a, b) => a.chat.median_seconds - b.chat.median_seconds)
          .map((row) => ({
            label: `${row.name} (${perfNum(row.chat.responses_measured)} رد)`,
            value: row.chat.median_seconds,
            color: row.chat.median_seconds <= 900 ? PERF_PALETTE[1] : row.chat.median_seconds <= 3600 ? PERF_PALETTE[2] : PERF_PALETTE[3],
          })),
        formatValue: perfDur,
        emptyText: 'مفيش ردود مقيسة في الفترة دي.',
      });
    }

    function perfFillEmployeeSelect(staff) {
      const select = document.getElementById('perf-employee');
      const previous = select.value;
      select.innerHTML = '<option value="">اختار موظف...</option>' + staff
        .map((row) => `<option value="${row.id}">${escapeHtml(row.name)}${row.is_active ? '' : ' (متوقف)'}</option>`).join('');
      if (previous && select.querySelector(`option[value="${previous}"]`)) select.value = previous;
      document.getElementById('perf-print-report').disabled = !select.value;
    }

    // ---------- تقرير موظف واحد ----------
    async function loadPerfMember(userId) {
      const wrap = document.getElementById('perf-member-report');
      wrap.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api(`/api/performance/staff/${userId}?` + perfQueryString());
        const summaryRow = (perfStaffData?.staff || []).find((row) => Number(row.id) === Number(userId)) || null;
        wrap.innerHTML = renderPerfMemberReport(data, summaryRow);
      } catch (error) {
        wrap.innerHTML = perfEmpty(error.message);
      }
    }

    function renderPerfMemberReport(data, summaryRow) {
      const chat = summaryRow ? summaryRow.chat : null;
      const calls = summaryRow ? summaryRow.calls : null;
      const response = data.response;
      const labels = data.timeseries.map((row) => row.day);

      const kpis = [
        perfKpi('ردود الشات', perfNum(chat ? chat.replies_sent : 0),
          chat ? `${perfNum(chat.conversations_touched)} محادثة · ${perfNum(chat.active_days)} يوم نشاط` : ''),
        perfKpi('وسيط سرعة الرد', perfDur(response.median_seconds),
          `${perfNum(response.count)} موجة مقيسة · ٩٠% خلال ${perfDur(response.p90_seconds)}`,
          response.median_seconds !== null && response.median_seconds <= 900 ? 'good' : 'warn'),
        perfKpi('مستنية رد دلوقتي', perfNum(chat ? chat.awaiting_tickets : 0),
          chat && chat.oldest_waiting_seconds ? `أطول انتظار ${perfDur(chat.oldest_waiting_seconds)}` : 'مفيش تأخير',
          chat && chat.awaiting_tickets ? 'warn' : 'good'),
        perfKpi('المكالمات', perfNum(calls ? calls.total : 0),
          calls ? `${perfNum(calls.reached)} وصلنا لهم · ${calls.reach_rate === null ? '—' : calls.reach_rate + '%'}` : ''),
        perfKpi('طلاب المتابعة',
          calls && calls.students_assigned ? `${perfNum(calls.students_done)}/${perfNum(calls.students_assigned)}` : '—',
          !calls || !calls.students_assigned ? 'مش مسند له طلاب متابعة'
            : calls.students_pending ? `${perfNum(calls.students_pending)} لسه ما اتكلمناش معاهم` : 'كلهم اتغطّوا',
          !calls || !calls.students_assigned ? null : calls.students_pending ? 'warn' : 'good'),
        perfKpi('تحرّك الأفكار', perfNum(summaryRow ? summaryRow.ideas.moves : 0),
          summaryRow ? `${perfNum(summaryRow.ideas.students)} طالب اتنقل لفكرة جديدة` : ''),
      ].join('');

      const waiting = data.longest_waiting.length
        ? `<div class="card"><h2>أطول محادثات مستنية رد عنده دلوقتي</h2>
            <table><thead><tr><th>الطالب</th><th>مستنية من</th></tr></thead><tbody>${
              data.longest_waiting.map((row) =>
                `<tr><td>${escapeHtml(row.student_name || '—')}</td><td>${perfDur(row.waiting_seconds)}</td></tr>`).join('')
            }</tbody></table></div>`
        : '';

      return `
        <div class="perf-print-header">
          <h2>تقرير أداء — ${escapeHtml(data.user.name)}</h2>
          <p>${escapeHtml(data.range.from)} → ${escapeHtml(data.range.to)} (${data.range.days} يوم)
             · ${escapeHtml(perfScopeLabel(perfSummaryData ? perfSummaryData.scope : null))}
             · اتولّد في ${escapeHtml(fmtDate(new Date().toISOString()))}</p>
        </div>
        <div class="perf-kpi-grid">${kpis}</div>
        <div class="card"><h2>الحركة اليومية</h2>
          ${perfLineChart({
            labels,
            series: [
              { name: 'ردود', color: PERF_PALETTE[0], values: data.timeseries.map((row) => row.replies) },
              { name: 'مكالمات', color: PERF_PALETTE[2], values: data.timeseries.map((row) => row.calls) },
              { name: 'مكالمات وصلنا فيها', color: PERF_PALETTE[1], values: data.timeseries.map((row) => row.calls_reached) },
              { name: 'تحرّك أفكار', color: PERF_PALETTE[4], values: data.timeseries.map((row) => row.idea_moves) },
            ],
          })}
        </div>
        <div class="perf-two-col">
          <div class="card"><h2>توزيع سرعة الرد</h2>
            ${perfBarChart({
              items: response.buckets.map((bucket, index) => ({
                label: bucket.label, value: bucket.count,
                color: index <= 1 ? PERF_PALETTE[1] : index <= 3 ? PERF_PALETTE[2] : PERF_PALETTE[3],
              })),
              emptyText: 'مفيش ردود مقيسة في الفترة دي.',
              showPercentOf: response.count,
            })}
          </div>
          <div class="card"><h2>نتايج مكالماته</h2>
            ${perfDonut({ items: data.call_outcomes.map((row) => ({ label: row.name, value: row.count })), centerLabel: 'مكالمة' })}
          </div>
        </div>
        <div class="perf-two-col">
          <div class="card"><h2>الأفكار اللي حرّكها</h2>
            ${perfBarChart({
              items: data.idea_moves.map((row) => ({ label: `فكرة ${row.idea_number}`, value: row.moves })),
              emptyText: 'ماحرّكش أفكار في الفترة دي.',
            })}
          </div>
          <div class="card"><h2>المحادثات المسندة له دلوقتي</h2>
            ${perfBarChart({
              items: data.subtitle_mix.map((row) => ({ label: row.name, value: row.count })),
              emptyText: 'مفيش محادثات مسندة له.',
            })}
          </div>
        </div>
        ${waiting}`;
    }

    // ---------- التهيئة ----------
    async function initPerformance() {
      if (!perfInitialised) {
        perfInitialised = true;
        perfSetRange(30);
        registerFilterGroup('performance', ['perf-from', 'perf-to', 'perf-employee', 'perf-bootcamp-filter']);

        document.getElementById('perf-refresh').addEventListener('click', loadPerformance);
        document.getElementById('perf-from').addEventListener('change', loadPerformance);
        document.getElementById('perf-to').addEventListener('change', loadPerformance);
        // فلتر الأبواب بياخد نفس خيارات باقي الشاشات. بيفضل فاضي افتراضيًا (كل الأبواب) — الافتراضي
        // بتاع شاشة الطلاب (الباب الأول + المنهج كاملا) مايتطبقش هنا عشان اللوحة تبدأ بالصورة الكاملة
        try {
          await loadTafraStudentFilters();
        } catch (error) {
          // بتوقع مثلاً لو قايمة الموظفين فشلت. الخيارات نفسها بتتخزن في tafraFilterOptions أول ما
          // الطلب يرجّع، قبل أي حاجة ممكن تقع — فالقايمة بتتعمل برة الـ try عشان متضيعش معاها
          console.warn('تعذر تحميل خيارات فلاتر الطلاب بالكامل:', error.message);
        }
        createMultiSelectFilter('perf-bootcamp-filter', 'كل الأبواب')
          ?.setOptions((tafraFilterOptions?.bootcamps || []).map((item) => ({ value: item.id, label: item.name })));
        document.getElementById('perf-bootcamp-filter').addEventListener('change', loadPerformance);
        document.getElementById('perf-quick-ranges').addEventListener('click', (event) => {
          const button = event.target.closest('[data-perf-days]');
          if (!button) return;
          perfSetRange(Number(button.dataset.perfDays));
          loadPerformance();
        });
        document.getElementById('perf-subtabs').addEventListener('click', (event) => {
          const button = event.target.closest('[data-perf-tab]');
          if (!button) return;
          document.querySelectorAll('#perf-subtabs .subtab-btn').forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          document.querySelectorAll('#tab-performance .perf-section').forEach((section) => {
            section.style.display = section.dataset.perfTab === button.dataset.perfTab ? '' : 'none';
          });
        });
        document.getElementById('perf-employee').addEventListener('change', (event) => {
          document.getElementById('perf-print-report').disabled = !event.target.value;
          if (event.target.value) loadPerfMember(event.target.value);
          else document.getElementById('perf-member-report').innerHTML = perfEmpty('اختار موظف من القايمة عشان تشوف تقريره.');
        });
        // الطباعة بتشتغل على الصفحة نفسها: كلاس على body بيخلّي ستايل الطباعة يسيب تقرير
        // الموظف بس ويخفي اللوحة كلها. أرخص وأسرع من توليد PDF على السيرفر
        document.getElementById('perf-print-report').addEventListener('click', () => {
          document.body.classList.add('printing-report');
          window.addEventListener('afterprint', () => document.body.classList.remove('printing-report'), { once: true });
          window.print();
        });
      }
      await loadPerformance();
    }

    // ---------- رابط تقرير الطالب ----------
    // التقرير صفحة عامة، فالنافذة دي مقصود إنها تخلي ده واضح للموظف: بتقول مين ممكن يفتحها
    // وإيه اللي فيها، وبتدي طريقة واحدة واضحة لقفل رابط اتشارك بالغلط (تجديد أو إلغاء)
    let currentReportStudentId = null;

    function bindStudentReportButtons(scope) {
      if (!scope) return;
      scope.querySelectorAll('[data-report-student]').forEach((button) => {
        if (button.dataset.reportBound === '1') return;
        button.dataset.reportBound = '1';
        button.addEventListener('click', () =>
          openStudentReportDialog(button.dataset.reportStudent, button.dataset.reportName));
      });
    }

    function openStudentReportDialog(studentId, studentName) {
      currentReportStudentId = Number(studentId);
      document.getElementById('student-report-name').textContent = studentName || '';
      document.getElementById('student-report-overlay').style.display = 'flex';
      loadStudentReportLink();
    }

    function closeStudentReportDialog() {
      document.getElementById('student-report-overlay').style.display = 'none';
      currentReportStudentId = null;
    }

    async function loadStudentReportLink() {
      const body = document.getElementById('student-report-body');
      body.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api('/api/student-report/' + currentReportStudentId);
        body.innerHTML = renderStudentReportLink(data);
        bindStudentReportLinkActions();
      } catch (error) {
        body.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function renderStudentReportLink(data) {
      const notice = `<p class="report-link-notice">الصفحة دي بتتفتح من غير تسجيل دخول لأي حد معاه الرابط.
        فيها الدرجات ومشاهدات الفيديوهات والمكالمات وتفاعله مع الرسايل — من غير ملاحظات المكالمات
        ولا نص المحادثات ولا أي بيانات عن الموظفين.</p>`;
      if (!data.url) {
        return notice + '<button type="button" class="btn btn-primary" id="create-report-link-btn">إنشاء رابط للمشاركة</button>';
      }
      return notice
        + `<div class="report-link-box">
             <input type="text" id="report-link-input" readonly value="${escapeHtml(data.url)}">
             <button type="button" class="btn btn-primary btn-sm" id="copy-report-link-btn" style="width:auto">📋 نسخ</button>
           </div>
           ${data.created_at ? `<div class="report-link-meta">الرابط ده اتعمل في ${fmtDate(data.created_at)}</div>` : ''}
           <div class="report-link-actions">
             <a class="btn btn-ghost btn-sm" style="width:auto" href="${escapeHtml(data.url)}" target="_blank" rel="noopener">فتح الصفحة</a>
             <button type="button" class="btn btn-ghost btn-sm" style="width:auto" id="regenerate-report-link-btn"
               title="بيعمل رابط جديد ويوقّف القديم فورًا">🔄 تجديد الرابط</button>
             <button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" id="revoke-report-link-btn"
               title="بيلغي الرابط تمامًا — الصفحة تبقى مش موجودة">🚫 إلغاء</button>
           </div>`;
    }

    function bindStudentReportLinkActions() {
      document.getElementById('create-report-link-btn')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        button.disabled = true;
        try {
          await api('/api/student-report/' + currentReportStudentId, { method: 'POST', body: JSON.stringify({}) });
          showToast('اتعمل رابط للتقرير');
          loadStudentReportLink();
        } catch (error) { showToast(error.message); }
      });
      document.getElementById('copy-report-link-btn')?.addEventListener('click', (event) => {
        const button = event.currentTarget;
        const input = document.getElementById('report-link-input');
        navigator.clipboard.writeText(input.value)
          .then(() => { button.textContent = '✅ اتنسخ'; setTimeout(() => { button.textContent = '📋 نسخ'; }, 1500); })
          .catch(() => { input.select(); showToast('المتصفح رفض النسخ — الرابط محدد، انسخه بإيدك'); });
      });
      document.getElementById('regenerate-report-link-btn')?.addEventListener('click', async () => {
        if (!confirm('الرابط القديم هيبطّل يشتغل فورًا، وأي حد معاه مش هيقدر يفتحه تاني. تأكيد؟')) return;
        try {
          await api('/api/student-report/' + currentReportStudentId, { method: 'POST', body: JSON.stringify({ regenerate: true }) });
          showToast('اتعمل رابط جديد والقديم اتوقف');
          loadStudentReportLink();
        } catch (error) { showToast(error.message); }
      });
      document.getElementById('revoke-report-link-btn')?.addEventListener('click', async () => {
        if (!confirm('هيتلغي الرابط تمامًا والصفحة تبقى مش موجودة لأي حد. تأكيد؟')) return;
        try {
          await api('/api/student-report/' + currentReportStudentId, { method: 'DELETE' });
          showToast('اتلغى رابط التقرير');
          loadStudentReportLink();
        } catch (error) { showToast(error.message); }
      });
    }

    document.getElementById('close-student-report-btn').addEventListener('click', closeStudentReportDialog);
    document.getElementById('student-report-overlay').addEventListener('click', (event) => {
      if (event.target.id === 'student-report-overlay') closeStudentReportDialog();
    });

    // ---------- التنقل بين التابات ----------
    const navItems = document.querySelectorAll('.nav-item');
    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navItems.forEach((i) => i.classList.remove('active'));
        item.classList.add('active');
        document.querySelectorAll('.tab-panel').forEach((p) => (p.style.display = 'none'));
        document.getElementById('tab-' + item.dataset.tab).style.display = 'block';
        loadTabData(item.dataset.tab);
      });
    });

    function loadTabData(tab) {
      if (tab === 'overview') loadStats();
      if (tab === 'tickets') initTickets();
      if (tab === 'calls') initCalls();
      if (tab === 'contacts') initContactsAndBroadcasts();
      if (tab === 'tafra-students') initTafraStudents();
      if (tab === 'new-bot') initNewBotTab();
      if (tab === 'reports') initReports();
      if (tab === 'performance') initPerformance();
      if (tab === 'templates') loadTemplates();
      if (tab === 'quizzes') initQuizzes();
      if (tab === 'settings') { loadSettings(); initAssistPanel(); }
      if (tab === 'ai') { loadSettings(); initAssistPanel(); initAiTab(); }
    }

    // ---------- طلاب منصة طفرة ----------
    // صفحتي "طلاب المنصة" و"التقارير" بيستخدموا نفس خيارات الفلاتر — بنعبّي الاتنين مرة واحدة
    // تعبئة قوايم الفلاتر لشاشة واحدة — منفصلة عن التحميل عشان شاشة بتتفتح بعد ما الخيارات
    // اتحمّلت خلاص تقدر تتعبّى لوحدها من tafraFilterOptions من غير طلب جديد
    function applyStudentFilterOptions(prefix, filters) {
      const levelInput = document.getElementById(`${prefix}-level-filter`);
      if (!filters || !levelInput) return;
      const statusNames = { active: 'نشط', inactive: 'غير نشط', suspended: 'موقوف' };
      createMultiSelectFilter(`${prefix}-level-filter`, 'الصف الدراسي')
        .setOptions(filters.levels.map((value) => ({ value, label: value })));
      createMultiSelectFilter(`${prefix}-status-filter`, 'الحالة')
        .setOptions(filters.statuses.map((value) => ({ value, label: statusNames[value] || value })));
      createMultiSelectFilter(`${prefix}-bootcamp-filter`, 'الباب/الكورس')
        .setOptions(filters.bootcamps.map((item) => ({ value: item.id, label: item.name })));
      createMultiSelectFilter(`${prefix}-exam-filter`, 'الاختبار')
        .setOptions(filters.exams.map((item) => ({ value: item.id, label: item.name })));
      // صندوق الدعم فلتر الأفكار بتاعه اسمه ticket- مش tickets-، وبيتعبّى في initTickets
      const ideaSelect = document.getElementById(`${prefix}-idea-filter`);
      if (!ideaSelect) return;
      const maxIdea = filters.max_idea_number || 20;
      const previousIdeaValue = ideaSelect.value;
      ideaSelect.innerHTML = '<option value="">كل الأفكار</option><option value="0">لم يُحدَّد بعد</option>' +
        Array.from({ length: maxIdea }, (_, i) => i + 1)
          .map((n) => `<option value="${n}">فكرة ${n}</option>`).join('');
      ideaSelect.value = previousIdeaValue;
    }

    async function loadTafraStudentFilters() {
      if (tafraFiltersLoaded) return;
      const filters = await api('/api/tafra/student-filters');
      tafraFilterOptions = filters;

      ['tafra', 'report', 'calls', 'tickets'].forEach((prefix) => applyStudentFilterOptions(prefix, filters));

      // فلتر الباب لتاب "بوت طفرة" (مشتركين بوت طفرة) مستقل عن اللوب فوق (التاب ده معندوش صف دراسي/حالة/اختبار،
      // بس محتاج فلتر الباب بنفس الافتراضي)
      createMultiSelectFilter('newbot-sub-bootcamp-filter', 'الباب/الكورس')
        .setOptions(filters.bootcamps.map((item) => ({ value: item.id, label: item.name })));
      // فلتر الاستبعاد بياخد نفس قايمة الأبواب — بيشيل المشتركين فيها بدل ما يقصر عليهم
      createMultiSelectFilter('newbot-sub-exclude-bootcamp-filter', 'استبعاد المشتركين في...')
        ?.setOptions(filters.bootcamps.map((item) => ({ value: item.id, label: item.name })));

      // افتراضيًا نفعّل فلتر البابين الأكتر استخدامًا (الباب الأول الانتقالية + المنهج كاملا) مع بعض
      // عشان محتاجش تختارهم يدويًا كل مرة — بيتطبّق بس أول ما الصفحة تتحمّل (لو الفلتر لسه فاضي)،
      // ولو غيّرته بنفسك في نفس الجلسة بيفضل زي ما اخترت. لازم يتطبّق على كل التابات ('report' بيتزامن
      // تلقائيًا من 'tafra' برضه، لكن 'calls' و'newbot-sub' فلترهم مستقل فمحتاج يتحدد صراحةً هنا كمان)
      const defaultBootcampIds = filters.bootcamps
        .filter((item) => (item.name.includes('الباب الأول') && item.name.includes('العناصر الانتقالية'))
          || (item.name.includes('المنهج') && item.name.includes('كامل')))
        .map((item) => String(item.id));
      if (defaultBootcampIds.length) {
        ['tafra', 'report', 'calls', 'newbot-sub'].forEach((prefix) => {
          const input = document.getElementById(`${prefix}-bootcamp-filter`);
          if (input && !input.value) {
            input.value = defaultBootcampIds.join(',');
            input.dispatchEvent(new Event('change'));
          }
        });
      }

      // فلتر الموظف المسؤول موجود في صفحة طلاب المنصة بس (أدمن فقط)، وبياخد أسماء الموظفين من meta
      // بتاعة صندوق الدعم — عشان كده بنتأكد إنه موجود فعلاً قبل ما نطلبها، لأن شاشة المتابعة
      // التليفونية بتنادي الدالة دي كمان لموظفين ممكن ما يكونش عندهم صلاحية الصندوق أصلًا
      const assigneeFilter = document.getElementById('tafra-assignee-filter');
      if (assigneeFilter && currentUserRole === 'admin') {
        await ensureTicketsMeta();
        const previousAssignee = assigneeFilter.value;
        assigneeFilter.innerHTML = '<option value="">كل الموظفين</option><option value="unassigned">غير مسند</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
        assigneeFilter.value = previousAssignee;
      }

      renderTafraEnrollmentSync(filters.enrollment_sync);
      // بيتنادى بعد ما القوايم والافتراضيات تتظبط، فالمحفوظ بتاع المستخدم بيغلب الافتراضي
      registerFilterGroup('tafra', ['tafra-student-search','tafra-level-filter','tafra-education-type-filter','tafra-gender-filter','tafra-telegram-filter','tafra-conversation-filter','tafra-assignee-filter','tafra-status-filter','tafra-bootcamp-filter','tafra-exam-filter','tafra-exam-attendance-filter','tafra-exam-mark-range-filter','tafra-idea-filter','tafra-enrolled-from','tafra-enrolled-to','tafra-welcome-status-filter','tafra-last-sent-from','tafra-last-sent-to','tafra-last-received-from','tafra-last-received-to','tafra-silent-week','tafra-silent-calls-week','tafra-exclude-sent-today']);
      registerFilterGroup('report', ['report-student-search','report-level-filter','report-education-type-filter','report-gender-filter','report-telegram-filter','report-conversation-filter','report-status-filter','report-bootcamp-filter','report-exam-filter','report-exam-attendance-filter','report-exam-mark-range-filter','report-idea-filter']);
      tafraFiltersLoaded = true;
    }

    function renderTafraEnrollmentSync(sync) {
      const status = document.getElementById('tafra-enrollment-sync-status');
      const button = document.getElementById('sync-tafra-enrollments');
      button.disabled = sync?.status === 'running';
      if (sync?.status === 'running') {
        status.textContent = `جارٍ تحديث الاشتراكات: الباب ${sync.current_bootcamp || 0} من ${sync.total_bootcamps || '...'} — ${sync.synced_enrollments || 0} سجل`;
      } else if (sync?.status === 'completed') {
        status.textContent = `آخر تحديث للاشتراكات: ${fmtDate(sync.completed_at)} — ${sync.synced_enrollments || 0} سجل`;
      } else if (sync?.status === 'failed') {
        status.textContent = `توقف آخر تحديث للاشتراكات: ${sync.error_message || 'تعذر الاتصال بالمنصة'}`;
      } else {
        status.textContent = 'يلزم تحديث اشتراكات الأبواب مرة واحدة لتشغيل الفلتر.';
      }
    }

    function tafraStudentQuery() {
      const params = new URLSearchParams({ page: tafraStudentsPage, limit: 50 });
      if (tafraSort.key) { params.set('sort', tafraSort.key); params.set('order', tafraSort.dir); }
      return studentFilterParams('tafra', params).toString();
    }

    // جدول الطلاب مستخدم في تابين: طلاب المنصة (بتحديد للمراسلة) والتقارير (معاينة بس من غير تحديد)
    function canMessageStudent(student) {
      return Boolean(student.contact_id && student.can_message);
    }

    // تاريخ/تواريخ اشتراك الطالب في الأبواب المحددة بالفلتر بالظبط — بيترتب حسب أقدم اشتراك من ضمنهم
    function enrollmentDatesCellHtml(student) {
      const dates = Array.isArray(student.enrollment_dates) ? student.enrollment_dates : [];
      if (!dates.length) return { html: '<span class="badge badge-muted">—</span>', sortValue: '' };
      const sorted = [...dates].sort((a, b) => new Date(a.enrolled_at || 0) - new Date(b.enrolled_at || 0));
      const html = sorted.map((entry) =>
        `<div class="tafra-student-sub">${escapeHtml(entry.bootcamp_name)}: ${entry.enrolled_at ? fmtDay(entry.enrolled_at) : 'بدون تاريخ'}</div>`
      ).join('');
      const earliest = sorted.find((entry) => entry.enrolled_at);
      return { html, sortValue: earliest ? new Date(earliest.enrolled_at).getTime() : '' };
    }

    function sortThAttrs(key, sort) {
      return sort?.key === key
        ? ` data-sort-dir="${sort.dir}" class="sortable-th ${sort.dir === 'asc' ? 'sort-asc' : 'sort-desc'}"`
        : '';
    }

    function messageDateCellHtml(value) {
      if (!value) return { html: '<span class="badge badge-muted">—</span>', sortValue: '' };
      return { html: fmtDate(value), sortValue: new Date(value).getTime() };
    }

    // زرار فتح الشات التفصيلي للطالب في صندوق الدعم — بيظهر في كل صف من نتائج البحث/الفلترة.
    // الطالب اللي لسه مالوش تذكرة (عمره ما كلّم البوت) مالوش شات يتفتح، فبنوضّح السبب بدل زرار ميّت
    function openChatButtonHtml(student) {
      if (student.ticket_id) {
        return `<button type="button" class="btn btn-ghost btn-sm open-student-chat-btn" data-ticket-id="${student.ticket_id}"
          title="فتح محادثة الطالب في صندوق الدعم">💬 فتح الشات</button>`;
      }
      return '<span class="tafra-student-sub" title="الطالب ده لسه مفيش له محادثة في صندوق الدعم">💬 لا يوجد شات</span>';
    }

    // بيربط زراير "فتح الشات" بعد ما الجدول يترسم — بينقل لتاب صندوق الدعم ويفتح التذكرة على طول
    function bindOpenStudentChatButtons(container) {
      container.querySelectorAll('.open-student-chat-btn').forEach((button) => {
        button.addEventListener('click', () => {
          pendingDeepLinkTicketId = Number(button.dataset.ticketId);
          document.querySelector('.nav-item[data-tab="tickets"]')?.click();
        });
      });
    }

    function buildStudentsTableHtml(students, { showExamMark, showCheckbox, showEnrollmentDates, sort, showReport }) {
      const headerCells = (showCheckbox ? '<th class="select-cell"><input type="checkbox" id="select-all-tafra-students" aria-label="تحديد الكل"></th>' : '')
        + `<th>الطالب</th><th>الباب</th><th>الهاتف</th><th>هاتف ولي الأمر</th><th>الصف</th><th>التعليم</th><th>الحالة</th><th>الفكرة الحالية</th>${showExamMark ? '<th>درجة الاختبار</th>' : ''}${showEnrollmentDates ? `<th data-sort-key="enrollment"${sortThAttrs('enrollment', sort)}>تاريخ الاشتراك</th>` : ''}<th data-sort-key="last_sent"${sortThAttrs('last_sent', sort)}>آخر إرسال</th><th data-sort-key="last_received"${sortThAttrs('last_received', sort)}>آخر استقبال</th><th>تيليجرام</th>`;
      const rows = students.map((student) => `<tr>
        ${showCheckbox ? `<td class="select-cell">${canMessageStudent(student)
          ? `<input type="checkbox" class="contact-selector" value="${student.contact_id}" ${selectedContactIds.has(Number(student.contact_id)) ? 'checked' : ''} aria-label="تحديد الطالب">`
          : ''}</td>` : ''}
        <td>
          <div class="tafra-student-name">${escapeHtml(student.name || 'بدون اسم')}</div>
          <div class="tafra-student-sub">رقم الطالب: ${escapeHtml(student.tafra_student_id)} — الكود: ${escapeHtml(student.student_code || '—')}</div>
          ${openChatButtonHtml(student)}
          ${showReport ? `<a class="btn btn-ghost btn-sm student-report-btn" target="_blank" rel="noopener"
            href="/student-report/${student.tafra_student_id}" title="افتح تقرير الطالب">📄 تقرير</a>
          <button type="button" class="btn btn-ghost btn-sm student-report-btn"
            data-report-student="${student.tafra_student_id}"
            data-report-name="${escapeHtml(student.name || 'الطالب')}" title="رابط للمشاركة">🔗</button>` : ''}
        </td>
        <td>${bootcampMarksHtml(student, 'sm') || '<span class="badge badge-muted">—</span>'}</td>
        <td>${escapeHtml(student.phone || '—')}</td>
        <td>${escapeHtml(student.parent_phone || '—')}</td>
        <td>${escapeHtml(student.educational_level || 'غير محدد')}</td>
        <td>${student.education_type === 'azhar' ? '<span class="badge badge-warning">أزهري</span>' : '<span class="badge badge-muted">عام</span>'}</td>
        <td>${student.status === 'active' ? '<span class="badge badge-success">نشط</span>' : `<span class="badge badge-muted">${escapeHtml(student.status || 'غير محدد')}</span>`}</td>
        <td>${student.current_idea_number ? `<span class="idea-badge">💡 فكرة ${student.current_idea_number}</span>` : '<span class="badge badge-muted">—</span>'}</td>
        ${showExamMark ? `<td>${student.exam_mark !== null && student.exam_mark !== undefined
          ? `<span class="badge badge-success">${escapeHtml(student.exam_mark)}${student.exam_percentage !== null && student.exam_percentage !== undefined ? ` (${escapeHtml(student.exam_percentage)}%)` : ''}</span>`
          : '<span class="badge badge-muted">لم يدخل</span>'}</td>` : ''}
        ${showEnrollmentDates ? (({ html, sortValue }) => `<td data-sort-value="${sortValue}">${html}</td>`)(enrollmentDatesCellHtml(student)) : ''}
        ${(({ html, sortValue }) => `<td data-sort-value="${sortValue}">${html}</td>`)(messageDateCellHtml(student.last_sent_at))}
        ${(({ html, sortValue }) => `<td data-sort-value="${sortValue}">${html}</td>`)(messageDateCellHtml(student.last_received_at))}
        <td>${canMessageStudent(student)
          ? `<span class="badge badge-success">مرتبط</span><div class="tafra-student-sub">${escapeHtml(student.telegram_username ? '@' + student.telegram_username : student.telegram_chat_id)}</div>`
          : student.telegram_chat_id
            ? `<span class="badge badge-warning" title="ربط حسابه على منصة طفرة بس لسه ما بدأش محادثة مع البوت">لم يبدأ محادثة</span>`
            : '<span class="badge badge-muted">غير مرتبط</span>'}</td>
      </tr>`).join('');
      return `<div class="tafra-students-table-wrap"><table><thead><tr>${headerCells}</tr></thead><tbody>${rows}</tbody></table></div>`;
    }

    async function loadTafraStudents() {
      const wrap = document.getElementById('tafra-students-table');
      wrap.innerHTML = '<div class="empty-state">جارٍ تحميل الطلاب...</div>';
      try {
        const result = await api('/api/tafra/students?' + tafraStudentQuery());
        tafraStudentsPages = result.meta.pages;
        document.getElementById('tafra-student-count').textContent = `الطلاب: ${result.meta.total}`;
        document.getElementById('tafra-student-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('tafra-students-prev').disabled = result.meta.page <= 1;
        document.getElementById('tafra-students-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.students.length) {
          wrap.innerHTML = '<div class="empty-state">لا يوجد طلاب مطابقون للفلاتر</div>';
          return;
        }
        // عمود الدرجة بيظهر بس لو اختبار واحد محدد — لو أكتر من اختبار، القيمة تبقى غامضة فمش بنعرضها
        const showExamMark = document.getElementById('tafra-exam-filter').value.split(',').filter(Boolean).length === 1;
        const showEnrollmentDates = document.getElementById('tafra-bootcamp-filter').value.split(',').filter(Boolean).length > 0;
        // مراسلة الطالب محتاجة إنه يكون بدأ محادثة مع البوت فعلًا — تيليجرام مايسمحش نبعتله غير كده،
        // حتى لو ربط حسابه على منصة طفرة نفسها
        currentFilteredTafraStudentContactIds = result.students.filter(canMessageStudent).map((s) => Number(s.contact_id));
        wrap.innerHTML = buildStudentsTableHtml(result.students, { showExamMark, showCheckbox: true, showEnrollmentDates, sort: tafraSort, showReport: true });
        bindOpenStudentChatButtons(wrap);
        bindStudentReportButtons(wrap);
        enableTableSort(wrap, {
          onSort: async (key, dir) => {
            tafraSort = { key, dir };
            tafraStudentsPage = 1;
            await loadTafraStudents();
          },
        });
        wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
            updateSelectedContactsUi();
          });
        });
        document.getElementById('select-all-tafra-students').addEventListener('change', (event) => {
          wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
          });
          updateSelectedContactsUi();
        });
        updateSelectedContactsUi();
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function initTafraStudents() {
      try {
        await loadTafraStudentFilters();
        bindStudentFilterEvents('tafra', () => { tafraStudentsPage = 1; loadTafraStudents(); });
        await loadTafraStudents();
      } catch (error) { showToast(error.message); }
    }

    // ---------- المتابعة التليفونية ----------
    const CALLS_FILTER_FIELDS = {
      search: 'calls-search', level: 'calls-level-filter', education_type: 'calls-education-type-filter',
      gender: 'calls-gender-filter',
      telegram: 'calls-telegram-filter', conversation_status: 'calls-conversation-filter',
      status: 'calls-status-filter', bootcamp: 'calls-bootcamp-filter',
      exam: 'calls-exam-filter', idea_number: 'calls-idea-filter',
      enrolled_from: 'calls-enrolled-from', enrolled_to: 'calls-enrolled-to',
      call_outcome: 'calls-outcome-filter', unreached_streak: 'calls-unreached-filter',
    };

    function callsQuery() {
      const params = new URLSearchParams({ page: callsPage, limit: 50 });
      return studentFilterParams('calls', params).toString();
    }

    function clearCallsFilters() {
      filterGroups.calls?.reset();
      resetStudentFilters('calls');
      callsPage = 1;
      loadCalls();
    }

    function callOutcomeBadge(name) {
      return name
        ? `<span class="badge badge-success">${escapeHtml(name)}</span>`
        : '<span class="badge badge-muted">لسه ما تمّش الاتصال</span>';
    }

    // بيسجّل إن الموظف ضغط زرار الـ SMS. مش بننتظر الرد (await) عن قصد — الضغطة نفسها بتفتح
    // تطبيق الرسائل، ولو استنينا كان ممكن يتأخر الفتح. الرابط مالوش دعوة بنتيجة التسجيل
    function recordSmsSend(studentId) {
      api('/api/calls/student/' + studentId + '/sms-log', { method: 'POST' })
        .then(() => {
          // لو البروفايل مفتوح لنفس الطالب بنحدّثه عشان السجل يبان فورًا
          if (Number(currentCallStudentId) === Number(studentId)) openCallProfile(studentId);
          else loadCalls();
        })
        .catch((error) => showToast('اتفتح تطبيق الرسائل بس التسجيل فشل: ' + error.message));
    }

    function buildCallsListHtml(students) {
      if (!students.length) return '<div class="empty-state">لا يوجد طلاب مطابقون</div>';
      const showCheckbox = currentUserRole === 'admin' || canAssignCalls;
      return students.map((student) => {
        const id = Number(student.tafra_student_id);
        const followUpDue = student.next_follow_up_at && new Date(student.next_follow_up_at) <= new Date();
        return `
          <div class="ticket-list-item ${id === Number(currentCallStudentId) ? 'active' : ''} ${student.silent_week ? 'silent-week' : ''}" data-student-id="${id}">
            <div class="ticket-list-title">
              <span class="ticket-name-with-subtitle">
                ${showCheckbox ? `<input type="checkbox" class="call-student-selector" value="${id}" ${selectedCallStudentIds.has(id) ? 'checked' : ''} aria-label="تحديد الطالب">` : ''}
                <span>${escapeHtml(student.name || 'بدون اسم')}</span>
                ${urgentBadge(student.is_urgent)}
                ${student.silent_week ? '<span class="silent-week-badge" title="بعتنا له بعد آخر كلام منه وعدّى أسبوع من غير أي رد — الحملات الجماعية مش محسوبة">مردش من أسبوع</span>' : ''}
                ${telegramReachBadge(student.can_message)}
                ${student.current_idea_number ? `<span class="idea-badge" title="رقم الفكرة الحالية">💡${student.current_idea_number}</span>` : ''}
                ${bootcampMarksHtml(student, 'sm')}
              </span>
              ${callOutcomeBadge(student.last_outcome_name)}
            </div>
            <div class="ticket-preview">📱 ${escapeHtml(student.phone || 'بدون رقم')}${
              student.exam_mark !== null && student.exam_mark !== undefined
                ? ` · الدرجة: ${escapeHtml(student.exam_mark)}${student.exam_percentage !== null && student.exam_percentage !== undefined ? ` (${escapeHtml(student.exam_percentage)}%)` : ''}`
                : ''
            }${
              (currentUserRole === 'admin' || canAssignCalls)
                ? ' · المسؤول: ' + (student.assigned_name ? escapeHtml(student.assigned_name) : 'غير مسند')
                : ''
            }</div>
            <div class="ticket-list-meta">
              <span>${student.last_called_at ? 'آخر مكالمة: ' + fmtDate(student.last_called_at) : 'لسه محصلش اتصال'}</span>
              <!-- الاسم data-sms-student مش data-student-id عن قصد: loadCalls بيختار
                   [data-student-id] ويربطه بفتح البروفايل، فلو استخدمناه هنا الرابط كان هياخد
                   نفس المُعالج ويفتح البروفايل بدل ما يفتح تطبيق الرسائل -->
              ${student.ticket_id ? `<button type="button" class="btn btn-ghost btn-sm open-student-chat-btn"
                  style="width:auto; padding:2px 10px" data-ticket-id="${student.ticket_id}"
                  title="فتح محادثة الطالب في صندوق الدعم">💬 الشات</button>` : ''}
              ${student.sms ? `<a class="btn btn-ghost btn-sm sms-row-btn" style="width:auto; padding:2px 10px"
                  data-sms-student="${id}"
                  href="sms:${student.sms.phone}?body=${encodeURIComponent(student.sms.body)}"
                  title="${student.last_sms_at ? 'آخر رسالة: ' + escapeHtml(fmtDate(student.last_sms_at)) : 'لسه ماتبعتلهوش رسالة'}"
                >✉️ SMS${student.sms_count ? ` (${student.sms_count})` : ''}</a>` : ''}
            </div>
            ${student.last_sms_at ? `<div class="ticket-muted" style="font-size:12px">✉️ آخر رسالة: ${fmtDate(student.last_sms_at)}</div>` : ''}
            ${student.next_follow_up_at ? `<div class="follow-up-badge ${followUpDue ? 'due' : ''}">📅 ${followUpDue ? 'حان موعد المتابعة: ' : 'المتابعة: '}${fmtDate(student.next_follow_up_at)}</div>` : ''}
          </div>`;
      }).join('');
    }

    async function loadCalls() {
      const list = document.getElementById('calls-list');
      list.innerHTML = '<div class="empty-state">جارٍ التحميل...</div>';
      try {
        const endpoint = (currentUserRole === 'admin' || canAssignCalls) ? '/api/calls/students?' : '/api/calls/my-list?';
        const data = await api(endpoint + callsQuery());
        // نفس القاعدة: الإجمالي بيتعرض لما السيرفر يبعته بس. قايمة الموظف الشخصية
        // (my-list) بترجّع الإجمالي عادي — ده عدد طلابه هو مش حجم المنصة
        const hasTotal = data.meta.total !== undefined;
        callsPages = hasTotal ? data.meta.pages : (data.meta.has_more ? data.meta.page + 1 : data.meta.page);
        document.getElementById('calls-count').textContent = hasTotal ? `الطلاب (${data.meta.total})` : 'الطلاب';
        document.getElementById('calls-page-label').textContent = hasTotal
          ? `صفحة ${data.meta.page} من ${data.meta.pages}`
          : (data.meta.page > 1 ? `صفحة ${data.meta.page}` : '');
        document.getElementById('calls-prev').disabled = data.meta.page <= 1;
        document.getElementById('calls-next').disabled = hasTotal
          ? data.meta.page >= data.meta.pages
          : !data.meta.has_more;
        list.innerHTML = buildCallsListHtml(data.students);
        list.querySelectorAll('[data-student-id]').forEach((row) => {
          row.addEventListener('click', (event) => {
            if (event.target.tagName === 'INPUT') return;
            openCallProfile(Number(row.dataset.studentId));
          });
        });
        // نفس دالة الربط المستخدمة في الشاشات التانية — بتنقل لتاب الدعم وتفتح التذكرة
        bindOpenStudentChatButtons(list);
        list.querySelectorAll('.open-student-chat-btn').forEach((btn) => {
          // من غير كده الضغطة بتطلع للصف وتفتح بروفايل المتابعة فوق الشات
          btn.addEventListener('click', (event) => event.stopPropagation());
        });
        list.querySelectorAll('.sms-row-btn').forEach((link) => {
          link.addEventListener('click', (event) => {
            // من غير كده الضغطة بتطلع للصف وتفتح بروفايل الطالب فوق تطبيق الرسائل
            event.stopPropagation();
            recordSmsSend(Number(link.dataset.smsStudent));
          });
        });
        list.querySelectorAll('.call-student-selector').forEach((checkbox) => {
          checkbox.addEventListener('click', (event) => event.stopPropagation());
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedCallStudentIds.add(id) : selectedCallStudentIds.delete(id);
            updateSelectedCallsUi();
          });
        });
        updateSelectedCallsUi();
      } catch (error) {
        list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function updateSelectedCallsUi() {
      const countEl = document.getElementById('selected-calls-count');
      if (!countEl) return;
      countEl.textContent = `المحدد: ${selectedCallStudentIds.size}`;
      document.getElementById('assign-selected-calls-btn').disabled =
        !selectedCallStudentIds.size || !document.getElementById('calls-assign-to-select').value;
      document.getElementById('unassign-selected-calls-btn').disabled = !selectedCallStudentIds.size;
      const urgentDisabled = !selectedCallStudentIds.size;
      const markBtn = document.getElementById('mark-urgent-calls-btn');
      const unmarkBtn = document.getElementById('unmark-urgent-calls-btn');
      if (markBtn) markBtn.disabled = urgentDisabled;
      if (unmarkBtn) unmarkBtn.disabled = urgentDisabled;
    }

    async function loadCallOutcomes() {
      callOutcomes = await api('/api/calls/outcomes');
    }

    // بيتنادى من initCalls بعد ما النتايج تتحمّل — منفصل عن loadCallOutcomes عشان التعبئة تحصل
    // في كل مرة الشاشة تتفتح حتى لو النتايج كانت متحمّلة قبل كده من بروفايل طالب
    function populateCallOutcomeFilter(prefix = 'calls') {
      const select = studentFilterElement(prefix, 'call_outcome');
      if (!select) return;
      const previous = select.value;
      select.innerHTML = '<option value="">كل نتائج المكالمات</option>' +
        callOutcomes.map((outcome) =>
          `<option value="${outcome.id}">${escapeHtml(outcome.name)}</option>`).join('');
      // بنرجّع اللي كان مختار (لو لسه موجود) عشان تحديث الشاشة ما يصفّرش فلتر الموظف من تحت إيده
      if (previous && select.querySelector(`option[value="${previous}"]`)) select.value = previous;
    }

    async function loadCallAssignees() {
      if (currentUserRole !== 'admin' && !canAssignCalls) return;
      callAssignees = await api('/api/calls/assignees');
      const scopeSelect = document.getElementById('calls-scope-filter');
      const assignSelect = document.getElementById('calls-assign-to-select');
      const calledBySelect = document.getElementById('calls-called-by-filter');
      const employeeOptions = callAssignees.map((user) =>
        `<option value="${user.id}">${escapeHtml(user.name)} (${user.assigned_count})</option>`).join('');
      scopeSelect.innerHTML = '<option value="">كل الطلاب</option><option value="unassigned">غير مسند</option>' + employeeOptions;
      assignSelect.innerHTML = '<option value="">إسناد المحددين لـ...</option>' +
        callAssignees.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
      calledBySelect.innerHTML = '<option value="">أي موظف اتصل</option>' +
        callAssignees.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
    }

    // نفس قايمة الموظفين بتتحط في فلاتر شاشة تانية (صندوق الدعم) — الشاشة دي معندهاش زراير
    // إسناد، ففلترين بس. لازم تتنادى بعد loadCallAssignees عشان callAssignees تكون متحمّلة
    function populateCallAssigneeFilters(prefix) {
      if (!callAssignees.length) return;
      const scopeSelect = studentFilterElement(prefix, 'assigned');
      if (scopeSelect) {
        const previous = scopeSelect.value;
        scopeSelect.innerHTML = '<option value="">كل الطلاب</option><option value="unassigned">غير مسند</option>' +
          callAssignees.map((user) => `<option value="${user.id}">${escapeHtml(user.name)} (${user.assigned_count})</option>`).join('');
        scopeSelect.value = previous;
      }
      const calledBySelect = studentFilterElement(prefix, 'called_by');
      if (calledBySelect) {
        const previous = calledBySelect.value;
        calledBySelect.innerHTML = '<option value="">أي موظف اتصل</option>' +
          callAssignees.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
        calledBySelect.value = previous;
      }
    }

    function closeMobileCallProfile() {
      document.querySelector('#tab-calls .ticket-workspace').classList.remove('ticket-open');
      document.getElementById('tab-calls').classList.remove('ticket-open-view');
      currentCallStudentId = null;
      loadCalls();
    }

    async function openCallProfile(studentId) {
      currentCallStudentId = studentId;
      document.querySelector('#tab-calls .ticket-workspace').classList.add('ticket-open');
      document.getElementById('tab-calls').classList.add('ticket-open-view');
      document.querySelectorAll('#calls-list [data-student-id]').forEach((row) => {
        row.classList.toggle('active', Number(row.dataset.studentId) === studentId);
      });
      const panel = document.getElementById('calls-profile-panel');
      panel.innerHTML = '<div class="empty-state">جارٍ التحميل...</div>';
      try {
        const data = await api('/api/calls/student/' + studentId);
        renderCallProfile(data);
      } catch (error) {
        panel.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function examPercentBadge(percentage) {
      if (percentage === null || percentage === undefined) return '<span class="badge badge-muted">بدون درجة</span>';
      const value = Number(percentage);
      const tone = value >= 75 ? 'badge-success' : value >= 50 ? 'badge-warning' : 'badge-danger';
      return `<span class="badge ${tone}">${Math.round(value * 10) / 10}%</span>`;
    }

    // كتلة نص عادية بدل الجداول: سهلة القراءة على التليفون وسهلة التحديد والنسخ، وزرار نسخ
    // بيحطها في الحافظة مرة واحدة عشان تتبعت للطالب من غير تحديد يدوي
    function copyableTextBlock(label, text) {
      const id = 'copytext-' + Math.random().toString(36).slice(2, 9);
      return `
        <div class="row-between" style="margin-bottom:6px">
          <b>${escapeHtml(label)}</b>
          <button type="button" class="btn btn-ghost btn-sm copy-text-btn" style="width:auto" data-copy-target="${id}">📋 نسخ</button>
        </div>
        <pre id="${id}" style="margin:0; font-family:inherit; font-size:15px; line-height:1.7;
          white-space:pre-wrap; overflow-wrap:anywhere; user-select:text; -webkit-user-select:text;
          background:var(--surface-sunken); border:1px solid var(--border); border-radius:8px; padding:12px">${escapeHtml(text)}</pre>`;
    }

    function renderStudentLessons(data) {
      const { views, summary } = data;
      if (!views.length) return '<div class="empty-state">مفيش مشاهدات مسجّلة للطالب ده على المنصة.</div>';
      const head = `
        <b style="display:block; margin-bottom:8px">🎬 مشاهدات الفيديوهات</b>
        <div class="row" style="gap:8px; flex-wrap:wrap; margin-bottom:12px">
          <span class="badge badge-muted">فيديوهات: ${summary.video_count}</span>
          <span class="badge badge-muted" title="محسوبة من نسبة المشاهدة (٩٠% فأكتر) — علامة &quot;مكتمل&quot; اللي بترجّعها المنصة مش موثوقة">خلّصها: ${summary.completed_count}</span>
          ${summary.average_progress !== null ? `<span class="badge badge-muted">متوسط المشاهدة: ${summary.average_progress}%</span>` : ''}
          ${summary.truncated ? `<span class="badge badge-warning" title="فيه مشاهدات أقدم متجابتش">أحدث ${summary.shown} من ${summary.total}</span>` : `<span class="badge badge-muted">الإجمالي: ${summary.total}</span>`}
        </div>`;
      // نفس أسلوب الدرجات: اسم الفيديو في سطر ونسبة المشاهدة تحته
      const viewsText = views.map((view) => {
        const percent = (view.progress_percentage === null || view.progress_percentage === undefined)
          ? '—' : `${Math.round(Number(view.progress_percentage) * 10) / 10}%`;
        return `${view.lesson_name || '—'}
${percent}`;
      }).join(`


`);
      return head + copyableTextBlock('مشاهدات الفيديوهات', viewsText);
    }

    function renderStudentExams(data) {
      const { taken, missed, summary } = data;
      const summaryRow = `
        <div class="row" style="gap:8px; flex-wrap:wrap; margin-bottom:12px">
          <span class="badge badge-muted">اختبارات مأخوذة: ${summary.taken_count}</span>
          <span class="badge badge-muted">مكتملة: ${summary.finished_count}</span>
          ${summary.average_percentage !== null ? `<span class="badge badge-muted">المتوسط: ${summary.average_percentage}%</span>` : ''}
          ${summary.missed_count ? `<span class="badge badge-danger">متاح ولم يدخله: ${summary.missed_count}</span>` : '<span class="badge badge-success">مدخّل كل المتاح</span>'}
        </div>`;

      // مطوية ومحطوطة **تحت** الدرجات: العدد نفسه ظاهر في الملخص فوق وهو الإشارة اللي تهم،
      // أما قائمة الأسماء فتفصيل مرجعي. لما كانت مفتوحة وفوق، طالب عنده 30 اختبار لم يدخله كان
      // بيدفن جدول الدرجات تحت 3400 حرف من الشارات ويخلي الموظف يفتكر إنه مفيش درجات أصلاً
      const missedBlock = missed.length ? `
        <details style="margin-top:16px">
          <summary style="cursor:pointer; font-weight:700">اختبارات متاحة لم يدخلها (${missed.length})</summary>
          <div class="row" style="gap:6px; flex-wrap:wrap; margin-top:10px">
            ${missed.map((exam) => `<span class="badge badge-danger" title="${escapeHtml(exam.bootcamp_name || '')}">${escapeHtml(exam.name)}</span>`).join('')}
          </div>
        </details>` : '';

      // تلات أعمدة بس — اسم الاختبار والدرجة والنسبة. الكورس والمحاولة والوقت والتاريخ اتشالوا
      // بناءً على طلب صريح: على شاشة التليفون كانوا بيضغطوا الأعمدة المهمة ويجبروا تمرير أفقي.
      // "(لم يكملها)" باقية جنب الاسم لأن الدرجة من غيرها بتتقري غلط — محاولة ناقصة مش نتيجة نهائية
      // نص عادي مش جدول — اسم الاختبار في سطر والدرجة تحته وسطرين فاضيين بين كل واحد والتاني،
      // عشان يتقرا على التليفون من غير تمرير أفقي ويتنسخ كتلة واحدة تتبعت للطالب
      const takenText = taken.map((exam) => {
        const percent = (exam.percentage === null || exam.percentage === undefined)
          ? '' : ` (${Math.round(Number(exam.percentage) * 10) / 10}%)`;
        const mark = exam.mark === null ? '—' : String(exam.mark);
        return `${exam.name}${exam.finished ? '' : ' (لم يكملها)'}
${mark}${percent}`;
      }).join(`


`);
      const takenBlock = taken.length
        ? copyableTextBlock('الدرجات', takenText)
        : '<div class="empty-state">الطالب ده لسه ماخدش أي اختبار.</div>';

      return summaryRow + takenBlock + missedBlock;
    }

    function renderCallProfile(data) {
