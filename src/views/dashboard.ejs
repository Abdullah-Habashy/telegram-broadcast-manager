    });
    document.getElementById('download-report-pdf').addEventListener('click', () => {
      window.location.href = '/api/tafra/students/export?format=pdf&' + reportQueryString();
    });

    ['tafra-level-filter', 'tafra-education-type-filter', 'tafra-gender-filter', 'tafra-telegram-filter', 'tafra-conversation-filter', 'tafra-assignee-filter', 'tafra-status-filter', 'tafra-bootcamp-filter', 'tafra-exam-filter', 'tafra-exam-attendance-filter', 'tafra-exam-mark-range-filter', 'tafra-idea-filter', 'tafra-enrolled-from', 'tafra-enrolled-to', 'tafra-welcome-status-filter', 'tafra-last-sent-from', 'tafra-last-sent-to', 'tafra-last-received-from', 'tafra-last-received-to', 'tafra-exclude-sent-today'].forEach((id) => {
      document.getElementById(id).addEventListener('change', () => {
        tafraStudentsPage = 1;
        loadTafraStudents();
      });
    });
    document.getElementById('tafra-student-search').addEventListener('input', () => {
      clearTimeout(tafraStudentSearchTimer);
      tafraStudentSearchTimer = setTimeout(() => { tafraStudentsPage = 1; loadTafraStudents(); }, 350);
    });
    document.getElementById('clear-tafra-filters').addEventListener('click', clearTafraReportFilters);
    document.getElementById('tafra-students-prev').addEventListener('click', () => {
      if (tafraStudentsPage > 1) { tafraStudentsPage -= 1; loadTafraStudents(); }
    });
    document.getElementById('tafra-students-next').addEventListener('click', () => {
      if (tafraStudentsPage < tafraStudentsPages) { tafraStudentsPage += 1; loadTafraStudents(); }
    });

    document.getElementById('sync-tafra-enrollments').addEventListener('click', async () => {
      if (!window.confirm('بدء قراءة اشتراكات الطلاب في الأبواب والكورسات؟ لن يتم تعديل منصة طفرة.')) return;
      const button = document.getElementById('sync-tafra-enrollments');
      button.disabled = true;
      try {
        const result = await api('/api/tafra/sync-enrollments', { method: 'POST' });
        showToast(result.message);
        const poll = async () => {
          tafraFiltersLoaded = false;
          const filters = await api('/api/tafra/student-filters');
          renderTafraEnrollmentSync(filters.enrollment_sync);
          if (filters.enrollment_sync?.status === 'running') setTimeout(poll, 3000);
          else {
            tafraFiltersLoaded = false;
            await loadTafraStudentFilters();
            await loadTafraStudents();
          }
        };
        setTimeout(poll, 1500);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    });

    document.getElementById('sync-tafra-bootcamp-names').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-bootcamp-names');
