          try {
            await api('/api/tickets/' + ticketId, {
              method: 'PATCH', body: JSON.stringify({ next_follow_up_at: new Date(value).toISOString() })
            });
            showToast('تم حفظ موعد التواصل القادم');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
        });
        document.getElementById('clear-ticket-follow-up').addEventListener('click', async () => {
