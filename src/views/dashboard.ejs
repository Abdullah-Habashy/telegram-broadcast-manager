                if (!ticketsMeta.subtitles.some((item) => Number(item.id) === Number(subtitle.id))) {
                  ticketsMeta.subtitles.push(subtitle);
                  ticketsMeta.subtitles.sort((a, b) => a.name.localeCompare(b.name, 'ar'));
                  const filter = document.getElementById('ticket-subtitle-filter');
                  filter.innerHTML = '<option value="">كل العناوين الفرعية</option>' +
                    ticketsMeta.subtitles.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
                }
                select.innerHTML = ticketsMeta.subtitles.map((item) =>
                  `<option value="${item.id}">${escapeHtml(item.name)}</option>`
                ).join('') + '<option value="__add__">＋ إضافة عنوان فرعي جديد</option>';
                select.value = String(subtitle.id);
                value = subtitle.id;
              }
              await api('/api/tickets/' + ticketId, { method: 'PATCH', body: JSON.stringify({ [field]: value }) });
              showToast('تم تحديث التذكرة');
              if (field === 'subtitle_id' || field === 'assigned_to') loadTicket(ticketId);
              else loadTickets();
            } catch (error) { showToast(error.message); }
          });
        });
        document.getElementById('send-ticket-reply').addEventListener('click', sendTicketReply);
        document.getElementById('cancel-ticket-reply-context').addEventListener('click', clearReplyContext);
        document.getElementById('mobile-ticket-back').addEventListener('click', closeMobileTicket);
        const mobileDetails = document.getElementById('ticket-mobile-details');
        const mobileStatusToggle = document.getElementById('mobile-ticket-status-toggle');
        const mobileFollowUpToggle = document.getElementById('mobile-ticket-follow-up-toggle');
        function toggleMobileTicketSection(section, clickedButton, otherButton) {
          const sectionClass = section === 'status' ? 'show-ticket-controls' : 'show-follow-up';
          const isOpen = mobileDetails.classList.contains('open') && mobileDetails.classList.contains(sectionClass);
          mobileDetails.classList.remove('open', 'show-ticket-controls', 'show-follow-up');
          clickedButton.classList.remove('active');
          otherButton.classList.remove('active');
          clickedButton.setAttribute('aria-expanded', 'false');
          otherButton.setAttribute('aria-expanded', 'false');
          if (!isOpen) {
            mobileDetails.classList.add('open', sectionClass);
            clickedButton.classList.add('active');
            clickedButton.setAttribute('aria-expanded', 'true');
          }
        }
        mobileStatusToggle.addEventListener('click', () =>
          toggleMobileTicketSection('status', mobileStatusToggle, mobileFollowUpToggle));
        mobileFollowUpToggle.addEventListener('click', () =>
          toggleMobileTicketSection('follow-up', mobileFollowUpToggle, mobileStatusToggle));
        document.getElementById('save-ticket-follow-up').addEventListener('click', async () => {
          const value = document.getElementById('ticket-follow-up-at').value;
          if (!value) return showToast('حدد تاريخ ووقت المتابعة');
          try {
            await api('/api/tickets/' + ticketId, {
              method: 'PATCH', body: JSON.stringify({ next_follow_up_at: new Date(value).toISOString() })
            });
            showToast('تم حفظ موعد التواصل القادم');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
        });
        document.getElementById('clear-ticket-follow-up').addEventListener('click', async () => {
          try {
            await api('/api/tickets/' + ticketId, {
              method: 'PATCH', body: JSON.stringify({ next_follow_up_at: null })
            });
            showToast('تم إنهاء موعد المتابعة');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
        });
        panel.querySelectorAll('.quick-follow-up-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const days = Number(button.dataset.days);
            const followUpDate = new Date();
            followUpDate.setDate(followUpDate.getDate() + days);
            button.disabled = true;
            try {
              await api('/api/tickets/' + ticketId, {
                method: 'PATCH', body: JSON.stringify({ next_follow_up_at: followUpDate.toISOString() })
              });
              showToast(`تم تحديد المتابعة بعد ${days === 1 ? 'يوم' : days === 2 ? 'يومين' : days + ' أيام'}`);
              loadTicket(ticketId);
            } catch (error) {
              showToast(error.message);
              button.disabled = false;
            }
          });
        });
        const replyImage = document.getElementById('ticket-reply-image');
        const replyImageName = document.getElementById('ticket-reply-image-name');
        const clearReplyImage = document.getElementById('clear-ticket-reply-image');
        replyImage.addEventListener('change', () => {
          const file = replyImage.files[0];
          replyImageName.textContent = file ? '📷' : '';
          replyImageName.title = file ? file.name : '';
          replyImageName.style.display = file ? 'inline-flex' : 'none';
          clearReplyImage.style.display = file ? 'inline-flex' : 'none';
        });
        clearReplyImage.addEventListener('click', () => {
          replyImage.value = '';
          replyImageName.textContent = '';
          replyImageName.style.display = 'none';
          clearReplyImage.style.display = 'none';
        });

        // —— بيكر رقم الفكرة ——
        const ideaPickerToggle = document.getElementById('idea-picker-toggle');
        const ideaPickerDropdown = document.getElementById('idea-picker-dropdown');
        const ideaPickerGrid = document.getElementById('idea-picker-grid');

        if (ideaPickerToggle && ideaPickerDropdown && ideaPickerGrid) {
          const maxIdea = ticketsMeta.max_idea_number || 20;
          let currentIdea = ticket.current_idea_number || null;

          function buildIdeaGrid() {
            ideaPickerGrid.innerHTML = Array.from({ length: maxIdea }, (_, i) => {
              const n = i + 1;
              return `<button type="button" class="idea-grid-btn${currentIdea === n ? ' active' : ''}" data-idea="${n}">${n}</button>`;
            }).join('');
            ideaPickerGrid.querySelectorAll('.idea-grid-btn').forEach((btn) => {
              btn.addEventListener('click', async () => {
                const idea = Number(btn.dataset.idea);
                btn.disabled = true;
                try {
                  await api(`/api/tickets/${ticketId}/idea`, {
                    method: 'PATCH', body: JSON.stringify({ idea_number: idea })
                  });
                  currentIdea = idea;
                  showToast(`تم تسجيل الفكرة ${idea}`);
                  ideaPickerDropdown.style.display = 'none';
                  ideaPickerToggle.setAttribute('aria-expanded', 'false');
                  loadTicket(ticketId);
                } catch (err) {
                  showToast(err.message);
                  btn.disabled = false;
                }
              });
            });
          }
          buildIdeaGrid();

          ideaPickerToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = ideaPickerDropdown.style.display !== 'none';
            ideaPickerDropdown.style.display = isOpen ? 'none' : 'block';
            ideaPickerToggle.setAttribute('aria-expanded', String(!isOpen));
          });

          const ideaClearBtn = document.getElementById('idea-clear-btn');
          if (ideaClearBtn) {
            ideaClearBtn.addEventListener('click', async () => {
              ideaClearBtn.disabled = true;
              try {
                await api(`/api/tickets/${ticketId}/idea`, {
                  method: 'PATCH', body: JSON.stringify({ idea_number: null })
                });
                showToast('تم إلغاء تحديد الفكرة');
                loadTicket(ticketId);
              } catch (err) {
                showToast(err.message);
                ideaClearBtn.disabled = false;
              }
            });
          }

          document.addEventListener('click', function closeIdeaPicker(e) {
            if (!document.getElementById('idea-picker-wrap')?.contains(e.target)) {
              if (ideaPickerDropdown) ideaPickerDropdown.style.display = 'none';
              document.removeEventListener('click', closeIdeaPicker);
            }
          });
        }

        // —— بيكر درجات آخر الاختبارات ——
        const examMarksToggle = document.getElementById('exam-marks-picker-toggle');
        const examMarksDropdown = document.getElementById('exam-marks-picker-dropdown');
        if (examMarksToggle && examMarksDropdown) {
          examMarksToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = examMarksDropdown.style.display !== 'none';
            examMarksDropdown.style.display = isOpen ? 'none' : 'block';
            examMarksToggle.setAttribute('aria-expanded', String(!isOpen));
          });
          function insertIntoReply(text) {
            const textarea = document.getElementById('ticket-reply-content');
            textarea.value = textarea.value.trim() ? `${textarea.value.trim()}\n\n${text}` : text;
            textarea.focus();
          }

          // سطر الدرجة — بيضيف النسبة المئوية بين قوسين جنبها لو متاحة
          function examMarkLine(m) {
            return `${m.exam_name.trim()}\n${m.mark}${m.percentage !== null && m.percentage !== undefined ? ` (${m.percentage}%)` : ''}`;
          }

          async function withExamMarksButton(btn, task) {
            btn.disabled = true;
            try {
              await task();
            } catch (err) {
              showToast(err.message);
            } finally {
              btn.disabled = false;
              examMarksDropdown.style.display = 'none';
              examMarksToggle.setAttribute('aria-expanded', 'false');
            }
          }

          examMarksDropdown.querySelectorAll('[data-exam-marks-count]').forEach((btn) => {
            btn.addEventListener('click', () => withExamMarksButton(btn, async () => {
              const count = Number(btn.dataset.examMarksCount);
              const marks = await api(`/api/tickets/${ticketId}/recent-exam-marks?count=${count}`);
              if (!marks.length) {
                showToast('لا توجد درجات اختبارات مسجّلة لهذا الطالب');
                return;
              }
              insertIntoReply(marks.map(examMarkLine).join('\n\n'));
            }));
          });

          const examMarksCourseBtn = document.getElementById('exam-marks-course-btn');
          examMarksCourseBtn.addEventListener('click', () => withExamMarksButton(examMarksCourseBtn, async () => {
            const marks = await api(`/api/tickets/${ticketId}/course-exam-marks`);
            if (!marks.length) {
              showToast('لا توجد درجات اختبارات أونلاين في كورسات الطالب المشترك فيها');
              return;
            }
            // بنجمّع الاختبارات تحت اسم كل كورس عشان الرسالة تبقى مرتبة ومفهومة — اسم الاختبار في
            // سطر والدرجة في السطر اللي تحته، وسطر فاضي بين كل اختبار والتاني
            const groups = new Map();
            marks.forEach((m) => {
              const course = m.bootcamp_name.trim();
              if (!groups.has(course)) groups.set(course, []);
              groups.get(course).push(examMarkLine(m));
            });
            const text = [...groups.entries()]
              .map(([course, examLines]) => `📘 ${course}:\n\n${examLines.join('\n\n')}`)
              .join('\n\n');
            insertIntoReply(text);
          }));

          document.addEventListener('click', function closeExamMarksPicker(e) {
            if (!document.getElementById('exam-marks-picker-wrap')?.contains(e.target)) {
              if (examMarksDropdown) examMarksDropdown.style.display = 'none';
              document.removeEventListener('click', closeExamMarksPicker);
            }
          });
        }

        // —— سجل تقدم الأفكار ——
        try {
          const ideaLog = await api(`/api/tickets/${ticketId}/idea-log`);
          if (ideaLog.length) {
            const messages = document.getElementById('ticket-messages');
            const logHtml = `<div class="idea-log-section">
              <div class="idea-log-title">💡 سجل الأفكار</div>
              ${ideaLog.map((entry) => `
                <div class="idea-log-entry">
                  <span class="idea-log-num">فكرة ${entry.idea_number}</span>
                  — ${escapeHtml(entry.changed_by_name || 'موظف')} — ${fmtDate(entry.changed_at)}
                </div>`).join('')}
            </div>`;
            messages.insertAdjacentHTML('beforeend', logHtml);
          }
        } catch (_) { /* تجاهل بصمت لو فشل تحميل السجل */ }

        const messages = document.getElementById('ticket-messages');
        messages.scrollTop = messages.scrollHeight;
        loadTickets();
      } catch (error) {
        panel.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function sendTicketReply() {
      const textarea = document.getElementById('ticket-reply-content');
      const content = textarea.value.trim();
      const image = document.getElementById('ticket-reply-image').files[0];
      if (!content && !image) return showToast('اكتب نصًا أو أرفق صورة');
      if (image && content.length > 1024) return showToast('النص مع الصورة يجب ألا يتجاوز 1024 حرفًا');
      const button = document.getElementById('send-ticket-reply');
      button.disabled = true;
      try {
        const formData = new FormData();
        formData.append('content', content);
        if (image) formData.append('image', image);
        if (currentReplyToMessageId) formData.append('reply_to_message_id', currentReplyToMessageId);
        const response = await fetch(`/api/tickets/${currentTicketId}/reply`, { method: 'POST', body: formData });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'فشل إرسال الرد');
        clearReplyContext();
        await loadTicket(currentTicketId);
        showToast('تم إرسال الرد للطالب');
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    }

    function closeMobileTicket() {
      document.querySelector('.ticket-workspace').classList.remove('ticket-open');
      document.getElementById('tab-tickets').classList.remove('ticket-open-view');
      currentTicketId = null;
      loadTickets();
    }

    ['ticket-status-filter', 'ticket-subtitle-filter', 'ticket-priority-filter', 'ticket-category-filter', 'ticket-assignee-filter', 'ticket-follow-up-filter', 'ticket-sent-filter', 'ticket-received-filter', 'ticket-unread-filter', 'ticket-awaiting-reply-filter', 'ticket-unassigned-filter', 'ticket-never-replied-filter', 'ticket-idea-filter']
      .forEach((id) => document.getElementById(id).addEventListener('change', () => {
        ticketsPage = 1;
        updateAgentFilterIndicator();
        loadTickets();
      }));
    const agentFilterToggle = document.getElementById('agent-filter-toggle');
    if (agentFilterToggle) {
      agentFilterToggle.addEventListener('click', () => {
        const filters = document.getElementById('ticket-advanced-filters');
        const isOpen = filters.classList.toggle('open');
        agentFilterToggle.classList.toggle('active', isOpen);
        agentFilterToggle.title = isOpen ? 'إخفاء الفلاتر' : 'إظهار الفلاتر';
        agentFilterToggle.setAttribute('aria-label', agentFilterToggle.title);
      });
    }

    function updateAgentFilterIndicator() {
      if (!agentFilterToggle) return;
      const hasFilter = [
        'ticket-status-filter', 'ticket-subtitle-filter', 'ticket-priority-filter', 'ticket-category-filter',
        'ticket-assignee-filter', 'ticket-follow-up-filter', 'ticket-sent-filter',
        'ticket-received-filter', 'ticket-idea-filter'
      ].some((id) => document.getElementById(id).value)
        || document.getElementById('ticket-unread-filter').checked
        || document.getElementById('ticket-awaiting-reply-filter').checked
        || document.getElementById('ticket-unassigned-filter').checked
        || document.getElementById('ticket-never-replied-filter').checked;
      agentFilterToggle.classList.toggle('has-filter', hasFilter);
    }
    document.getElementById('ticket-search').addEventListener('input', () => {
      clearTimeout(ticketSearchTimer);
      ticketSearchTimer = setTimeout(() => { ticketsPage = 1; loadTickets(); }, 350);
    });
    document.getElementById('refresh-tickets-btn').addEventListener('click', loadTickets);
    document.getElementById('tickets-prev').addEventListener('click', () => { if (ticketsPage > 1) { ticketsPage--; loadTickets(); } });
    document.getElementById('tickets-next').addEventListener('click', () => { if (ticketsPage < ticketsTotalPages) { ticketsPage++; loadTickets(); } });

    // ---------- جهات الاتصال ----------
    async function initContactsAndBroadcasts() {
      try {
        await ensureTicketsMeta();
        document.getElementById('contact-assignee-filter').innerHTML =
          '<option value="">كل الموظفين</option><option value="unassigned">غير معيّنة</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
        document.getElementById('contact-subtitle-filter').innerHTML =
          '<option value="">كل العناوين الفرعية</option>' +
          ticketsMeta.subtitles.map((subtitle) => `<option value="${subtitle.id}">${escapeHtml(subtitle.name)}</option>`).join('');
        loadBootcampsIntoContactFilter();
        await Promise.all([loadContacts(), loadTagsIntoSelect(), loadBroadcasts()]);
      } catch (error) { showToast(error.message); }
    }

    async function loadBootcampsIntoContactFilter() {
      const bootcampSelect = document.getElementById('contact-bootcamp-filter');
      const examSelect = document.getElementById('contact-exam-filter');
      const examContextSelect = document.getElementById('broadcast-exam-context');
      try {
        const filters = await api('/api/tafra/student-filters');
        bootcampSelect.innerHTML = '<option value="">كل الأبواب والكورسات</option>' +
          filters.bootcamps.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
        examSelect.innerHTML = '<option value="">كل الاختبارات</option>' +
          filters.exams.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
        examContextSelect.innerHTML = '<option value="">بدون ربط</option>' +
          filters.exams.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
      } catch (error) {
        bootcampSelect.disabled = true;
        examSelect.disabled = true;
        examContextSelect.disabled = true;
      }
    }

    function updateSelectedContactsUi() {
      const count = selectedContactIds.size;
      document.getElementById('selected-contacts-count').textContent = `المحدد: ${count}`;
      document.getElementById('message-selected-btn').disabled = count === 0;
      document.getElementById('selected-tafra-students-count').textContent = `المحدد: ${count}`;
      document.getElementById('message-selected-tafra-students-btn').disabled = count === 0;
      const selectedNewBotCount = document.getElementById('selected-newbot-count');
      if (selectedNewBotCount) selectedNewBotCount.textContent = `المحدد: ${count}`;
      const messageSelectedNewBotBtn = document.getElementById('message-selected-newbot-btn');
      if (messageSelectedNewBotBtn) messageSelectedNewBotBtn.disabled = count === 0;

      const selectedOption = document.querySelector('#broadcast-tag option[value="__selected__"]');
      if (selectedOption) selectedOption.textContent = `الجهات المحددة (${count})`;

      const hint = document.getElementById('selected-audience-hint');
      if (document.getElementById('broadcast-tag').value === '__selected__') {
        hint.style.display = 'block';
        hint.textContent = count ? `سيتم الإرسال إلى ${count} جهة محددة` : 'لم تحدد أي جهة اتصال بعد';
      } else {
        hint.style.display = 'none';
      }
    }

    async function loadContacts() {
      const wrap = document.getElementById('contacts-table-wrap');
      try {
        const query = new URLSearchParams();
        const filterValues = {
          status: document.getElementById('contact-status-filter').value,
          subtitle_id: document.getElementById('contact-subtitle-filter').value,
          priority: document.getElementById('contact-priority-filter').value,
          category: document.getElementById('contact-category-filter').value,
          assigned_to: document.getElementById('contact-assignee-filter').value,
          bootcamp_id: document.getElementById('contact-bootcamp-filter').value,
          enrolled_from: document.getElementById('contact-enrolled-from').value,
          enrolled_to: document.getElementById('contact-enrolled-to').value,
          exam: document.getElementById('contact-exam-filter').value,
          attendance: document.getElementById('contact-exam-filter').value
            ? document.getElementById('contact-exam-attendance-filter').value : '',
          mark_range: (document.getElementById('contact-exam-filter').value
            && document.getElementById('contact-exam-attendance-filter').value !== 'not_entered')
            ? document.getElementById('contact-exam-mark-range-filter').value : '',
          follow_up: document.getElementById('contact-follow-up-filter').value,
          sent_older_than: document.getElementById('filter-sent').value,
          received_older_than: document.getElementById('filter-received').value,
          start_status: document.getElementById('filter-start-status').value,
        };
        Object.entries(filterValues).forEach(([key, value]) => { if (value) query.set(key, value); });
        if (document.getElementById('contact-unread-filter').checked) query.set('unread', 'true');
        const contacts = await api('/api/contacts' + (query.size ? `?${query}` : ''));
        currentFilteredContactIds = contacts.map((contact) => Number(contact.id));
        if (contacts.length === 0) {
          currentFilteredContactIds = [];
          wrap.innerHTML = '<div class="empty-state">لسه مفيش جهات اتصال — هتظهر هنا أول ما حد يعمل /start على البوت</div>';
          return;
        }
        wrap.innerHTML = `
          <table>
            <thead><tr><th class="select-cell"><input type="checkbox" id="select-all-contacts" aria-label="تحديد الكل"></th><th>الاسم</th><th>الباب</th><th>العنوان الفرعي</th><th>الحالة</th><th>الموظف</th><th data-sort-key="sent">آخر رسالة أرسلناها</th><th data-sort-key="received">آخر رسالة استلمناها</th><th>تصنيفات</th></tr></thead>
            <tbody>
              ${contacts.map((c) => `
                <tr>
                  <td class="select-cell"><input type="checkbox" class="contact-selector" value="${c.id}" ${selectedContactIds.has(c.id) ? 'checked' : ''} aria-label="تحديد جهة الاتصال"></td>
                  <td>${escapeHtml([c.first_name, c.last_name].filter(Boolean).join(' ') || c.telegram_username || String(c.chat_id))}</td>
                  <td>${bootcampMarksHtml(c, 'sm') || '<span class="badge badge-muted">—</span>'}</td>
                  <td>${c.subtitle_name ? `<span class="ticket-subtitle-badge">${escapeHtml(c.subtitle_name)}</span>` : '—'}</td>
                  <td>${c.ticket_status ? escapeHtml(ticketLabels.status[c.ticket_status] || c.ticket_status) : '—'}</td>
                  <td>${escapeHtml(c.assigned_name || '—')}</td>
                  <td data-sort-value="${c.last_sent_at ? new Date(c.last_sent_at).getTime() : ''}">${fmtDay(c.last_sent_at)}</td>
                  <td data-sort-value="${c.last_received_at ? new Date(c.last_received_at).getTime() : ''}">${fmtDay(c.last_received_at)}</td>
                  <td>${c.tags.map((t) => `<span class="tag-pill">${escapeHtml(t.name)}</span>`).join(' ') || '—'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
        enableTableSort(wrap);
        wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
            updateSelectedContactsUi();
          });
        });
        document.getElementById('select-all-contacts').addEventListener('change', (event) => {
          wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
          });
          updateSelectedContactsUi();
        });
        updateSelectedContactsUi();
      } catch (e) { wrap.innerHTML = `<div class="empty-state">${e.message}</div>`; }
    }
    [
      'contact-status-filter', 'contact-subtitle-filter', 'contact-priority-filter',
      'contact-category-filter', 'contact-assignee-filter', 'contact-bootcamp-filter',
      'contact-enrolled-from', 'contact-enrolled-to', 'contact-exam-filter',
      'contact-exam-attendance-filter', 'contact-exam-mark-range-filter', 'contact-follow-up-filter',
      'filter-sent', 'filter-received', 'filter-start-status', 'contact-unread-filter'
    ].forEach((id) => document.getElementById(id).addEventListener('change', loadContacts));

    document.getElementById('select-filtered-contacts-btn').addEventListener('click', () => {
      currentFilteredContactIds.forEach((id) => selectedContactIds.add(id));
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = true; });
      updateSelectedContactsUi();
      showToast(`تم تحديد ${currentFilteredContactIds.length} نتيجة مفلترة`);
    });
    document.getElementById('select-first-n-contacts-btn').addEventListener('click', () => {
      selectFirstN('#contacts-table-wrap .contact-selector', 'select-first-n-contacts', selectedContactIds, updateSelectedContactsUi);
    });
    document.getElementById('clear-selected-contacts-btn').addEventListener('click', () => {
      selectedContactIds.clear();
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = false; });
      updateSelectedContactsUi();
    });

    // مشتركة بين تاب "جهات الاتصال" وتاب "طلاب المنصة" — بتودّي لبانل الإرسال بنفس التحديد الحالي
    async function goToComposeWithSelection({ prefillNewBot = false } = {}) {
      if (selectedContactIds.size === 0) return;
      // إيه فلتر الاختبار اللي كان مفعّل وقت التحديد (من أي تاب) — بيتربط تلقائيًا بالرسالة عشان كلمتي "اختبار"/"الدرجة"
      // الربط ده بيشتغل بس لو اختبار واحد محدد (مش قايمة اختبارات) عشان معنى "الدرجة" يفضل واضح في الرسالة
      const tafraExamValue = document.getElementById('tafra-exam-filter').value;
      const contactExamValue = document.getElementById('contact-exam-filter').value;
      const singleExam = (value) => (value && !value.includes(',') ? value : '');
      const activeExamFilter = singleExam(tafraExamValue) || singleExam(contactExamValue);
      const contactsNav = document.querySelector('.nav-item[data-tab="contacts"]');
      if (contactsNav && !contactsNav.classList.contains('active')) contactsNav.click();
      await loadBootcampsIntoContactFilter(); // يضمن إن خيارات ربط الاختبار جاهزة قبل ما نحددها تحت
      document.getElementById('broadcast-tag').value = '__selected__';
      document.getElementById('broadcast-exam-context').value = activeExamFilter || '';
      updateSelectedContactsUi();
      // لما الإرسال جاي من تاب "بوت طفرة"، نجهّز رسالة وزرار جاهزين يوجّهوا الطالب لبوت طفرة
      // مباشرة — الموظف يقدر يعدّلهم عادي زي أي رسالة تانية قبل الإرسال
      if (prefillNewBot) {
        try {
          const info = await api('/api/tafra/new-bot-info');
          const contentField = document.getElementById('broadcast-content');
          if (!contentField.value.trim()) {
            contentField.value = 'أهلاً يا الاسم! 👋 عندنا بوت جديد فيه خدمات إضافية ليك، اضغط على الزرار تحت وابدأ معاه دلوقتي.';
          }
          document.getElementById('broadcast-button-text').value = '🚀 ابدأ بوت طفرة';
          document.getElementById('broadcast-button-url').value = info.link;
        } catch (error) {
          showToast('تعذر تجهيز رابط بوت طفرة تلقائيًا: ' + error.message);
        }
      }
      document.getElementById('broadcast-compose').scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('broadcast-content').focus();
    }

    document.getElementById('message-selected-btn').addEventListener('click', () => goToComposeWithSelection());

    document.getElementById('select-filtered-tafra-students-btn').addEventListener('click', () => {
      currentFilteredTafraStudentContactIds.forEach((id) => selectedContactIds.add(id));
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = true; });
      updateSelectedContactsUi();
      showToast(`تم تحديد ${currentFilteredTafraStudentContactIds.length} طالب ممكن مراسلته`);
    });
    document.getElementById('select-all-tafra-students-btn').addEventListener('click', async () => {
      const btn = document.getElementById('select-all-tafra-students-btn');
      btn.disabled = true;
      try {
        // بيجيب معرّفات كل الطلاب المطابقين للفلتر الحالي من كل الصفحات (مش بس اللي ظاهرين دلوقتي)
        const result = await api('/api/tafra/students/ids?' + tafraStudentQuery());
        result.ids.forEach((id) => selectedContactIds.add(id));
        document.querySelectorAll('#tafra-students-table .contact-selector').forEach((checkbox) => {
          if (selectedContactIds.has(Number(checkbox.value))) checkbox.checked = true;
        });
        updateSelectedContactsUi();
        showToast(`تم تحديد ${result.ids.length} طالب ممكن مراسلته من كل الصفحات المطابقة للفلتر`);
      } catch (error) {
        showToast(error.message);
      } finally {
        btn.disabled = false;
      }
    });
    document.getElementById('select-first-n-tafra-btn').addEventListener('click', () => {
      selectFirstNAcrossPages(
        '/api/tafra/students/ids?' + tafraStudentQuery(), 'select-first-n-tafra',
        '#tafra-students-table .contact-selector', selectedContactIds, updateSelectedContactsUi
      );
    });
    document.getElementById('clear-selected-tafra-students-btn').addEventListener('click', () => {
      selectedContactIds.clear();
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = false; });
      updateSelectedContactsUi();
    });
    document.getElementById('message-selected-tafra-students-btn').addEventListener('click', goToComposeWithSelection);

    // ---------- بوت طفرة (توجيه الطلاب اللي لسه ما بدأوش، عن طريق بوت المتابعة) ----------
    let newBotStudentsPage = 1;
    let newBotStudentsPages = 1;
    let newBotTabInitialized = false;
    let currentFilteredNewBotContactIds = [];

    function newBotStudentQuery() {
      const params = new URLSearchParams({ page: newBotStudentsPage, limit: 50 });
      const search = document.getElementById('newbot-search').value.trim();
      const status = document.getElementById('newbot-status-filter').value;
      const telegram = document.getElementById('newbot-telegram-filter').value;
      const bootcamp = document.getElementById('newbot-bootcamp-filter').value;
      const gender = document.getElementById('newbot-gender-filter').value;
      if (search) params.set('search', search);
      if (status) params.set('new_bot_status', status);
      if (telegram) params.set('telegram', telegram);
      if (bootcamp) params.set('bootcamp', bootcamp);
      if (gender) params.set('gender', gender);
      return params.toString();
    }

    function newBotStudentRowHtml(student) {
      const canMessage = canMessageStudent(student);
      const checkboxCell = canMessage
        ? `<input type="checkbox" class="contact-selector" value="${student.contact_id}" ${selectedContactIds.has(Number(student.contact_id)) ? 'checked' : ''} aria-label="تحديد الطالب">`
        : telegramReachBadge(false);
      const statusBadge = student.new_bot_started
        ? '<span class="badge badge-success">✅ بدأ بوت طفرة</span>'
        : '<span class="badge badge-muted">لسه ما بدأش</span>';
      const followUpBadge = student.can_message
        ? '<span class="badge badge-success">✅ بدأ بوت المتابعة</span>'
        : '<span class="badge badge-muted">لسه ما بدأش</span>';
      return `<tr>
        <td class="select-cell">${checkboxCell}</td>
        <td><div class="tafra-student-name">${escapeHtml(student.name || 'بدون اسم')}</div><div class="tafra-student-sub">الكود: ${escapeHtml(student.student_code || '—')}</div></td>
        <td>📱 ${escapeHtml(student.phone || '—')}</td>
        <td>${followUpBadge}</td>
        <td>${statusBadge}</td>
      </tr>`;
    }

    async function loadNewBotStudents() {
      const wrap = document.getElementById('newbot-students-table');
      try {
        const result = await api('/api/tafra/students?' + newBotStudentQuery());
        newBotStudentsPages = result.meta.pages;
        document.getElementById('newbot-student-count').textContent = `الطلاب: ${result.meta.total}`;
        document.getElementById('newbot-student-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('newbot-students-prev').disabled = result.meta.page <= 1;
        document.getElementById('newbot-students-next').disabled = result.meta.page >= result.meta.pages;
        currentFilteredNewBotContactIds = result.students.filter(canMessageStudent).map((s) => Number(s.contact_id));
        if (!result.students.length) {
          wrap.innerHTML = '<div class="empty-state">لا يوجد طلاب مطابقون</div>';
          return;
        }
        wrap.innerHTML = `<div class="tafra-students-table-wrap"><table><thead><tr>
          <th class="select-cell"><input type="checkbox" id="select-all-newbot-students" aria-label="تحديد الكل"></th>
          <th>الطالب</th><th>الهاتف</th><th>بدأ بوت المتابعة</th><th>حالة بوت طفرة</th>
        </tr></thead><tbody>${result.students.map(newBotStudentRowHtml).join('')}</tbody></table></div>`;
        wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
            updateSelectedContactsUi();
          });
        });
        document.getElementById('select-all-newbot-students').addEventListener('change', (event) => {
          wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
          });
          updateSelectedContactsUi();
        });
        updateSelectedContactsUi();
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    // ---------- فحص "الوصول الفعلي" لطلاب طفرة المرتبطين اللي ضغطوا Start على بوت طفرة قبل كده
    // (بوت طفرة هو نفس بوت منصة طفرة الرسمي) من غير ما يظهروا في new_bot_contacts ----------
    async function loadNewBotReachabilitySyncStatus() {
      const statusElement = document.getElementById('newbot-reachability-status');
      const button = document.getElementById('run-newbot-reachability-sync');
      try {
        const result = await api('/api/tafra/new-bot-reachability-sync-status');
        const sync = result.sync || {};
        button.disabled = sync.status === 'running';
        if (sync.status === 'running') {
          statusElement.textContent = `جارٍ الفحص: ${sync.checked_count || 0} من ${sync.total_count || '...'} — ${sync.found_reachable || 0} قابل للمراسلة لحد دلوقتي`;
        } else if (sync.status === 'completed') {
          statusElement.textContent = `آخر فحص: ${fmtDate(sync.completed_at)} — ${sync.found_reachable || 0} طالب إضافي قابل للمراسلة من أصل ${sync.total_count || 0} اتفحصوا`;
        } else if (sync.status === 'failed') {
          statusElement.textContent = `فشل آخر فحص: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          statusElement.textContent = 'لسه ما اتعملش فحص للوصول الفعلي — دوس الزرار عشان تبدأ.';
        }
        return sync;
      } catch (error) {
        statusElement.textContent = error.message;
      }
    }

    async function initNewBotTab() {
      await loadTafraStudentFilters(); // بيجهّز خيارات وافتراضي فلتر الباب (الباب الأول + المنهج كاملا)
      loadNewBotReachabilitySyncStatus();
      if (!newBotTabInitialized) {
        newBotTabInitialized = true;
        document.getElementById('run-newbot-reachability-sync').addEventListener('click', async () => {
          const button = document.getElementById('run-newbot-reachability-sync');
          if (!window.confirm('فحص حالة الوصول ممكن ياخد كذا دقيقة (بيتم في الخلفية، مش هيبعت أي رسالة لحد). تكمل؟')) return;
          button.disabled = true;
          try {
            const result = await api('/api/tafra/new-bot-reachability-sync', { method: 'POST' });
            showToast(result.message || 'بدأ الفحص في الخلفية');
            const poll = async () => {
              const sync = await loadNewBotReachabilitySyncStatus();
              if (sync?.status === 'running') setTimeout(poll, 3000);
              else if (sync?.status === 'completed') {
                showToast(`اكتمل الفحص — ${sync.found_reachable || 0} طالب إضافي قابل للمراسلة`);
                loadNewBotStudents();
              } else if (sync?.status === 'failed') showToast('فشل الفحص، راجع التفاصيل');
            };
            setTimeout(poll, 1500);
          } catch (error) {
            showToast(error.message);
            button.disabled = false;
          }
        });
        document.getElementById('newbot-search').addEventListener('input', () => {
          clearTimeout(newBotSearchTimer);
          newBotSearchTimer = setTimeout(() => { newBotStudentsPage = 1; loadNewBotStudents(); }, 350);
        });
        document.getElementById('newbot-status-filter').addEventListener('change', () => {
          newBotStudentsPage = 1; loadNewBotStudents();
        });
        document.getElementById('newbot-telegram-filter').addEventListener('change', () => {
          newBotStudentsPage = 1; loadNewBotStudents();
        });
        document.getElementById('newbot-bootcamp-filter').addEventListener('change', () => {
          newBotStudentsPage = 1; loadNewBotStudents();
        });
        document.getElementById('newbot-gender-filter').addEventListener('change', () => {
          newBotStudentsPage = 1; loadNewBotStudents();
        });
        document.getElementById('clear-newbot-filters').addEventListener('click', () => {
          document.getElementById('newbot-search').value = '';
          document.getElementById('newbot-status-filter').value = '';
          document.getElementById('newbot-telegram-filter').value = '';
          document.getElementById('newbot-gender-filter').value = '';
          document.getElementById('newbot-bootcamp-filter').value = '';
          multiSelectControllers['newbot-bootcamp-filter']?.refresh();
          newBotStudentsPage = 1;
          loadNewBotStudents();
        });
      document.getElementById('newbot-students-prev').addEventListener('click', () => {
        if (newBotStudentsPage > 1) { newBotStudentsPage--; loadNewBotStudents(); }
      });
      document.getElementById('newbot-students-next').addEventListener('click', () => {
        if (newBotStudentsPage < newBotStudentsPages) { newBotStudentsPage++; loadNewBotStudents(); }
      });
      document.getElementById('select-page-newbot-btn').addEventListener('click', () => {
        currentFilteredNewBotContactIds.forEach((id) => selectedContactIds.add(id));
        document.querySelectorAll('#newbot-students-table .contact-selector').forEach((checkbox) => { checkbox.checked = true; });
        updateSelectedContactsUi();
        showToast(`تم تحديد ${currentFilteredNewBotContactIds.length} طالب ممكن مراسلته`);
      });
      document.getElementById('select-all-newbot-btn').addEventListener('click', async () => {
        const btn = document.getElementById('select-all-newbot-btn');
        btn.disabled = true;
        try {
          const result = await api('/api/tafra/students/ids?' + newBotStudentQuery());
          result.ids.forEach((id) => selectedContactIds.add(id));
          document.querySelectorAll('#newbot-students-table .contact-selector').forEach((checkbox) => {
            if (selectedContactIds.has(Number(checkbox.value))) checkbox.checked = true;
          });
          updateSelectedContactsUi();
          showToast(`تم تحديد ${result.ids.length} طالب من كل الصفحات المطابقة للفلتر`);
        } catch (error) {
          showToast(error.message);
        } finally {
          btn.disabled = false;
        }
      });
        document.getElementById('clear-selected-newbot-btn').addEventListener('click', () => {
          selectedContactIds.clear();
          document.querySelectorAll('#newbot-students-table .contact-selector').forEach((checkbox) => { checkbox.checked = false; });
          updateSelectedContactsUi();
        });
        document.getElementById('message-selected-newbot-btn').addEventListener('click', () => goToComposeWithSelection({ prefillNewBot: true }));
      }
      loadNewBotStudents();
    }
    let newBotSearchTimer = null;

    // ---------- رسالة من بوت طفرة نفسه لمشتركين فيه بالفعل (اتجاه عكسي — مثلًا نرجعهم لبوت المتابعة) ----------
    let newBotSubPage = 1;
    let newBotSubPages = 1;
    let newBotSubInitialized = false;
    let newBotSubSearchTimer = null;
    const selectedNewBotSubChatIds = new Set();

    function newBotSubQuery() {
      const params = new URLSearchParams({ page: newBotSubPage, limit: 50 });
      const search = document.getElementById('newbot-sub-search').value.trim();
      if (search) params.set('search', search);
      return params.toString();
    }

    function updateSelectedNewBotSubUi() {
      document.getElementById('selected-newbot-sub-count').textContent = `المحدد: ${selectedNewBotSubChatIds.size}`;
    }

    async function loadNewBotSubscribers() {
      const wrap = document.getElementById('newbot-sub-table');
      try {
        const result = await api('/api/tafra/new-bot-contacts?' + newBotSubQuery());
        newBotSubPages = result.meta.pages;
        document.getElementById('newbot-sub-count').textContent = `مشتركين بوت طفرة (${result.meta.total})`;
        document.getElementById('newbot-sub-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('newbot-sub-prev').disabled = result.meta.page <= 1;
        document.getElementById('newbot-sub-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.contacts.length) {
          wrap.innerHTML = '<div class="empty-state">لسه محدش بدأ بوت طفرة</div>';
          return;
        }
        wrap.innerHTML = `<div class="tafra-students-table-wrap"><table><thead><tr>
          <th class="select-cell"><input type="checkbox" id="select-all-newbot-sub" aria-label="تحديد الكل"></th>
          <th>الاسم</th><th>اليوزر</th><th>بدأ في</th>
        </tr></thead><tbody>${result.contacts.map((c) => `
          <tr>
            <td class="select-cell"><input type="checkbox" class="newbot-sub-selector" value="${c.chat_id}" ${selectedNewBotSubChatIds.has(Number(c.chat_id)) ? 'checked' : ''} aria-label="تحديد المشترك"></td>
            <td>${escapeHtml([c.first_name, c.last_name].filter(Boolean).join(' ') || 'بدون اسم')}</td>
            <td>${c.telegram_username ? '@' + escapeHtml(c.telegram_username) : '—'}</td>
            <td>${c.source === 'platform_link'
              ? '<span class="badge badge-muted" title="اتأكد إنه قابل للمراسلة عن طريق الفحص، مش من ضغطه Start على الهاندلر بتاعنا">🔗 من المنصة</span>'
              : fmtDate(c.started_at)}</td>
          </tr>`).join('')}</tbody></table></div>`;
        wrap.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedNewBotSubChatIds.add(id) : selectedNewBotSubChatIds.delete(id);
            updateSelectedNewBotSubUi();
          });
        });
        document.getElementById('select-all-newbot-sub').addEventListener('change', (event) => {
          wrap.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedNewBotSubChatIds.add(id) : selectedNewBotSubChatIds.delete(id);
          });
          updateSelectedNewBotSubUi();
        });
        updateSelectedNewBotSubUi();
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function initNewBotSubscribersTab() {
      loadNewBotSubscribers();
      // نجهّز رابط بوت المتابعة كقيمة افتراضية للزرار (لو لسه فاضي) — مفيد جدًا لو الرسالة هدفها
      // ترجّع الطالب لبوت المتابعة، وبرضه قابل للتعديل عادي
      api('/api/tafra/new-bot-info').then((info) => {
        const urlField = document.getElementById('newbot-sub-button-url');
        const textField = document.getElementById('newbot-sub-button-text');
        if (info.main_bot_link && !urlField.value) {
          urlField.value = info.main_bot_link;
          if (!textField.value) textField.value = '💬 ارجع لبوت المتابعة';
        }
      }).catch(() => {});
      if (newBotSubInitialized) return;
      newBotSubInitialized = true;
      document.getElementById('newbot-sub-search').addEventListener('input', () => {
        clearTimeout(newBotSubSearchTimer);
        newBotSubSearchTimer = setTimeout(() => { newBotSubPage = 1; loadNewBotSubscribers(); }, 350);
      });
      document.getElementById('refresh-newbot-subs-btn').addEventListener('click', () => {
        newBotSubPage = 1; loadNewBotSubscribers();
      });
      document.getElementById('newbot-sub-prev').addEventListener('click', () => {
        if (newBotSubPage > 1) { newBotSubPage--; loadNewBotSubscribers(); }
      });
      document.getElementById('newbot-sub-next').addEventListener('click', () => {
        if (newBotSubPage < newBotSubPages) { newBotSubPage++; loadNewBotSubscribers(); }
      });
      document.getElementById('select-page-newbot-sub-btn').addEventListener('click', () => {
        document.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
          checkbox.checked = true;
          selectedNewBotSubChatIds.add(Number(checkbox.value));
        });
        updateSelectedNewBotSubUi();
      });
      document.getElementById('clear-selected-newbot-sub-btn').addEventListener('click', () => {
        selectedNewBotSubChatIds.clear();
        document.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => { checkbox.checked = false; });
        updateSelectedNewBotSubUi();
      });
      document.getElementById('clear-newbot-sub-button').addEventListener('click', () => {
        document.getElementById('newbot-sub-button-text').value = '';
        document.getElementById('newbot-sub-button-url').value = '';
      });
      document.getElementById('send-newbot-sub-btn').addEventListener('click', async () => {
        const btn = document.getElementById('send-newbot-sub-btn');
        const message = document.getElementById('newbot-sub-message').value.trim();
        const buttonText = document.getElementById('newbot-sub-button-text').value.trim();
        const buttonUrl = document.getElementById('newbot-sub-button-url').value.trim();
        if (!selectedNewBotSubChatIds.size) return showToast('اختار مشترك واحد على الأقل');
        if (!message) return showToast('اكتب نص الرسالة الأول');
        if (buttonText && !buttonUrl) return showToast('حطيت نص للزرار من غير رابط');
        if (buttonUrl && !/^https?:\/\//i.test(buttonUrl)) return showToast('رابط الزرار لازم يبدأ بـ http:// أو https://');
        if (!confirm(`إرسال الرسالة دي لـ ${selectedNewBotSubChatIds.size} مشترك عن طريق بوت طفرة؟`)) return;
        btn.disabled = true;
        try {
          const result = await api('/api/tafra/new-bot-broadcast', {
            method: 'POST',
            body: JSON.stringify({
              chat_ids: [...selectedNewBotSubChatIds], message,
              button_text: buttonText || undefined, button_url: buttonUrl || undefined,
            }),
          });
          showToast(`تم الإرسال: ${result.sent} نجح${result.failed ? ` — ${result.failed} فشل` : ''}`);
          selectedNewBotSubChatIds.clear();
          updateSelectedNewBotSubUi();
          loadNewBotSubscribers();
        } catch (error) {
          showToast(error.message);
        } finally {
          btn.disabled = false;
        }
      });
    }
    const newBotSubTabBtn = document.querySelector('#new-bot-subtabs .subtab-btn[data-subtab="subscribers"]');
    if (newBotSubTabBtn) {
      newBotSubTabBtn.addEventListener('click', initNewBotSubscribersTab);
    }

    document.getElementById('csv-input').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/contacts/import', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        showToast(`تم استيراد ${data.imported} جهة اتصال${data.skipped ? ` (${data.skipped} اتجاهلت)` : ''}`);
        loadContacts();
      } catch (err) { showToast(err.message); }
      e.target.value = '';
    });

    // ---------- القوالب والتصنيفات (مشتركة) ----------
    async function loadTagsIntoSelect() {
      try {
        const tags = await api('/api/tags');
        const select = document.getElementById('broadcast-tag');
        const currentValue = select.value;
        select.innerHTML = '<option value="">كل جهات الاتصال</option>' +
          `<option value="__selected__">الجهات المحددة (${selectedContactIds.size})</option>` +
          tags.map((t) => `<option value="${t.id}">${t.name}</option>`).join('');
        if ([...select.options].some((option) => option.value === currentValue)) select.value = currentValue;
        updateSelectedContactsUi();
      } catch (e) { /* تجاهل بصمت لو مفيش تصنيفات لسه */ }
    }

    async function loadTemplates() {
      const list = document.getElementById('templates-list');
