          if (sync?.status === 'running' || sync?.status === 'discovering') setTimeout(poll, 3000);
          else if (sync?.status === 'completed') showToast(`اكتمل تحديث الاختبارات — ${sync.synced_marks || 0} درجة`);
          else if (sync?.status === 'failed') showToast('فشل تحديث الاختبارات، راجع التفاصيل');
        };
        setTimeout(poll, 1500);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
