    let callAutoAssignLogPage = 1;
    let callAutoAssignLogPages = 1;

    async function loadCallAutoAssignLog() {
      const wrap = document.getElementById('call-auto-assign-log-table');
      try {
        const result = await api('/api/calls/auto-assign-log?page=' + callAutoAssignLogPage);
        callAutoAssignLogPages = result.meta.pages;
        document.getElementById('call-auto-assign-log-page-label').textContent =
          `صفحة ${result.meta.page} من ${result.meta.pages} — إجمالي ${result.meta.total}`;
        document.getElementById('call-auto-assign-log-prev').disabled = result.meta.page <= 1;
        document.getElementById('call-auto-assign-log-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.log.length) {
          wrap.innerHTML = '<div class="empty-state">لسه مفيش أي إسناد تلقائي حصل</div>';
          return;
        }
        wrap.innerHTML = `
          <table>
            <thead><tr><th>الطالب</th><th>الهاتف</th><th>الكورس</th><th>تاريخ الاشتراك</th><th>الموظف</th><th>تاريخ الإسناد</th></tr></thead>
            <tbody>
              ${result.log.map((row) => `
                <tr>
                  <td>${escapeHtml(row.student_name || '—')}</td>
                  <td>${escapeHtml(row.phone || '—')}</td>
                  <td>${escapeHtml(row.bootcamp_name || '—')}</td>
                  <td>${fmtDate(row.enrolled_at)}</td>
                  <td>${escapeHtml(row.assigned_to_name || '—')}</td>
                  <td>${fmtDate(row.assigned_at)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }
    document.getElementById('call-auto-assign-log-prev').addEventListener('click', () => {
      if (callAutoAssignLogPage > 1) { callAutoAssignLogPage -= 1; loadCallAutoAssignLog(); }
    });
    document.getElementById('call-auto-assign-log-next').addEventListener('click', () => {
      if (callAutoAssignLogPage < callAutoAssignLogPages) { callAutoAssignLogPage += 1; loadCallAutoAssignLog(); }
    });

    let selectedCallAutoAssignEmployeeIds = new Set();
    let selectedCallAutoAssignBootcampIds = new Set();

    async function loadCallAutoAssignConfig() {
      const bootcampsWrap = document.getElementById('call-auto-assign-bootcamps');
      const employeesWrap = document.getElementById('call-auto-assign-employees');
      const statusElement = document.getElementById('call-auto-assign-status');
      try {
        const [config, filters, assignees] = await Promise.all([
          api('/api/calls/auto-assign-config'),
          api('/api/tafra/student-filters'),
          api('/api/calls/assignees'),
        ]);

        document.getElementById('call-auto-assign-enabled').checked = Boolean(config.enabled);

        selectedCallAutoAssignBootcampIds = new Set((config.bootcamp_ids || []).map(String));
        const bootcamps = filters.bootcamps || [];
        bootcampsWrap.innerHTML = bootcamps.length
          ? bootcamps.map((item) => `
              <label class="multiselect-option">
                <input type="checkbox" class="call-auto-assign-bootcamp-checkbox" value="${escapeHtml(String(item.id))}"
                  ${selectedCallAutoAssignBootcampIds.has(String(item.id)) ? 'checked' : ''}>
                <span>${escapeHtml(item.name)}</span>
              </label>`).join('')
          : '<div class="empty-state">لا يوجد أبواب/كورسات محفوظة</div>';
        bootcampsWrap.querySelectorAll('.call-auto-assign-bootcamp-checkbox').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            checkbox.checked
              ? selectedCallAutoAssignBootcampIds.add(checkbox.value)
              : selectedCallAutoAssignBootcampIds.delete(checkbox.value);
          });
        });

        selectedCallAutoAssignEmployeeIds = new Set((config.employee_ids || []).map(String));
        employeesWrap.innerHTML = assignees.length
          ? assignees.map((user) => `
              <label class="multiselect-option">
                <input type="checkbox" class="call-auto-assign-employee-checkbox" value="${user.id}"
                  ${selectedCallAutoAssignEmployeeIds.has(String(user.id)) ? 'checked' : ''}>
                <span>${escapeHtml(user.name)}</span>
              </label>`).join('')
          : '<div class="empty-state">لا يوجد موظفين نشطين</div>';
        employeesWrap.querySelectorAll('.call-auto-assign-employee-checkbox').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            checkbox.checked
              ? selectedCallAutoAssignEmployeeIds.add(checkbox.value)
              : selectedCallAutoAssignEmployeeIds.delete(checkbox.value);
          });
        });

        const bootcampNames = (config.bootcamps || []).map((b) => b.name).join('، ');
        statusElement.textContent = config.enabled
          ? `مفعّل حاليًا على: ${bootcampNames || '—'} — آخر تحديث للإعدادات: ${fmtDate(config.updated_at)}`
          : 'الإسناد التلقائي غير مفعّل حاليًا.';
      } catch (error) {
        statusElement.textContent = error.message;
      }
    }

    document.getElementById('save-call-auto-assign').addEventListener('click', async () => {
      const button = document.getElementById('save-call-auto-assign');
      const enabled = document.getElementById('call-auto-assign-enabled').checked;
      const bootcampIds = [...selectedCallAutoAssignBootcampIds].map(Number);
      const employeeIds = [...selectedCallAutoAssignEmployeeIds].map(Number);
      if (enabled && !bootcampIds.length) return showToast('اختر كورس واحد على الأقل');
      if (enabled && !employeeIds.length) return showToast('اختر موظف واحد على الأقل للتوزيع بالتبادل');
      button.disabled = true;
      try {
        await api('/api/calls/auto-assign-config', {
          method: 'POST',
          body: JSON.stringify({ enabled, bootcamp_ids: bootcampIds, employee_ids: employeeIds }),
        });
        showToast('تم حفظ إعدادات الإسناد التلقائي');
        await loadCallAutoAssignConfig();
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
      }
    });

    let selectedSelectiveSyncBootcampIds = new Set();

    function updateSelectiveSyncSelectedCount() {
      const count = selectedSelectiveSyncBootcampIds.size;
      document.getElementById('selective-sync-selected-count').textContent =
        count ? `المحدد: ${count} باب` : 'لسه محددتش أي باب';
    }

    async function loadSelectiveSyncBootcampList() {
      const wrap = document.getElementById('selective-sync-bootcamp-list');
      try {
        const filters = await api('/api/tafra/student-filters');
        const bootcamps = filters.bootcamps || [];
        wrap.innerHTML = bootcamps.length
          ? bootcamps.map((item) => `
              <label class="multiselect-option">
                <input type="checkbox" class="selective-sync-bootcamp-checkbox" value="${escapeHtml(String(item.id))}"
                  ${selectedSelectiveSyncBootcampIds.has(String(item.id)) ? 'checked' : ''}>
                <span>${escapeHtml(item.name)}</span>
              </label>`).join('')
          : '<div class="empty-state">لا يوجد أبواب/كورسات محفوظة — حدّث أسماء الأبواب من "ربط طفرة" الأول</div>';
        wrap.querySelectorAll('.selective-sync-bootcamp-checkbox').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            checkbox.checked
              ? selectedSelectiveSyncBootcampIds.add(checkbox.value)
              : selectedSelectiveSyncBootcampIds.delete(checkbox.value);
            updateSelectiveSyncSelectedCount();
          });
        });
        updateSelectiveSyncSelectedCount();
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function loadSelectiveSyncStatus() {
      const statusElement = document.getElementById('selective-sync-status');
      const button = document.getElementById('run-selective-sync');
      try {
        const result = await api('/api/tafra/selective-sync-status');
        const sync = result.sync || {};
        button.disabled = sync.status === 'running';
        if (sync.status === 'running') {
          statusElement.textContent = `جارٍ التحديث (${sync.bootcamp_names || ''}): الباب ${sync.current_bootcamp || 0} من ${sync.total_bootcamps || '...'} — ${sync.synced_enrollments || 0} سجل`;
        } else if (sync.status === 'completed') {
          statusElement.textContent = `آخر تحديث انتقائي: ${fmtDate(sync.completed_at)} — ${sync.bootcamp_names || ''} (${sync.synced_enrollments || 0} سجل)`;
        } else if (sync.status === 'failed') {
          statusElement.textContent = `فشل آخر تحديث انتقائي: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          statusElement.textContent = 'لم يتم أي تحديث انتقائي بعد.';
        }
        return sync;
      } catch (error) {
        statusElement.textContent = error.message;
      }
    }

    document.getElementById('run-selective-sync').addEventListener('click', async () => {
      const button = document.getElementById('run-selective-sync');
      const bootcampIds = [...selectedSelectiveSyncBootcampIds].map(Number);
      if (!bootcampIds.length) return showToast('اختار باب واحد على الأقل');
      if (!window.confirm(`بدء تحديث بيانات واشتراكات طلاب ${bootcampIds.length} باب مختار؟ لن يتم تعديل منصة طفرة.`)) return;
      button.disabled = true;
      try {
        const result = await api('/api/tafra/sync-selected-bootcamps', {
          method: 'POST', body: JSON.stringify({ bootcamp_ids: bootcampIds })
        });
        showToast(result.message || 'بدأ تحديث الأبواب المختارة في الخلفية');
        const poll = async () => {
          const sync = await loadSelectiveSyncStatus();
          if (sync?.status === 'running') setTimeout(poll, 3000);
          else if (sync?.status === 'completed') showToast(`اكتمل تحديث الأبواب المختارة — ${sync.synced_enrollments || 0} سجل`);
          else if (sync?.status === 'failed') showToast('فشل تحديث الأبواب المختارة، راجع التفاصيل');
        };
        setTimeout(poll, 1500);
      } catch (error) {
        showToast(error.message);
        button.disabled = false;
      }
    });

    async function loadTafraExamSyncStatus() {
      const detailsElement = document.getElementById('tafra-exam-sync-details');
      const button = document.getElementById('sync-tafra-exams');
      try {
        const result = await api('/api/tafra/exam-sync-status');
        const sync = result.sync || {};
        button.disabled = sync.status === 'running' || sync.status === 'discovering';
        if (sync.status === 'discovering') {
          detailsElement.textContent = `جارٍ اكتشاف الاختبارات (المنصة بترجّع أحدث 10 بس، فبنمسح رقم رقم): ${sync.total_exams || 0} اختبار اتلقى لحد دلوقتي`;
        } else if (sync.status === 'running') {
          detailsElement.textContent = `جارٍ سحب الدرجات: الاختبار ${sync.current_exam || 0} من ${sync.total_exams || '...'} — ${sync.synced_marks || 0} درجة`;
        } else if (sync.status === 'completed') {
          detailsElement.textContent = `آخر تحديث: ${fmtDate(sync.completed_at)} — ${result.exam_count || 0} اختبار، ${result.marks_count || 0} درجة`;
        } else if (sync.status === 'failed') {
          detailsElement.textContent = `فشل آخر تحديث: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          detailsElement.textContent = 'لم يتم تحديث الاختبارات بعد.';
        }
        return sync;
      } catch (error) {
        detailsElement.textContent = error.message;
      }
    }

    async function loadTafraStatus() {
      const statusElement = document.getElementById('tafra-connection-status');
      const detailsElement = document.getElementById('tafra-sync-details');
      const syncButton = document.getElementById('sync-tafra-students');
      try {
        const result = await api('/api/tafra/status');
        statusElement.textContent = result.configured ? '✓ بيانات الربط محفوظة — وضع القراءة فقط' : 'لم تُحفظ بيانات الربط بعد';
        statusElement.className = result.configured ? 'badge badge-success' : 'badge badge-muted';
        syncButton.disabled = !result.configured || result.sync?.status === 'running';
        const sync = result.sync || {};
        if (sync.status === 'running') {
          detailsElement.textContent = `جارٍ التحديث: الصفحة ${sync.current_page || 0} من ${sync.total_pages || '...'} — تم جلب ${sync.synced_students || 0} طالب`;
        } else if (sync.status === 'completed') {
          detailsElement.textContent = `آخر تحديث ناجح: ${fmtDate(sync.completed_at)} — الطلاب: ${sync.synced_students || 0} — المرتبطون بتيليجرام: ${sync.telegram_students || 0}`;
        } else if (sync.status === 'failed') {
          detailsElement.textContent = `فشل آخر تحديث: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          detailsElement.textContent = 'لم تتم مزامنة الطلاب بعد.';
        }
      } catch (error) {
        statusElement.textContent = 'تعذر قراءة حالة الربط';
        statusElement.className = 'badge badge-danger';
        detailsElement.textContent = error.message;
      }
    }

    document.getElementById('save-tafra-credentials').addEventListener('click', async () => {
      const button = document.getElementById('save-tafra-credentials');
      const identifier = document.getElementById('tafra-identifier').value.trim();
      const password = document.getElementById('tafra-password').value;
      if (!identifier || !password) return showToast('أدخل رقم الهاتف أو البريد وكلمة المرور');
      button.disabled = true;
      try {
        const result = await api('/api/tafra/credentials', {
          method: 'POST', body: JSON.stringify({ identifier, password })
        });
        document.getElementById('tafra-password').value = '';
        showToast(result.message || 'تم حفظ الربط');
        await loadTafraStatus();
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
      }
    });

    document.getElementById('sync-tafra-exams').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-exams');
      if (!window.confirm('بدء قراءة كل الاختبارات (أونلاين وورقي) ودرجات الطلاب فيها؟ لن يتم تعديل منصة طفرة. المنصة بترجّع أحدث 10 اختبارات بس في القائمة العادية، فبنمسح كل رقم لوحده للتأكد إننا هنجيب كل الاختبارات — العملية ممكن تاخد كام دقيقة.')) return;
      button.disabled = true;
