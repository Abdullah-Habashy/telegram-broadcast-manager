      document.querySelector('.ticket-workspace').classList.remove('ticket-open');
      document.getElementById('tab-tickets').classList.remove('ticket-open-view');
      currentTicketId = null;
      loadTickets();
    }

    ['ticket-status-filter', 'ticket-subtitle-filter', 'ticket-priority-filter', 'ticket-category-filter', 'ticket-assignee-filter', 'ticket-follow-up-filter', 'ticket-sent-filter', 'ticket-received-filter', 'ticket-unread-filter', 'ticket-idea-filter']
