    // ---------- صندوق الدعم ----------
    const ticketLabels = {
      status: {
        new: 'جديدة', in_progress: 'قيد المتابعة', waiting_student: 'بانتظار الطالب',
        resolved: 'مكتملة', closed: 'مغلقة'
      },
      priority: { low: 'منخفضة', normal: 'عادية', urgent: 'عاجلة' },
      category: {
        general: 'عام', registration: 'تسجيل', fees: 'مصروفات', results: 'نتائج',
        platform: 'المنصة', complaint: 'شكوى', technical: 'تقني'
      }
    };

    async function ensureTicketsMeta() {
      if (!ticketsMeta) ticketsMeta = await api('/api/tickets/meta');
      return ticketsMeta;
    }

    async function initTickets() {
      initLiveEvents();
      try {
        await ensureTicketsMeta();
        const assigneeFilter = document.getElementById('ticket-assignee-filter');
        assigneeFilter.innerHTML = '<option value="">كل الموظفين</option><option value="unassigned">غير معيّنة</option>' +
          ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
        const subtitleFilter = document.getElementById('ticket-subtitle-filter');
        subtitleFilter.innerHTML = '<option value="">كل العناوين الفرعية</option>' +
          ticketsMeta.subtitles.map((subtitle) => `<option value="${subtitle.id}">${escapeHtml(subtitle.name)}</option>`).join('');
        const maxIdea = ticketsMeta.max_idea_number || 20;
        const ideaFilter = document.getElementById('ticket-idea-filter');
        if (ideaFilter) {
          ideaFilter.innerHTML = '<option value="">كل الأفكار</option><option value="0">لم يُحدَّد بعد</option>' +
            Array.from({ length: maxIdea }, (_, i) => i + 1)
              .map((n) => `<option value="${n}">فكرة ${n}</option>`).join('');
        }
      } catch (error) {
        return showToast(error.message);
      }
      // خيارات فلاتر الطلاب المشتركة (الصف، الحالة، الباب، الاختبار، نتايج المكالمات، الموظفين).
      // كل ده جوه try عشان لو أي منها فشل — مثلًا موظف مالوش صلاحية المتابعة التليفونية — الشاشة
      // تفضل شغالة بفلاترها الأصلية بدل ما تقف من غير أي تذاكر
      try {
        // الترتيب مهم: التحميل بيتخطّى نفسه لو شاشة تانية سبقته، فالتعبئة بتتنادى صراحةً بعده
        await loadTafraStudentFilters();
        applyStudentFilterOptions('tickets', tafraFilterOptions);
        if (canViewCalls) {
          if (!callOutcomes.length) await loadCallOutcomes();
          populateCallOutcomeFilter('tickets');
        }
        if (currentUserRole === 'admin' || canAssignCalls) {
          if (!callAssignees.length) await loadCallAssignees();
          populateCallAssigneeFilters('tickets');
        }
      } catch (error) {
        console.warn('تعذر تحميل خيارات فلاتر الطلاب في صندوق الدعم:', error.message);
      }

      // الاسترجاع هنا بالذات: بعد ما قوايم الموظفين/العناوين/الأفكار اتملت، وقبل أول تحميل
      const SHARED_TICKET_FILTER_IDS = filtersFor('tickets').map((def) => filterId(def, 'tickets'));
      const TICKET_FILTER_IDS = ['ticket-search','ticket-status-filter','ticket-subtitle-filter','ticket-priority-filter','ticket-category-filter','ticket-assignee-filter','ticket-follow-up-filter','ticket-sent-filter','ticket-received-filter','ticket-idea-filter','ticket-unread-filter','ticket-awaiting-reply-filter','ticket-unassigned-filter','ticket-never-replied-filter',
        ...SHARED_TICKET_FILTER_IDS];
      registerFilterGroup('tickets', TICKET_FILTER_IDS);
      bindStudentFilterEvents('tickets', () => {
        ticketsPage = 1;
        updateAgentFilterIndicator();
        loadTickets();
      });
      // فلتر الحضور بيبدأ بـ "دخل الاختبار" مش فاضي، فالتصفير بيرجّعه لقيمته دي مش لفاضي
      const ticketsAttendanceId = filterId(STUDENT_FILTER_DEFS.find((def) => def.key === 'attendance'), 'tickets');
      document.getElementById('clear-ticket-filters')?.addEventListener('click', () => {
        ticketsPage = 1;
        resetFilterGroup('tickets', TICKET_FILTER_IDS, loadTickets, { [ticketsAttendanceId]: 'entered' });
      });
      loadTickets();
      if (currentUserTeam) initTeamAttendance();
      if (currentUserRole === 'admin') {
        loadAdminUsers();
        // نفس تنافي المربعين في كارت الموظف — نموذج الإضافة لازم يمنع تعليم الاتنين كمان،
        // وإلا الأدمن يعلّم اتنين ويتحفظ واحد من غير ما حد يقوله
        document.querySelectorAll('.new-staff-team').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            if (!checkbox.checked) return;
            document.querySelectorAll('.new-staff-team').forEach((other) => {
              if (other !== checkbox) other.checked = false;
            });
          });
        });
      }
      if (pendingDeepLinkTicketId) {
        const ticketId = Number(pendingDeepLinkTicketId);
        pendingDeepLinkTicketId = null;
        history.replaceState(null, '', location.pathname);
        loadTicket(ticketId);
      }
    }

    // زرار الحضور بتاع التيمات المتخصصة. التذاكر مابتتحوّلش على حد مش مسجّل حضور، والانصراف
    // بيرجّع كل اللي في إيده لفريق المتابعة — عشان مايفضلش سؤال طالب واقف عند حد مشي
    async function initTeamAttendance() {
      const button = document.getElementById('team-attendance-btn');
      const info = document.getElementById('team-attendance-info');
      if (!button || button.dataset.bound === '1') return;
      button.dataset.bound = '1';

      const render = (state) => {
        button.textContent = state.present ? 'تسجيل الانصراف' : 'تسجيل الحضور';
        button.className = state.present ? 'btn btn-danger-ghost btn-sm' : 'btn btn-sm';
        button.style.width = 'auto';
        info.textContent = state.present
          ? `حاضر من ${fmtDate(state.started_at)}${state.holding ? ` · ${state.holding} تذكرة معاك` : ''}`
          : 'مش هيتحوّلك تذاكر لحد ما تسجّل حضور';
      };

      const refresh = async () => {
        try { render(await api('/api/tickets/teams/attendance')); }
        catch (error) { info.textContent = error.message; }
      };

      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          const state = await api('/api/tickets/teams/attendance');
          if (state.present && state.holding
            && !confirm(`معاك ${state.holding} تذكرة، هترجع لفريق المتابعة. تأكيد الانصراف؟`)) return;
          const result = await api(`/api/tickets/teams/attendance/${state.present ? 'check-out' : 'check-in'}`,
            { method: 'POST' });
          showToast(result.present ? 'اتسجّل حضورك' : `اتسجّل انصرافك${result.returned ? ` — رجّعنا ${result.returned} تذكرة` : ''}`);
          await refresh();
          loadTickets();
        } catch (error) { showToast(error.message); }
        finally { button.disabled = false; }
      });

      await refresh();
    }

    // ---------- تسجيل رسالة صوتية للطالب ----------
    //
    // اتجاه واحد: الموظف بيسجّل ويبعت. أول ضغطة بتبدأ التسجيل، والتانية بتوقفه وتبعته على طول
    // — من غير مرحلة "معاينة قبل الإرسال"، لأن ده رد في محادثة شغالة مش استوديو.
    //
    // ترتيب الصيغ مهم: تليجرام بيقبل ogg/opus وm4a وmp3 بس. لو المتصفح يقدر يطلّع واحدة منهم
    // بنستخدمها ويتبعت من غير أي تحويل. كروم وإيدچ مابيقدروش، فبيطلّعوا webm والسيرفر بيغيّر
    // الحاوية بس (نسخ stream، من غير إعادة ترميز)
    const VOICE_MIME_PREFERENCE = [
      'audio/ogg;codecs=opus',
      'audio/mp4',
      'audio/webm;codecs=opus',
      'audio/webm',
    ];
    let voiceRecorder = null;
    let voiceTimer = null;

    function pickVoiceMime() {
      if (typeof MediaRecorder === 'undefined') return null;
      return VOICE_MIME_PREFERENCE.find((type) => MediaRecorder.isTypeSupported(type)) || '';
    }

    function stopVoiceTracks(stream) {
      stream.getTracks().forEach((track) => track.stop());
    }

    async function startVoiceRecording(button, ticketId) {
      if (!navigator.mediaDevices?.getUserMedia) {
        return showToast('متصفحك مابيدعمش التسجيل الصوتي');
      }
      const mimeType = pickVoiceMime();
      if (mimeType === null) return showToast('متصفحك مابيدعمش التسجيل الصوتي');

      let stream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (error) {
        // المستخدم رفض الإذن أو مفيش مايك — الرسالة بتفرّق بين الحالتين عشان يعرف يتصرف
        return showToast(error.name === 'NotAllowedError'
          ? 'لازم تسمح للموقع باستخدام المايك من إعدادات المتصفح'
          : 'مفيش مايك متاح');
      }

      const chunks = [];
      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
      recorder.addEventListener('dataavailable', (event) => {
        if (event.data.size) chunks.push(event.data);
      });
      recorder.addEventListener('stop', async () => {
        stopVoiceTracks(stream);
        clearInterval(voiceTimer);
        voiceRecorder = null;
        button.classList.remove('recording');
        button.textContent = '🎙️';
        if (recorder.cancelled || !chunks.length) return;

        button.disabled = true;
        try {
          const blob = new Blob(chunks, { type: recorder.mimeType || mimeType || 'audio/webm' });
          const form = new FormData();
          // الامتداد هنا شكلي — السيرفر بياخد الصيغة من نوع المحتوى مش من الاسم
          form.append('voice', blob, 'voice');
          const response = await fetch(`/api/tickets/${ticketId}/voice`, { method: 'POST', body: form });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'تعذر إرسال التسجيل');
          showToast('اتبعت التسجيل الصوتي');
          loadTicket(ticketId);
          loadTickets();
        } catch (error) { showToast(error.message); }
        finally { button.disabled = false; }
      });

      recorder.start();
      voiceRecorder = recorder;
      button.classList.add('recording');
      let seconds = 0;
      const tick = () => {
        seconds += 1;
        button.textContent = `⏹ ${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
        // حد أقصى ٥ دقايق: بعدها بيقف ويتبعت لوحده بدل ما يفضل شغال لو حد نسيه
        if (seconds >= 300) recorder.stop();
      };
      button.textContent = '⏹ 00:00';
      voiceTimer = setInterval(tick, 1000);
    }

    function bindVoiceButton(ticketId) {
      const button = document.getElementById('ticket-voice-btn');
      if (!button) return;
      button.addEventListener('click', () => {
        if (voiceRecorder) voiceRecorder.stop();
        else startVoiceRecording(button, ticketId);
      });
      // قفل المحادثة والتسجيل شغال: بنلغيه بدل ما نبعت تسجيل الموظف نسي إنه بيتعمل
      button.addEventListener('cancel-voice', () => {
        if (!voiceRecorder) return;
        voiceRecorder.cancelled = true;
        voiceRecorder.stop();
      });
    }

    // ---------- الردود الجاهزة ----------
    // الضغط بيحط النص في مربع الرد **مش بيبعته**: الموظف بيعدّل عليه (اسم، تفصيلة) وبعدين
    // يبعت. الإرسال المباشر كان هيخلّي أي دوسة غلط رسالة راحت للطالب فعلًا.
    // بتتحمّل مرة واحدة وبتتخزّن، مش مع كل تذكرة بيفتحها
    let quickRepliesCache = null;
    let aiProviders = [];

    // "بتوعي بس" ولا "الكل". بيتخزّن في المتصفح زي باقي الفلاتر في اللوحة، فاختيار الموظف
    // بيفضل معاه بين الجلسات من غير عمود في القاعدة
    const QUICK_REPLY_SCOPE_KEY = 'quick-reply-scope';
    function quickReplyScope() {
      try { return localStorage.getItem(QUICK_REPLY_SCOPE_KEY) === 'mine' ? 'mine' : 'all'; }
      catch (_) { return 'all'; }
    }

    // **مصدر واحد للاتنين**: الشرايح وقايمة / بيندهوا الدالة دي، فالترقيم والمحتوى مستحيل
    // يختلفوا بينهم. لو كل واحد فلتر لوحده، /3 كان ممكن يوصل لرد غير اللي رقمه ٣ على الشاشة
    function visibleQuickReplies() {
      const all = (quickRepliesCache || []).filter((r) => r.is_active);
      return quickReplyScope() === 'mine' ? all.filter((r) => r.is_mine) : all;
    }

    async function renderQuickReplies() {
      const bar = document.getElementById('quick-replies-bar');
      if (!bar) return;
      try {
        if (!quickRepliesCache) {
          quickRepliesCache = (await api('/api/assist/quick-replies')).quick_replies || [];
        }
        const total = quickRepliesCache.filter((row) => row.is_active).length;
        const mineCount = quickRepliesCache.filter((row) => row.is_active && row.is_mine).length;
        if (!total) { bar.innerHTML = ''; return; }
        const active = visibleQuickReplies();
        const scope = quickReplyScope();
        // المفتاح بيظهر بس لما يكون فيه ردود شخصية فعلًا — من غيرها هو خيار بين "الكل"
        // و"مفيش حاجة"، وده مش خيار
        const toggle = mineCount
          ? `<button type="button" class="quick-reply-scope ${scope === 'mine' ? 'on' : ''}" id="quick-reply-scope-btn"
               title="${scope === 'mine' ? `بتشوف بتوعك بس (${mineCount}) — اضغط لعرض الكل (${total})` : `بتشوف الكل (${total}) — اضغط لعرض بتوعك بس (${mineCount})`}">${scope === 'mine' ? '👤 بتوعي' : '👥 الكل'}</button>`
          : '';
        // الرقم على كل شريحة هو نفسه اللي بيشتغل مع /: الموظف بيشوفه وهو بيستخدم الشرايح
        // فبيحفظه من غير ما يحفظ حاجة، وبعد كام يوم بيكتب /3 على طول
        bar.innerHTML = toggle + active.map((row, i) => `
          <button type="button" class="quick-reply-chip" data-quick-reply="${row.id}"
            title="${escapeHtml(row.content.slice(0, 160))}"><span class="quick-reply-num">${i + 1}</span>${escapeHtml(row.title)}</button>`).join('');
        document.getElementById('quick-reply-scope-btn')?.addEventListener('click', () => {
          try { localStorage.setItem(QUICK_REPLY_SCOPE_KEY, scope === 'mine' ? 'all' : 'mine'); } catch (_) {}
          renderQuickReplies();
        });
        bar.querySelectorAll('[data-quick-reply]').forEach((button) => {
          button.addEventListener('click', () => {
            const reply = active.find((row) => String(row.id) === button.dataset.quickReply);
            if (!reply) return;
            const box = document.getElementById('ticket-reply-content');
            // بيتضاف لآخر اللي مكتوب مش بيمسحه — الموظف ممكن يكون كاتب مقدمة بإيده
            box.value = box.value.trim() ? `${box.value.trim()}
${reply.content}` : reply.content;
            box.focus();
            box.dispatchEvent(new Event('input'));
          });
        });
      } catch (_) { bar.innerHTML = ''; }
    }

    // ---------- شاشة الردود الجاهزة وقاعدة المعرفة (أدمن) ----------
    const OUTCOME_LABELS = {
      sent: ['✅ اتبعت', 'stat-success'],
      asked: ['❓ سأل سؤال توضيحي', 'stat-success'],
      no_answer: ['🔍 مش في المصدر', 'stat-muted'],
      blocked: ['🚫 موضوع ممنوع', 'stat-warning'],
      error: ['⚠️ خطأ', 'stat-warning'],
    };

    async function loadQuickRepliesAdmin() {
      const list = document.getElementById('qr-list');
      if (!list) return;
      try {
        const data = await api('/api/assist/quick-replies');
        quickRepliesCache = data.quick_replies || [];
        list.innerHTML = quickRepliesCache.length
          ? quickRepliesCache.map((row) => `
            <div class="row-between" style="padding:8px 0; border-bottom:1px solid var(--border); gap:8px">
              <div style="flex:1; min-width:0">
                <b>${escapeHtml(row.title)}</b>
                <div class="ticket-muted" style="font-size:12px; white-space:pre-wrap">${escapeHtml(row.content)}</div>
              </div>
              <label class="icon-toggle" title="مفعّل"><input type="checkbox" data-qr-active="${row.id}" ${row.is_active ? 'checked' : ''}> ⚡</label>
              <button type="button" class="btn btn-danger-ghost btn-sm" data-qr-del="${row.id}" style="width:auto">حذف</button>
            </div>`).join('')
          : '<div class="empty-state">مفيش ردود جاهزة لسه</div>';
        list.querySelectorAll('[data-qr-active]').forEach((box) => {
          box.addEventListener('change', () => api(`/api/assist/quick-replies/${box.dataset.qrActive}`,
            { method: 'PATCH', body: JSON.stringify({ is_active: box.checked }) })
            .then(() => { quickRepliesCache = null; showToast('اتحدّث'); })
            .catch((e) => showToast(e.message)));
        });
        list.querySelectorAll('[data-qr-del]').forEach((button) => {
          button.addEventListener('click', async () => {
            if (!confirm('تحذف الرد الجاهز ده؟')) return;
            try {
              await api(`/api/assist/quick-replies/${button.dataset.qrDel}`, { method: 'DELETE' });
              quickRepliesCache = null;
              loadQuickRepliesAdmin();
            } catch (e) { showToast(e.message); }
          });
        });
      } catch (e) { list.innerHTML = `<div class="empty-state">${escapeHtml(e.message)}</div>`; }
    }

    async function loadKnowledge() {
      const list = document.getElementById('kb-list');
      const status = document.getElementById('ai-status');
      if (!list) return;
      try {
        const data = await api('/api/assist/knowledge');
        // الحالة بتقول صراحةً ليه الميزة مش شغالة — أكتر سببين إن المفتاح ناقص أو القاعدة فاضية
        aiProviders = data.providers || [];
        const ready = aiProviders.filter((p) => p.available);
        status.innerHTML = ready.length
          ? `${ready.map((p) => '✅ ' + escapeHtml(p.label)).join(' · ')} · ${data.knowledge.filter((k) => k.is_active).length} معلومة مفعّلة`
          : '<b style="color:var(--danger)">مفيش أي مفتاح مضبوط</b> — ضيف ANTHROPIC_API_KEY أو GROQ_API_KEY في ملف .env على السيرفر';
        const select = document.getElementById('ai-provider');
        // المزوّد اللي مفتاحه مش مضبوط بيظهر معطّل مش مخفي — عشان تعرف إنه موجود وناقصه مفتاح
        select.innerHTML = aiProviders.map((p) =>
          `<option value="${p.key}" ${p.available ? '' : 'disabled'}>${escapeHtml(p.label)}${p.available ? '' : ' (مفيش مفتاح)'}</option>`).join('');
        list.innerHTML = data.knowledge.length
          ? data.knowledge.map((row) => `
            <div class="row-between" style="padding:8px 0; border-bottom:1px solid var(--border); gap:8px">
              <div style="flex:1; min-width:0">
                <b>${escapeHtml(row.question)}</b>
                <div class="ticket-muted" style="font-size:12px; white-space:pre-wrap">${escapeHtml(row.answer)}</div>
              </div>
              <label class="icon-toggle" title="مفعّلة — المعطّلة بتتشال من المصدر فورًا"><input type="checkbox" data-kb-active="${row.id}" ${row.is_active ? 'checked' : ''}> ⚡</label>
              <button type="button" class="btn btn-danger-ghost btn-sm" data-kb-del="${row.id}" style="width:auto">حذف</button>
            </div>`).join('')
          : '<div class="empty-state">قاعدة المعرفة فاضية — النموذج مش هيرد على أي حاجة لحد ما تضيف معلومات</div>';
        list.querySelectorAll('[data-kb-active]').forEach((box) => {
          box.addEventListener('change', () => api(`/api/assist/knowledge/${box.dataset.kbActive}`,
            { method: 'PATCH', body: JSON.stringify({ is_active: box.checked }) })
            .then(() => showToast('اتحدّث')).catch((e) => showToast(e.message)));
        });
        list.querySelectorAll('[data-kb-del]').forEach((button) => {
          button.addEventListener('click', async () => {
            if (!confirm('تحذف المعلومة دي؟')) return;
            try {
              await api(`/api/assist/knowledge/${button.dataset.kbDel}`, { method: 'DELETE' });
              loadKnowledge();
            } catch (e) { showToast(e.message); }
          });
        });
      } catch (e) { list.innerHTML = `<div class="empty-state">${escapeHtml(e.message)}</div>`; }
    }

    // ---------- المساحة التجريبية ----------
    // المحادثة في المتصفح بس — مفيش تخزين على السيرفر. الحصاد بياخد النص كله ويرجّع اقتراحات،
    // والاقتراحات هي اللي بتتحفظ لو الأدمن وافق. الرسايل نفسها مالهاش قيمة بعد الحصاد
    let aiChatMessages = [];
    let aiSuggestions = [];

    function renderAiChat() {
      const log = document.getElementById('ai-chat-log');
      if (!aiChatMessages.length) {
        log.innerHTML = '<div class="empty-state">ابدأ بسؤال زي ما الطالب هيسأله</div>';
        return;
      }
      log.innerHTML = aiChatMessages.map((m) => {
        if (m.role === 'user') {
          return `<div class="ai-chat-msg user">${escapeHtml(m.content)}</div>`;
        }
        const [label, tone] = OUTCOME_LABELS[m.outcome] || ['', 'stat-muted'];
        // النتيجة بتتعرض مع كل دور مش في الآخر: الثغرة لازم تبان لحظة حصولها عشان الأدمن
        // يكتب التصحيح وهو فاكر السؤال
        const badge = m.outcome && m.outcome !== 'sent'
          ? `<span class="stat-pill ${tone}" style="margin-bottom:4px; display:inline-block">${label}</span><br>` : '';
        return `<div class="ai-chat-msg bot">${badge}${escapeHtml(m.content)}</div>`;
      }).join('');
      log.scrollTop = log.scrollHeight;
    }

    async function sendAiChat() {
      const input = document.getElementById('ai-chat-input');
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      aiChatMessages.push({ role: 'user', content: text });
      renderAiChat();
      const button = document.getElementById('ai-chat-send');
      button.disabled = true;
      try {
        const result = await api('/api/assist/chat', {
          method: 'POST',
          body: JSON.stringify({ messages: aiChatMessages }),
        });
        const body = result.answer
          || (result.outcome === 'no_answer' ? 'مش لاقي الإجابة في المصدر — اكتبلي الإجابة الصح وهحفظها.'
            : result.outcome === 'blocked' ? 'الموضوع ده ممنوع عليّ، والسؤال بيروح لموظف.'
              : result.detail || 'حصل خطأ');
        aiChatMessages.push({ role: 'assistant', content: body, outcome: result.outcome });
      } catch (error) {
        aiChatMessages.push({ role: 'assistant', content: error.message, outcome: 'error' });
      } finally {
        button.disabled = false;
        renderAiChat();
      }
    }

    function renderSuggestions() {
      const card = document.getElementById('ai-suggestions-card');
      const box = document.getElementById('ai-suggestions');
      if (!aiSuggestions.length) { card.style.display = 'none'; return; }
      card.style.display = '';
      box.innerHTML = aiSuggestions.map((c, i) => `
        <div class="card" style="margin:0 0 8px; padding:12px">
          <label class="row" style="gap:8px; margin-bottom:8px">
            <input type="checkbox" data-sug="${i}" checked>
            <b>${c.action === 'update' ? `✏️ تصحيح للمعلومة #${c.target_id}` : '➕ معلومة جديدة'}</b>
          </label>
          <input type="text" class="compact-input" data-sug-q="${i}" value="${escapeHtml(c.question)}" style="width:100%; margin-bottom:6px">
          <textarea class="compact-input" data-sug-a="${i}" rows="2" style="width:100%">${escapeHtml(c.answer)}</textarea>
          ${c.reason ? `<div class="ticket-muted" style="font-size:11px; margin-top:6px">${escapeHtml(c.reason)}</div>` : ''}
        </div>`).join('');
    }

    async function harvestInto(endpoint, payload, label) {
      try {
        showToast(label);
        const data = await api(endpoint, { method: 'POST', body: JSON.stringify(payload) });
        aiSuggestions = data.changes || [];
        renderSuggestions();
