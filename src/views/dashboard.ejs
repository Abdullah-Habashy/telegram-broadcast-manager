    async function loadAdminUsers() {
      const list = document.getElementById('staff-users-list');
      try {
        const [users, sessionsInfo, staffStats] = await Promise.all([
          api('/api/admin/users'),
          api('/api/admin/sessions').catch(() => []), // مايوقفش عرض باقي بيانات الموظفين لو حصل خطأ هنا
          api('/api/admin/staff-stats').catch(() => []),
        ]);
        const sessionsByUser = new Map(sessionsInfo.map((entry) => [Number(entry.id), entry]));
        const statsByUser = new Map(staffStats.map((entry) => [Number(entry.id), entry]));
        // بطاقة لكل موظف بدل صف جدول عريض — الأقسام بتتلف تحت بعض على الشاشات الضيقة بدل ما تحتاج
        // سكرول أفقي، وعلى الديسكتوب بتترص جنب بعض في نفس البطاقة من غير ما الصفحة تتمدد عرضيًا
        list.innerHTML = `
          <div class="staff-cards">${users.map((user) => {
              const isSelf = Number(user.id) === currentUserId;
              const sessionInfo = sessionsByUser.get(Number(user.id));
              const sessionCount = sessionInfo?.session_count || 0;
              const sessionCell = sessionCount > 0
                ? `<details class="session-details">
                     <summary><span class="stat-pill ${sessionCount > 1 ? 'stat-warning' : 'stat-success'}" title="${sessionCount} جلسة نشطة">💻${sessionCount}</span></summary>
                     <div class="session-device-list">
                       ${sessionInfo.sessions.map((s) => `<div class="tafra-student-sub">${escapeHtml(s.device_label)}${s.login_at ? ' — ' + fmtDate(s.login_at) : ''}</div>`).join('')}
                     </div>
                   </details>`
                : '<span class="stat-pill stat-muted" title="غير متصل الآن">💻—</span>';
              const stats = statsByUser.get(Number(user.id));
              const statPills = [];
              if (stats?.tickets) {
                statPills.push(`<span class="stat-pill" title="إجمالي تذاكر صندوق الدعم المسندة">🎫${stats.tickets.total}</span>`);
                if (stats.tickets.awaiting_reply > 0) {
                  statPills.push(`<span class="stat-pill stat-warning" title="تذاكر لم يُرد عليها">🟠${stats.tickets.awaiting_reply}</span>`);
                }
              }
              if (stats?.calls) {
                statPills.push(`<span class="stat-pill" title="إجمالي طلاب المتابعة التليفونية المسندين">📞${stats.calls.total}</span>`);
                if (stats.calls.pending > 0) {
                  statPills.push(`<span class="stat-pill stat-warning" title="لسه ما تم الاتصال بيهم">🟠${stats.calls.pending}</span>`);
                }
              }
              const reportCell = statPills.length ? statPills.join('') : '<span class="stat-pill stat-muted">—</span>';
              const telegramCell = user.telegram_linked
                ? '<span class="stat-pill stat-success" title="حسابه مربوط على تيليجرام">✅</span>'
                : `<button type="button" class="btn btn-ghost btn-sm staff-telegram-link-btn" data-user-id="${user.id}" data-user-name="${escapeHtml(user.name)}" title="توليد كود ربط تيليجرام">🔗</button>`;
              return `
              <div class="staff-card">
                <div class="staff-card-header">
                  <input type="text" class="staff-name-input staff-inline-input" data-user-id="${user.id}" value="${escapeHtml(user.name)}">
                  <input type="email" class="staff-email-input staff-inline-input" data-user-id="${user.id}" value="${escapeHtml(user.email)}">
                  <select class="staff-role-select" data-user-id="${user.id}" ${isSelf ? 'disabled' : ''}>
                    <option value="agent" ${user.role === 'agent' ? 'selected' : ''}>موظف دعم</option>
                    <option value="admin" ${user.role === 'admin' ? 'selected' : ''}>مدير</option>
                  </select>
                  <label class="icon-toggle" title="مفعّل"><input type="checkbox" class="staff-active-toggle" data-user-id="${user.id}" ${user.is_active ? 'checked' : ''} ${isSelf ? 'disabled' : ''}> ⚡</label>
                </div>
                <div class="staff-card-body">
                  ${user.role === 'admin' ? '<span class="stat-pill" title="كل الصلاحيات (مدير)">⭐</span>' : `
                    <label class="icon-toggle" title="صلاحية صندوق الدعم"><input type="checkbox" class="staff-view-tickets-toggle" data-user-id="${user.id}" ${user.can_view_tickets ? 'checked' : ''}> 🎫</label>
                    <label class="icon-toggle" title="صلاحية المتابعة التليفونية"><input type="checkbox" class="staff-view-calls-toggle" data-user-id="${user.id}" ${user.can_view_calls ? 'checked' : ''}> 📞</label>
                    <label class="icon-toggle" title="مسند — يقدر يسند/يلغي إسناد طلاب المكالمات لغيره من الموظفين"><input type="checkbox" class="staff-assign-calls-toggle" data-user-id="${user.id}" ${user.can_assign_calls ? 'checked' : ''}> 🧭</label>
                  `}
                  ${reportCell}
                  ${sessionCell}
                  ${telegramCell}
                </div>
                <div class="staff-card-footer">
                  <div class="staff-password-reset">
                    <input type="password" class="staff-new-password" data-user-id="${user.id}" placeholder="كلمة جديدة">
                    <button type="button" class="btn btn-ghost btn-sm staff-reset-password" data-user-id="${user.id}" title="تغيير كلمة المرور">🔑</button>
                  </div>
                  ${user.role === 'agent' ? `<button type="button" class="btn btn-ghost btn-sm staff-impersonate-btn" data-user-id="${user.id}" data-user-name="${escapeHtml(user.name)}" title="تسجيل دخول كموظف">🎭</button>` : ''}
                  ${isSelf ? '' : `<button type="button" class="btn btn-danger-ghost btn-sm staff-delete-btn" data-user-id="${user.id}" data-user-name="${escapeHtml(user.name)}" title="حذف الحساب">🗑️</button>`}
                </div>
              </div>`;
            }).join('')}</div>`;
        list.querySelectorAll('.staff-name-input').forEach((input) => {
          input.addEventListener('change', () => {
            const name = input.value.trim();
            if (!name) { showToast('الاسم مطلوب'); return; }
            updateStaffUser(input.dataset.userId, { name });
          });
        });
        list.querySelectorAll('.staff-email-input').forEach((input) => {
          input.addEventListener('change', () => {
            const email = input.value.trim();
            if (!email) { showToast('البريد الإلكتروني مطلوب'); return; }
            updateStaffUser(input.dataset.userId, { email });
          });
        });
        list.querySelectorAll('.staff-role-select').forEach((select) => {
          select.addEventListener('change', () => updateStaffUser(select.dataset.userId, { role: select.value }));
        });
        list.querySelectorAll('.staff-active-toggle').forEach((checkbox) => {
          checkbox.addEventListener('change', () => updateStaffUser(checkbox.dataset.userId, { is_active: checkbox.checked }));
        });
        list.querySelectorAll('.staff-view-tickets-toggle').forEach((checkbox) => {
          checkbox.addEventListener('change', () => updateStaffUser(checkbox.dataset.userId, { can_view_tickets: checkbox.checked }));
        });
        list.querySelectorAll('.staff-view-calls-toggle').forEach((checkbox) => {
          checkbox.addEventListener('change', () => updateStaffUser(checkbox.dataset.userId, { can_view_calls: checkbox.checked }));
        });
        list.querySelectorAll('.staff-assign-calls-toggle').forEach((checkbox) => {
          checkbox.addEventListener('change', () => updateStaffUser(checkbox.dataset.userId, { can_assign_calls: checkbox.checked }));
        });
        list.querySelectorAll('.staff-delete-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            if (!confirm(`حذف حساب "${button.dataset.userName}" نهائيًا؟ الإجراء ده لا يمكن التراجع عنه.`)) return;
            button.disabled = true;
            try {
              await api('/api/admin/users/' + button.dataset.userId, { method: 'DELETE' });
              showToast('تم حذف الحساب');
              invalidateStaffCaches();
              loadAdminUsers();
            } catch (error) {
              showToast(error.message);
              button.disabled = false;
            }
          });
        });
        list.querySelectorAll('.staff-impersonate-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            if (!confirm(`هتسجّل دخول بحساب "${button.dataset.userName}" وتشتغل بصلاحياته. أي رد أو إجراء هيتسجّل باسمه. متابعة؟`)) return;
            button.disabled = true;
            try {
              await api('/api/admin/users/' + button.dataset.userId + '/impersonate', { method: 'POST' });
              window.location.href = '/';
            } catch (error) {
              showToast(error.message);
              button.disabled = false;
            }
          });
        });
        list.querySelectorAll('.staff-telegram-link-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            button.disabled = true;
            try {
              const result = await api('/api/admin/users/' + button.dataset.userId + '/telegram-link-code', { method: 'POST' });
              prompt(
                `ابعت الأمر ده لـ "${button.dataset.userName}" يبعته هو نفسه من حسابه الشخصي على تيليجرام للبوت (مرة واحدة بس):`,
                `/linkstaff ${result.code}`
              );
              showToast('اتولّد كود الربط — الكود صالح لحد ما يتم استخدامه');
            } catch (error) {
              showToast(error.message);
            } finally {
              button.disabled = false;
            }
          });
        });
        list.querySelectorAll('.staff-reset-password').forEach((button) => {
          button.addEventListener('click', async () => {
            const input = list.querySelector(`.staff-new-password[data-user-id="${button.dataset.userId}"]`);
            const password = input.value;
            if (password.length < 8) return showToast('كلمة المرور يجب أن تكون 8 أحرف على الأقل');
            button.disabled = true;
            try {
              await api('/api/admin/users/' + button.dataset.userId, {
                method: 'PATCH', body: JSON.stringify({ password })
              });
              showToast('تم تغيير كلمة المرور');
              loadAdminUsers();
            } catch (error) {
              showToast(error.message);
              button.disabled = false;
            }
          });
        });
      } catch (error) {
        list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    // أي تغيير في فريق العمل (حساب جديد، تغيير دور، تفعيل/تعطيل) بيبطّل كل الكاش اللي فيه قوائم موظفين
    // (صندوق الدعم، جهات الاتصال، المتابعة التليفونية) عشان يفضلوا متزامنين مع بعض من غير Refresh يدوي للصفحة
    function invalidateStaffCaches() {
      ticketsMeta = null;
      callAssignees = [];
    }

    async function updateStaffUser(userId, changes) {
      try {
        await api('/api/admin/users/' + userId, { method: 'PATCH', body: JSON.stringify(changes) });
        showToast('تم تحديث الحساب');
        invalidateStaffCaches();
        loadAdminUsers();
      } catch (error) {
        showToast(error.message);
        loadAdminUsers();
      }
    }

    // عنصر create-staff-btn موجود بس لما القسم يترندر (الأدمن بس، بعد نقل إدارة الفريق لصندوق
    // الدعم) — لازم نتأكد من وجوده الأول، وإلا الموظف العادي (اللي مش هيلاقي العنصر ده أصلًا)
    // هيقع على الخطأ ده جوّه أول سطر ينفّذ في الصفحة، وكل الكود اللي بعده في نفس ملف السكريبت
    // (تحميل التذاكر، تسجيل الأحداث... إلخ) بيتوقف تنفيذه فورًا
    const createStaffBtn = document.getElementById('create-staff-btn');
    if (createStaffBtn) {
      createStaffBtn.addEventListener('click', async () => {
        const name = document.getElementById('staff-name').value.trim();
        const email = document.getElementById('staff-email').value.trim();
        const password = document.getElementById('staff-password').value;
        const role = document.getElementById('staff-role').value;
        const can_view_tickets = document.getElementById('staff-can-view-tickets').checked;
        const can_view_calls = document.getElementById('staff-can-view-calls').checked;
        const can_assign_calls = document.getElementById('staff-can-assign-calls').checked;
        if (!name || !email || !password) return showToast('املأ بيانات الحساب كاملة');
        try {
          await api('/api/admin/users', {
            method: 'POST',
            body: JSON.stringify({ name, email, password, role, can_view_tickets, can_view_calls, can_assign_calls }),
          });
          document.getElementById('staff-name').value = '';
          document.getElementById('staff-email').value = '';
          document.getElementById('staff-password').value = '';
          showToast('تم إنشاء الحساب');
          invalidateStaffCaches();
          loadAdminUsers();
        } catch (error) { showToast(error.message); }
      });
    }

    // ---------- إشعارات وتحديثات الوقت الفعلي (Real-time SSE + Live Auto Sync) ----------
    let liveEvtSource = null;
    let liveSyncTimer = null;
    let renderedMessageKeys = new Set();

    function updateActiveConversationLive(data) {
      if (!currentTicketId || !data || !data.messages) return;

      const messagesContainer = document.getElementById('ticket-messages');
      if (!messagesContainer) return;

      let hasNew = false;
      const emptyState = messagesContainer.querySelector('.empty-state');
      const liveKeys = new Set();

      data.messages.forEach((msg) => {
        const key = messageKeyOf(msg);
        liveKeys.add(key);
        if (!renderedMessageKeys.has(key)) {
          renderedMessageKeys.add(key);
          hasNew = true;
          if (emptyState) emptyState.remove();
          messagesContainer.insertAdjacentHTML('beforeend', ticketMessageHtml(msg));
          return;
        }
        // رسالة اتعدّلت من موظف تاني — نحدّث محتواها في مكانها
        const bubble = messagesContainer.querySelector(`[data-message-key="${CSS.escape(key)}"]`);
        if (bubble && !bubble.querySelector('.msg-edit-box') && bubble.dataset.editedAt !== (msg.edited_at || '')) {
          bubble.outerHTML = ticketMessageHtml(msg);
        }
      });

      // رسالة اتحذفت من موظف تاني — نشيلها من المحادثة المفتوحة
      messagesContainer.querySelectorAll('.ticket-message').forEach((bubble) => {
        const key = bubble.dataset.messageKey;
        if (key && !liveKeys.has(key) && !bubble.querySelector('.msg-edit-box')) {
          renderedMessageKeys.delete(key);
          bubble.remove();
        }
      });

      if (hasNew) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    async function performLiveSync() {
      // فقط إذا كان الموظف/المدير متواجد في تبويب صندوق الدعم
      const ticketsTab = document.getElementById('tab-tickets');
      if (!ticketsTab || ticketsTab.style.display === 'none') return;

      try {
        // إذا كانت هناك محادثة مفتوحة حالياً، نحصل على الرسائل الجديدة فوراً
        if (currentTicketId) {
          const data = await api('/api/tickets/' + currentTicketId);
          updateActiveConversationLive(data);
        }
        // تحديث قائمة التذاكر جانباً في الخلفية بشكل صامت وبدون اختفاء العناصر
        if (typeof loadTickets === 'function') {
          await loadTickets(true);
        }
      } catch (_) {}
    }

    // بعد مزامنة تلقائية/يدوية لطلاب طفرة — نحدّث أي تاب مفتوح دلوقتي من غير ما المستخدم يعمل Refresh يدوي
    function handleTafraSyncCompleted(data) {
      if (data.new_students > 0) showToast(`تحديث تلقائي لبيانات الطلاب — ${data.new_students} طالب جديد`);
      tafraFiltersLoaded = false;
      if (document.getElementById('tab-tafra-students')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadTafraStudents).catch(() => {});
      } else if (document.getElementById('tab-reports')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadReportPreview).catch(() => {});
      } else if (document.getElementById('tab-calls')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadCalls).catch(() => {});
      }
    }

    function initLiveEvents() {
      if (liveEvtSource) {
        try { liveEvtSource.close(); } catch (_) {}
      }

      liveEvtSource = new EventSource('/api/tickets/stream');

      liveEvtSource.onopen = function() {
        console.log('⚡ Connected to real-time live events stream');
      };

      liveEvtSource.onerror = function() {
        console.warn('⚠️ SSE connection lost/reconnecting...');
      };

      liveEvtSource.onmessage = function(event) {
        try {
          const data = JSON.parse(event.data);
          if (data.type === 'new_incoming_message') {
            performLiveSync();
          }
          if (data.type === 'tafra_sync_completed') {
            handleTafraSyncCompleted(data);
          }
        } catch (e) {
          console.error('Error handling SSE message:', e);
        }
      };

      // تشغيل فاحص تزامن سريع كل ثانيتين كضمان مزدوج لا يفوت أي رسالة أثناء فتح صندوق الدعم
      if (liveSyncTimer) clearInterval(liveSyncTimer);
      liveSyncTimer = setInterval(performLiveSync, 2500);
    }

    // ---------- إشعارات التليفون (Web Push) — بتوصل حتى لو المتصفح مقفول ----------
    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const raw = atob(base64);
      return Uint8Array.from([...raw].map((char) => char.charCodeAt(0)));
    }

    const pushToggleBtn = document.getElementById('push-toggle-btn');
    let pushSupported = 'serviceWorker' in navigator && 'PushManager' in window;

    function setPushButtonState(enabled) {
      if (!pushToggleBtn) return;
      pushToggleBtn.textContent = enabled ? '🔔' : '🔕';
      pushToggleBtn.classList.toggle('enabled', enabled);
      pushToggleBtn.title = enabled ? 'إشعارات التليفون مفعّلة (اضغط للإلغاء)' : 'تفعيل إشعارات التليفون';
    }

    async function initPushUi() {
      if (!pushToggleBtn) return;
      if (!pushSupported) {
        pushToggleBtn.style.display = 'none';
        return;
      }
      try {
        const { enabled: serverEnabled } = await api('/api/push/public-key');
        if (!serverEnabled) { pushToggleBtn.style.display = 'none'; return; }
        const registration = await navigator.serviceWorker.register('/sw.js');
        const existingSubscription = await registration.pushManager.getSubscription();
        setPushButtonState(Boolean(existingSubscription));
      } catch (error) {
        console.warn('⚠️ Push init failed:', error.message);
      }
    }

    async function togglePushSubscription() {
      if (!pushSupported) return;
      pushToggleBtn.disabled = true;
      try {
        const registration = await navigator.serviceWorker.ready;
        const existingSubscription = await registration.pushManager.getSubscription();

        if (existingSubscription) {
          await api('/api/push/unsubscribe', { method: 'POST', body: JSON.stringify({ endpoint: existingSubscription.endpoint }) });
          await existingSubscription.unsubscribe();
          setPushButtonState(false);
          showToast('تم إلغاء إشعارات التليفون');
          return;
        }

        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
          showToast('لازم توافق على إذن الإشعارات من المتصفح عشان تشتغل');
          return;
        }
        const { publicKey } = await api('/api/push/public-key');
        const subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(publicKey),
        });
        await api('/api/push/subscribe', { method: 'POST', body: JSON.stringify({ subscription }) });
        setPushButtonState(true);
        showToast('تم تفعيل إشعارات التليفون');
      } catch (error) {
        showToast(error.message || 'تعذر تفعيل الإشعارات');
      } finally {
        pushToggleBtn.disabled = false;
      }
    }

    if (pushToggleBtn) pushToggleBtn.addEventListener('click', togglePushSubscription);
    initPushUi();

    // ---------- تشغيل أولي ----------
    const hasTicketsAccess = Boolean(document.querySelector('.nav-item[data-tab="tickets"]'));
    const hasCallsAccess = Boolean(document.querySelector('.nav-item[data-tab="calls"]'));
    if (pendingDeepLinkTicketId) {
      document.querySelector('.nav-item[data-tab="tickets"]')?.click();
    } else if (currentUserRole === 'admin') {
      loadStats();
    } else if (hasTicketsAccess) {
      initTickets();
    } else if (hasCallsAccess) {
      initCalls();
    }
    // بث الأحداث اللحظي مرتبط بصندوق الدعم — بلاش نفتحه لموظف مالوش صلاحية عرضه أصلًا
    if (hasTicketsAccess) initLiveEvents();
  </script>
</body>
</html>
