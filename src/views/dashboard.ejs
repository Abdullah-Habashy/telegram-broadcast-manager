    // أي تغيير في فريق العمل (حساب جديد، تغيير دور، تفعيل/تعطيل) بيبطّل كل الكاش اللي فيه قوائم موظفين
    // (صندوق الدعم، جهات الاتصال، المتابعة التليفونية) عشان يفضلوا متزامنين مع بعض من غير Refresh يدوي للصفحة
    function invalidateStaffCaches() {
      ticketsMeta = null;
      callAssignees = [];
    }

    async function updateStaffUser(userId, changes) {
      try {
        await api('/api/admin/users/' + userId, { method: 'PATCH', body: JSON.stringify(changes) });
        showToast('تم تحديث الحساب');
        invalidateStaffCaches();
        loadAdminUsers();
      } catch (error) {
        showToast(error.message);
        loadAdminUsers();
      }
    }

    // عنصر create-staff-btn موجود بس لما القسم يترندر (الأدمن بس، بعد نقل إدارة الفريق لصندوق
    // الدعم) — لازم نتأكد من وجوده الأول، وإلا الموظف العادي (اللي مش هيلاقي العنصر ده أصلًا)
    // هيقع على الخطأ ده جوّه أول سطر ينفّذ في الصفحة، وكل الكود اللي بعده في نفس ملف السكريبت
    // (تحميل التذاكر، تسجيل الأحداث... إلخ) بيتوقف تنفيذه فورًا
    const createStaffBtn = document.getElementById('create-staff-btn');
    if (createStaffBtn) {
      createStaffBtn.addEventListener('click', async () => {
        const name = document.getElementById('staff-name').value.trim();
        const email = document.getElementById('staff-email').value.trim();
        const password = document.getElementById('staff-password').value;
        const role = document.getElementById('staff-role').value;
        const can_view_tickets = document.getElementById('staff-can-view-tickets').checked;
        const can_view_calls = document.getElementById('staff-can-view-calls').checked;
        const can_assign_calls = document.getElementById('staff-can-assign-calls').checked;
        const team = document.querySelector('.new-staff-team:checked')?.value || null;
        if (!name || !email || !password) return showToast('املأ بيانات الحساب كاملة');
        try {
          await api('/api/admin/users', {
            method: 'POST',
            body: JSON.stringify({ name, email, password, role, can_view_tickets, can_view_calls, can_assign_calls, team }),
          });
          document.getElementById('staff-name').value = '';
          document.getElementById('staff-email').value = '';
          document.getElementById('staff-password').value = '';
          showToast('تم إنشاء الحساب');
          invalidateStaffCaches();
          loadAdminUsers();
        } catch (error) { showToast(error.message); }
      });
    }

    // ---------- إشعارات وتحديثات الوقت الفعلي (Real-time SSE + Live Auto Sync) ----------
    let liveEvtSource = null;
    let liveSyncTimer = null;
    let renderedMessageKeys = new Set();

    function updateActiveConversationLive(data) {
      if (!currentTicketId || !data || !data.messages) return;

      const messagesContainer = document.getElementById('ticket-messages');
      if (!messagesContainer) return;

      let hasNew = false;
      const emptyState = messagesContainer.querySelector('.empty-state');
      const liveKeys = new Set();

      data.messages.forEach((msg) => {
        const key = messageKeyOf(msg);
        liveKeys.add(key);
        if (!renderedMessageKeys.has(key)) {
          renderedMessageKeys.add(key);
          hasNew = true;
          if (emptyState) emptyState.remove();
          messagesContainer.insertAdjacentHTML('beforeend', ticketMessageHtml(msg));
          return;
        }
        // رسالة اتعدّلت من موظف تاني — نحدّث محتواها في مكانها
        const bubble = messagesContainer.querySelector(`[data-message-key="${CSS.escape(key)}"]`);
        if (bubble && !bubble.querySelector('.msg-edit-box') && bubble.dataset.editedAt !== (msg.edited_at || '')) {
          bubble.outerHTML = ticketMessageHtml(msg);
        }
      });

      // رسالة اتحذفت من موظف تاني — نشيلها من المحادثة المفتوحة
      messagesContainer.querySelectorAll('.ticket-message').forEach((bubble) => {
        const key = bubble.dataset.messageKey;
        if (key && !liveKeys.has(key) && !bubble.querySelector('.msg-edit-box')) {
          renderedMessageKeys.delete(key);
          bubble.remove();
        }
      });

      if (hasNew) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    async function performLiveSync() {
      // فقط إذا كان الموظف/المدير متواجد في تبويب صندوق الدعم
      const ticketsTab = document.getElementById('tab-tickets');
      if (!ticketsTab || ticketsTab.style.display === 'none') return;

      try {
        // إذا كانت هناك محادثة مفتوحة حالياً، نحصل على الرسائل الجديدة فوراً
        if (currentTicketId) {
          const data = await api('/api/tickets/' + currentTicketId);
          updateActiveConversationLive(data);
        }
        // تحديث قائمة التذاكر جانباً في الخلفية بشكل صامت وبدون اختفاء العناصر
        if (typeof loadTickets === 'function') {
          await loadTickets(true);
        }
      } catch (_) {}
    }

    // بعد مزامنة تلقائية/يدوية لطلاب طفرة — نحدّث أي تاب مفتوح دلوقتي من غير ما المستخدم يعمل Refresh يدوي
    function handleTafraSyncCompleted(data) {
      if (data.new_students > 0) showToast(`تحديث تلقائي لبيانات الطلاب — ${data.new_students} طالب جديد`);
      tafraFiltersLoaded = false;
      if (document.getElementById('tab-tafra-students')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadTafraStudents).catch(() => {});
      } else if (document.getElementById('tab-reports')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadReportPreview).catch(() => {});
      } else if (document.getElementById('tab-calls')?.style.display !== 'none') {
        loadTafraStudentFilters().then(loadCalls).catch(() => {});
      }
    }

    function initLiveEvents() {
      if (liveEvtSource) {
        try { liveEvtSource.close(); } catch (_) {}
      }

      liveEvtSource = new EventSource('/api/tickets/stream');

      liveEvtSource.onopen = function() {
        console.log('⚡ Connected to real-time live events stream');
      };

      liveEvtSource.onerror = function() {
        console.warn('⚠️ SSE connection lost/reconnecting...');
      };

      liveEvtSource.onmessage = function(event) {
        try {
          const data = JSON.parse(event.data);
          if (data.type === 'new_incoming_message') {
            performLiveSync();
          }
          if (data.type === 'tafra_sync_completed') {
            handleTafraSyncCompleted(data);
          }
        } catch (e) {
          console.error('Error handling SSE message:', e);
        }
      };

      // تشغيل فاحص تزامن سريع كل ثانيتين كضمان مزدوج لا يفوت أي رسالة أثناء فتح صندوق الدعم
      if (liveSyncTimer) clearInterval(liveSyncTimer);
      liveSyncTimer = setInterval(performLiveSync, 2500);
    }

    // ---------- إشعارات التليفون (Web Push) — بتوصل حتى لو المتصفح مقفول ----------
    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const raw = atob(base64);
      return Uint8Array.from([...raw].map((char) => char.charCodeAt(0)));
    }

    const pushToggleBtn = document.getElementById('push-toggle-btn');
    let pushSupported = 'serviceWorker' in navigator && 'PushManager' in window;

    function setPushButtonState(enabled) {
      if (!pushToggleBtn) return;
      pushToggleBtn.textContent = enabled ? '🔔' : '🔕';
      pushToggleBtn.classList.toggle('enabled', enabled);
      pushToggleBtn.title = enabled ? 'إشعارات التليفون مفعّلة (اضغط للإلغاء)' : 'تفعيل إشعارات التليفون';
    }

    async function initPushUi() {
      if (!pushToggleBtn) return;
      if (!pushSupported) {
        pushToggleBtn.style.display = 'none';
        return;
      }
      try {
        const { enabled: serverEnabled } = await api('/api/push/public-key');
        if (!serverEnabled) { pushToggleBtn.style.display = 'none'; return; }
        const registration = await navigator.serviceWorker.register('/sw.js');
        const existingSubscription = await registration.pushManager.getSubscription();
        setPushButtonState(Boolean(existingSubscription));
      } catch (error) {
        console.warn('⚠️ Push init failed:', error.message);
      }
    }

    async function togglePushSubscription() {
      if (!pushSupported) return;
      pushToggleBtn.disabled = true;
      try {
        const registration = await navigator.serviceWorker.ready;
        const existingSubscription = await registration.pushManager.getSubscription();

        if (existingSubscription) {
          await api('/api/push/unsubscribe', { method: 'POST', body: JSON.stringify({ endpoint: existingSubscription.endpoint }) });
          await existingSubscription.unsubscribe();
          setPushButtonState(false);
          showToast('تم إلغاء إشعارات التليفون');
          return;
        }

        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
          showToast('لازم توافق على إذن الإشعارات من المتصفح عشان تشتغل');
          return;
        }
        const { publicKey } = await api('/api/push/public-key');
        const subscription = await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(publicKey),
        });
        await api('/api/push/subscribe', { method: 'POST', body: JSON.stringify({ subscription }) });
        setPushButtonState(true);
        showToast('تم تفعيل إشعارات التليفون');
      } catch (error) {
        showToast(error.message || 'تعذر تفعيل الإشعارات');
      } finally {
        pushToggleBtn.disabled = false;
      }
    }

    if (pushToggleBtn) pushToggleBtn.addEventListener('click', togglePushSubscription);
    initPushUi();

    // ---------- الاختبارات ----------
    //
    // تلات شاشات في تبويب واحد: القايمة، محرر الأسئلة، والنتايج. الحالة في المتغيرات دي،
    // ما عدا محتوى المحرر — ده بيفضل في الـ DOM ويتقري منه عند الحفظ (readQuizEditor).
    // السبب: إعادة رسم المحرر مع كل حرف كانت بتضيّع مكان المؤشر جوه الإجابة المرجعية.
    let quizList = [];
    let editingQuizId = null;
    let quizEditorQuestions = [];
    let quizEditorHasAttempts = false;
    let quizResultsId = null;
    let quizRegradeTimer = null;

    // قايمة الأبواب بتتحمّل مرة واحدة وبتتخزّن — بتتعرض في محرر كل اختبار
    let quizBootcamps = [];

    async function loadQuizBootcamps() {
      try {
        quizBootcamps = await api('/api/quizzes/bootcamps');
      } catch (error) {
        // فشل القايمة مايمنعش المحرر من الشغل — الربط بباب اختياري أصلًا
        quizBootcamps = [];
      }
      const select = document.getElementById('quiz-bootcamp');
      select.innerHTML = '<option value="">مش مربوط بباب</option>'
        + quizBootcamps.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
    }

    function initQuizzes() {
      showQuizView('list');
      loadQuizzes();
      loadQuizBootcamps();
      // كارت النموذج وكارت التجريب مش موجودين أصلًا في صفحة غير الأدمن، والنداء بيرجّع
      // ٤٠٣ — فبيتخطى بدل ما يرمي على عناصر مش موجودة
      if (currentUserRole === 'admin') loadGradingProviders();
    }

    function showQuizView(view) {
      document.getElementById('quiz-list-view').style.display = view === 'list' ? '' : 'none';
      document.getElementById('quiz-editor-view').style.display = view === 'editor' ? '' : 'none';
      document.getElementById('quiz-results-view').style.display = view === 'results' ? '' : 'none';
    }

    async function loadQuizzes() {
      const list = document.getElementById('quizzes-list');
      try {
        quizList = await api('/api/quizzes');
        if (!quizList.length) {
          list.innerHTML = '<div class="empty-state">لسه مفيش اختبارات — ابدأ بواحد جديد</div>';
          return;
        }
        list.innerHTML = quizList.map(renderQuizRow).join('');
      } catch (error) {
        list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function renderQuizRow(quiz) {
      const badges = [
        `<span class="badge badge-muted">${quiz.question_count} سؤال</span>`,
        `<span class="badge badge-muted">${quiz.submitted_count} سلّموا</span>`,
        quiz.in_progress_count ? `<span class="badge badge-warning">${quiz.in_progress_count} لسه بيحلّوا</span>` : '',
        quiz.needs_review_count ? `<span class="badge badge-danger">${quiz.needs_review_count} محتاجة مراجعتك</span>` : '',
        quiz.is_open ? '<span class="badge badge-success">مفتوح</span>' : '<span class="badge badge-muted">مقفول</span>',
        quiz.time_limit_minutes ? `<span class="badge badge-muted">⏱️ ${quiz.time_limit_minutes} دقيقة</span>` : '',
      ].filter(Boolean).join(' ');

      return `
        <div style="padding:14px 0; border-bottom:1px solid var(--border)">
          <div class="row-between" style="gap:12px; flex-wrap:wrap">
            <div>
              <b>${escapeHtml(quiz.title)}</b>
              <div style="margin-top:6px; display:flex; gap:6px; flex-wrap:wrap">${badges}</div>
            </div>
            <div class="row" style="gap:8px; flex-wrap:wrap">
              <button type="button" class="btn btn-primary btn-sm" style="width:auto" onclick="openQuizResults(${quiz.id})">النتايج</button>
              <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="openQuizEditor(${quiz.id})">تعديل</button>
              <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="toggleQuizOpen(${quiz.id})">${quiz.is_open ? 'اقفل' : 'افتح'}</button>
              <button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" onclick="deleteQuiz(${quiz.id})">حذف</button>
            </div>
          </div>
          <div class="row" style="gap:8px; margin-top:10px">
            <input type="text" class="compact-input" style="flex:1" readonly value="${escapeHtml(quiz.url)}" onclick="this.select()" />
            <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="copyQuizLink(${quiz.id})">نسخ الرابط</button>
          </div>
        </div>`;
    }

    async function copyQuizLink(id) {
      const quiz = quizList.find((item) => item.id === id);
      if (!quiz) return;
      try {
        await navigator.clipboard.writeText(quiz.url);
        showToast('الرابط اتنسخ — ابعته للطلبة');
      } catch (error) {
        showToast('مقدرناش ننسخ — حدّد الرابط من الخانة وانسخه بإيدك');
      }
    }

    // ---------- نموذج التصحيح ----------
    // نفس القايمة بتتعبى في مكانين: الكارت اللي بيعتمد النموذج، وقايمة "جرّب بنموذج" جوه
    // خانة التجريب. الفرق بينهم إن التجريب مابيحفظش — عشان تقدر تقارن قبل ما تعتمد
    let gradingProviders = [];

    async function loadGradingProviders() {
      const state = document.getElementById('grading-provider-state');
      try {
        const data = await api('/api/quizzes/grading-provider');
        gradingProviders = data.providers;
        // المزوّد اللي مفتاحه مش مضبوط بيتقفل في القايمة بدل ما يتشال منها — الأدمن يشوف
        // إنه موجود وسبب عدم إتاحته، مش يفتكره اتلغى
        const options = data.providers.map((provider) => `
          <option value="${provider.key}" ${provider.available ? '' : 'disabled'}>
            ${escapeHtml(provider.label)}${provider.available ? '' : ' — المفتاح مش مضبوط'}
          </option>`).join('');
        const select = document.getElementById('grading-provider-select');
        select.innerHTML = options;
        select.value = data.current;
        const preview = document.getElementById('preview-provider');
        preview.innerHTML = options;
        preview.value = data.current;
        document.getElementById('grading-mode-select').value = data.mode || 'instant';
        renderGradingProviderState(data.current, data.mode, data.queue_length);
      } catch (error) {
        state.textContent = error.message;
      }
    }

    // شرح الوضع بيتعرض تحت الاختيار مش جواه: الأدمن اللي بيقرر ده محتاج يعرف الطالب
    // هيشوف إيه، والفرق بين الوضعين مالوش معنى من غير الجملة دي
    const GRADING_MODE_HELP = {
      instant: 'الطالب بيسلّم والتصحيح بيبدأ في نفس اللحظة — بياخد درجته في ثواني. ده المناسب في الأيام العادية.',
      queued: 'الطالب بيسلّم وإجاباته بتتسجّل فورًا، والتصحيح بيمشي في الخلفية كل دقيقة. الدرجة بتتأخر لحد دقيقة، والسيرفر بيرتاح وقت الامتحانات الكبيرة.',
    };

    function renderGradingProviderState(current, mode, queued) {
      const provider = gradingProviders.find((item) => item.key === current);
      document.getElementById('grading-provider-state').textContent = provider
        ? `المعتمد دلوقتي: ${provider.label} (${provider.model})`
        : 'مفيش نموذج معتمد.';
      const help = GRADING_MODE_HELP[mode === 'queued' ? 'queued' : 'instant'];
      // طول الطابور بيتعرض لما يكون فيه ورق مستني فعلًا — الصفر مش معلومة
      const waiting = queued ? ` — مستني في الطابور دلوقتي: ${queued} ورقة.` : '';
      document.getElementById('grading-mode-help').textContent = help + waiting;
    }

    async function saveGradingProvider() {
      const button = document.getElementById('save-grading-provider-btn');
      button.disabled = true;
      try {
        const provider = document.getElementById('grading-provider-select').value;
        const mode = document.getElementById('grading-mode-select').value;
        const result = await api('/api/quizzes/grading-provider', {
          method: 'POST', body: JSON.stringify({ provider, mode }),
        });
        // **الإعداد بيتقرا مكاشًا على السيرفر لمدة دقيقة**، فالتغيير مش بيسري لحظيًا على
        // التسليمات. الرسالة بتقول كده صراحة بدل ما الأدمن يجرّب ويستغرب.
        // ورسالة واحدة مش اتنين: الـ toast التاني بيمسح الأول قبل ما يتقرا
        showToast(`${result.label} · ${result.mode === 'queued' ? 'طابور' : 'فوري'} — بيسري خلال دقيقة`);
        renderGradingProviderState(provider, result.mode, null);
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
      }
    }

    // ---------- تجريب التصحيح ----------
    // النتايج بتتراكم من فوق لتحت عشان المقارنة: نفس المرجع مع خمس إجابات مختلفة في
    // نفس الشاشة هو اللي بيوريك إن الدرجة الجزئية متدرّجة صح ولا بتقفز
    async function runGradePreview() {
      const button = document.getElementById('preview-grade-btn');
      const payload = {
        text: document.getElementById('preview-question').value.trim(),
        reference_answer: document.getElementById('preview-reference').value.trim(),
        grading_notes: document.getElementById('preview-notes').value.trim(),
        points: Number(document.getElementById('preview-points').value) || 1,
        student_answer: document.getElementById('preview-answer').value.trim(),
        provider: document.getElementById('preview-provider').value,
      };
      button.disabled = true;
      button.textContent = 'بيصحّح...';
      try {
        const result = await api('/api/quizzes/grade-preview', { method: 'POST', body: JSON.stringify(payload) });
        renderPreviewResult(payload, result);
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
        button.textContent = 'صحّح';
      }
    }

    function renderPreviewResult(payload, result) {
      const labels = { correct: 'صح', partial: 'جزئي', incorrect: 'غلط' };
      const badges = { correct: 'badge-success', partial: 'badge-warning', incorrect: 'badge-danger' };
      const card = document.createElement('div');
      card.className = 'card';
      card.style.cssText = 'background:var(--surface-sunken); margin-bottom:10px';
      card.innerHTML = `
        <div class="row-between" style="gap:8px; flex-wrap:wrap">
          <span class="badge ${badges[result.verdict] || 'badge-muted'}">${labels[result.verdict] || result.verdict}</span>
          <b>${result.awarded_points} / ${result.points}</b>
        </div>
        <div style="margin-top:8px"><span class="card-desc">إجابة الطالب:</span>
          <div style="white-space:pre-wrap">${escapeHtml(payload.student_answer)}</div></div>
        <div style="margin-top:8px"><span class="card-desc">سبب المصحّح:</span>
          <div>${escapeHtml(result.reason)}</div></div>
        <div class="card-desc" style="margin-top:8px">${escapeHtml(result.model || result.provider)} · ${result.latency_ms} م.ث</div>`;
      const box = document.getElementById('preview-results');
      box.insertBefore(card, box.firstChild);
    }

    // ---------- استيراد من ملف Word ----------
    //
    // **بيضيف مابيمسحش.** الموظف ممكن يكون كاتب أسئلة بإيده قبل ما يستورد، ومسحها من
    // غير سؤال أسوأ بكتير من إنه يشيل المكرّر بإيده.
    //
    // التحذيرات بتتعرض كلها ومابتمنعش الإضافة — الملف اللي فيه سؤال مالوش درجة لسه
    // نافع، والموظف بيصلّحه في المحرر تحت قبل ما يحفظ
    async function applyParsedQuestions(payload) {
      const box = document.getElementById('quiz-doc-result');
      const shape = (question) => ({
        kind: question.kind,
        label: question.label || '',
        text: question.text || '',
        image: question.image || null,
        points: Number(question.points),
        options: question.kind === 'mcq' ? (question.options || []) : [],
        correct_option: question.correct_option,
        reference_answer: question.reference_answer || '',
        grading_notes: question.grading_notes || '',
        parts: (question.parts || []).map((part) => shape(part)),
      });
      quizEditorQuestions = quizEditorQuestions.concat(payload.questions.map(shape));
      renderQuizQuestions();

      const warnings = (payload.warnings || []).length
        ? `<ul style="margin:8px 0 0; padding-inline-start:18px; line-height:1.9">
            ${payload.warnings.map((line) => `<li>${escapeHtml(line)}</li>`).join('')}</ul>`
        : '';
      box.innerHTML = `
        <div class="card" style="background:var(--surface-sunken); margin:0">
          <b>اتقرا ${payload.questions.length} سؤال واتحطوا في المحرر تحت ⬇️</b>
          <div class="card-desc" style="margin-top:4px">راجعهم واضغط <b>حفظ الاختبار</b> — لسه مافيش حاجة اتسجّلت.</div>
          ${warnings ? `<div class="card-desc" style="margin-top:8px">⚠️ حاجات تشوفها:${warnings}</div>` : ''}
        </div>`;
      showToast(`${payload.questions.length} سؤال اتضافوا للمحرر`);
    }

    function showDocError(message) {
      document.getElementById('quiz-doc-result').innerHTML =
        `<div class="card" style="background:var(--surface-sunken); margin:0">${escapeHtml(message)}</div>`;
    }

    async function importQuizDocumentFile() {
      const input = document.getElementById('quiz-doc-file');
      const file = input.files && input.files[0];
      if (!file) return showToast('اختار ملف .docx الأول');
      const button = document.getElementById('quiz-doc-file-btn');
      button.disabled = true;
      try {
        // multipart مش JSON عشان الملف — نفس نمط رفع الصور في اللوحة
        const formData = new FormData();
        formData.append('document', file);
        const response = await fetch('/api/quizzes/parse-document', { method: 'POST', body: formData });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'مقدرناش نقرا الملف');
        await applyParsedQuestions(result);
        input.value = '';
      } catch (error) {
        showDocError(error.message);
      } finally {
        button.disabled = false;
      }
    }

    async function importQuizDocumentText() {
      const text = document.getElementById('quiz-doc-text').value.trim();
      if (!text) return showToast('الصق الأسئلة الأول');
      try {
        const result = await api('/api/quizzes/parse-document', {
          method: 'POST', body: JSON.stringify({ text }),
        });
        await applyParsedQuestions(result);
      } catch (error) {
        showDocError(error.message);
      }
    }

    // ---------- محرر الاختبار ----------
    function newQuizEditor() {
      editingQuizId = null;
      quizEditorQuestions = [];
      quizEditorHasAttempts = false;
      document.getElementById('quiz-editor-title').textContent = 'اختبار جديد';
      document.getElementById('quiz-title').value = '';
      document.getElementById('quiz-slug').value = '';
      document.getElementById('quiz-description').value = '';
      document.getElementById('quiz-time-limit').value = '';
      document.getElementById('quiz-show-score').checked = true;
      document.getElementById('quiz-show-answers').checked = true;
      document.getElementById('quiz-bootcamp').value = '';
      document.getElementById('quiz-answers-after-close').checked = false;
      document.getElementById('quiz-shuffle-questions').checked = false;
      document.getElementById('quiz-shuffle-options').checked = false;
      document.getElementById('quiz-editor-note').textContent = '';
      document.getElementById('quiz-doc-result').innerHTML = '';
      document.getElementById('quiz-doc-text').value = '';
      document.getElementById('quiz-doc-file').value = '';
      renderQuizQuestions();
      showQuizView('editor');
    }

    async function openQuizEditor(id) {
      try {
        const quiz = await api(`/api/quizzes/${id}`);
        editingQuizId = quiz.id;
        quizEditorHasAttempts = quiz.attempt_count > 0;
        const shape = (question) => ({
          id: question.id,
          kind: question.kind,
          label: question.label || '',
          text: question.text || '',
          image: question.image || null,
          points: Number(question.points),
          options: question.kind === 'mcq' ? (question.options || []) : [],
          correct_option: question.correct_option,
          reference_answer: question.reference_answer || '',
          grading_notes: question.grading_notes || '',
          parts: (question.parts || []).map((part) => shape(part)),
        });
        quizEditorQuestions = quiz.questions.map(shape);
        document.getElementById('quiz-editor-title').textContent = `تعديل: ${quiz.title}`;
        document.getElementById('quiz-title').value = quiz.title;
        document.getElementById('quiz-slug').value = quiz.slug || '';
        document.getElementById('quiz-description').value = quiz.description || '';
        document.getElementById('quiz-time-limit').value = quiz.time_limit_minutes || '';
        document.getElementById('quiz-show-score').checked = quiz.show_score_to_student;
        document.getElementById('quiz-show-answers').checked = quiz.show_answers_to_student;
        document.getElementById('quiz-bootcamp').value = quiz.target_bootcamp_id || '';
        document.getElementById('quiz-answers-after-close').checked = quiz.answers_after_close;
        document.getElementById('quiz-shuffle-questions').checked = quiz.shuffle_questions;
        document.getElementById('quiz-shuffle-options').checked = quiz.shuffle_options;
        // الحذف بيمسح إجابات الطلاب معاه، فبيتقفل خالص أول ما حد يحل — والموظف لازم يعرف
        // ليه الزرار مش موجود قبل ما يدوّر عليه
        document.getElementById('quiz-editor-note').textContent = quizEditorHasAttempts
          ? `فيه ${quiz.attempt_count} طالب دخلوا الاختبار ده — تقدر تعدّل النصوص والدرجات والإجابة المرجعية، لكن حذف سؤال مقفول عشان مايمسحش إجاباتهم.`
          : '';
        renderQuizQuestions();
        showQuizView('editor');
      } catch (error) {
        showToast(error.message);
      }
    }

    // ---------- محرر الأسئلة ----------
    //
    // الشجرة: السؤال إما عادي (مقالي/اختياري) أو أب (kind='group') وتحته parts. الفرع
    // نفسه سؤال كامل — نفس الحقول ونفس الرسم — عشان مايبقاش عندنا كودين لنفس الحاجة.
    //
    // **الـ DOM هو مصدر الحقيقة أثناء الكتابة**، وreadQuizEditor بتقراه للمتغيّر قبل أي
    // إعادة رسم. إعادة الرسم مع كل حرف كانت بتضيّع مكان المؤشر جوه الإجابة المرجعية.
    const PART_LABELS = ['أ', 'ب', 'ج', 'د', 'هـ', 'و', 'ز', 'ح', 'ط', 'ي'];

    function blankQuestion(kind) {
      return {
        kind,
        text: '',
        image: null,
        points: kind === 'group' ? 0 : 1,
        options: kind === 'mcq' ? [{ text: '', image: null }, { text: '', image: null }] : [],
        correct_option: kind === 'mcq' ? 0 : null,
        reference_answer: '',
        grading_notes: '',
        label: '',
        parts: kind === 'group' ? [blankQuestion('essay')] : [],
      };
    }

    // مسار العنصر في الشجرة: "3" لسؤال، و"3.1" للفرع التاني جواه. بيتحط في data-path
    // وبيترجع منه، فمفيش مصفوفتين متوازيتين ممكن يفترقوا
    function questionAt(path) {
      const [index, partIndex] = String(path).split('.').map(Number);
      const question = quizEditorQuestions[index];
      if (!question) return null;
      return Number.isInteger(partIndex) ? question.parts[partIndex] : question;
    }

    function renderQuizQuestions() {
      const box = document.getElementById('quiz-questions-editor');
      if (!quizEditorQuestions.length) {
        box.innerHTML = '<div class="empty-state">ضيف أول سؤال</div>';
        return;
      }
      box.innerHTML = quizEditorQuestions.map((question, index) => {
        const isGroup = question.kind === 'group';
        const title = isGroup ? 'سؤال برأس وفروع'
          : question.kind === 'mcq' ? 'اختيار من متعدد'
          : 'مقالي — بيتصحّح بالذكاء الصناعي';

        const parts = isGroup ? `
          <div style="margin-top:14px; padding-inline-start:14px; border-inline-start:3px solid var(--primary)">
            ${question.parts.map((part, partIndex) => renderQuestionFields(part, `${index}.${partIndex}`, partIndex)).join('')}
            <div class="row" style="gap:8px; margin-top:10px">
              <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="addQuizPart(${index}, 'essay')">+ فرع مقالي</button>
              <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="addQuizPart(${index}, 'mcq')">+ فرع اختياري</button>
            </div>
          </div>` : '';

        return `
          <div class="card quiz-question" data-path="${index}" style="background:var(--surface-sunken); margin-bottom:12px">
            <div class="row-between" style="margin-bottom:10px; gap:8px; flex-wrap:wrap">
              <b>${index + 1}. ${title}</b>
              <div class="row" style="gap:6px">
                <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="moveQuizQuestion(${index}, -1)" ${index === 0 ? 'disabled' : ''}>↑</button>
                <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="moveQuizQuestion(${index}, 1)" ${index === quizEditorQuestions.length - 1 ? 'disabled' : ''}>↓</button>
                ${quizEditorHasAttempts ? '' : `<button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" onclick="removeQuizQuestion(${index})">حذف</button>`}
              </div>
            </div>
            ${renderQuestionFields(question, String(index), null)}
            ${parts}
          </div>`;
      }).join('');
    }

    // نفس الدالة بترسم السؤال والفرع — الفرق بس إن الفرع بياخد خانة حرف ورأس أصغر
    function renderQuestionFields(question, path, partIndex) {
      const isPart = partIndex !== null;
      const isGroup = question.kind === 'group';
      const label = isPart ? (question.label || PART_LABELS[partIndex] || String(partIndex + 1)) : '';

      const partHeader = isPart ? `
        <div class="row-between" style="gap:8px; margin-bottom:8px; flex-wrap:wrap">
          <div class="row" style="gap:8px; align-items:center">
            <input type="text" class="compact-input quiz-label" style="width:64px; text-align:center"
                   value="${escapeHtml(question.label || '')}" placeholder="${escapeHtml(label)}" title="حرف الفرع" />
            <span class="card-desc">${question.kind === 'mcq' ? 'فرع اختياري' : 'فرع مقالي'}</span>
          </div>
          <div class="row" style="gap:6px">
            <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="moveQuizPart('${path}', -1)">↑</button>
            <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="moveQuizPart('${path}', 1)">↓</button>
            ${quizEditorHasAttempts ? '' : `<button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" onclick="removeQuizPart('${path}')">حذف الفرع</button>`}
          </div>
        </div>` : '';

      const points = isGroup ? '' : `
        <div class="field" style="max-width:150px"><label>الدرجة</label>
          <input type="number" class="compact-input quiz-points" min="0.5" step="0.5" value="${question.points}" /></div>`;

      const body = question.kind === 'mcq' ? renderOptions(question, path)
        : question.kind === 'essay' ? `
          <div class="field"><label>الإجابة المرجعية <span class="card-desc">(المعيار اللي الذكاء الصناعي بيقارن بيه)</span></label>
            <textarea class="quiz-reference" rows="3">${escapeHtml(question.reference_answer)}</textarea></div>
          <div class="field"><label>تعليمات إضافية للتصحيح (اختياري)</label>
            <input type="text" class="compact-input quiz-notes" style="width:100%" value="${escapeHtml(question.grading_notes)}" placeholder="مثال: لازم يذكر القانون بالاسم" /></div>`
        : '';

      return `
        <div class="quiz-fields${isPart ? ' quiz-part' : ''}" data-path="${path}" ${isPart ? 'style="margin-bottom:16px"' : ''}>
          ${partHeader}
          <div class="field"><label>${isGroup ? 'رأس السؤال' : 'نص السؤال'}
            <span class="card-desc">${isGroup ? 'الكلام المشترك اللي فوق الفروع' : 'تقدر تسيبه فاضي لو السؤال صورة'}</span></label>
            <textarea class="quiz-question-text" rows="2">${escapeHtml(question.text)}</textarea></div>
          ${renderImageField(question, path)}
          ${points}
          ${body}
        </div>`;
    }

    // الصورة بتترفع فورًا وبيترجع مسارها — مافيش رفع مؤجل مع الحفظ، عشان الموظف يشوفها
    // قبل ما يكمّل ويتأكد إنها الصورة الصح
    function renderImageField(question, path) {
      return `
        <div class="field">
          <label>صورة (اختياري)</label>
          <div class="row" style="gap:8px; align-items:center; flex-wrap:wrap">
            <label class="btn btn-ghost btn-sm" style="width:auto; cursor:pointer">
              ${question.image ? 'تغيير الصورة' : 'رفع صورة'}
              <input type="file" accept="image/jpeg,image/png" style="display:none"
                     onchange="uploadQuizImage(event, '${path}')" />
            </label>
            ${question.image ? `<button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" onclick="clearQuizImage('${path}')">إزالة</button>` : ''}
          </div>
          ${question.image ? `<img src="${escapeHtml(question.image)}" alt="" style="max-width:100%; max-height:220px; margin-top:8px; border-radius:8px; border:1px solid var(--border)" />` : ''}
        </div>`;
    }

    function renderOptions(question, path) {
      const options = question.options.length ? question.options : [{ text: '', image: null }, { text: '', image: null }];
      return `
        <div class="quiz-options">${options.map((option, optionIndex) => `
          <div class="row" style="gap:8px; align-items:flex-start; margin-bottom:8px">
            <input type="radio" name="quiz-correct-${path.replace('.', '-')}" value="${optionIndex}"
                   ${Number(question.correct_option) === optionIndex ? 'checked' : ''} title="الإجابة الصح" style="margin-top:10px" />
            <div style="flex:1">
              <input type="text" class="compact-input quiz-option-text" style="width:100%"
                     value="${escapeHtml(option.text)}" placeholder="اختيار ${optionIndex + 1} — أو سيبه فاضي واكتفِ بالصورة" />
              <div class="row" style="gap:8px; align-items:center; margin-top:6px">
                <label class="btn btn-ghost btn-sm" style="width:auto; cursor:pointer; font-size:12px">
                  ${option.image ? 'تغيير صورة الاختيار' : '🖼️ صورة للاختيار'}
                  <input type="file" accept="image/jpeg,image/png" style="display:none"
                         onchange="uploadQuizImage(event, '${path}', ${optionIndex})" />
                </label>
                ${option.image ? `<button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto; font-size:12px" onclick="clearQuizImage('${path}', ${optionIndex})">إزالة</button>` : ''}
              </div>
              ${option.image ? `<img src="${escapeHtml(option.image)}" alt="" style="max-width:220px; max-height:140px; margin-top:6px; border-radius:6px; border:1px solid var(--border)" />` : ''}
            </div>
            <button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto; margin-top:4px" onclick="removeQuizOption('${path}', ${optionIndex})">×</button>
          </div>`).join('')}
          <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="addQuizOption('${path}')">+ اختيار</button>
        </div>`;
    }

    // بتقري كل حقول المحرر من الـ DOM جوه quizEditorQuestions. بتلف على .quiz-fields
    // (السؤال والفرع بيستخدموا نفس الكلاس) وبتوصل للكائن الصح من data-path
    function readQuizEditor() {
      document.querySelectorAll('#quiz-questions-editor .quiz-fields').forEach((node) => {
        const question = questionAt(node.dataset.path);
        if (!question) return;
        question.text = node.querySelector(':scope > .field > .quiz-question-text').value;
        const labelInput = node.querySelector(':scope > .row-between .quiz-label');
        if (labelInput) question.label = labelInput.value.trim();
        const pointsInput = node.querySelector(':scope > .field > .quiz-points');
        if (pointsInput) question.points = Number(pointsInput.value) || 1;

        if (question.kind === 'mcq') {
          const optionsBox = node.querySelector(':scope > .quiz-options');
          const texts = optionsBox.querySelectorAll('.quiz-option-text');
          question.options = Array.from(texts).map((input, index) => ({
            text: input.value,
            // الصورة مش في الـ DOM كقيمة — متخزّنة في الكائن من ساعة الرفع
            image: question.options[index] ? question.options[index].image : null,
          }));
          const picked = optionsBox.querySelector('input[type="radio"]:checked');
          question.correct_option = picked ? Number(picked.value) : 0;
        } else if (question.kind === 'essay') {
          question.reference_answer = node.querySelector(':scope > .field > .quiz-reference').value;
          question.grading_notes = node.querySelector(':scope > .field > .quiz-notes').value;
        }
      });
    }

    function addQuizQuestion(kind) {
      readQuizEditor();
      quizEditorQuestions.push(blankQuestion(kind));
      renderQuizQuestions();
    }

    function addQuizPart(index, kind) {
      readQuizEditor();
      quizEditorQuestions[index].parts.push(blankQuestion(kind));
      renderQuizQuestions();
    }

    function removeQuizQuestion(index) {
      readQuizEditor();
      quizEditorQuestions.splice(index, 1);
      renderQuizQuestions();
    }

    function removeQuizPart(path) {
      readQuizEditor();
      const [index, partIndex] = path.split('.').map(Number);
      const parts = quizEditorQuestions[index].parts;
      if (parts.length <= 1) return showToast('الرأس محتاج فرع واحد على الأقل — امسح السؤال كله لو مش عايزه');
      parts.splice(partIndex, 1);
      renderQuizQuestions();
    }

    function moveQuizQuestion(index, direction) {
      readQuizEditor();
      const target = index + direction;
      if (target < 0 || target >= quizEditorQuestions.length) return;
      const [moved] = quizEditorQuestions.splice(index, 1);
      quizEditorQuestions.splice(target, 0, moved);
      renderQuizQuestions();
    }

    function moveQuizPart(path, direction) {
      readQuizEditor();
      const [index, partIndex] = path.split('.').map(Number);
      const parts = quizEditorQuestions[index].parts;
      const target = partIndex + direction;
      if (target < 0 || target >= parts.length) return;
      const [moved] = parts.splice(partIndex, 1);
      parts.splice(target, 0, moved);
      renderQuizQuestions();
    }

    function addQuizOption(path) {
      readQuizEditor();
      questionAt(path).options.push({ text: '', image: null });
      renderQuizQuestions();
    }

    function removeQuizOption(path, optionIndex) {
      readQuizEditor();
      const question = questionAt(path);
      if (question.options.length <= 2) return showToast('السؤال محتاج اختيارين على الأقل');
      question.options.splice(optionIndex, 1);
      // الإجابة الصح كانت بتفضل على نفس الرقم بعد الحذف فتشاور على اختيار تاني خالص
      if (question.correct_option === optionIndex) question.correct_option = 0;
      else if (question.correct_option > optionIndex) question.correct_option -= 1;
      renderQuizQuestions();
    }

    // ---------- صور الأسئلة ----------
    async function uploadQuizImage(event, path, optionIndex) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      readQuizEditor();
      const form = new FormData();
      form.append('image', file);
      try {
        showToast('بترفع الصورة...');
        // من غير Content-Type: المتصفح بيحطه بنفسه مع الـ boundary بتاع multipart
        const response = await fetch('/api/quizzes/image', { method: 'POST', body: form });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'الرفع فشل');
        const question = questionAt(path);
        if (optionIndex === undefined) question.image = data.path;
        else question.options[optionIndex].image = data.path;
        renderQuizQuestions();
        showToast('الصورة اترفعت');
      } catch (error) {
        showToast(error.message);
      } finally {
        event.target.value = '';
      }
    }

    function clearQuizImage(path, optionIndex) {
      readQuizEditor();
      const question = questionAt(path);
      if (optionIndex === undefined) question.image = null;
      else question.options[optionIndex].image = null;
      renderQuizQuestions();
    }

    async function saveQuiz() {
      readQuizEditor();
      const title = document.getElementById('quiz-title').value.trim();
      if (!title) return showToast('اكتب عنوان الاختبار');
      if (!quizEditorQuestions.length) return showToast('ضيف سؤال واحد على الأقل');

      const payload = {
        title,
        // فاضية = مابنبعتش الحقل خالص، والسيرفر بيسيب الرابط القديم زي ما هو (COALESCE)
        slug: document.getElementById('quiz-slug').value.trim() || undefined,
        description: document.getElementById('quiz-description').value.trim(),
        time_limit_minutes: document.getElementById('quiz-time-limit').value || null,
        show_score_to_student: document.getElementById('quiz-show-score').checked,
        show_answers_to_student: document.getElementById('quiz-show-answers').checked,
        target_bootcamp_id: document.getElementById('quiz-bootcamp').value || null,
        answers_after_close: document.getElementById('quiz-answers-after-close').checked,
        shuffle_questions: document.getElementById('quiz-shuffle-questions').checked,
        shuffle_options: document.getElementById('quiz-shuffle-options').checked,
        is_open: true,
      };

      try {
        if (editingQuizId) {
          // التعديل مابيفتحش اختبار مقفول من ورا الموظف — القفل قرار منفصل بزراره
          const current = quizList.find((quiz) => quiz.id === editingQuizId);
          payload.is_open = current ? current.is_open : true;
          await api(`/api/quizzes/${editingQuizId}`, { method: 'PUT', body: JSON.stringify(payload) });
        } else {
          const created = await api('/api/quizzes', { method: 'POST', body: JSON.stringify(payload) });
          editingQuizId = created.id;
        }
        await api(`/api/quizzes/${editingQuizId}/questions`, {
          method: 'PUT',
          body: JSON.stringify({ questions: quizEditorQuestions }),
        });
        showToast('الاختبار اتحفظ');
        await loadQuizzes();
        showQuizView('list');
      } catch (error) {
        showToast(error.message);
      }
    }

    async function toggleQuizOpen(id) {
      const quiz = quizList.find((item) => item.id === id);
      if (!quiz) return;
      try {
        await api(`/api/quizzes/${id}`, {
          method: 'PUT',
          body: JSON.stringify({
            title: quiz.title,
            description: quiz.description,
            time_limit_minutes: quiz.time_limit_minutes,
            show_score_to_student: quiz.show_score_to_student,
            // من غير السطر ده القفل والفتح كان بيرجّع عرض التصحيح لافتراضيه — الحقل
            // اللي مش في الطلب بياخد الافتراضي عند السيرفر مش قيمته الحالية
            show_answers_to_student: quiz.show_answers_to_student,
            target_bootcamp_id: quiz.target_bootcamp_id || null,
            answers_after_close: quiz.answers_after_close,
            shuffle_questions: quiz.shuffle_questions,
            shuffle_options: quiz.shuffle_options,
            is_open: !quiz.is_open,
          }),
        });
        showToast(quiz.is_open ? 'الاختبار اتقفل — الرابط بقى مايفتحش' : 'الاختبار اتفتح');
        loadQuizzes();
      } catch (error) { showToast(error.message); }
    }

    async function deleteQuiz(id) {
      if (!confirm('متأكد من حذف الاختبار؟')) return;
      try {
        await api(`/api/quizzes/${id}`, { method: 'DELETE', body: JSON.stringify({}) });
        showToast('الاختبار اتحذف');
        loadQuizzes();
        return;
      } catch (error) {
        // السيرفر بيرفض حذف اختبار فيه محاولات من غير تأكيد تاني — إجابات الطلاب بتروح معاه
        if (!error.data || !error.data.needs_confirmation) return showToast(error.message);
        if (!confirm(`${error.message}\n\nتأكيد الحذف؟`)) return;
      }
      try {
        await api(`/api/quizzes/${id}`, { method: 'DELETE', body: JSON.stringify({ confirm: true }) });
        showToast('الاختبار وإجاباته اتحذفوا');
        loadQuizzes();
      } catch (error) { showToast(error.message); }
    }

    // ---------- النتايج ----------
    async function openQuizResults(id) {
      quizResultsId = id;
      const quiz = quizList.find((item) => item.id === id);
      document.getElementById('quiz-results-title').textContent = quiz ? `نتايج: ${quiz.title}` : 'النتايج';
      document.getElementById('quiz-attempt-detail').style.display = 'none';
      // التصدير رابط عادي مش نداء fetch: تنزيل ملف من fetch محتاج blob وanchor مؤقت،
      // والمتصفح بيعمل الشغل ده لوحده لو الرابط <a> والسيرفر باعت Content-Disposition
      document.getElementById('quiz-export-btn').href = `/api/quizzes/${id}/export`;
      // لوحة الإحصائيات بتتقفل مع كل اختبار جديد — أرقام اختبار معروضة في صفحة اختبار
      // تاني غلط مابيبانش، لأن الشكل هو الشكل
      document.getElementById('quiz-stats').style.display = 'none';
      document.getElementById('quiz-missing').style.display = 'none';
      showQuizView('results');
      loadQuizAttempts();
    }

    // ---------- إحصائيات الأسئلة ----------
    // النسبة اللي بيتترتب بيها: متوسط (درجة الطالب ÷ درجة السؤال). السؤال اللي متوسطه
    // ٣٠٪ معناه إن تلت الفصل بس فهمه — وده اللي المدرّس محتاج يشوفه الأول
    function statsBar(ratio) {
      const percent = ratio === null ? 0 : Math.round(ratio * 100);
      const tone = ratio === null ? 'var(--border)'
        : percent >= 75 ? 'var(--success)' : percent >= 40 ? 'var(--warning)' : 'var(--danger)';
      return `<div style="height:8px; border-radius:999px; background:var(--surface-sunken); overflow:hidden; margin:8px 0">
        <div style="height:100%; width:${percent}%; background:${tone}"></div></div>`;
    }

    // للاختياري: أنهي اختيار شدّ الطلاب. الاختيار الغلط اللي ماشي عليه ٤٠٪ بيقول إن فيه
    // فهم غلط بعينه — مش تخمين عشوائي — وده بيتشرح في الحصة مش بيتعاد بنفس الكلام
    function statsPicks(question) {
      if (question.kind !== 'mcq' || !question.picks.length) return '';
      const total = question.picks.reduce((sum, pick) => sum + pick.picks, 0) || 1;
      const rows = question.picks
        .slice()
        .sort((a, b) => b.picks - a.picks)
        .map((pick) => {
          const option = pick.option === null || pick.option === undefined
            ? null : question.options[pick.option];
          const isRight = pick.option !== null && Number(question.correct_option) === Number(pick.option);
          const name = pick.option === null || pick.option === undefined
            ? '<i>ماختاروش</i>'
            : escapeHtml((option && option.text) || `اختيار ${pick.option + 1}`);
          return `<div class="row-between" style="gap:10px; padding:3px 0">
            <span>${isRight ? '✅ ' : ''}${name}</span>
            <span class="card-desc">${pick.picks} (${Math.round((pick.picks / total) * 100)}%)</span>
          </div>`;
        }).join('');
      return `<div style="margin-top:8px">${rows}</div>`;
    }

    async function loadQuestionStats() {
      const panel = document.getElementById('quiz-stats');
      // الزرار بيفتح ويقفل — الضغطة التانية بتخفيه بدل ما تعيد التحميل
      if (panel.style.display !== 'none') { panel.style.display = 'none'; return; }
      panel.style.display = '';
      panel.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api(`/api/quizzes/${quizResultsId}/question-stats`);
        if (!data.submitted) {
          panel.innerHTML = '<div class="empty-state">لسه محدش سلّم الاختبار ده.</div>';
          return;
        }
        // الترتيب من الأصعب: السؤال اللي مالوش إجابات خالص بيروح الآخر مش الأول —
        // نسبته null مش صفر، والفرق بين "محدش جاوبه" و"كلهم غلطوا فيه" مهم
        const ordered = data.questions.slice().sort((a, b) => {
          if (a.avg_ratio === null) return 1;
          if (b.avg_ratio === null) return -1;
          return a.avg_ratio - b.avg_ratio;
        });
        const cards = ordered.map((question) => {
          const heading = question.is_part
            ? `سؤال ${question.number} (${escapeHtml(question.label || '')})`
            : `سؤال ${question.number}`;
          const percent = question.avg_ratio === null ? '—' : `${Math.round(question.avg_ratio * 100)}%`;
          const counts = [
            `صح ${question.full_marks}`,
            question.partial ? `ناقص ${question.partial}` : '',
            `غلط ${question.zero}`,
            question.ungraded ? `مستني مراجعة ${question.ungraded}` : '',
          ].filter(Boolean).join(' · ');
          return `
            <div class="card" style="background:var(--surface-sunken); margin-bottom:10px">
              <div class="row-between" style="gap:10px; flex-wrap:wrap">
                <b>${heading}</b>
                <span class="badge badge-muted">${percent} من الدرجة</span>
              </div>
              <div class="card-desc" style="margin-top:4px">${escapeHtml((question.text || '').slice(0, 160))}</div>
              ${statsBar(question.avg_ratio)}
              <div class="card-desc">${counts} — من ${question.answered} جاوبوا</div>
              ${statsPicks(question)}
            </div>`;
        }).join('');
        const average = data.avg_ratio === null ? '—' : `${Math.round(data.avg_ratio * 100)}%`;
        panel.innerHTML = `
          <div class="row-between" style="margin-bottom:10px; gap:12px; flex-wrap:wrap">
            <b>📊 الأسئلة من الأصعب للأسهل</b>
            <span class="card-desc">${data.submitted} سلّموا · متوسط الورقة ${average}</span>
          </div>
          ${cards}`;
      } catch (error) {
        panel.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    // ---------- مين ماحلّش ----------
    // الأرقام هي المنتج هنا: القايمة بتتنسخ وتروح لتيم المكالمات أو لرسالة جماعية.
    // اللي مربوط بتيليجرام بيتعلّم، عشان اللي مش مربوط يتعرف إنه محتاج مكالمة مش رسالة
    function copyMissingPhones() {
      const phones = (quizMissingList || []).map((student) => student.phone).filter(Boolean);
      if (!phones.length) return showToast('مفيش أرقام تتنسخ');
      navigator.clipboard.writeText(phones.join('\n'))
        .then(() => showToast(`${phones.length} رقم اتنسخوا`))
        .catch(() => showToast('مقدرناش ننسخ — حدّد الأرقام بإيدك'));
    }

    let quizMissingList = [];

    async function loadQuizMissing() {
      const panel = document.getElementById('quiz-missing');
      if (panel.style.display !== 'none') { panel.style.display = 'none'; return; }
      panel.style.display = '';
      panel.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api(`/api/quizzes/${quizResultsId}/coverage`);
        if (!data.configured) {
          panel.innerHTML = `<div class="empty-state">
            الاختبار ده مش مربوط بباب، فمش عارفين مين كان المفروض يحلّه.<br />
            افتح <b>تعديل</b> واختار الباب من "الباب اللي الاختبار موجّه له".</div>`;
          quizMissingList = [];
          return;
        }
        quizMissingList = data.missing;
        const rows = data.missing.map((student) => `
          <div class="row-between" style="gap:10px; padding:7px 0; border-bottom:1px solid var(--border)">
            <span>${escapeHtml(student.name || '—')}</span>
            <span class="row" style="gap:8px; align-items:center">
              <span class="card-desc" dir="ltr">${escapeHtml(student.phone || '—')}</span>
              ${student.reachable
                ? '<span class="badge badge-success">على البوت</span>'
                : '<span class="badge badge-muted">مكالمة</span>'}
            </span>
          </div>`).join('');
        const truncated = data.missing_count > data.missing.length
          ? `<div class="card-desc" style="margin-top:8px">القايمة بتعرض أول ${data.missing.length} — الباقي في التصدير.</div>`
          : '';
        // اللي حلّ برقم مش على المنصة مابيتحسبش في "حلّوا" لأن مفيش طريقة نربطه بمشترك.
        // السكوت عن الرقم ده بيخلي المدرّس يفتكر إن فيه طلاب ماحلّوش وهم حلّوا
        const unmatched = data.unmatched_submitted
          ? `<div class="card-desc" style="margin-top:6px">⚠️ ${data.unmatched_submitted} سلّموا برقم مش على المنصة — مش محسوبين فوق لأننا مش عارفين هم مين.</div>`
          : '';
        panel.innerHTML = `
          <div class="row-between" style="margin-bottom:6px; gap:12px; flex-wrap:wrap">
            <b>🔎 ${escapeHtml(data.bootcamp_name || 'الباب')}</b>
            <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="copyMissingPhones()">انسخ أرقام المتخلّفين</button>
          </div>
          <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px">
            <span class="badge badge-muted">${data.enrolled} مشترك</span>
            <span class="badge badge-success">${data.submitted} حلّوا</span>
            ${data.in_progress ? `<span class="badge badge-warning">${data.in_progress} بدأوا وماكملوش</span>` : ''}
            <span class="badge badge-danger">${data.missing_count} ماحلّوش</span>
          </div>
          ${unmatched}
          ${rows || '<div class="empty-state">كل المشتركين حلّوا 🎉</div>'}
          ${truncated}`;
      } catch (error) {
        panel.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function loadQuizAttempts() {
      const box = document.getElementById('quiz-attempts-table');
      box.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const attempts = await api(`/api/quizzes/${quizResultsId}/attempts`);
        if (!attempts.length) {
          box.innerHTML = '<div class="empty-state">لسه محدش دخل الاختبار</div>';
          return;
        }
        const rows = attempts.map((attempt) => {
          const name = attempt.platform_name || attempt.student_name || '—';
          const status = !attempt.submitted_at
            ? '<span class="badge badge-warning">لسه بيحل</span>'
            : attempt.grading_status === 'queued'
              ? '<span class="badge badge-muted">في طابور التصحيح...</span>'
            : attempt.grading_status === 'regrading'
              ? '<span class="badge badge-muted">بيتصحّح تاني...</span>'
              : attempt.grading_status === 'partial'
                ? '<span class="badge badge-danger">محتاجة مراجعتك</span>'
                : '<span class="badge badge-success">اتصحّح</span>';
          const score = attempt.score === null ? '—' : `${Math.round(attempt.score * 100) / 100} / ${attempt.max_score}`;
          return `<tr>
            <td>${escapeHtml(name)}${attempt.matched ? '' : ' <span class="badge badge-muted">مش مطابق للمنصة</span>'}</td>
            <td>${escapeHtml(attempt.phone)}</td>
            <td>${status}${attempt.is_late ? ' <span class="badge badge-muted">متأخر</span>' : ''}</td>
            <td>${score}</td>
            <td>${attempt.submitted_at ? fmtDate(attempt.submitted_at) : fmtDate(attempt.started_at)}</td>
            <td><button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="openQuizAttempt(${attempt.id})">الإجابات</button></td>
          </tr>`;
        }).join('');
        box.innerHTML = `<table><thead><tr><th>الطالب</th><th>التليفون</th><th>الحالة</th><th>الدرجة</th><th>الوقت</th><th></th></tr></thead><tbody>${rows}</tbody></table>`;
        // طول ما فيه محاولة في الطابور بنعيد التحميل لوحدنا — التصحيح ماشي في الخلفية
        // والموظف مالوش دعوة يفضل يضغط تحديث عشان يعرف خلص ولا لأ
        clearTimeout(quizRegradeTimer);
        const stillRegrading = attempts.filter((attempt) => ['regrading', 'queued'].includes(attempt.grading_status)).length;
        if (stillRegrading) {
          document.getElementById('quiz-results-title').dataset.pending = stillRegrading;
          quizRegradeTimer = setTimeout(() => {
            // الشاشة اتقفلت وهو مستني؟ نبطّل — التصحيح بيكمّل على السيرفر من غيرنا
            if (document.getElementById('quiz-results-view').style.display !== 'none') loadQuizAttempts();
          }, 5000);
        }
      } catch (error) {
        box.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function openQuizAttempt(attemptId) {
      const box = document.getElementById('quiz-attempt-detail');
      box.style.display = '';
      box.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api(`/api/quizzes/attempts/${attemptId}`);
        const name = data.attempt.platform_name || data.attempt.student_name || '—';
        const verdictLabels = { correct: 'صح', partial: 'جزئي', incorrect: 'غلط' };

        let questionNumber = 0;
        const answers = data.answers.map((answer) => {
          const options = Array.isArray(answer.options) ? answer.options : [];
          const image = answer.image
            ? `<img src="${escapeHtml(answer.image)}" alt="" style="max-width:100%; max-height:260px; border-radius:8px; margin:8px 0" />`
            : '';

          // رأس السؤال: عنوان بس، مالوش إجابة ولا درجة يتعدّلوا
          if (answer.kind === 'group') {
            questionNumber += 1;
            return `<div class="card" style="background:var(--surface-sunken); margin-bottom:10px; border-inline-start:3px solid var(--primary)">
              <b>${questionNumber}. ${escapeHtml(answer.text)}</b>${image}</div>`;
          }
          if (!answer.is_part) questionNumber += 1;
          const heading = answer.is_part
            ? `<b>${escapeHtml(answer.label || '')}) ${escapeHtml(answer.text)}</b>`
            : `<b>${questionNumber}. ${escapeHtml(answer.text)}</b>`;

          const isMcq = answer.kind === 'mcq';
          const optionText = (option) => (option
            ? escapeHtml(option.text) + (option.image ? ' 🖼️' : '')
            : '—');
          const studentText = isMcq
            ? (answer.selected_option === null || answer.selected_option === undefined
              ? '<i>ماختارش</i>' : optionText(options[answer.selected_option]))
            : (answer.essay_text ? escapeHtml(answer.essay_text) : '<i>ساب السؤال فاضي</i>');
          const reference = isMcq
            ? optionText(options[answer.correct_option])
            : escapeHtml(answer.reference_answer);
          // حكم النموذج وسببه بيتعرضوا للموظف مش للطالب — ده اللي بيخليه يقدر يخالفه بثقة
          const verdict = answer.ai_verdict
            ? `<div class="card-desc" style="margin-top:6px">🤖 ${verdictLabels[answer.ai_verdict] || answer.ai_verdict}: ${escapeHtml(answer.ai_reason)}</div>`
            : '';
          const staffMark = answer.graded_by === 'staff'
            ? `<span class="badge badge-muted">عدّلها ${escapeHtml(answer.graded_by_name || 'موظف')}</span>`
            : '';

          return `
            <div class="card" style="background:var(--surface-sunken); margin-bottom:10px${answer.is_part ? '; margin-inline-start:18px' : ''}">
              <div class="row-between" style="gap:8px; flex-wrap:wrap">
                ${heading}
                <span class="badge badge-muted">${answer.points} درجة</span>
              </div>
              ${image}
              <div style="margin-top:10px"><span class="card-desc">إجابة الطالب:</span>
                <div style="white-space:pre-wrap">${studentText}</div></div>
              <div style="margin-top:8px"><span class="card-desc">${isMcq ? 'الإجابة الصح:' : 'الإجابة المرجعية:'}</span>
                <div style="white-space:pre-wrap">${reference}</div></div>
              ${verdict}
              <div class="row" style="gap:8px; margin-top:10px; align-items:center; flex-wrap:wrap">
                <span class="card-desc">الدرجة:</span>
                <input type="number" class="compact-input" style="width:90px" min="0" max="${answer.points}" step="0.5"
                       id="quiz-grade-${answer.question_id}" value="${answer.awarded_points === null ? '' : answer.awarded_points}" />
                <button type="button" class="btn btn-ghost btn-sm" style="width:auto"
                        onclick="saveQuizGrade(${attemptId}, ${answer.question_id})">اعتمد الدرجة</button>
                ${staffMark}
              </div>
            </div>`;
        }).join('');

        const needsReview = data.attempt.grading_status === 'partial';
        box.innerHTML = `
          <div class="row-between" style="margin-bottom:12px; gap:12px; flex-wrap:wrap">
            <b>${escapeHtml(name)} — ${data.attempt.score === null ? '—' : Math.round(data.attempt.score * 100) / 100} / ${data.attempt.max_score === null ? '—' : data.attempt.max_score}</b>
            <div class="row" style="gap:8px">
              ${needsReview ? `<button type="button" class="btn btn-primary btn-sm" style="width:auto" onclick="regradeQuizAttempt(${attemptId})">أعد التصحيح الآلي</button>` : ''}
              <button type="button" class="btn btn-danger-ghost btn-sm" style="width:auto" onclick="reopenQuizAttempt(${attemptId})">اسمحله يعيد</button>
              <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="hideQuizAttempt()">إخفاء</button>
            </div>
          </div>
          ${data.attempt.grading_error ? `<div class="card-desc" style="margin-bottom:10px">⚠️ التصحيح الآلي فشل: ${escapeHtml(data.attempt.grading_error)}</div>` : ''}
          ${answers}`;
      } catch (error) {
        box.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function hideQuizAttempt() {
      document.getElementById('quiz-attempt-detail').style.display = 'none';
    }

    async function saveQuizGrade(attemptId, questionId) {
      const input = document.getElementById(`quiz-grade-${questionId}`);
      if (!input || input.value === '') return showToast('اكتب الدرجة الأول');
      try {
        await api(`/api/quizzes/attempts/${attemptId}/answers/${questionId}`, {
          method: 'PUT',
          body: JSON.stringify({ awarded_points: Number(input.value) }),
        });
        showToast('الدرجة اتعدّلت');
        await loadQuizAttempts();
        await openQuizAttempt(attemptId);
      } catch (error) { showToast(error.message); }
    }

    // إعادة تصحيح الاختبار كله بالإجابة المرجعية الجديدة. التحذير صريح لأن العملية بتكلّف
    // نداء نموذج لكل سؤال مقالي في كل محاولة — مش زرار بيتضغط بالغلط
    async function regradeWholeQuiz() {
      if (!confirm(`هيعيد تصحيح كل المحاولات المسلّمة بالإجابات المرجعية الحالية.

الدرجات اللي عدّلتها بإيدك هتفضل زي ما هي، والتصحيح هيمشي في الخلفية.

تمام؟`)) return;
      try {
        const result = await api(`/api/quizzes/${quizResultsId}/regrade`, { method: 'POST', body: JSON.stringify({}) });
        showToast(result.attempts
          ? `${result.attempts} محاولة دخلت طابور إعادة التصحيح`
          : 'مفيش محاولات مسلّمة تتصحّح');
        document.getElementById('quiz-attempt-detail').style.display = 'none';
        loadQuizAttempts();
      } catch (error) { showToast(error.message); }
    }

    // بيمسح إجابات الطالب. التأكيد بيقول كده بالنص — الموظف اللي بيدوس الزرار ده
    // بيحل مشكلة طالب، مش بيجرّب
    async function reopenQuizAttempt(attemptId) {
      if (!confirm(`هيمسح إجابات الطالب في الاختبار ده ويسيبه يدخل من الأول بنفس رقمه.

مفيش رجوع في الخطوة دي.

تمام؟`)) return;
      try {
        const result = await api(`/api/quizzes/attempts/${attemptId}/reopen`, {
          method: 'POST', body: JSON.stringify({}),
        });
        showToast(result.quiz_is_open
          ? 'اتفتحت — قوله يفتح نفس الرابط بنفس رقمه'
          : 'اتفتحت، بس الاختبار نفسه مقفول — افتحه عشان يقدر يدخل');
        document.getElementById('quiz-attempt-detail').style.display = 'none';
        loadQuizAttempts();
      } catch (error) { showToast(error.message); }
    }

    async function regradeQuizAttempt(attemptId) {
      try {
        showToast('بنعيد التصحيح الآلي...');
        await api(`/api/quizzes/attempts/${attemptId}/regrade`, { method: 'POST', body: JSON.stringify({}) });
        showToast('اتصحّح');
        await loadQuizAttempts();
        await openQuizAttempt(attemptId);
      } catch (error) { showToast(error.message); }
    }

    document.getElementById('new-quiz-btn').addEventListener('click', newQuizEditor);
    document.getElementById('quiz-editor-back').addEventListener('click', () => { loadQuizzes(); showQuizView('list'); });
    document.getElementById('quiz-results-back').addEventListener('click', () => {
      clearTimeout(quizRegradeTimer);
      loadQuizzes();
      showQuizView('list');
    });
    document.getElementById('quiz-regrade-all-btn').addEventListener('click', regradeWholeQuiz);
    document.getElementById('quiz-stats-btn').addEventListener('click', loadQuestionStats);
    document.getElementById('quiz-missing-btn').addEventListener('click', loadQuizMissing);
    document.getElementById('preview-grade-btn')?.addEventListener('click', runGradePreview);
    document.getElementById('save-grading-provider-btn')?.addEventListener('click', saveGradingProvider);
    document.getElementById('preview-clear-btn')?.addEventListener('click', () => {
      document.getElementById('preview-results').innerHTML = '';
    });
    document.getElementById('quiz-doc-file-btn').addEventListener('click', importQuizDocumentFile);
    document.getElementById('quiz-doc-text-btn').addEventListener('click', importQuizDocumentText);
    document.getElementById('add-mcq-btn').addEventListener('click', () => addQuizQuestion('mcq'));
    document.getElementById('add-essay-btn').addEventListener('click', () => addQuizQuestion('essay'));
    document.getElementById('add-group-btn').addEventListener('click', () => addQuizQuestion('group'));
    document.getElementById('save-quiz-btn').addEventListener('click', saveQuiz);
    // معاينة الرابط وهو بيكتب — أرخص من إنه يحفظ وبعدين يكتشف إن الشكل مرفوض
    document.getElementById('quiz-slug').addEventListener('input', (event) => {
      const value = event.target.value.trim().toLowerCase().replace(/\s+/g, '-');
      document.getElementById('quiz-slug-preview').textContent = value || 'كود-تلقائي';
    });

    // ---------- شروط الـ API العام ----------
    // القايمة نفسها بتتقري من فلاتر طلاب المنصة، فمفيش نداء جديد للأبواب. الحفظ بيروح
    // لـ settings.api_follow_up_bootcamps، واللي بيقرا منها هو /api/public/student-status
    let apiBootcampsLoaded = false;

    async function initApiConditionsTab() {
      if (apiBootcampsLoaded) return;
      const state = document.getElementById('api-bootcamps-state');
      try {
        await loadTafraStudentFilters();
        const control = createMultiSelectFilter('api-bootcamps-filter', 'اختار الأبواب...');
        control.setOptions(tafraFilterOptions.bootcamps.map((item) => ({ value: item.id, label: item.name })));
        const settings = await api('/api/settings');
        document.getElementById('api-bootcamps-filter').value = settings.api_follow_up_bootcamps || '';
        control.refresh();
        apiBootcampsLoaded = true;
        renderApiBootcampsState();
      } catch (error) {
        state.textContent = error.message;
      }
    }

    // بتقول للأدمن الشرط شغّال ولا مقفول بالكلام مش بعدد — الفرق بين الاتنين هو الفرق بين
    // "بتابع المشتركين" و"وقفت المتابعة كلها"
    function renderApiBootcampsState() {
      const value = document.getElementById('api-bootcamps-filter').value;
      const count = value ? value.split(',').filter(Boolean).length : 0;
      document.getElementById('api-bootcamps-state').textContent = count
        ? `الشرط شغّال على ${count} باب — المشترك في أي واحد منهم بيرجّع false لو لسه ما دخلش البوت.`
        : 'الشرط مقفول دلوقتي — الـ API بيرد على دخول البوت بس.';
    }

    async function saveApiBootcamps() {
      const button = document.getElementById('save-api-bootcamps-btn');
      button.disabled = true;
      try {
        const bootcamps = document.getElementById('api-bootcamps-filter').value || '';
        await api('/api/settings/api-follow-up', { method: 'POST', body: JSON.stringify({ bootcamps }) });
        showToast('اتحفظت شروط الـ API');
        renderApiBootcampsState();
      } catch (error) {
        showToast(error.message);
      } finally {
        button.disabled = false;
      }
    }

    // بينده نفس النقطة العامة اللي النظام الخارجي بيستخدمها — مش نسخة منها. أي فرق بين
    // اللي بيظهر هنا واللي بيوصل بره معناه إننا بنجرّب حاجة تانية
    async function testApiOnPhone() {
      const phone = document.getElementById('api-test-phone').value.trim();
      const box = document.getElementById('api-test-result');
      if (!phone) return showToast('اكتب رقم موبايل');
      box.innerHTML = '<div class="empty-state">بيسأل...</div>';
      try {
        const response = await fetch(`/api/public/student-status?phone=${encodeURIComponent(phone)}`);
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'حصل خطأ');

        const skip = data.skip_follow_up;
        const verdict = skip
          ? '<span class="badge badge-success">true — سيبه</span>'
          : '<span class="badge badge-danger">false — اتصل بيه</span>';
        const why = !data.found ? 'الرقم مش على منصة طفرة أصلًا'
          : data.started ? 'داخل البوت خلاص'
          : data.enrolled === null ? 'شرط الأبواب مقفول، ولسه ما دخلش البوت'
          : data.enrolled ? `مشترك في: ${data.enrolled_bootcamps.join('، ')} — ولسه ما دخلش البوت`
          : 'مش مشترك في أي باب من اللي اتحددوا';
        box.innerHTML = `
          <div class="card" style="background:var(--surface-sunken); margin:0">
            <div class="row-between" style="gap:8px; flex-wrap:wrap">
              <b>${escapeHtml(data.student_name || 'مش موجود على المنصة')}</b>
              ${verdict}
            </div>
            <div class="card-desc" style="margin-top:8px">السبب: ${escapeHtml(why)}</div>
            <pre dir="ltr" style="margin:10px 0 0; padding:10px; background:var(--surface); border-radius:8px; overflow-x:auto; font-size:12px">${escapeHtml(JSON.stringify(data, null, 2))}</pre>
          </div>`;
      } catch (error) {
        box.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    document.querySelector('#new-bot-subtabs .subtab-btn[data-subtab="api-conditions"]')
      ?.addEventListener('click', initApiConditionsTab);
    document.getElementById('save-api-bootcamps-btn')?.addEventListener('click', saveApiBootcamps);
    document.getElementById('api-test-btn')?.addEventListener('click', testApiOnPhone);
    document.getElementById('api-test-phone')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') testApiOnPhone();
    });

    // ---------- تشغيل أولي ----------
    const hasTicketsAccess = Boolean(document.querySelector('.nav-item[data-tab="tickets"]'));
    const hasCallsAccess = Boolean(document.querySelector('.nav-item[data-tab="calls"]'));
    if (pendingDeepLinkTicketId) {
      document.querySelector('.nav-item[data-tab="tickets"]')?.click();
    } else if (currentUserRole === 'admin') {
      loadStats();
    } else if (hasTicketsAccess) {
      initTickets();
    } else if (hasCallsAccess) {
      initCalls();
    }
    // بث الأحداث اللحظي مرتبط بصندوق الدعم — بلاش نفتحه لموظف مالوش صلاحية عرضه أصلًا
    if (hasTicketsAccess) initLiveEvents();
  </script>
</body>
</html>
