    // ---------- قائمة الردود الجاهزة بـ / ----------
    //
    // الاختصار `/` مش رقم مجرّد عن قصد: الموظف بيرد على الطالب بأرقام فعلًا (عدد محاضرات،
    // رقم فكرة)، فرقم لوحده كان هيتحول لرد جاهز بالغلط. `/` مستحيل يبقى بداية رد حقيقي.
    //
    // بعد `/` بتترشّح بالعنوان أو بالرقم: `/2` بيوصل للتاني على طول، و`/مذكرة` بيفلتر بالاسم.
    // الاتنين شغالين مع بعض فالمستخدم الجديد بيتصفّح والقديم بيكتب الرقم من غير ما يبص.
    let slashIndex = 0;
    let slashMatches = [];

    function closeSlashMenu() {
      const menu = document.getElementById('quick-reply-menu');
      if (menu) menu.style.display = 'none';
      slashMatches = [];
    }

    function insertQuickReply(reply) {
      const box = document.getElementById('ticket-reply-content');
      // بيستبدل الـ / وكلمة الترشيح اللي بعدها بس — أي كلام كتبه الموظف قبلها بيفضل مكانه
      box.value = box.value.replace(/\/\S*$/, reply.content);
      closeSlashMenu();
      box.focus();
      box.dispatchEvent(new Event('input'));
    }

    function renderSlashMenu(query) {
      const menu = document.getElementById('quick-reply-menu');
      if (!menu) return;
      const all = visibleQuickReplies();
      const term = query.trim().toLowerCase();
      slashMatches = !term
        ? all
        : all.filter((r, i) => String(i + 1) === term || r.title.toLowerCase().includes(term));
      if (!slashMatches.length) { closeSlashMenu(); return; }
      slashIndex = Math.min(slashIndex, slashMatches.length - 1);
      menu.innerHTML = slashMatches.map((r, i) => `
        <button type="button" class="quick-reply-option ${i === slashIndex ? 'active' : ''}" data-slash="${i}">
          <span class="quick-reply-num">${all.indexOf(r) + 1}</span>
          <span class="quick-reply-name">${escapeHtml(r.title)}</span>
          <span class="quick-reply-peek">${escapeHtml(r.content.slice(0, 70))}</span>
        </button>`).join('');
      menu.style.display = 'block';
      menu.querySelectorAll('[data-slash]').forEach((button) => {
        button.addEventListener('mousedown', (event) => {
          // mousedown مش click: الـ blur بيقفل القايمة قبل ما الـ click يوصل
          event.preventDefault();
          insertQuickReply(slashMatches[Number(button.dataset.slash)]);
        });
      });
    }

    function bindSlashMenu() {
      const box = document.getElementById('ticket-reply-content');
      if (!box || box.dataset.slashBound === '1') return;
      box.dataset.slashBound = '1';

      box.addEventListener('input', () => {
        const match = box.value.match(/\/(\S*)$/);
        if (match) { slashIndex = 0; renderSlashMenu(match[1]); } else closeSlashMenu();
      });

      box.addEventListener('keydown', (event) => {
        if (!slashMatches.length) return;
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          slashIndex = (slashIndex + (event.key === 'ArrowDown' ? 1 : -1) + slashMatches.length) % slashMatches.length;
          renderSlashMenu(box.value.match(/\/(\S*)$/)?.[1] || '');
        } else if (event.key === 'Enter' || event.key === 'Tab') {
          event.preventDefault();
          insertQuickReply(slashMatches[slashIndex]);
        } else if (event.key === 'Escape') {
          closeSlashMenu();
        }
      });

      box.addEventListener('blur', () => setTimeout(closeSlashMenu, 150));
    }

    // حفظ اللي الموظف كاتبه دلوقتي كرد جاهز — أقل احتكاك ممكن لبناء المكتبة: هو لسه كاتب
    // إجابة كويسة، فبدل ما يعيد كتابتها في شاشة تانية بيحفظها من مكانه
    async function saveDraftAsQuickReply() {
      const box = document.getElementById('ticket-reply-content');
      const content = box.value.trim();
      if (!content) return showToast('اكتب الرد الأول وبعدين احفظه');
      const title = window.prompt('اسم مختصر للرد ده (هيظهر في القايمة):');
      if (!title?.trim()) return;
      try {
        await api('/api/assist/quick-replies', {
          method: 'POST', body: JSON.stringify({ title: title.trim(), content }),
        });
        quickRepliesCache = null;
        await renderQuickReplies();
        showToast('اتحفظ — اكتب / في أي وقت عشان تستخدمه');
      } catch (error) { showToast(error.message); }
    }

    function ticketQueryString() {
      const query = new URLSearchParams({ page: String(ticketsPage) });
      const values = {
        q: document.getElementById('ticket-search').value.trim(),
        status: document.getElementById('ticket-status-filter').value,
        subtitle_id: document.getElementById('ticket-subtitle-filter').value,
        priority: document.getElementById('ticket-priority-filter').value,
        category: document.getElementById('ticket-category-filter').value,
        assigned_to: document.getElementById('ticket-assignee-filter').value,
        follow_up: document.getElementById('ticket-follow-up-filter').value,
        sent_older_than: document.getElementById('ticket-sent-filter').value,
        received_older_than: document.getElementById('ticket-received-filter').value,
        idea_number: document.getElementById('ticket-idea-filter') ? document.getElementById('ticket-idea-filter').value : '',
      };
      Object.entries(values).forEach(([key, value]) => { if (value) query.set(key, value); });
      if (document.getElementById('ticket-unread-filter').checked) query.set('unread', 'true');
      if (document.getElementById('ticket-awaiting-reply-filter').checked) query.set('awaiting_reply', 'true');
      if (document.getElementById('ticket-unassigned-filter').checked) query.set('unassigned', 'true');
      if (document.getElementById('ticket-never-replied-filter').checked) query.set('never_replied', 'true');
      // فلاتر الطلاب المشتركة — الشريط بيرسمها في صندوق الدعم و buildTicketFilters بيفهمها،
      // بس السطر ده كان ناقص فكانت بتتغيّر وتعيد التحميل وماتأثرش في النتيجة بأي حاجة
      return studentFilterParams('tickets', query).toString();
    }

    async function loadTickets(silent = false) {
      const list = document.getElementById('ticket-list');
      if (!silent) {
        list.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      }
      try {
        const data = await api('/api/tickets?' + ticketQueryString());
        ticketsTotalPages = data.pages;
        // الأدمن بيشوف الإجمالي وعدد الصفحات؛ الموظف بيشوف عدد اللي محتاج تدخّل بس.
        // السيرفر أصلًا مش بيبعتله total ولا pages، فالتفريع هنا على وجود الرقم مش على الدور —
        // ولو اتغيّرت القاعدة على السيرفر الواجهة بتمشي وراها من غير تعديل
        const countEl = document.getElementById('ticket-count');
        const pageEl = document.getElementById('ticket-page-label');
        if (data.total === undefined) {
          countEl.textContent = data.actionable ? `محتاجة تدخّلك: ${data.actionable}` : 'مفيش حاجة محتاجة تدخّلك';
          pageEl.textContent = data.page > 1 ? `صفحة ${data.page}` : '';
          ticketsHasMore = Boolean(data.has_more);
          document.getElementById('tickets-next').disabled = !ticketsHasMore;
        } else {
          countEl.textContent = `التذاكر (${data.total})`;
          pageEl.textContent = `صفحة ${data.page} من ${data.pages}`;
          ticketsHasMore = data.page < data.pages;
          document.getElementById('tickets-next').disabled = !ticketsHasMore;
        }
        document.getElementById('tickets-prev').disabled = data.page <= 1;

        if (!data.tickets.length) {
          list.innerHTML = '<div class="empty-state">لا توجد تذاكر مطابقة</div>';
          return;
        }

        list.innerHTML = data.tickets.map((ticket) => {
          const name = studentDisplayName(ticket);
          const preview = ticket.last_message_preview || 'لا توجد رسالة';
          const followUpDue = ticket.next_follow_up_at && new Date(ticket.next_follow_up_at) <= new Date()
            && !['resolved', 'closed'].includes(ticket.status);
          const ideaBadge = ticket.current_idea_number
            ? `<span class="idea-badge" title="رقم الفكرة الحالية">💡${ticket.current_idea_number}</span>`
            : '';
          const hasUnread = Boolean(ticket.unread_count && ticket.unread_count > 0);
          // البنفسجي والأحمر متنافيين بحكم التعريف (الأحمر آخر رسالة فيه واردة، والبنفسجي آخر رسالة
          // مننا)، لكن الأزرق ممكن يتقاطع معاه: رسالة قديمة لسه ما اتفتحتش وبعتنا بعدها متابعة
          // تلقائية. الأزرق بيغلب لأنه أكثر إلحاحًا — فيه كلام من الطالب محدش فتحه أصلًا
          // الأخضر بيكسب الألوان كلها: التذكرة وهي مع التيم العلمي مش مستنية حاجة من موظف
          // المتابعة، فتعليمها حمرا (محتاجة رد) أو "مردش من أسبوع" هيبقى كلام غلط
          const transferTeam = ticket.transfer_agent_id ? TEAM_INFO[ticket.transfer_team] : null;
          const silentWeek = Boolean(ticket.silent_week) && !hasUnread && !transferTeam;
          const checkboxHtml = currentUserRole === 'admin'
            ? `<label class="ticket-select-checkbox"><input type="checkbox" class="ticket-selector" value="${ticket.id}" ${selectedTicketIds.has(Number(ticket.id)) ? 'checked' : ''} aria-label="تحديد التذكرة"></label>`
            : '';
          return `
            <div class="ticket-list-row">
            ${checkboxHtml}
            <button type="button" class="ticket-list-item ${Number(ticket.id) === Number(currentTicketId) ? 'active' : ''} ${transferTeam ? 'transfer-' + transferTeam.tone : ''} ${!transferTeam && hasUnread ? 'has-unread' : ''} ${!transferTeam && ticket.never_replied ? 'never-replied' : ''} ${silentWeek ? 'silent-week' : ''}" data-ticket-id="${ticket.id}">
              <div class="ticket-list-title">
                <span class="ticket-name-with-subtitle">
                  <span>${escapeHtml(name)}</span>
                  ${telegramReachBadge(ticket.can_message)}
                  <span class="ticket-subtitle-badge">${escapeHtml(ticket.subtitle_name || 'مطلوب المتابعة')}</span>
                  ${urgentBadge(ticket.is_urgent)}
                  ${!transferTeam && ticket.never_replied ? '<span class="never-replied-badge" title="الرسالة اتفتحت وعدّى عليها أكتر من ١٠ دقايق من غير رد ولا حتى تفاعل بإيموجي">محتاجة رد</span>' : ''}
                  ${silentWeek ? '<span class="silent-week-badge" title="بعتنا له بعد آخر كلام منه وعدّى أسبوع من غير أي رد — الحملات الجماعية مش محسوبة">مردش من أسبوع</span>' : ''}
                  ${ideaBadge}
                  ${bootcampMarksHtml(ticket, 'sm')}
                  ${ticket.assigned_name ? `<span class="ticket-employee-badge ${employeeBadgeClass(ticket.assigned_to)}" title="موظف المتابعة المسؤول: ${escapeHtml(ticket.assigned_name)}">${escapeHtml(firstEmployeeName(ticket.assigned_name))}</span>` : ''}
                  ${transferTeam ? `<span class="team-badge team-badge-${transferTeam.tone}" title="ومعاه ${transferTeam.label}${ticket.transfer_agent_name ? ' — ' + escapeHtml(ticket.transfer_agent_name) : ''}">${transferTeam.icon} ${escapeHtml(firstEmployeeName(ticket.transfer_agent_name) || transferTeam.label)}</span>` : ''}
                </span>
                ${ticket.unread_count ? `<span class="unread-count" title="${ticket.unread_count} رسائل غير مقروءة">${ticket.unread_count}</span>` : ''}
              </div>
              <div class="ticket-preview">${ticket.last_message_direction === 'outgoing' ? '↩ ' : ''}${escapeHtml(preview)}</div>
              <div class="ticket-list-meta">
                <span>${ticketLabels.status[ticket.status] || ticket.status}</span>
                <span>${ticketLabels.priority[ticket.priority] || ticket.priority}</span>
                <span>${fmtDate(ticket.last_message_at)}</span>
              </div>
              ${ticket.next_follow_up_at ? `<div class="follow-up-badge ${followUpDue ? 'due' : ''}">📅 ${followUpDue ? 'حان الموعد: ' : 'المتابعة: '}${fmtDate(ticket.next_follow_up_at)}</div>` : ''}
            </button>
            </div>`;
        }).join('');
        list.querySelectorAll('[data-ticket-id]').forEach((button) => {
          button.addEventListener('click', () => loadTicket(Number(button.dataset.ticketId)));
        });
        list.querySelectorAll('.ticket-selector').forEach((checkbox) => {
          checkbox.addEventListener('click', (event) => event.stopPropagation());
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedTicketIds.add(id) : selectedTicketIds.delete(id);
            updateSelectedTicketsUi();
          });
        });
      } catch (error) {
        if (!silent) list.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    // ---------- تحديد وإسناد التذاكر بالجملة (أدمن فقط) ----------
    const selectedTicketIds = new Set();

    function updateSelectedTicketsUi() {
      const count = selectedTicketIds.size;
      const countBadge = document.getElementById('selected-tickets-count');
      if (countBadge) countBadge.textContent = `المحدد: ${count}`;
      const assignBtn = document.getElementById('assign-selected-tickets-btn');
      if (assignBtn) assignBtn.disabled = count === 0 || !document.getElementById('tickets-assign-to-select').value;
    }

    async function initTicketsBulkAssign() {
      const assignSelect = document.getElementById('tickets-assign-to-select');
      if (!assignSelect) return;
      await ensureTicketsMeta();
      assignSelect.innerHTML = '<option value="">إسناد المحددة لـ...</option>' +
        ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');

      assignSelect.addEventListener('change', updateSelectedTicketsUi);

      document.getElementById('select-all-tickets-btn').addEventListener('click', () => {
        document.querySelectorAll('#ticket-list .ticket-selector').forEach((checkbox) => {
          checkbox.checked = true;
          selectedTicketIds.add(Number(checkbox.value));
        });
        updateSelectedTicketsUi();
      });

      document.getElementById('select-all-filtered-tickets-btn').addEventListener('click', async (event) => {
        const button = event.currentTarget;
        button.disabled = true;
        try {
          // بيجيب معرّفات كل التذاكر المطابقة للفلتر/البحث الحالي من كل الصفحات، مش الصفحة المعروضة بس
          const result = await api('/api/tickets/ids?' + ticketQueryString());
          if (!result.ids.length) return showToast('لا يوجد نتائج لتحديدها');
          result.ids.forEach((id) => selectedTicketIds.add(id));
          document.querySelectorAll('#ticket-list .ticket-selector').forEach((checkbox) => {
            if (selectedTicketIds.has(Number(checkbox.value))) checkbox.checked = true;
          });
          updateSelectedTicketsUi();
          showToast(`تم تحديد ${result.ids.length} تذكرة من كل الصفحات المطابقة للفلتر`);
        } catch (error) {
          showToast(error.message);
        } finally {
          button.disabled = false;
        }
      });

      document.getElementById('select-first-n-tickets-btn').addEventListener('click', () => {
        selectFirstNAcrossPages(
          '/api/tickets/ids?' + ticketQueryString(), 'select-first-n-tickets',
          '#ticket-list .ticket-selector', selectedTicketIds, updateSelectedTicketsUi
        );
      });

      document.getElementById('clear-selected-tickets-btn').addEventListener('click', () => {
        selectedTicketIds.clear();
        document.querySelectorAll('#ticket-list .ticket-selector').forEach((checkbox) => { checkbox.checked = false; });
        updateSelectedTicketsUi();
      });

      document.getElementById('assign-selected-tickets-btn').addEventListener('click', async (event) => {
        const button = event.currentTarget;
        const assignedTo = assignSelect.value;
        if (!selectedTicketIds.size || !assignedTo) return;
        const assigneeName = assignSelect.options[assignSelect.selectedIndex].textContent;
        if (!confirm(`إسناد ${selectedTicketIds.size} تذكرة إلى ${assigneeName}؟`)) return;
        button.disabled = true;
        try {
          const result = await api('/api/tickets/bulk-assign', {
            method: 'PATCH',
            body: JSON.stringify({ ticket_ids: Array.from(selectedTicketIds), assigned_to: Number(assignedTo) }),
          });
          showToast(`تم إسناد ${result.updated} تذكرة إلى ${assigneeName}`);
          selectedTicketIds.clear();
          assignSelect.value = '';
          updateSelectedTicketsUi();
          loadTickets();
        } catch (error) {
          showToast(error.message);
        } finally {
          button.disabled = false;
        }
      });
    }

    function buildOptions(values, current, labels, emptyLabel) {
      const empty = emptyLabel ? `<option value="">${emptyLabel}</option>` : '';
      return empty + values.map((value) =>
        `<option value="${value}" ${value === current ? 'selected' : ''}>${escapeHtml(labels[value] || value)}</option>`
      ).join('');
    }

    async function loadTicket(ticketId) {
      currentTicketId = ticketId;
      document.querySelector('.ticket-workspace').classList.add('ticket-open');
      document.getElementById('tab-tickets').classList.add('ticket-open-view');
      const panel = document.getElementById('ticket-conversation-panel');
      panel.innerHTML = '<div class="empty-state">بيتحمّل...</div>';
      try {
        const data = await api('/api/tickets/' + ticketId);
        const ticket = data.ticket;
        currentReplyToMessageId = null;
        const name = studentDisplayName(ticket);
        const assignedUser = ticketsMeta.users.find((user) => Number(user.id) === Number(ticket.assigned_to));
        const usersOptions = '<option value="">غير معيّنة</option>' + ticketsMeta.users.map((user) =>
          `<option value="${user.id}" ${Number(user.id) === Number(ticket.assigned_to) ? 'selected' : ''}>${escapeHtml(user.name)}</option>`
        ).join('');
        const subtitlesOptions = ticketsMeta.subtitles.map((subtitle) =>
          `<option value="${subtitle.id}" ${Number(subtitle.id) === Number(ticket.subtitle_id) ? 'selected' : ''}>${escapeHtml(subtitle.name)}</option>`
        ).join('') + '<option value="__add__">＋ إضافة عنوان فرعي جديد</option>';

        // زراير التيمات — اتبنت هنا مش جوه الـ innerHTML عشان التلاتة تفرعات ماتبقاش تعشيش
        // template literals جوه بعض. موظف المتابعة عنده زرار لكل تيم بيحوّل بيه وبيسحب بيه،
        // وموظف التيم عنده زرار الإرجاع. الجديد: التيم اللي تيمه canHandOff (الواتساب) شايف
        // كمان زراير باقي التيمات ويسلّم لهم على طول — الطالب غير المشترك ممكن يسأل سؤال
        // علمي أو تكون عنده مشكلة تقنية، وموظف الواتساب هو الوحيد الشايف التذكرة ساعتها
        const myTeam = currentUserTeam ? TEAM_INFO[currentUserTeam] : null;
        const canHandOffTicket = Boolean(myTeam && myTeam.canHandOff && ticket.transfer_team === currentUserTeam);
        const handOffButtons = canHandOffTicket
          ? Object.entries(TEAM_INFO).filter(([key]) => key !== currentUserTeam).map(([key, team]) => `
                  <button type="button" class="btn btn-ghost btn-sm icon-only-mobile team-transfer-btn"
                    data-team="${key}" title="${team.transferTitle}"
                    aria-label="${team.transferTitle}">${team.icon}</button>`).join('')
          : '';
        const teamButtonsHtml = myTeam
          ? handOffButtons + (ticket.transfer_agent_id
              ? `<button type="button" class="btn btn-sm" id="ticket-team-return" style="width:auto"
                  title="رجّعها لفريق المتابعة">✅ خلصت — رجّعها</button>`
              : '')
          : Object.entries(TEAM_INFO).map(([key, team]) => `
                  <button type="button" class="btn btn-ghost btn-sm icon-only-mobile team-transfer-btn"
                    data-team="${key}"
                    title="${ticket.transfer_team === key ? `مع ${team.label} دلوقتي — اضغط لسحبها` : team.transferTitle}"
                    aria-label="${team.transferTitle}"
                    ${ticket.transfer_agent_id && ticket.transfer_team !== key ? 'disabled' : ''}
                    style="${ticket.transfer_team === key ? `background:var(--${team.tone}-tint)` : ''}">${team.icon}</button>`).join('');

        panel.innerHTML = `
          <div class="ticket-conversation-header">
            <button type="button" class="btn btn-ghost btn-sm mobile-ticket-back icon-only-mobile" id="mobile-ticket-back" title="رجوع للتذاكر" aria-label="رجوع للتذاكر">←</button>
            <div>
              <h2 class="ticket-heading-name">
                ${escapeHtml(name)}
                ${telegramReachBadge(ticket.can_message)}
                ${bootcampMarksHtml(ticket)}
                <span class="ticket-subtitle-badge">${escapeHtml(ticket.subtitle_name || 'مطلوب المتابعة')}</span>
                ${assignedUser ? `<span class="ticket-employee-badge ${employeeBadgeClass(assignedUser.id)}" title="موظف المتابعة المسؤول: ${escapeHtml(assignedUser.name)}">${escapeHtml(firstEmployeeName(assignedUser.name))}</span>` : ''}
                ${ticket.transfer_agent_id && TEAM_INFO[ticket.transfer_team] ? `<span class="team-badge team-badge-${TEAM_INFO[ticket.transfer_team].tone}" title="ومعاه ${TEAM_INFO[ticket.transfer_team].label} دلوقتي">${TEAM_INFO[ticket.transfer_team].icon} ${escapeHtml(ticket.transfer_agent_name || TEAM_INFO[ticket.transfer_team].label)}</span>` : ''}
                ${ticket.current_idea_number ? `<span class="idea-badge-lg" title="رقم الفكرة الحالية">💡 فكرة ${ticket.current_idea_number}</span>` : ''}
                ${urgentBadge(ticket.is_urgent)}
              </h2>
              <div class="ticket-muted">${ticket.telegram_username ? '@' + escapeHtml(ticket.telegram_username) + ' · ' : ''}Chat ID: ${ticket.chat_id}</div>
            </div>
          </div>
          <div class="mobile-ticket-option-buttons">
            <!-- هنا مش جوه صندوق المتابعة: الصندوق ده كلاسه admin-ticket-details ومخفي عن الموظف
                 في الـ CSS، والموظف هو أكتر حد محتاج يعدّل رسالة المتابعة للطالب اللي بيتابعه -->
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="edit-next-follow-up-msg"
              title="${ticket.next_follow_up_message ? 'رسالة المتابعة القادمة مخصّصة — اضغط للتعديل' : 'تعديل رسالة المتابعة التلقائية القادمة'}"
              aria-label="تعديل رسالة المتابعة"
              style="${ticket.next_follow_up_message ? 'background:var(--primary-tint)' : ''}">✏️</button>
            ${teamButtonsHtml}
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="ticket-urgent-toggle"
              title="${ticket.is_urgent ? 'إلغاء علامة عاجل' : 'وسم كحالة عاجلة'}" aria-label="عاجل"
              style="${ticket.is_urgent ? 'background:var(--danger-tint,#fdeaea)' : ''}">🚨</button>
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="ticket-lessons-toggle"
              title="مشاهدات فيديوهات الطالب" aria-label="مشاهدات الفيديوهات" aria-expanded="false">🎬</button>
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="ticket-report-open-btn"
              title="افتح تقرير الطالب كامل" aria-label="افتح تقرير الطالب">📄</button>
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="ticket-report-send-btn"
              title="ابعت التقرير للطالب في الشات بضغطة" aria-label="ابعت التقرير للطالب">📨</button>
            <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="ticket-report-btn"
              title="رابط التقرير — للمشاركة مع ولي الأمر" aria-label="رابط التقرير">🔗</button>
            <button type="button" class="btn btn-ghost btn-sm mobile-ticket-details-toggle icon-only-mobile" id="mobile-ticket-status-toggle" title="الحالة وبيانات التذكرة" aria-label="إظهار الحالة وبيانات التذكرة" aria-expanded="false">◉</button>
            <button type="button" class="btn btn-ghost btn-sm mobile-ticket-details-toggle icon-only-mobile" id="mobile-ticket-follow-up-toggle" title="موعد المتابعة" aria-label="إظهار موعد المتابعة" aria-expanded="false">📅</button>
          </div>
          <div class="ticket-mobile-details admin-ticket-details" id="ticket-mobile-details">
            <div class="ticket-controls">
            <label>الحالة<select data-ticket-field="status">${buildOptions(ticketsMeta.statuses, ticket.status, ticketLabels.status)}</select></label>
            <label>العنوان الفرعي<select data-ticket-field="subtitle_id">${subtitlesOptions}</select></label>
            <label>الأولوية<select data-ticket-field="priority">${buildOptions(ticketsMeta.priorities, ticket.priority, ticketLabels.priority)}</select></label>
            <label>التصنيف<select data-ticket-field="category">${buildOptions(ticketsMeta.categories, ticket.category, ticketLabels.category)}</select></label>
            <label>الموظف<select data-ticket-field="assigned_to">${usersOptions}</select></label>
            </div>
            <div class="ticket-follow-up-box">
            <label>
              <span>موعد التواصل القادم</span>
              <input type="datetime-local" id="ticket-follow-up-at" value="${toDateTimeLocal(ticket.next_follow_up_at)}">
            </label>
            <button type="button" class="btn btn-primary btn-sm" id="save-ticket-follow-up" style="width:auto">حفظ الموعد</button>
            <button type="button" class="btn btn-ghost btn-sm" id="clear-ticket-follow-up" ${ticket.next_follow_up_at ? '' : 'disabled'}>تم التواصل / إلغاء الموعد</button>

            <div class="quick-follow-up-buttons">
              <span>اختيار سريع:</span>
              ${[1, 2, 3, 4, 5, 6, 7].map((days) => `
                <button type="button" class="btn btn-ghost btn-sm quick-follow-up-btn" data-days="${days}">
                  <span class="quick-mobile-label">+${days}</span>
                  <span class="quick-desktop-label">بعد ${days === 1 ? 'يوم' : days === 2 ? 'يومين' : days + ' أيام'}</span>
                </button>`).join('')}
            </div>
            </div>
          </div>
          <div class="card ticket-lessons-panel" id="ticket-lessons-panel" style="display:none"></div>
          <div class="ticket-messages" id="ticket-messages">
            ${data.messages.length ? data.messages.map(ticketMessageHtml).join('') : '<div class="empty-state">لا توجد رسائل</div>'}
          </div>
          <div class="ticket-reply-box">
            <div class="ticket-reply-context" id="ticket-reply-context" style="display:none">
              <span class="ticket-reply-context-label">↩ بترد على:</span>
              <span class="ticket-reply-context-preview" id="ticket-reply-context-preview"></span>
              <button type="button" class="btn btn-ghost btn-sm icon-only-mobile" id="cancel-ticket-reply-context" title="إلغاء الرد" aria-label="إلغاء الرد">✕</button>
            </div>
            <div id="quick-replies-bar" class="quick-replies-bar"></div>
            <div class="ticket-reply-main" style="position:relative">
              <div id="quick-reply-menu" class="quick-reply-menu" style="display:none"></div>
              <textarea id="ticket-reply-content" placeholder="اكتب ردك للطالب... (اكتب / للردود الجاهزة)"></textarea>
            </div>
            <div class="ticket-reply-actions">
              <label class="btn btn-ghost icon-action-btn" title="إرفاق صورة" aria-label="إرفاق صورة">
                📎
                <input type="file" id="ticket-reply-image" accept="image/jpeg,image/png" style="display:none">
              </label>
              <span id="ticket-reply-image-name" class="reply-image-indicator" style="display:none" title=""></span>
              <button type="button" class="btn btn-danger-ghost icon-action-btn" id="clear-ticket-reply-image" style="display:none" title="إزالة الصورة" aria-label="إزالة الصورة">✕</button>
              <div class="idea-picker-wrap" id="idea-picker-wrap">
                <button type="button" class="btn btn-ghost icon-action-btn idea-picker-toggle" id="idea-picker-toggle"
                  title="تسجيل رقم الفكرة" aria-label="تسجيل رقم الفكرة"
                  aria-expanded="false">
                  💡${ticket.current_idea_number ? `<sup class="idea-current-sup">${ticket.current_idea_number}</sup>` : ''}
                </button>
                <div class="idea-picker-dropdown" id="idea-picker-dropdown" style="display:none">
                  <div class="idea-picker-header">فكرة الطالب الحالية</div>
                  <div class="idea-picker-grid" id="idea-picker-grid"></div>
                  ${ticket.current_idea_number ? '<button type="button" class="btn btn-ghost btn-sm idea-clear-btn" id="idea-clear-btn">إلغاء التحديد</button>' : ''}
                </div>
              </div>
              <div class="idea-picker-wrap" id="exam-marks-picker-wrap">
                <button type="button" class="btn btn-ghost icon-action-btn" id="exam-marks-picker-toggle"
                  title="كتابة رسالة بدرجات آخر الاختبارات" aria-label="كتابة رسالة بدرجات آخر الاختبارات"
                  aria-expanded="false">📊</button>
                <div class="idea-picker-dropdown" id="exam-marks-picker-dropdown" style="display:none">
                  <div class="idea-picker-header">كتابة درجات آخر الاختبارات في الرد</div>
                  <button type="button" class="btn btn-ghost btn-sm" style="width:100%; margin-bottom:6px" data-exam-marks-count="3">آخر 3 اختبارات</button>
                  <button type="button" class="btn btn-ghost btn-sm" style="width:100%; margin-bottom:6px" data-exam-marks-count="5">آخر 5 اختبارات</button>
                  <button type="button" class="btn btn-ghost btn-sm" style="width:100%" id="exam-marks-course-btn" title="اختبارات أونلاين بس — المنصة مش بترجع كورس الاختبارات الورقية">كل اختبارات كورساتي المشترك فيها</button>
                </div>
              </div>
              <button type="button" class="btn btn-ghost ticket-send-button" id="save-quick-reply-btn" style="width:auto"
                title="احفظ اللي كاتبه دلوقتي كرد جاهز" aria-label="احفظ كرد جاهز">💾</button>
              <button type="button" class="btn btn-ghost ticket-send-button" id="ticket-voice-btn" style="width:auto"
                title="تسجيل رسالة صوتية للطالب" aria-label="تسجيل رسالة صوتية">🎙️</button>
              <button class="btn btn-primary ticket-send-button" id="send-ticket-reply" style="width:auto" title="إرسال الرد">
                ➤ <span class="desktop-button-label">إرسال</span>
              </button>
            </div>
          </div>`;

        // صندوق الرد بيكبر مع المحتوى لحد 55% من الشاشة بدل ما يفضل سطرين ثابتين. الحد الأقصى
        // في الـ CSS بيخلي الصندوق يعمل تمرير داخلي بعد كده بدل ما يبلع الشاشة ويخفي المحادثة.
        // مهم بعد حقن درجات الاختبارات: النص بيبقى عشرات الأسطر وكان بيتقص عند 110px
        function autoGrowReplyBox(textarea) {
          if (!textarea) return;
          textarea.style.height = 'auto';
          textarea.style.height = textarea.scrollHeight + 'px';
        }

        const replyBoxEl = document.getElementById('ticket-reply-content');
        replyBoxEl?.addEventListener('input', () => autoGrowReplyBox(replyBoxEl));

        // تعيين مفاتيح الرسائل الحالية لمنع التكرار عند التحديث التلقائي المباشر
        renderedMessageKeys = new Set((data.messages || []).map(messageKeyOf));
        document.getElementById('edit-next-follow-up-msg')?.addEventListener('click', async () => {
          // القالب العام بيتعرض كنقطة بداية عشان الموظف يعدّل عليه بدل ما يكتب من الصفر
          const current = ticket.next_follow_up_message || '';
          const edited = window.prompt(
            `رسالة المتابعة التلقائية القادمة لهذا الطالب وحده.
كلمة "الاسم" هتتحول لاسمه من المنصة، و"رقم الفكرة" لرقم فكرته.
سيبها فاضية للرجوع للقالب العام.`,
            current
          );
          if (edited === null) return;
          try {
            await api(`/api/tickets/${ticket.id}/next-follow-up-message`, {
              method: 'PATCH', body: JSON.stringify({ message: edited })
            });
            showToast(edited.trim() ? 'تم حفظ رسالة المتابعة القادمة' : 'رجعت للقالب العام');
            openTicket(ticket.id);
          } catch (error) { showToast(error.message); }
        });

        // زراير التحويل — واحد لكل تيم، ونفس الزرار بيسحب التذكرة لو هي مع تيمه بالفعل
        panel.querySelectorAll('.team-transfer-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const teamKey = button.dataset.team;
            const team = TEAM_INFO[teamKey];
            button.disabled = true;
            try {
              if (ticket.transfer_team === teamKey) {
                await api(`/api/tickets/${ticket.id}/teams/return`, { method: 'POST' });
                showToast(`رجّعت التذكرة من ${team.label}`);
                loadTicket(ticket.id);
                loadTickets();
              } else {
                const result = await api(`/api/tickets/${ticket.id}/teams/${teamKey}/transfer`, { method: 'POST' });
                showToast('اتحوّلت لـ ' + (result.agent_name || team.label));
                loadTickets();
                // موظف التيم بيشوف المحوّل له بس، فالتذكرة خرجت من إيده خلاص — إعادة فتحها
                // هترجع 403. موظف المتابعة بيفضل شايفها فبنحدّثها قدامه
                if (currentUserTeam) closeMobileTicket(); else loadTicket(ticket.id);
              }
            } catch (error) {
              // مفيش حد حاضر: الرسالة اللي رجعت من السيرفر بتقول كده، والطالب اتبعتله تنبيه
              showToast(error.message);
              loadTicket(ticket.id);
            } finally { button.disabled = false; }
          });
        });

        document.getElementById('ticket-team-return')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          button.disabled = true;
          try {
            await api(`/api/tickets/${ticket.id}/teams/return`, { method: 'POST' });
            showToast('رجّعت التذكرة لفريق المتابعة');
            loadTickets();
            closeMobileTicket();
          } catch (error) { showToast(error.message); }
          finally { button.disabled = false; }
        });

        document.getElementById('ticket-urgent-toggle')?.addEventListener('click', async () => {
          try {
            await api(`/api/tickets/${ticket.id}/urgent`, {
              method: 'POST', body: JSON.stringify({ is_urgent: !ticket.is_urgent })
            });
            openTicket(ticket.id);
            loadTickets();
          } catch (error) { showToast(error.message); }
        });

        document.getElementById('ticket-messages').addEventListener('click', handleMessageToolsClick);

        panel.querySelectorAll('[data-ticket-field]').forEach((select) => {
          select.addEventListener('change', async () => {
            const field = select.dataset.ticketField;
            let value = field === 'assigned_to' ? (select.value || null) : select.value;
            try {
              if (field === 'subtitle_id' && value === '__add__') {
                const name = window.prompt('اكتب العنوان الفرعي الجديد:');
                if (!name?.trim()) {
                  select.value = String(ticket.subtitle_id);
                  return;
                }
                const subtitle = await api('/api/tickets/subtitles', {
                  method: 'POST', body: JSON.stringify({ name: name.trim() })
                });
                if (!ticketsMeta.subtitles.some((item) => Number(item.id) === Number(subtitle.id))) {
                  ticketsMeta.subtitles.push(subtitle);
                  ticketsMeta.subtitles.sort((a, b) => a.name.localeCompare(b.name, 'ar'));
                  const filter = document.getElementById('ticket-subtitle-filter');
                  filter.innerHTML = '<option value="">كل العناوين الفرعية</option>' +
                    ticketsMeta.subtitles.map((item) => `<option value="${item.id}">${escapeHtml(item.name)}</option>`).join('');
                }
                select.innerHTML = ticketsMeta.subtitles.map((item) =>
                  `<option value="${item.id}">${escapeHtml(item.name)}</option>`
                ).join('') + '<option value="__add__">＋ إضافة عنوان فرعي جديد</option>';
                select.value = String(subtitle.id);
                value = subtitle.id;
              }
              await api('/api/tickets/' + ticketId, { method: 'PATCH', body: JSON.stringify({ [field]: value }) });
              showToast('تم تحديث التذكرة');
              // الأولوية مربوطة بعلامة 🚨: اختيار "عاجلة" بيحطها وأي أولوية تانية بتشيلها، فلازم
              // الكارت المفتوح والقائمة يتحدّثوا مع بعض وإلا الشارة تفضل على حالتها القديمة
              if (field === 'priority') { loadTicket(ticketId); loadTickets(); }
              else if (field === 'subtitle_id' || field === 'assigned_to') loadTicket(ticketId);
              else loadTickets();
            } catch (error) { showToast(error.message); }
          });
        });
        document.getElementById('send-ticket-reply').addEventListener('click', sendTicketReply);
        bindVoiceButton(ticketId);
        renderQuickReplies();
        bindSlashMenu();
        document.getElementById('save-quick-reply-btn')?.addEventListener('click', saveDraftAsQuickReply);
        document.getElementById('cancel-ticket-reply-context').addEventListener('click', clearReplyContext);
        document.getElementById('mobile-ticket-back').addEventListener('click', closeMobileTicket);

        // مشاهدات الفيديوهات: نداء لحظي لمنصة طفرة، فبيتحمّل أول ما الموظف يفتح الكارت مش مع
        // كل تذكرة بيفتحها. dataset.loaded بيمنع إعادة التحميل مع كل فتح وقفل
        // أزرار التقرير بتحتاج تحوّل التذكرة لطالب منصة الأول — مش كل من بيكلم البوت طالب مسجّل
        async function ticketStudentId() {
          const result = await api('/api/student-report/ticket/' + ticketId + '/student');
          if (!result.tafra_student_id) {
            showToast('الطالب ده مش مربوط بحساب على منصة طفرة، فمفيش تقرير');
            return null;
          }
          return result.tafra_student_id;
        }
        document.getElementById('ticket-report-open-btn').addEventListener('click', async (event) => {
          const button = event.currentTarget;
          button.disabled = true;
          try {
            const studentId = await ticketStudentId();
            if (studentId) window.open('/student-report/' + studentId, '_blank', 'noopener');
          } catch (error) { showToast(error.message); }
          finally { button.disabled = false; }
        });
        document.getElementById('ticket-report-btn').addEventListener('click', async () => {
          try {
            const studentId = await ticketStudentId();
            if (studentId) openStudentReportDialog(studentId, studentDisplayName(ticket));
          } catch (error) { showToast(error.message); }
        });
        // الإرسال بيروح للطالب نفسه على تيليجرام وبيتسجّل في المحادثة زي أي رد — فبيتأكد الأول
        document.getElementById('ticket-report-send-btn').addEventListener('click', async (event) => {
          if (!confirm('هيتبعت لينك التقرير للطالب في الشات على تيليجرام. تأكيد؟')) return;
          const button = event.currentTarget;
          button.disabled = true;
          try {
            await api('/api/student-report/ticket/' + ticketId + '/send', { method: 'POST' });
            showToast('اتبعت التقرير للطالب');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
          finally { button.disabled = false; }
        });

        const lessonsToggle = document.getElementById('ticket-lessons-toggle');
        const lessonsPanel = document.getElementById('ticket-lessons-panel');
        lessonsToggle.addEventListener('click', async () => {
          const willOpen = lessonsPanel.style.display === 'none';
          lessonsPanel.style.display = willOpen ? 'block' : 'none';
          lessonsToggle.classList.toggle('active', willOpen);
          lessonsToggle.setAttribute('aria-expanded', String(willOpen));
          if (!willOpen || lessonsPanel.dataset.loaded === '1') return;
          lessonsPanel.dataset.loaded = '1';
          lessonsPanel.innerHTML = '<div class="empty-state">جارٍ تحميل المشاهدات من منصة طفرة...</div>';
          try {
            const data = await api('/api/tickets/' + ticketId + '/lesson-views');
            lessonsPanel.innerHTML = data.linked === false
              ? '<div class="empty-state">الطالب ده مش مربوط بحساب على منصة طفرة، فمفيش مشاهدات.</div>'
              : renderStudentLessons(data);
          } catch (error) {
            // إعادة المحاولة مسموحة بعد الفشل — غالبًا بطء لحظي من المنصة مش مشكلة دايمة
            lessonsPanel.dataset.loaded = '';
            lessonsPanel.innerHTML = `<div class="empty-state">تعذر تحميل المشاهدات: ${escapeHtml(error.message)}</div>`;
          }
        });
        const mobileDetails = document.getElementById('ticket-mobile-details');
        const mobileStatusToggle = document.getElementById('mobile-ticket-status-toggle');
        const mobileFollowUpToggle = document.getElementById('mobile-ticket-follow-up-toggle');
        function toggleMobileTicketSection(section, clickedButton, otherButton) {
          const sectionClass = section === 'status' ? 'show-ticket-controls' : 'show-follow-up';
          const isOpen = mobileDetails.classList.contains('open') && mobileDetails.classList.contains(sectionClass);
          mobileDetails.classList.remove('open', 'show-ticket-controls', 'show-follow-up');
          clickedButton.classList.remove('active');
          otherButton.classList.remove('active');
          clickedButton.setAttribute('aria-expanded', 'false');
          otherButton.setAttribute('aria-expanded', 'false');
          if (!isOpen) {
            mobileDetails.classList.add('open', sectionClass);
            clickedButton.classList.add('active');
            clickedButton.setAttribute('aria-expanded', 'true');
          }
        }
        mobileStatusToggle.addEventListener('click', () =>
          toggleMobileTicketSection('status', mobileStatusToggle, mobileFollowUpToggle));
        mobileFollowUpToggle.addEventListener('click', () =>
          toggleMobileTicketSection('follow-up', mobileFollowUpToggle, mobileStatusToggle));
        document.getElementById('save-ticket-follow-up').addEventListener('click', async () => {
          const value = document.getElementById('ticket-follow-up-at').value;
          if (!value) return showToast('حدد تاريخ ووقت المتابعة');
          try {
            await api('/api/tickets/' + ticketId, {
              method: 'PATCH', body: JSON.stringify({ next_follow_up_at: new Date(value).toISOString() })
            });
            showToast('تم حفظ موعد التواصل القادم');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
        });
        document.getElementById('clear-ticket-follow-up').addEventListener('click', async () => {
          try {
            await api('/api/tickets/' + ticketId, {
              method: 'PATCH', body: JSON.stringify({ next_follow_up_at: null })
            });
            showToast('تم إنهاء موعد المتابعة');
            loadTicket(ticketId);
          } catch (error) { showToast(error.message); }
        });
        panel.querySelectorAll('.quick-follow-up-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const days = Number(button.dataset.days);
            const followUpDate = new Date();
            followUpDate.setDate(followUpDate.getDate() + days);
            button.disabled = true;
            try {
              await api('/api/tickets/' + ticketId, {
                method: 'PATCH', body: JSON.stringify({ next_follow_up_at: followUpDate.toISOString() })
