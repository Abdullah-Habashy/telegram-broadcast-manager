    document.getElementById('sync-tafra-students').addEventListener('click', async () => {
      const button = document.getElementById('sync-tafra-students');
      if (!window.confirm('بدء قراءة وتحديث جميع الطلاب داخل قاعدة بيانات المشروع؟ لن يتم تعديل منصة طفرة.')) return;
      button.disabled = true;
      button.textContent = 'جارٍ تحديث الطلاب...';
      try {
        const result = await api('/api/tafra/sync', { method: 'POST' });
        showToast(result.message || 'بدأ تحديث الطلاب في الخلفية');
        const waitForCompletion = async () => {
          await loadTafraStatus();
          const status = await api('/api/tafra/status');
          if (status.sync?.status === 'running') {
            setTimeout(waitForCompletion, 3000);
          } else if (status.sync?.status === 'completed') {
            showToast(`اكتمل تحديث ${status.sync.synced_students} طالب`);
          } else if (status.sync?.status === 'failed') {
            showToast('فشل تحديث الطلاب، راجع حالة الربط');
          }
        };
        setTimeout(waitForCompletion, 1500);
      } catch (error) {
        showToast(error.message);
      } finally {
        button.textContent = 'تحديث بيانات الطلاب الآن';
        await loadTafraStatus();
      }
    });

    function renderBotProfiles(profiles) {
      const list = document.getElementById('bot-profiles-list');
      if (!profiles.length) {
        list.innerHTML = '<div class="empty-state">لا توجد بوتات محفوظة حتى الآن</div>';
        return;
      }
      list.innerHTML = profiles.map((profile) => `
        <div class="bot-profile-row ${profile.is_active ? 'active' : ''}">
          <div class="bot-profile-info">
            <b>${escapeHtml(profile.label)}</b>
            <span>${profile.bot_username ? '@' + escapeHtml(profile.bot_username) : 'بيانات البوت تُحدّث عند أول تفعيل'}</span>
          </div>
          <div class="row bot-profile-actions">
            ${profile.is_active
              ? '<span class="badge badge-success">مفعّل الآن</span>'
              : `<button type="button" class="btn btn-primary btn-sm activate-bot-profile" data-profile-id="${profile.id}" data-profile-name="${escapeHtml(profile.bot_username || profile.label)}">⇄ تفعيل</button>
                 <button type="button" class="btn btn-danger-ghost btn-sm delete-bot-profile" data-profile-id="${profile.id}">حذف</button>`}
          </div>
        </div>`).join('');

      list.querySelectorAll('.activate-bot-profile').forEach((button) => {
        button.addEventListener('click', async () => {
          if (!window.confirm(`تحويل المشروع إلى ${button.dataset.profileName}؟ سيتم نقل Webhook وإيقاف استقبال البوت الحالي.`)) return;
          button.disabled = true;
          try {
            const result = await api(`/api/settings/bots/${button.dataset.profileId}/activate`, { method: 'POST' });
            showToast(result.message || 'تم تبديل البوت');
            loadSettings();
          } catch (error) {
            showToast(error.message);
            button.disabled = false;
          }
        });
      });
      list.querySelectorAll('.delete-bot-profile').forEach((button) => {
        button.addEventListener('click', async () => {
          if (!window.confirm('حذف هذا البوت من القائمة؟ لن يتم حذف أي بيانات طلاب.')) return;
          try {
            await api(`/api/settings/bots/${button.dataset.profileId}`, { method: 'DELETE' });
            showToast('تم حذف البوت المحفوظ');
            loadSettings();
          } catch (error) { showToast(error.message); }
        });
      });
    }

    document.getElementById('add-bot-profile-btn').addEventListener('click', async () => {
      const bot_token = document.getElementById('bot-token-input').value.trim();
      const label = document.getElementById('bot-profile-label').value.trim();
      if (!bot_token) return showToast('الصق توكن البوت الأول');
      try {
        const res = await api('/api/settings/bots', { method: 'POST', body: JSON.stringify({ bot_token, label }) });
        showToast(res.message || 'تم الحفظ');
        document.getElementById('bot-token-input').value = '';
        document.getElementById('bot-profile-label').value = '';
        loadSettings();
      } catch (e) { showToast(e.message); }
    });

