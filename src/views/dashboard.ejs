<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <title>لوحة التحكم — Broadcast Manager</title>
  <%- include('partials/layout-head') %>
</head>
<body class="role-<%= userRole %>">
  <% if (impersonatorAdminName) { %>
    <div class="impersonation-banner">
      <span>🎭 انت داخل دلوقتي بحساب "<%= userName %>" (بصفتك الأدمن "<%= impersonatorAdminName %>")</span>
      <button type="button" id="stop-impersonation-btn" class="btn btn-primary btn-sm">الرجوع لحسابي</button>
    </div>
  <% } %>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="auth-brand">
        <span class="dot"></span>
        <span>Broadcast Manager</span>
      </div>

      <% if (userRole === 'admin') { %>
        <div class="nav-item <%= defaultTab === 'overview' ? 'active' : '' %>" data-tab="overview"><span class="ind"></span> نظرة عامة</div>
      <% } %>
      <% if (canViewTickets) { %>
        <div class="nav-item <%= defaultTab === 'tickets' ? 'active' : '' %>" data-tab="tickets"><span class="ind"></span> صندوق الدعم</div>
      <% } %>
      <% if (canViewCalls) { %>
        <div class="nav-item <%= defaultTab === 'calls' ? 'active' : '' %>" data-tab="calls"><span class="ind"></span> المتابعة التليفونية</div>
      <% } %>
      <% if (userRole === 'admin') { %>
        <div class="nav-item" data-tab="contacts"><span class="ind"></span> جهات الاتصال والإرسال</div>
        <div class="nav-item" data-tab="tafra-students"><span class="ind"></span> طلاب المنصة</div>
        <div class="nav-item" data-tab="new-bot"><span class="ind"></span> بوت طفرة</div>
        <div class="nav-item" data-tab="performance"><span class="ind"></span> متابعة الأداء</div>
        <div class="nav-item" data-tab="reports"><span class="ind"></span> التقارير</div>
      <% } %>
      <%# الاختبارات مش للأدمن بس: التيم العلمي والدعم الفني بيبنوا أسئلتهم ويراجعوا تصحيحها.
          الشرط جاي محسوب من السيرفر (utils/teams.js) عشان يفضل هو نفسه اللي بيحمي /api/quizzes %>
      <% if (canManageQuizzes) { %>
        <div class="nav-item" data-tab="quizzes"><span class="ind"></span> الاختبارات</div>
      <% } %>
      <% if (userRole === 'admin') { %>
        <div class="nav-item" data-tab="templates"><span class="ind"></span> القوالب</div>
        <div class="nav-item" data-tab="ai"><span class="ind"></span> الذكاء الصناعي</div>
        <div class="nav-item" data-tab="settings"><span class="ind"></span> الإعدادات</div>
      <% } %>

      <button type="button" class="push-toggle-btn" id="push-toggle-btn"
        title="تفعيل إشعارات التليفون" aria-label="تفعيل إشعارات التليفون">🔕</button>

      <!-- زرار الحساب ده بيظهر على الموبايل بس (القائمة الجانبية بتتحول لصف علوي، وقسم الحساب
           التحتاني بيختفي) — نفس الوظايف (تغيير كلمة المرور وتسجيل الخروج) بس في مكان يوصله فيه -->
      <div class="account-menu-wrap">
        <button type="button" class="account-menu-toggle-btn" id="account-menu-toggle-btn" title="الحساب" aria-label="الحساب">👤</button>
        <div class="account-menu-dropdown" id="account-menu-dropdown" style="display:none">
          <div class="account-menu-name">👋 <%= userName %></div>
          <% if (canViewTickets) { %>
            <button type="button" class="btn btn-ghost btn-sm" id="mobile-open-activity-btn" style="width:100%">متابعة الأداء</button>
            <button type="button" class="btn btn-ghost btn-sm" id="mobile-open-response-btn" style="width:100%">سرعة الرد</button>
          <% } %>
          <button type="button" class="btn btn-ghost btn-sm" id="mobile-open-change-password-btn" style="width:100%">تغيير كلمة المرور</button>
          <form method="POST" action="/logout">
            <button type="submit" class="btn btn-ghost btn-sm" style="width:100%">تسجيل الخروج</button>
          </form>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="user-name">👋 <%= userName %></div>
        <button type="button" class="btn btn-ghost btn-sm" id="open-change-password-btn" style="width:100%">تغيير كلمة المرور</button>
        <form method="POST" action="/logout">
          <button type="submit" class="btn btn-ghost btn-sm" style="width:100%">تسجيل الخروج</button>
        </form>
      </div>
    </aside>

    <div class="modal-overlay" id="student-report-overlay" style="display:none">
      <div class="modal-card card student-report-modal">
        <div class="row-between" style="margin-bottom:12px">
          <h2 style="margin:0">تقرير الطالب</h2>
          <button type="button" class="btn btn-ghost btn-sm" id="close-student-report-btn" title="إغلاق" aria-label="إغلاق">✕</button>
        </div>
        <p class="card-desc" id="student-report-name"></p>
        <div id="student-report-body"><div class="empty-state">بيتحمّل...</div></div>
      </div>
    </div>

    <div class="modal-overlay" id="link-student-overlay" style="display:none">
      <div class="modal-card card">
        <div class="row-between" style="margin-bottom:12px">
          <b>ربط <span id="link-student-telegram-name"></span> بحساب على المنصة</b>
          <button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="closeLinkDialog()">إغلاق</button>
        </div>
        <p class="card-desc" style="margin-top:0">
          دوّر على الطالب بالاسم أو رقم التليفون أو الكود. بعد الربط هيظهر باسمه الحقيقي
          في كل الشاشات، وهيقدر يطلب تقريره من البوت.
        </p>
        <input type="search" id="link-student-search" class="compact-input" style="width:100%"
               placeholder="اسم الطالب أو رقمه أو كوده" />
        <div id="link-student-results" style="margin-top:12px; max-height:340px; overflow-y:auto"></div>
      </div>
    </div>

    <div class="modal-overlay" id="change-password-overlay" style="display:none">
      <div class="modal-card card">
        <div class="row-between" style="margin-bottom:14px">
          <h2 style="margin:0">تغيير كلمة المرور</h2>
          <button type="button" class="btn btn-ghost btn-sm" id="close-change-password-btn" title="إغلاق" aria-label="إغلاق">✕</button>
        </div>
        <div class="field">
          <label>كلمة المرور الحالية</label>
          <div class="password-field-wrap">
            <input type="password" id="change-password-current" autocomplete="current-password">
            <button type="button" class="password-toggle-btn" data-toggle-for="change-password-current" title="إظهار كلمة المرور" aria-label="إظهار كلمة المرور">👁</button>
          </div>
        </div>
        <div class="field">
          <label>كلمة المرور الجديدة</label>
          <div class="password-field-wrap">
            <input type="password" id="change-password-new" autocomplete="new-password" placeholder="8 أحرف على الأقل">
            <button type="button" class="password-toggle-btn" data-toggle-for="change-password-new" title="إظهار كلمة المرور" aria-label="إظهار كلمة المرور">👁</button>
          </div>
        </div>
        <div class="field">
          <label>تأكيد كلمة المرور الجديدة</label>
          <div class="password-field-wrap">
            <input type="password" id="change-password-confirm" autocomplete="new-password">
            <button type="button" class="password-toggle-btn" data-toggle-for="change-password-confirm" title="إظهار كلمة المرور" aria-label="إظهار كلمة المرور">👁</button>
          </div>
        </div>
        <button type="button" class="btn btn-primary" id="submit-change-password-btn" style="width:100%; margin-top:8px">حفظ كلمة المرور الجديدة</button>
      </div>
    </div>

    <main class="main">
      <!-- ===== نظرة عامة ===== -->
      <section class="tab-panel" id="tab-overview" style="<%= defaultTab === 'overview' ? '' : 'display:none' %>">
        <div class="page-header">
          <h1>نظرة عامة</h1>
          <p>ملخص سريع لحالة البوت وجهات الاتصال</p>
        </div>
        <div class="stats-grid" id="stats-grid">
          <div class="stat-card"><div class="label">إجمالي جهات الاتصال</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">متفاعلين آخر أسبوع</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">رسائل مُرسلة</div><div class="value">—</div></div>
          <div class="stat-card"><div class="label">معدل الرد التقريبي</div><div class="value">—</div></div>
        </div>
        <div class="card">
          <h2>الخطوات الأولى</h2>
          <p class="card-desc">علشان البوت يشتغل، لازم الآتي بالترتيب:</p>
          <ol style="margin:0; padding-inline-start: 20px; color: var(--text-muted); font-size: 13.5px; line-height: 2;">
            <li>روح <b>الإعدادات</b> وسجّل توكن البوت (من BotFather)</li>
            <li>تأكد إن <code>PUBLIC_URL</code> متحدد في ملف <code>.env</code> عشان الـ Webhook يشتغل</li>
            <li>ابعت <code>/start</code> للبوت من حسابك على تليجرام للتجربة</li>
          </ol>
        </div>
      </section>

      <!-- ===== صندوق الدعم ===== -->
      <section class="tab-panel" id="tab-tickets" style="<%= defaultTab === 'tickets' ? '' : 'display:none' %>">
        <div class="page-header">
          <h1>صندوق الدعم</h1>
          <p>استقبال رسائل الطلاب، توزيعها على الموظفين، والرد من مكان واحد</p>
        </div>

        <div class="subtabs" id="tickets-subtabs">
          <button type="button" class="subtab-btn active" data-subtab="conversations">المحادثات</button>
          <% if (userRole === 'admin') { %>
            <button type="button" class="subtab-btn" data-subtab="staff">الفريق</button>
          <% } %>
          <button type="button" class="subtab-btn" data-subtab="activity">متابعة الأداء</button>
          <button type="button" class="subtab-btn" data-subtab="response">سرعة الرد</button>
          <% if (userRole === 'admin') { %>
            <button type="button" class="subtab-btn" data-subtab="flagged">الرسائل المميزة</button>
          <% } %>
        </div>

        <div class="subtab-section" data-subtab="conversations">
        <div class="ticket-toolbar card">
          <input type="search" id="ticket-search" class="compact-input" placeholder="بحث بالاسم، الهاتف، كلمة من المحادثة أو رقم التذكرة">
          <% if (userTeam) { %>
            <button type="button" class="btn btn-sm" id="team-attendance-btn" style="width:auto">تسجيل الحضور</button>
            <span id="team-attendance-info" class="ticket-muted" style="font-size:12px"></span>
          <% } %>
          <button type="button" class="btn btn-ghost btn-sm agent-filter-toggle" id="agent-filter-toggle" title="إظهار الفلاتر" aria-label="إظهار الفلاتر">⚲</button>
          <div class="ticket-advanced-filters" id="ticket-advanced-filters">
          <select id="ticket-status-filter" class="compact-select">
            <option value="">كل الحالات</option>
            <option value="new">جديدة</option>
            <option value="in_progress">قيد المتابعة</option>
            <option value="waiting_student">بانتظار الطالب</option>
            <option value="resolved">مكتملة</option>
            <option value="closed">مغلقة</option>
          </select>
          <select id="ticket-subtitle-filter" class="compact-select">
            <option value="">كل العناوين الفرعية</option>
          </select>
          <select id="ticket-priority-filter" class="compact-select">
            <option value="">كل الأولويات</option>
            <option value="urgent">عاجلة</option>
            <option value="normal">عادية</option>
            <option value="low">منخفضة</option>
          </select>
          <select id="ticket-category-filter" class="compact-select">
            <option value="">كل التصنيفات</option>
            <option value="general">عام</option>
            <option value="registration">تسجيل</option>
            <option value="fees">مصروفات</option>
            <option value="results">نتائج</option>
            <option value="platform">المنصة</option>
            <option value="complaint">شكوى</option>
            <option value="technical">تقني</option>
          </select>
          <select id="ticket-assignee-filter" class="compact-select"><option value="">كل الموظفين</option></select>
          <select id="ticket-follow-up-filter" class="compact-select">
            <option value="">كل مواعيد المتابعة</option>
            <option value="due">حان موعد التواصل</option>
            <option value="today">متابعات اليوم</option>
            <option value="upcoming">مواعيد قادمة</option>
            <option value="none">بدون موعد متابعة</option>
          </select>
          <select id="ticket-sent-filter" class="compact-select">
            <option value="">آخر إرسال: أي وقت</option>
            <option value="1">آخر إرسال أقدم من يوم</option>
            <option value="3">آخر إرسال أقدم من 3 أيام</option>
            <option value="7">آخر إرسال أقدم من أسبوع</option>
          </select>
          <select id="ticket-received-filter" class="compact-select">
            <option value="">آخر استقبال: أي وقت</option>
            <option value="1">آخر استقبال أقدم من يوم</option>
            <option value="3">آخر استقبال أقدم من 3 أيام</option>
            <option value="7">آخر استقبال أقدم من أسبوع</option>
          </select>
          <select id="ticket-idea-filter" class="compact-select">
            <option value="">كل الأفكار</option>
            <option value="0">لم يُحدَّد بعد</option>
          </select>
          <label class="row ticket-unread-filter"><input type="checkbox" id="ticket-unread-filter"> غير المقروء فقط</label>
          <label class="row ticket-unread-filter"><input type="checkbox" id="ticket-awaiting-reply-filter"> مفتوحة ولم يُرد عليها</label>
          <label class="row ticket-unread-filter"><input type="checkbox" id="ticket-unassigned-filter"> غير مسندة لأي موظف</label>
          <label class="row ticket-unread-filter"><input type="checkbox" id="ticket-never-replied-filter"> مفتوحة ومحتاجة رد</label>
          <div id="tickets-filter-bar"></div>
          <button type="button" class="btn btn-ghost btn-sm" id="clear-ticket-filters">مسح الفلاتر</button>
          </div>
          <button class="btn btn-ghost btn-sm" id="refresh-tickets-btn">تحديث</button>
          <% if (userRole === 'agent') { %>
            <form method="POST" action="/logout" class="agent-logout-form">
              <button type="submit" class="btn btn-ghost btn-sm" title="تسجيل الخروج" aria-label="تسجيل الخروج">⇥</button>
            </form>
          <% } %>
        </div>

        <% if (userRole === 'admin') { %>
          <div class="card" style="padding-block:12px" id="tickets-bulk-assign-card">
            <div class="row-between audience-actions">
              <div class="row">
                <button type="button" class="btn btn-ghost btn-sm" id="select-all-tickets-btn">تحديد كل التذاكر المعروضة</button>
                <button type="button" class="btn btn-ghost btn-sm" id="select-all-filtered-tickets-btn">تحديد كل النتائج (الفلتر الحالي)</button>
                <span class="select-first-n-group">
                  <input type="number" id="select-first-n-tickets" class="compact-input" min="1" value="10" title="عدد النتائج">
                  <button type="button" class="btn btn-ghost btn-sm" id="select-first-n-tickets-btn">تحديد أول عدد</button>
                </span>
                <button type="button" class="btn btn-ghost btn-sm" id="clear-selected-tickets-btn">إلغاء التحديد</button>
              </div>
              <div class="row" style="gap:8px; flex-wrap:wrap">
                <span id="selected-tickets-count" class="badge badge-muted">المحدد: 0</span>
                <select id="tickets-assign-to-select" class="compact-select"><option value="">إسناد المحددة لـ...</option></select>
                <button type="button" class="btn btn-primary btn-sm" id="assign-selected-tickets-btn" style="width:auto" disabled>إسناد</button>
              </div>
            </div>
          </div>
        <% } %>

        <div class="ticket-workspace">
          <div class="ticket-list-panel card">
            <div class="row-between"><b id="ticket-count">التذاكر</b><span id="ticket-page-label" class="ticket-muted"></span></div>
            <div id="ticket-list"><div class="empty-state">بيتحمّل...</div></div>
            <div class="ticket-pagination">
              <button class="btn btn-ghost btn-sm" id="tickets-prev">السابق</button>
              <button class="btn btn-ghost btn-sm" id="tickets-next">التالي</button>
            </div>
          </div>

          <div class="ticket-conversation-panel card" id="ticket-conversation-panel">
            <div class="empty-state">اختر تذكرة لعرض المحادثة والرد</div>
          </div>
        </div>
        </div>

        <% if (userRole === 'admin') { %>
        <div class="subtab-section" data-subtab="staff" style="display:none">
          <div class="card">
            <h2>إدارة حسابات الفريق</h2>
            <p class="card-desc">أنشئ حسابًا مستقلًا لكل مدير أو موظف دعم. تقدر تحدد لكل موظف دعم إيه التابات اللي يشوفها — صندوق الدعم و/أو المتابعة التليفونية.</p>
            <div class="staff-create-form">
              <input type="text" id="staff-name" placeholder="الاسم">
              <input type="email" id="staff-email" placeholder="البريد الإلكتروني">
              <input type="password" id="staff-password" placeholder="كلمة المرور (8 أحرف على الأقل)">
              <select id="staff-role"><option value="agent">موظف دعم</option><option value="admin">مدير</option></select>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap"><input type="checkbox" id="staff-can-view-tickets" checked> صندوق الدعم</label>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap"><input type="checkbox" id="staff-can-view-calls" checked> المتابعة التليفونية</label>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap" title="يقدر يسند/يلغي إسناد طلاب المكالمات لغيره من الموظفين"><input type="checkbox" id="staff-can-assign-calls"> مسند المكالمات</label>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap" title="بيستقبل الأسئلة العلمية المحوّلة من فريق المتابعة، ومستثنى من التوزيع التلقائي للتذاكر الجديدة"><input type="checkbox" class="new-staff-team" id="staff-team-science" value="science"> تيم علمي</label>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap" title="بيستقبل المشاكل التقنية المحوّلة من فريق المتابعة، ومستثنى من التوزيع التلقائي للتذاكر الجديدة"><input type="checkbox" class="new-staff-team" id="staff-team-tech" value="tech"> دعم فني</label>
              <label class="row" style="white-space:nowrap; flex-wrap:nowrap" title="بيتحوّل عليه تلقائيًا كل طالب دخل البوت ومش مشترك في أي كورس"><input type="checkbox" class="new-staff-team" id="staff-team-whatsapp" value="whatsapp"> موظف واتساب</label>
              <button type="button" class="btn btn-primary" id="create-staff-btn" style="width:auto">إنشاء الحساب</button>
            </div>
            <div id="staff-users-list"><div class="empty-state">بيتحمّل...</div></div>
          </div>
        </div>
        <% } %>

        <div class="subtab-section" data-subtab="activity" style="display:none">
          <div class="card" style="padding-block:12px">
            <div class="row" style="gap:8px; flex-wrap:wrap; align-items:center">
              <% if (userRole === 'admin') { %>
                <select id="activity-user-filter" class="compact-select"><option value="">كل الموظفين</option></select>
              <% } %>
              <input type="date" id="activity-from-filter" class="compact-input" title="من تاريخ">
              <input type="date" id="activity-to-filter" class="compact-input" title="إلى تاريخ">
              <button type="button" class="btn btn-ghost btn-sm" id="clear-activity-filters">مسح الفلاتر</button>
              <button type="button" class="btn btn-ghost btn-sm" id="refresh-activity-btn">تحديث</button>
            </div>
          </div>
          <div class="card">
            <div class="row-between" style="margin-bottom:12px">
              <b id="activity-count">نشاط الموظفين</b>
              <span id="activity-page-label" class="ticket-muted"></span>
            </div>
            <div id="activity-list"><div class="empty-state">بيتحمّل...</div></div>
            <div class="ticket-pagination">
              <button type="button" class="btn btn-ghost btn-sm" id="activity-prev">السابق</button>
              <button type="button" class="btn btn-ghost btn-sm" id="activity-next">التالي</button>
            </div>
          </div>
        </div>

        <div class="subtab-section" data-subtab="response" style="display:none">
          <div class="card" style="padding-block:12px">
            <div class="row" style="gap:8px; flex-wrap:wrap; align-items:center">
              <% if (userRole === 'admin') { %>
                <select id="response-user-filter" class="compact-select"><option value="">كل الموظفين</option></select>
              <% } %>
              <input type="date" id="response-from-filter" class="compact-input" title="من تاريخ">
              <input type="date" id="response-to-filter" class="compact-input" title="إلى تاريخ">
              <button type="button" class="btn btn-ghost btn-sm" id="clear-response-filters">مسح الفلاتر</button>
              <button type="button" class="btn btn-ghost btn-sm" id="refresh-response-btn">تحديث</button>
            </div>
          </div>
          <div class="card">
            <div class="row-between" style="margin-bottom:12px">
              <b>ملخص الرد على الشات</b>
              <span id="response-stats-note" class="ticket-muted"></span>
            </div>
