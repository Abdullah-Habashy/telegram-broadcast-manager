        document.getElementById('outside-hours-ack-enabled').checked = s.outside_hours_ack_enabled === 'true';
        document.getElementById('outside-hours-ack-text').value = s.outside_hours_ack_text || '';
        document.getElementById('sms-template-enabled').checked = s.sms_template_enabled === 'true';
        document.getElementById('sms-template-text').value = s.sms_template_text || '';
        document.getElementById('working-hours-enabled').checked = s.working_hours_enabled === 'true';
        document.getElementById('working-hours-start').value = s.working_hours_start || '09:00';
        document.getElementById('working-hours-end').value = s.working_hours_end || '22:00';
        document.getElementById('working-hours-message').value = s.outside_hours_reply_message || '';
        document.getElementById('forwarding-enabled').checked = s.forwarding_enabled === 'true';
        document.getElementById('follow-up-auto-enabled').checked = s.follow_up_auto_enabled === 'true';
        document.getElementById('follow-up-auto-message').value = s.follow_up_auto_message || '';
        document.getElementById('agent-intro-enabled').checked = s.agent_intro_enabled === 'true';
        document.getElementById('agent-intro-message').value = s.agent_intro_message || '';
        const maxIdeaInput = document.getElementById('max-idea-number');
        if (maxIdeaInput) maxIdeaInput.value = s.max_idea_number || '20';
        const autoSyncInput = document.getElementById('tafra-auto-sync-interval');
        if (autoSyncInput) autoSyncInput.value = s.tafra_auto_sync_interval_hours || '12';
        const examSyncInput = document.getElementById('tafra-exam-auto-sync-interval');
        if (examSyncInput) examSyncInput.value = s.tafra_exam_auto_sync_interval_hours || '12';
        document.getElementById('forward-link-command').textContent = `/setforward ${s.forward_setup_code}`;
        const forwardStatus = document.getElementById('forward-target-status');
        if (s.forward_chat_id) {
          forwardStatus.textContent = `الحساب المرتبط: ${s.forward_chat_name || s.forward_chat_id}`;
          forwardStatus.className = 'badge badge-success';
        } else {
          forwardStatus.textContent = 'لم يتم ربط حساب بعد';
