    async function loadTafraStatus() {
      const statusElement = document.getElementById('tafra-connection-status');
      const detailsElement = document.getElementById('tafra-sync-details');
      const syncButton = document.getElementById('sync-tafra-students');
      try {
        const result = await api('/api/tafra/status');
        statusElement.textContent = result.configured ? '✓ بيانات الربط محفوظة — وضع القراءة فقط' : 'لم تُحفظ بيانات الربط بعد';
        statusElement.className = result.configured ? 'badge badge-success' : 'badge badge-muted';
        syncButton.disabled = !result.configured || result.sync?.status === 'running';
        const sync = result.sync || {};
        if (sync.status === 'running') {
          detailsElement.textContent = `جارٍ التحديث: الصفحة ${sync.current_page || 0} من ${sync.total_pages || '...'} — تم جلب ${sync.synced_students || 0} طالب`;
        } else if (sync.status === 'completed') {
          detailsElement.textContent = `آخر تحديث ناجح: ${fmtDate(sync.completed_at)} — الطلاب: ${sync.synced_students || 0} — المرتبطون بتيليجرام: ${sync.telegram_students || 0}`;
        } else if (sync.status === 'failed') {
          detailsElement.textContent = `فشل آخر تحديث: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          detailsElement.textContent = 'لم تتم مزامنة الطلاب بعد.';
        }
      } catch (error) {
        statusElement.textContent = 'تعذر قراءة حالة الربط';
        statusElement.className = 'badge badge-danger';
        detailsElement.textContent = error.message;
      }
    }

