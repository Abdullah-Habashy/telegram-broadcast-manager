            <button type="button" class="btn btn-ghost btn-sm student-report-btn" style="width:auto"
              data-report-student="${student.tafra_student_id}"
              data-report-name="${escapeHtml(student.name || 'الطالب')}">🔗 رابط للمشاركة</button>
            ${student.ticket_id ? `<button type="button" class="btn btn-ghost btn-sm" id="open-call-student-ticket">صندوق الدعم</button>` : ''}
          </div>
        </div>
        <div id="student-data-panels" style="display:none">
          <div class="card" id="student-exams-panel" style="margin-block:12px">
            <div class="empty-state">جارٍ التحميل...</div>
