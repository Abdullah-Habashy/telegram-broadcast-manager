      if (!identifier || !password) return showToast('أدخل رقم الهاتف أو البريد وكلمة المرور');
      button.disabled = true;
      try {
        const result = await api('/api/tafra/credentials', {
          method: 'POST', body: JSON.stringify({ identifier, password })
        });
