              <input type="text" id="broadcast-button-text" class="compact-input" placeholder="نص الزرار، مثلاً: 🚀 ابدأ بوت طفرة" maxlength="64" style="flex:1">
              <input type="url" id="broadcast-button-url" class="compact-input" placeholder="https://t.me/..." style="flex:1">
              <button type="button" class="btn btn-ghost btn-sm" id="clear-broadcast-button" style="width:auto">مسح الزرار</button>
            </div>
