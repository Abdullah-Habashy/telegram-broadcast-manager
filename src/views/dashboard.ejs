    async function loadContacts() {
      const wrap = document.getElementById('contacts-table-wrap');
      try {
        const query = new URLSearchParams();
        const filterValues = {
          status: document.getElementById('contact-status-filter').value,
          subtitle_id: document.getElementById('contact-subtitle-filter').value,
          priority: document.getElementById('contact-priority-filter').value,
          category: document.getElementById('contact-category-filter').value,
          assigned_to: document.getElementById('contact-assignee-filter').value,
          bootcamp_id: document.getElementById('contact-bootcamp-filter').value,
          enrolled_from: document.getElementById('contact-enrolled-from').value,
          enrolled_to: document.getElementById('contact-enrolled-to').value,
          exam: document.getElementById('contact-exam-filter').value,
          attendance: document.getElementById('contact-exam-filter').value
            ? document.getElementById('contact-exam-attendance-filter').value : '',
          mark_range: (document.getElementById('contact-exam-filter').value
            && document.getElementById('contact-exam-attendance-filter').value !== 'not_entered')
            ? document.getElementById('contact-exam-mark-range-filter').value : '',
          follow_up: document.getElementById('contact-follow-up-filter').value,
          sent_older_than: document.getElementById('filter-sent').value,
          received_older_than: document.getElementById('filter-received').value,
          start_status: document.getElementById('filter-start-status').value,
        };
        Object.entries(filterValues).forEach(([key, value]) => { if (value) query.set(key, value); });
        if (document.getElementById('contact-unread-filter').checked) query.set('unread', 'true');
        const contacts = await api('/api/contacts' + (query.size ? `?${query}` : ''));
        currentFilteredContactIds = contacts.map((contact) => Number(contact.id));
        if (contacts.length === 0) {
          currentFilteredContactIds = [];
          wrap.innerHTML = '<div class="empty-state">لسه مفيش جهات اتصال — هتظهر هنا أول ما حد يعمل /start على البوت</div>';
          return;
        }
        wrap.innerHTML = `
          <table>
            <thead><tr><th class="select-cell"><input type="checkbox" id="select-all-contacts" aria-label="تحديد الكل"></th><th>الاسم</th><th>الباب</th><th>العنوان الفرعي</th><th>الحالة</th><th>الموظف</th><th data-sort-key="sent">آخر رسالة أرسلناها</th><th data-sort-key="received">آخر رسالة استلمناها</th><th>تصنيفات</th></tr></thead>
            <tbody>
              ${contacts.map((c) => `
                <tr>
                  <td class="select-cell"><input type="checkbox" class="contact-selector" value="${c.id}" ${selectedContactIds.has(c.id) ? 'checked' : ''} aria-label="تحديد جهة الاتصال"></td>
                  <td>${escapeHtml(studentDisplayName(c))}</td>
                  <td>${bootcampMarksHtml(c, 'sm') || '<span class="badge badge-muted">—</span>'}</td>
                  <td>${c.subtitle_name ? `<span class="ticket-subtitle-badge">${escapeHtml(c.subtitle_name)}</span>` : '—'}</td>
                  <td>${c.ticket_status ? escapeHtml(ticketLabels.status[c.ticket_status] || c.ticket_status) : '—'}</td>
                  <td>${escapeHtml(c.assigned_name || '—')}</td>
                  <td data-sort-value="${c.last_sent_at ? new Date(c.last_sent_at).getTime() : ''}">${fmtDay(c.last_sent_at)}</td>
                  <td data-sort-value="${c.last_received_at ? new Date(c.last_received_at).getTime() : ''}">${fmtDay(c.last_received_at)}</td>
                  <td>${c.tags.map((t) => `<span class="tag-pill">${escapeHtml(t.name)}</span>`).join(' ') || '—'}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
        enableTableSort(wrap);
        wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
            updateSelectedContactsUi();
          });
        });
        document.getElementById('select-all-contacts').addEventListener('change', (event) => {
          wrap.querySelectorAll('.contact-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedContactIds.add(id) : selectedContactIds.delete(id);
          });
          updateSelectedContactsUi();
        });
        updateSelectedContactsUi();
      } catch (e) { wrap.innerHTML = `<div class="empty-state">${e.message}</div>`; }
    }
    [
      'contact-status-filter', 'contact-subtitle-filter', 'contact-priority-filter',
      'contact-category-filter', 'contact-assignee-filter', 'contact-bootcamp-filter',
      'contact-enrolled-from', 'contact-enrolled-to', 'contact-exam-filter',
      'contact-exam-attendance-filter', 'contact-exam-mark-range-filter', 'contact-follow-up-filter',
      'filter-sent', 'filter-received', 'filter-start-status', 'contact-unread-filter'
    ].forEach((id) => document.getElementById(id).addEventListener('change', loadContacts));

    document.getElementById('clear-contact-filters')?.addEventListener('click', () => {
      resetFilterGroup('contacts', CONTACT_FILTER_IDS, loadContacts, { 'contact-exam-attendance-filter': 'entered' });
    });

    document.getElementById('select-filtered-contacts-btn').addEventListener('click', () => {
      currentFilteredContactIds.forEach((id) => selectedContactIds.add(id));
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = true; });
      updateSelectedContactsUi();
      showToast(`تم تحديد ${currentFilteredContactIds.length} نتيجة مفلترة`);
    });
    document.getElementById('select-first-n-contacts-btn').addEventListener('click', () => {
      selectFirstN('#contacts-table-wrap .contact-selector', 'select-first-n-contacts', selectedContactIds, updateSelectedContactsUi);
    });
    document.getElementById('clear-selected-contacts-btn').addEventListener('click', () => {
      selectedContactIds.clear();
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = false; });
      updateSelectedContactsUi();
    });

    // مشتركة بين تاب "جهات الاتصال" وتاب "طلاب المنصة" — بتودّي لبانل الإرسال بنفس التحديد الحالي
    async function goToComposeWithSelection() {
      if (selectedContactIds.size === 0) return;
      // إيه فلتر الاختبار اللي كان مفعّل وقت التحديد (من أي تاب) — بيتربط تلقائيًا بالرسالة عشان كلمتي "اختبار"/"الدرجة"
      // الربط ده بيشتغل بس لو اختبار واحد محدد (مش قايمة اختبارات) عشان معنى "الدرجة" يفضل واضح في الرسالة
      const tafraExamValue = document.getElementById('tafra-exam-filter').value;
      const contactExamValue = document.getElementById('contact-exam-filter').value;
      const singleExam = (value) => (value && !value.includes(',') ? value : '');
      const activeExamFilter = singleExam(tafraExamValue) || singleExam(contactExamValue);
      const contactsNav = document.querySelector('.nav-item[data-tab="contacts"]');
      if (contactsNav && !contactsNav.classList.contains('active')) contactsNav.click();
      await loadBootcampsIntoContactFilter(); // يضمن إن خيارات ربط الاختبار جاهزة قبل ما نحددها تحت
      document.getElementById('broadcast-tag').value = '__selected__';
      document.getElementById('broadcast-exam-context').value = activeExamFilter || '';
      updateSelectedContactsUi();
      document.getElementById('broadcast-compose').scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('broadcast-content').focus();
    }

    document.getElementById('message-selected-btn').addEventListener('click', () => goToComposeWithSelection());

    document.getElementById('select-filtered-tafra-students-btn').addEventListener('click', () => {
      currentFilteredTafraStudentContactIds.forEach((id) => selectedContactIds.add(id));
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = true; });
      updateSelectedContactsUi();
      showToast(`تم تحديد ${currentFilteredTafraStudentContactIds.length} طالب ممكن مراسلته`);
    });
    document.getElementById('select-all-tafra-students-btn').addEventListener('click', async () => {
      const btn = document.getElementById('select-all-tafra-students-btn');
      btn.disabled = true;
      try {
        // بيجيب معرّفات كل الطلاب المطابقين للفلتر الحالي من كل الصفحات (مش بس اللي ظاهرين دلوقتي)
        const result = await api('/api/tafra/students/ids?' + tafraStudentQuery());
        result.ids.forEach((id) => selectedContactIds.add(id));
        document.querySelectorAll('#tafra-students-table .contact-selector').forEach((checkbox) => {
          if (selectedContactIds.has(Number(checkbox.value))) checkbox.checked = true;
        });
        updateSelectedContactsUi();
        showToast(`تم تحديد ${result.ids.length} طالب ممكن مراسلته من كل الصفحات المطابقة للفلتر`);
      } catch (error) {
        showToast(error.message);
      } finally {
        btn.disabled = false;
      }
    });
    document.getElementById('select-first-n-tafra-btn').addEventListener('click', () => {
      selectFirstNAcrossPages(
        '/api/tafra/students/ids?' + tafraStudentQuery(), 'select-first-n-tafra',
        '#tafra-students-table .contact-selector', selectedContactIds, updateSelectedContactsUi
      );
    });
    document.getElementById('clear-selected-tafra-students-btn').addEventListener('click', () => {
      selectedContactIds.clear();
      document.querySelectorAll('.contact-selector').forEach((checkbox) => { checkbox.checked = false; });
      updateSelectedContactsUi();
    });
    document.getElementById('message-selected-tafra-students-btn').addEventListener('click', goToComposeWithSelection);

    // ---------- إسناد الطلاب المحددين لموظف (نفس التحديد اللي بيتعمل للمراسلة) ----------
    (async function initTafraBulkAssign() {
      const assignSelect = document.getElementById('tafra-assign-to-select');
      const assignBtn = document.getElementById('assign-selected-tafra-students-btn');
      if (!assignSelect || !assignBtn) return;
      await ensureTicketsMeta();
      assignSelect.innerHTML = '<option value="">إسناد المحددين لـ...</option>' +
        ticketsMeta.users.map((user) => `<option value="${user.id}">${escapeHtml(user.name)}</option>`).join('');
      assignSelect.addEventListener('change', updateSelectedContactsUi);

      assignBtn.addEventListener('click', async () => {
        const assignedTo = assignSelect.value;
        if (!selectedContactIds.size || !assignedTo) return;
        const assigneeName = assignSelect.options[assignSelect.selectedIndex].textContent;
        if (!confirm(`إسناد ${selectedContactIds.size} طالب إلى ${assigneeName}؟\n\nالطالب اللي عنده محادثة هتتحول لـ${assigneeName}، واللي لسه مالوش تذكرة هتتعمل له واحدة جديدة.`)) return;
        assignBtn.disabled = true;
        try {
          const result = await api('/api/tickets/bulk-assign-by-contact', {
            method: 'PATCH',
            body: JSON.stringify({ contact_ids: Array.from(selectedContactIds), assigned_to: Number(assignedTo) }),
          });
          // بنوضّح التلاتة أرقام صراحةً: اتحوّل، واتعملّه تذكرة جديدة، واتخطّى لأنه لسه ما كلّمش البوت
          const parts = [`تم إسناد ${result.updated + result.created} طالب إلى ${assigneeName}`];
          if (result.created) parts.push(`(${result.created} اتعملّهم تذاكر جديدة)`);
          if (result.skipped) parts.push(`— ${result.skipped} اتخطّوا لأنهم لسه ما بدأوش محادثة مع البوت`);
          showToast(parts.join(' '));
          selectedContactIds.clear();
          assignSelect.value = '';
          updateSelectedContactsUi();
          loadTafraStudents();
        } catch (error) {
          showToast(error.message);
        } finally {
          assignBtn.disabled = false;
        }
      });
    })();

    // ---------- فحص "الوصول الفعلي" لطلاب طفرة المرتبطين اللي ضغطوا Start على بوت طفرة قبل كده
    // (بوت طفرة هو نفس بوت منصة طفرة الرسمي) من غير ما يظهروا في new_bot_contacts ----------
    async function loadNewBotReachabilitySyncStatus() {
      const statusElement = document.getElementById('newbot-reachability-status');
      const button = document.getElementById('run-newbot-reachability-sync');
      try {
        const result = await api('/api/tafra/new-bot-reachability-sync-status');
        const sync = result.sync || {};
        button.disabled = sync.status === 'running';
        if (sync.status === 'running') {
          statusElement.textContent = `جارٍ الفحص: ${sync.checked_count || 0} من ${sync.total_count || '...'} — ${sync.found_reachable || 0} قابل للمراسلة لحد دلوقتي`;
        } else if (sync.status === 'completed') {
          statusElement.textContent = `آخر فحص: ${fmtDate(sync.completed_at)} — ${sync.found_reachable || 0} طالب إضافي قابل للمراسلة من أصل ${sync.total_count || 0} اتفحصوا`;
        } else if (sync.status === 'failed') {
          statusElement.textContent = `فشل آخر فحص: ${sync.error_message || 'سبب غير معروف'}`;
        } else {
          statusElement.textContent = 'لسه ما اتعملش فحص للوصول الفعلي — دوس الزرار عشان تبدأ.';
        }
        return sync;
      } catch (error) {
        statusElement.textContent = error.message;
      }
    }

    // ---------- رسالة من بوت طفرة نفسه لمشتركين فيه بالفعل (اتجاه عكسي — مثلًا نرجعهم لبوت المتابعة) ----------
    let newBotSubPage = 1;
    let newBotSubPages = 1;
    let newBotSubInitialized = false;
    let newBotSubSearchTimer = null;
    const selectedNewBotSubChatIds = new Set();

    function newBotSubQuery() {
      const params = new URLSearchParams({ page: newBotSubPage, limit: 50 });
      const search = document.getElementById('newbot-sub-search').value.trim();
      const bootcamp = document.getElementById('newbot-sub-bootcamp-filter').value;
      const excludeBootcamp = document.getElementById('newbot-sub-exclude-bootcamp-filter').value;
      const gender = document.getElementById('newbot-sub-gender-filter').value;
      if (search) params.set('search', search);
      if (bootcamp) params.set('bootcamp', bootcamp);
      if (excludeBootcamp) params.set('exclude_bootcamp', excludeBootcamp);
      if (gender) params.set('gender', gender);
      const excludeSentWithin = document.getElementById('newbot-sub-exclude-sent-within').value;
      if (excludeSentWithin) params.set('exclude_sent_within', excludeSentWithin);
      return params.toString();
    }

    function updateSelectedNewBotSubUi() {
      document.getElementById('selected-newbot-sub-count').textContent = `المحدد: ${selectedNewBotSubChatIds.size}`;
    }

    async function loadNewBotSubscribers() {
      const wrap = document.getElementById('newbot-sub-table');
      try {
        const result = await api('/api/tafra/new-bot-contacts?' + newBotSubQuery());
        newBotSubPages = result.meta.pages;
        document.getElementById('newbot-sub-count').textContent = `مشتركين بوت طفرة (${result.meta.total})`;
        document.getElementById('newbot-sub-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('newbot-sub-prev').disabled = result.meta.page <= 1;
        document.getElementById('newbot-sub-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.contacts.length) {
          wrap.innerHTML = '<div class="empty-state">لسه محدش بدأ بوت طفرة</div>';
          return;
        }
        wrap.innerHTML = `<p class="card-desc" style="margin:0 0 10px">اللي دخل بوت المتابعة مش بيظهر هنا — بوت طفرة بيدعو للدخول، واللي دخل خلاص بيتراسل من بوت المتابعة نفسه.</p>
        <div class="tafra-students-table-wrap"><table><thead><tr>
          <th class="select-cell"><input type="checkbox" id="select-all-newbot-sub" aria-label="تحديد الكل"></th>
          <th>الطالب</th><th>الهاتف</th><th>انضم لبوت طفرة</th>
        </tr></thead><tbody>${result.contacts.map((c) => `
          <tr>
            <td class="select-cell"><input type="checkbox" class="newbot-sub-selector" value="${c.chat_id}" ${selectedNewBotSubChatIds.has(Number(c.chat_id)) ? 'checked' : ''} aria-label="تحديد المشترك"></td>
            <td><div class="tafra-student-name">${escapeHtml(studentDisplayName(c))}</div><div class="tafra-student-sub">${c.telegram_username ? '@' + escapeHtml(c.telegram_username) : (c.student_code ? 'الكود: ' + escapeHtml(c.student_code) : '')}</div></td>
            <td>📱 ${escapeHtml(c.phone || '—')}</td>
            <td>${c.source === 'platform_link'
              ? '<span class="badge badge-muted" title="اتأكد إنه قابل للمراسلة عن طريق الفحص، مش من ضغطه Start على الهاندلر بتاعنا">🔗 من المنصة</span>'
              : fmtDate(c.started_at)}</td>
          </tr>`).join('')}</tbody></table></div>`;
        wrap.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const id = Number(checkbox.value);
            checkbox.checked ? selectedNewBotSubChatIds.add(id) : selectedNewBotSubChatIds.delete(id);
            updateSelectedNewBotSubUi();
          });
        });
        document.getElementById('select-all-newbot-sub').addEventListener('change', (event) => {
          wrap.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
            checkbox.checked = event.target.checked;
            const id = Number(checkbox.value);
            checkbox.checked ? selectedNewBotSubChatIds.add(id) : selectedNewBotSubChatIds.delete(id);
          });
          updateSelectedNewBotSubUi();
        });
        updateSelectedNewBotSubUi();
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    // ---------- حالة الويب هوك (مين حاليًا صاحبه — إحنا ولا منصة طفرة) وزراري التبديل ----------
    const WEBHOOK_STATUS_LABELS = {
      us: '✅ متوصل بينا (بنستقبل تفاعل الطلاب)',
      tafra: '⚠️ متوصل بمنصة طفرة، مش بينا — تفاعل الطلاب مش بيوصلنا دلوقتي',
      none: '❌ مفيش ويب هوك مسجّل خالص',
      other: '❓ متوصل بجهة تانية غير معروفة',
    };
    async function loadNewBotWebhookStatus() {
      const statusElement = document.getElementById('newbot-webhook-status');
      try {
        const status = await api('/api/tafra/new-bot-webhook-status');
        statusElement.textContent = WEBHOOK_STATUS_LABELS[status.pointing_to] || status.url || 'غير معروف';
        return status;
      } catch (error) {
        statusElement.textContent = error.message;
      }
    }

    async function initNewBotTab() {
      await loadTafraStudentFilters(); // بيجهّز خيارات وافتراضي فلتر الباب (الباب الأول + المنهج كاملا)
      loadNewBotReachabilitySyncStatus();
      loadNewBotWebhookStatus();
      registerFilterGroup('newbot', ['newbot-sub-search','newbot-sub-bootcamp-filter','newbot-sub-exclude-bootcamp-filter','newbot-sub-gender-filter','newbot-sub-exclude-sent-within']);
      loadNewBotSubscribers();
      // نجهّز آخر رسالة وزرار اتبعتوا فعليًا كقيم افتراضية (لو لسه فاضيين) — وإلا رابط بوت المتابعة
      // كافتراضي احتياطي للزرار لو معندناش إرسال سابق أصلًا
      api('/api/tafra/new-bot-info').then((info) => {
        const messageField = document.getElementById('newbot-sub-message');
        const urlField = document.getElementById('newbot-sub-button-url');
        const textField = document.getElementById('newbot-sub-button-text');
        if (info.last_message && !messageField.value) messageField.value = info.last_message;
        if (!urlField.value) {
          if (info.last_button_url) {
            urlField.value = info.last_button_url;
            if (!textField.value) textField.value = info.last_button_text || '';
          } else if (info.main_bot_link) {
            urlField.value = info.main_bot_link;
            if (!textField.value) textField.value = '💬 ارجع لبوت المتابعة';
          }
        }
      }).catch(() => {});
      if (newBotSubInitialized) return;
      newBotSubInitialized = true;
      document.getElementById('run-newbot-reachability-sync').addEventListener('click', async () => {
        const button = document.getElementById('run-newbot-reachability-sync');
        if (!window.confirm('فحص حالة الوصول ممكن ياخد كذا دقيقة (بيتم في الخلفية، مش هيبعت أي رسالة لحد). تكمل؟')) return;
        button.disabled = true;
        try {
          const result = await api('/api/tafra/new-bot-reachability-sync', { method: 'POST' });
          showToast(result.message || 'بدأ الفحص في الخلفية');
          const poll = async () => {
            const sync = await loadNewBotReachabilitySyncStatus();
            if (sync?.status === 'running') setTimeout(poll, 3000);
            else if (sync?.status === 'completed') {
              showToast(`اكتمل الفحص — ${sync.found_reachable || 0} طالب إضافي قابل للمراسلة`);
              loadNewBotSubscribers();
            } else if (sync?.status === 'failed') showToast('فشل الفحص، راجع التفاصيل');
          };
          setTimeout(poll, 1500);
        } catch (error) {
          showToast(error.message);
          button.disabled = false;
        }
      });
      document.getElementById('claim-newbot-webhook-btn').addEventListener('click', async () => {
        const button = document.getElementById('claim-newbot-webhook-btn');
        if (!window.confirm('هيوقّف استقبال منصة طفرة لأي تحديث من بوت طفرة، ويخلينا إحنا اللي نستقبله بدالها. تكمل؟')) return;
        button.disabled = true;
        try {
          await api('/api/tafra/new-bot-webhook-claim', { method: 'POST' });
          showToast('تم توجيه الويب هوك لسيرفرنا');
          loadNewBotWebhookStatus();
        } catch (error) {
          showToast(error.message);
        } finally {
          button.disabled = false;
        }
      });
      document.getElementById('release-newbot-webhook-btn').addEventListener('click', async () => {
        const button = document.getElementById('release-newbot-webhook-btn');
        if (!window.confirm('هيوقّف استقبالنا لتفاعل الطلاب على بوت طفرة، ويرجّعه لمنصة طفرة بدالنا. تكمل؟')) return;
        button.disabled = true;
        try {
          await api('/api/tafra/new-bot-webhook-release', { method: 'POST' });
          showToast('تم إرجاع الويب هوك لمنصة طفرة');
          loadNewBotWebhookStatus();
        } catch (error) {
          showToast(error.message);
        } finally {
          button.disabled = false;
        }
      });
      document.getElementById('newbot-sub-search').addEventListener('input', () => {
        clearTimeout(newBotSubSearchTimer);
        newBotSubSearchTimer = setTimeout(() => { newBotSubPage = 1; loadNewBotSubscribers(); }, 350);
      });
      document.getElementById('newbot-sub-exclude-bootcamp-filter').addEventListener('change', () => {
        newBotSubPage = 1;
        loadNewBotSubscribers();
      });
      document.getElementById('newbot-sub-bootcamp-filter').addEventListener('change', () => {
        newBotSubPage = 1; loadNewBotSubscribers();
      });
      document.getElementById('newbot-sub-gender-filter').addEventListener('change', () => {
        newBotSubPage = 1; loadNewBotSubscribers();
      });
      document.getElementById('newbot-sub-exclude-sent-within').addEventListener('change', () => {
        newBotSubPage = 1; loadNewBotSubscribers();
      });
      document.getElementById('clear-newbot-sub-filters').addEventListener('click', () => {
        filterGroups.newbot?.reset();
        document.getElementById('newbot-sub-search').value = '';
        document.getElementById('newbot-sub-gender-filter').value = '';
        document.getElementById('newbot-sub-bootcamp-filter').value = '';
        document.getElementById('newbot-sub-exclude-bootcamp-filter').value = '';
        document.getElementById('newbot-sub-exclude-sent-within').value = '';
        multiSelectControllers['newbot-sub-bootcamp-filter']?.refresh();
        multiSelectControllers['newbot-sub-exclude-bootcamp-filter']?.refresh();
        newBotSubPage = 1;
        loadNewBotSubscribers();
      });
      document.getElementById('refresh-newbot-subs-btn').addEventListener('click', () => {
        newBotSubPage = 1; loadNewBotSubscribers();
      });
      document.getElementById('newbot-sub-prev').addEventListener('click', () => {
        if (newBotSubPage > 1) { newBotSubPage--; loadNewBotSubscribers(); }
      });
      document.getElementById('newbot-sub-next').addEventListener('click', () => {
        if (newBotSubPage < newBotSubPages) { newBotSubPage++; loadNewBotSubscribers(); }
      });
      document.getElementById('select-page-newbot-sub-btn').addEventListener('click', () => {
        document.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
          checkbox.checked = true;
          selectedNewBotSubChatIds.add(Number(checkbox.value));
        });
        updateSelectedNewBotSubUi();
      });
      document.getElementById('select-all-newbot-sub-btn').addEventListener('click', async () => {
        const btn = document.getElementById('select-all-newbot-sub-btn');
        btn.disabled = true;
        try {
          const result = await api('/api/tafra/new-bot-contacts/ids?' + newBotSubQuery());
          result.chat_ids.forEach((id) => selectedNewBotSubChatIds.add(id));
          document.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => {
            if (selectedNewBotSubChatIds.has(Number(checkbox.value))) checkbox.checked = true;
          });
          updateSelectedNewBotSubUi();
          showToast(`تم تحديد ${result.chat_ids.length} مشترك من كل النتائج المطابقة للفلتر`);
        } catch (error) {
          showToast(error.message);
        } finally {
          btn.disabled = false;
        }
      });
      document.getElementById('clear-selected-newbot-sub-btn').addEventListener('click', () => {
        selectedNewBotSubChatIds.clear();
        document.querySelectorAll('.newbot-sub-selector').forEach((checkbox) => { checkbox.checked = false; });
        updateSelectedNewBotSubUi();
      });
      document.getElementById('clear-newbot-sub-button').addEventListener('click', () => {
        document.getElementById('newbot-sub-button-text').value = '';
        document.getElementById('newbot-sub-button-url').value = '';
      });
      // اختيار الصورة — العدّاد بيظهر بس لما تبقى فيه صورة، لأن حد الـ١٠٢٤ حرف مالوش لازمة من غيرها
      const newBotImageInput = document.getElementById('newbot-sub-image');
      const newBotImageName = document.getElementById('newbot-sub-image-name');
      const newBotImageClear = document.getElementById('clear-newbot-sub-image');
      const newBotImageNote = document.getElementById('newbot-sub-image-note');
      const newBotCharCount = document.getElementById('newbot-sub-char-count');
      const newBotMessageBox = document.getElementById('newbot-sub-message');

      function refreshNewBotImageState() {
        const file = newBotImageInput.files[0];
        newBotImageName.textContent = file ? file.name : 'لم يتم اختيار صورة';
        newBotImageClear.style.display = file ? 'inline-flex' : 'none';
        newBotImageNote.style.display = file ? 'block' : 'none';
        if (file) {
          const length = newBotMessageBox.value.trim().length;
          newBotCharCount.textContent = `نصك دلوقتي ${length} حرف`;
          newBotCharCount.style.color = length > 1024 ? 'var(--danger)' : 'var(--text-faint)';
        }
      }
      function clearNewBotSubImage() {
        newBotImageInput.value = '';
        refreshNewBotImageState();
      }
      newBotImageInput.addEventListener('change', refreshNewBotImageState);
      newBotImageClear.addEventListener('click', clearNewBotSubImage);
      newBotMessageBox.addEventListener('input', refreshNewBotImageState);

      document.getElementById('send-newbot-sub-btn').addEventListener('click', async () => {
        const btn = document.getElementById('send-newbot-sub-btn');
        const message = document.getElementById('newbot-sub-message').value.trim();
        const buttonText = document.getElementById('newbot-sub-button-text').value.trim();
        const buttonUrl = document.getElementById('newbot-sub-button-url').value.trim();
        const image = document.getElementById('newbot-sub-image').files[0];
        if (!selectedNewBotSubChatIds.size) return showToast('اختار مشترك واحد على الأقل');
        if (!message) return showToast('اكتب نص الرسالة الأول');
        if (buttonText && !buttonUrl) return showToast('حطيت نص للزرار من غير رابط');
        if (buttonUrl && !/^https?:\/\//i.test(buttonUrl)) return showToast('رابط الزرار لازم يبدأ بـ http:// أو https://');
        // تليجرام بيقصّ نص الصورة عند ١٠٢٤ حرف، فبنمنع الإرسال بدل ما الرسالة توصل ناقصة
        if (image && message.length > 1024) {
          return showToast(`النص مع الصورة لازم يكون ١٠٢٤ حرف على الأكثر — نصك ${message.length}`);
        }
        const what = image ? 'الصورة والرسالة دول' : 'الرسالة دي';
        if (!confirm(`إرسال ${what} لـ ${selectedNewBotSubChatIds.size} مشترك عن طريق بوت طفرة؟`)) return;
        btn.disabled = true;
        try {
          // multipart مش JSON عشان الصورة — chat_ids بتتبعت JSON مكتوبة والباك إند بيفكّها
          const formData = new FormData();
          formData.append('chat_ids', JSON.stringify([...selectedNewBotSubChatIds]));
          formData.append('message', message);
          if (buttonText) formData.append('button_text', buttonText);
          if (buttonUrl) formData.append('button_url', buttonUrl);
          if (image) formData.append('image', image);
          const response = await fetch('/api/tafra/new-bot-broadcast', { method: 'POST', body: formData });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'فشل الإرسال');
          showToast(`تم الإرسال: ${result.sent} نجح${result.failed ? ` — ${result.failed} فشل` : ''}`);
          selectedNewBotSubChatIds.clear();
          updateSelectedNewBotSubUi();
          clearNewBotSubImage();
          loadNewBotSubscribers();
        } catch (error) {
          showToast(error.message);
        } finally {
          btn.disabled = false;
        }
      });
    }

    // ---------- لوج دخول بوت المتابعة (تاب "التقارير" الفرعي جوه بوت طفرة) — تاريخ أول /start حقيقي
    // لكل طالب، مأخوذ من tickets.created_at لأنه بيتسجّل مرة واحدة بس بالظبط في هذه اللحظة ----------
    // ---------- ربط حساب تيليجرام بحساب المنصة ----------
    // **ليه يدوي:** الربط التلقائي بيحصل لما الطالب يبعت رقمه للبوت. اللي مابعتش بيفضل
    // معروف باسم تيليجرام، والموظف اللي بيكلّمه هو الوحيد اللي يعرف هو مين — فده بيديله
    // مكان يسجّل المعرفة دي، وبتفيد كل الشاشات مرة واحدة
    let linkDialogChatId = null;
    let linkSearchTimer = null;

    function openLinkDialog(chatId, telegramName) {
      linkDialogChatId = chatId;
      document.getElementById('link-student-telegram-name').textContent = telegramName;
      document.getElementById('link-student-search').value = '';
      document.getElementById('link-student-results').innerHTML =
        '<div class="empty-state">اكتب اسم الطالب أو رقمه أو كوده</div>';
      document.getElementById('link-student-overlay').style.display = 'flex';
      document.getElementById('link-student-search').focus();
    }

    function closeLinkDialog() {
      document.getElementById('link-student-overlay').style.display = 'none';
      linkDialogChatId = null;
    }

    async function searchStudentsToLink() {
      const term = document.getElementById('link-student-search').value.trim();
      const box = document.getElementById('link-student-results');
      if (term.length < 2) {
        box.innerHTML = '<div class="empty-state">اكتب حرفين على الأقل</div>';
        return;
      }
      try {
        const data = await api('/api/tafra/students/search?q=' + encodeURIComponent(term));
        if (!data.students.length) {
          box.innerHTML = '<div class="empty-state">مفيش طالب مطابق</div>';
          return;
        }
        box.innerHTML = data.students.map((student) => `
          <div class="row-between" style="padding:10px 0; border-bottom:1px solid var(--border); gap:10px">
            <div>
              <b>${escapeHtml(student.name || '—')}</b>
              <div class="card-desc">📱 ${escapeHtml(student.phone || '—')}${student.student_code ? ' · كود ' + escapeHtml(student.student_code) : ''}
                ${student.already_linked ? ' · <span class="badge badge-warning">مربوط بحساب تاني</span>' : ''}</div>
            </div>
            <button type="button" class="btn btn-primary btn-sm" style="width:auto"
                    onclick="linkContactToStudent(${student.id})">اربط</button>
          </div>`).join('');
      } catch (error) {
        box.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    async function linkContactToStudent(studentId, confirmed) {
      try {
        const result = await api('/api/tafra/link-contact', {
          method: 'POST',
          body: JSON.stringify({ chat_id: linkDialogChatId, tafra_student_id: studentId, confirm: confirmed === true }),
        });
        showToast(`اتربط بـ${result.name}`);
        closeLinkDialog();
        loadFollowUpBotLog();
      } catch (error) {
        // الربط الغلط أخطر من عدم الربط — السيرفر بيوقف ويطلب تأكيد لما الحساب مشغول
        if (error.data?.needs_confirmation && confirm(`${error.message}\n\nتأكيد؟`)) {
          return linkContactToStudent(studentId, true);
        }
        showToast(error.message);
      }
    }

    async function unlinkContact(chatId) {
      if (!confirm('فكّ الربط هيرجّع الاسم لاسم تيليجرام، والطالب هيحتاج يبعت رقمه تاني. تمام؟')) return;
      try {
        await api('/api/tafra/unlink-contact', { method: 'POST', body: JSON.stringify({ chat_id: chatId }) });
        showToast('اتفكّ الربط');
        loadFollowUpBotLog();
      } catch (error) { showToast(error.message); }
    }

    let followUpLogPage = 1;
    let followUpLogPages = 1;
    let followUpLogInitialized = false;
    let followUpLogSearchTimer = null;

    function followUpLogQuery() {
      const params = new URLSearchParams({ page: followUpLogPage, limit: 50 });
      const search = document.getElementById('followup-log-search').value.trim();
      if (search) params.set('search', search);
      return params.toString();
    }

    async function loadFollowUpBotLog() {
      const wrap = document.getElementById('followup-log-table');
      try {
        const result = await api('/api/tafra/follow-up-bot-log?' + followUpLogQuery());
        followUpLogPages = result.meta.pages;
        document.getElementById('followup-log-count').textContent = `لوج دخول بوت المتابعة (${result.meta.total})`;
        document.getElementById('followup-log-page-label').textContent = `صفحة ${result.meta.page} من ${result.meta.pages}`;
        document.getElementById('followup-log-prev').disabled = result.meta.page <= 1;
        document.getElementById('followup-log-next').disabled = result.meta.page >= result.meta.pages;
        if (!result.entries.length) {
          wrap.innerHTML = '<div class="empty-state">لا يوجد طلاب مطابقون</div>';
          return;
        }
        // **عمود "مصدر الاسم" مش زينة.** الاسم اللي جاي من تيليجرام ممكن يكون لقب أو اسم
        // الأب، والموظف لازم يعرف إنه بيقرا اسم غير موثوق قبل ما يبني عليه كلام مع الطالب
        wrap.innerHTML = `<div class="tafra-students-table-wrap"><table><thead><tr>
          <th>الاسم</th><th>مصدر الاسم</th><th>الهاتف</th><th>اليوزر</th><th>تاريخ الدخول</th><th></th>
        </tr></thead><tbody>${result.entries.map((entry) => {
          const linked = Boolean((entry.tafra_name || '').trim());
          return `
          <tr>
            <td>${escapeHtml(studentDisplayName(entry))}</td>
            <td>${linked
              ? '<span class="badge badge-success">المنصة</span>'
              : '<span class="badge badge-warning">تيليجرام — مش مربوط</span>'}</td>
            <td>📱 ${escapeHtml(entry.phone || '—')}</td>
            <td>${entry.telegram_username ? '@' + escapeHtml(entry.telegram_username) : '—'}</td>
            <td>${fmtDate(entry.started_at)}</td>
            <td>${linked
              ? `<button type="button" class="btn btn-ghost btn-sm" style="width:auto" onclick="unlinkContact('${entry.chat_id}')">فكّ الربط</button>`
              : `<button type="button" class="btn btn-primary btn-sm" style="width:auto" onclick="openLinkDialog('${entry.chat_id}', '${escapeHtml(studentDisplayName(entry)).replace(/'/g, "\\'")}')">اربط بالمنصة</button>`}</td>
          </tr>`; }).join('')}</tbody></table></div>`;
      } catch (error) {
        wrap.innerHTML = `<div class="empty-state">${escapeHtml(error.message)}</div>`;
      }
    }

    function initFollowUpBotLogTab() {
      loadFollowUpBotLog();
      if (followUpLogInitialized) return;
      followUpLogInitialized = true;
      document.getElementById('followup-log-search').addEventListener('input', () => {
        clearTimeout(followUpLogSearchTimer);
        followUpLogSearchTimer = setTimeout(() => { followUpLogPage = 1; loadFollowUpBotLog(); }, 350);
      });
      document.getElementById('link-student-search')?.addEventListener('input', () => {
      clearTimeout(linkSearchTimer);
      linkSearchTimer = setTimeout(searchStudentsToLink, 300);
    });
    document.getElementById('link-student-overlay')?.addEventListener('click', (event) => {
      if (event.target.id === 'link-student-overlay') closeLinkDialog();
    });

    document.getElementById('refresh-followup-log-btn').addEventListener('click', () => {
        followUpLogPage = 1; loadFollowUpBotLog();
      });
      document.getElementById('followup-log-prev').addEventListener('click', () => {
        if (followUpLogPage > 1) { followUpLogPage--; loadFollowUpBotLog(); }
      });
      document.getElementById('followup-log-next').addEventListener('click', () => {
        if (followUpLogPage < followUpLogPages) { followUpLogPage++; loadFollowUpBotLog(); }
      });
    }
    document.querySelector('#new-bot-subtabs .subtab-btn[data-subtab="reports"]')?.addEventListener('click', initFollowUpBotLogTab);

    document.getElementById('csv-input').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/contacts/import', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        showToast(`تم استيراد ${data.imported} جهة اتصال${data.skipped ? ` (${data.skipped} اتجاهلت)` : ''}`);
        loadContacts();
      } catch (err) { showToast(err.message); }
      e.target.value = '';
    });

    // ---------- القوالب والتصنيفات (مشتركة) ----------
    async function loadTagsIntoSelect() {
      try {
        const tags = await api('/api/tags');
        const select = document.getElementById('broadcast-tag');
        const currentValue = select.value;
        select.innerHTML = '<option value="">كل جهات الاتصال</option>' +
          `<option value="__selected__">الجهات المحددة (${selectedContactIds.size})</option>` +
          tags.map((t) => `<option value="${t.id}">${t.name}</option>`).join('');
        if ([...select.options].some((option) => option.value === currentValue)) select.value = currentValue;
        updateSelectedContactsUi();
      } catch (e) { /* تجاهل بصمت لو مفيش تصنيفات لسه */ }
    }

    async function loadTemplates() {
      const list = document.getElementById('templates-list');
      try {
        const templates = await api('/api/templates');
        if (templates.length === 0) {
          list.innerHTML = '<div class="empty-state">لسه مفيش قوالب</div>';
          return;
        }
        list.innerHTML = templates.map((t) => `
          <div class="row-between" style="padding:10px 0; border-bottom:1px solid var(--border)">
            <div><b>${t.name}</b><div style="color:var(--text-muted); font-size:13px">${t.content}</div></div>
            <button class="btn btn-danger-ghost btn-sm" onclick="deleteTemplate(${t.id})">حذف</button>
          </div>
        `).join('');
      } catch (e) { list.innerHTML = `<div class="empty-state">${e.message}</div>`; }
    }

    document.getElementById('add-template-btn').addEventListener('click', async () => {
      const name = document.getElementById('template-name').value.trim();
      const content = document.getElementById('template-content').value.trim();
      if (!name || !content) return showToast('املأ اسم القالب والمحتوى');
      try {
        await api('/api/templates', { method: 'POST', body: JSON.stringify({ name, content }) });
        document.getElementById('template-name').value = '';
        document.getElementById('template-content').value = '';
        showToast('تم إضافة القالب');
        loadTemplates();
      } catch (e) { showToast(e.message); }
    });

    async function deleteTemplate(id) {
      try {
        await api('/api/templates/' + id, { method: 'DELETE' });
        loadTemplates();
      } catch (e) { showToast(e.message); }
    }

    // ---------- الإرسال الجماعي ----------
    document.getElementById('broadcast-tag').addEventListener('change', updateSelectedContactsUi);

    const broadcastImageInput = document.getElementById('broadcast-image');
    const broadcastImageName = document.getElementById('broadcast-image-name');
    const clearBroadcastImage = document.getElementById('clear-broadcast-image');

    broadcastImageInput.addEventListener('change', () => {
      const file = broadcastImageInput.files[0];
      broadcastImageName.textContent = file ? file.name : 'لم يتم اختيار صورة';
      clearBroadcastImage.style.display = file ? 'inline-flex' : 'none';
    });

    clearBroadcastImage.addEventListener('click', () => {
      broadcastImageInput.value = '';
      broadcastImageName.textContent = 'لم يتم اختيار صورة';
      clearBroadcastImage.style.display = 'none';
    });

    async function loadBroadcasts() {
      const wrap = document.getElementById('broadcasts-table-wrap');
      try {
        const broadcasts = await api('/api/broadcasts');
        if (broadcasts.length === 0) {
          wrap.innerHTML = '<div class="empty-state">لسه مفيش عمليات إرسال</div>';
          return;
        }
        const statusBadge = (s) => ({
          pending: '<span class="badge badge-warning">قيد الانتظار</span>',
          sending: '<span class="badge badge-warning">بيتبعت الآن</span>',
          completed: '<span class="badge badge-success">تم</span>',
          failed: '<span class="badge badge-danger">فشل</span>',
        }[s] || s);
        wrap.innerHTML = `
          <table>
            <thead><tr><th>الرسالة</th><th>الحالة</th><th>نجح</th><th>فشل</th><th data-sort-key="date">التاريخ</th><th>الجمهور</th></tr></thead>
            <tbody>
              ${broadcasts.map((b) => `
                <tr>
                  <td><span class="row" style="gap:6px; flex-wrap:nowrap">
                    <span>${escapeHtml((b.message_content || '').slice(0, 40))}${b.message_content.length > 40 ? '…' : ''}</span>
                    <button type="button" class="btn btn-ghost btn-sm copy-broadcast-btn" data-id="${b.id}" title="نسخ نص الرسالة كامل" style="width:auto; padding:2px 6px">📋</button>
                  </span></td>
                  <td>${statusBadge(b.status)}</td>
                  <td>${b.sent_count}</td>
                  <td>${b.failed_count}</td>
                  <td data-sort-value="${new Date(b.scheduled_for || b.created_at).getTime()}">${fmtDate(b.scheduled_for || b.created_at)}</td>
                  <td><button type="button" class="btn btn-ghost btn-sm reuse-audience-btn" data-id="${b.id}">إعادة استخدام نفس الجمهور</button></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
        enableTableSort(wrap);
        wrap.querySelectorAll('.reuse-audience-btn').forEach((button) => {
          button.addEventListener('click', () => reuseBroadcastAudience(button.dataset.id));
        });
        wrap.querySelectorAll('.copy-broadcast-btn').forEach((button) => {
          button.addEventListener('click', async () => {
            const broadcast = broadcasts.find((b) => String(b.id) === button.dataset.id);
            if (!broadcast) return;
            await navigator.clipboard.writeText(broadcast.message_content || '');
            showToast('تم نسخ نص الرسالة');
          });
        });
      } catch (e) { wrap.innerHTML = `<div class="empty-state">${e.message}</div>`; }
    }

    // إعادة استخدام نفس مستقبلي رسالة جماعية سابقة بالظبط (مش إعادة تطبيق فلترها، عشان الفلاتر ممكن
    // تختلف نتيجتها لاحقًا) — بيحدد نفس جهات الاتصال كجمهور جاهز، والموظف يكتب رسالة جديدة ويبعتها
    async function reuseBroadcastAudience(broadcastId) {
      try {
        const broadcast = await api('/api/broadcasts/' + broadcastId);
        const contactIds = [...new Set((broadcast.recipients || []).map((r) => r.contact_id))];
        if (!contactIds.length) return showToast('مفيش مستقبلين مسجّلين لعملية الإرسال دي');

        selectedContactIds.clear();
        contactIds.forEach((id) => selectedContactIds.add(id));

        await loadTagsIntoSelect();
        document.getElementById('broadcast-tag').value = '__selected__';
        updateSelectedContactsUi();

        document.getElementById('broadcast-content').scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('broadcast-content').focus();
        showToast(`تم تحديد نفس جمهور الرسالة (${contactIds.length} جهة اتصال) — اكتب الرسالة الجديدة واضغط إرسال`);
      } catch (e) { showToast(e.message); }
    }

    document.getElementById('send-broadcast-btn').addEventListener('click', async () => {
      const message_content = document.getElementById('broadcast-content').value.trim();
      const audienceValue = document.getElementById('broadcast-tag').value;
      const filter_tag_id = audienceValue && audienceValue !== '__selected__' ? audienceValue : null;
      const selected_contact_ids = audienceValue === '__selected__' ? Array.from(selectedContactIds) : undefined;
      const scheduleVal = document.getElementById('broadcast-schedule').value;
      const scheduled_for = scheduleVal ? new Date(scheduleVal).toISOString() : null;
      const image = broadcastImageInput.files[0];
      const buttonText = document.getElementById('broadcast-button-text').value.trim();
      const buttonUrl = document.getElementById('broadcast-button-url').value.trim();

      if (!message_content) return showToast('اكتب محتوى الرسالة الأول');
      if (image && message_content.length > 1024) return showToast('النص مع الصورة يجب ألا يتجاوز 1024 حرفًا');
      if (audienceValue === '__selected__' && selected_contact_ids.length === 0) {
        return showToast('اختار جهة اتصال واحدة على الأقل من صفحة جهات الاتصال');
      }
      if (buttonText && !buttonUrl) return showToast('حطيت نص للزرار من غير رابط');
      if (buttonUrl && !/^https?:\/\//i.test(buttonUrl)) return showToast('رابط الزرار لازم يبدأ بـ http:// أو https://');

      try {
        const formData = new FormData();
        formData.append('message_content', message_content);
        if (filter_tag_id) formData.append('filter_tag_id', filter_tag_id);
        if (selected_contact_ids) formData.append('selected_contact_ids', JSON.stringify(selected_contact_ids));
        const examContext = document.getElementById('broadcast-exam-context').value;
        if (examContext) formData.append('exam', examContext);
        if (scheduled_for) formData.append('scheduled_for', scheduled_for);
        if (image) formData.append('image', image);
        if (buttonText && buttonUrl) {
          formData.append('button_text', buttonText);
          formData.append('button_url', buttonUrl);
        }

        const response = await fetch('/api/broadcasts', { method: 'POST', body: formData });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'حصل خطأ أثناء الإرسال');
        showToast(scheduled_for ? 'تم جدولة الرسالة' : 'جاري الإرسال الآن');
        document.getElementById('broadcast-content').value = '';
        document.getElementById('broadcast-schedule').value = '';
        document.getElementById('broadcast-exam-context').value = '';
        document.getElementById('broadcast-button-text').value = '';
        document.getElementById('broadcast-button-url').value = '';
        clearBroadcastImage.click();
        loadBroadcasts();
      } catch (e) { showToast(e.message); }
    });
