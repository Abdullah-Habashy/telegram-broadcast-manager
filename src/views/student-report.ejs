<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/layout-head') %>
  <link rel="stylesheet" href="/student-report.css" />
  <title>تقرير <%= report.student.name %></title>
</head>
<body class="report-body">
  <div class="report-shell">

    <header class="report-header">
      <div>
        <h1><%= report.student.name %></h1>
        <p class="report-subtitle">
          <%= report.bootcamp ? 'تقرير كورس: ' + report.bootcamp.name : 'تقرير المتابعة' %>
          <% if (report.student.grade_level) { %> · <%= report.student.grade_level %><% } %>
          <% if (report.student.student_code) { %> · كود <%= report.student.student_code %><% } %>
          <% if (staffPreview) { %> · <span class="report-staff-badge">معاينة داخلية</span><% } %>
        </p>
      </div>
      <div class="report-header-side">
        <div class="report-generated">اتولّد في <%= report.generated_at_text %></div>
        <button type="button" class="report-print-btn" onclick="window.print()">🖨 طباعة</button>
      </div>
    </header>

    <!-- ===================== التقرير الإجمالي =====================
         أول حاجة ولي الأمر يشوفها: أربع دوائر بنسبة كل جانب، وجنب كل واحدة جملة بالعربي تقول
         الرقم ومعناه. اللي عايز يتعمّق يكمّل تحت في الأقسام المفصّلة -->
    <section class="report-card report-overall">
      <h2>📊 التقرير الإجمالي</h2>
      <p class="report-overall-intro">ملخّص سريع لكل حاجة — الدايرة بتوضّح النسبة، والجملة جنبها بتقول المعنى.</p>

      <% if (report.bootcamps.length > 1) { %>
        <%# مبدّل الكورس: بيقصر الاختبارات والفيديوهات على كورس واحد. المكالمات والرسايل
            مالهاش كورس بطبيعتها فبتفضل زي ما هي، وفيه سطر بيوضّح ده %>
        <div class="report-course-switch">
          <span class="report-course-switch-label">اعرض:</span>
          <a class="report-course-tab <%= report.bootcamp ? '' : 'active' %>" href="?">كل الكورسات</a>
          <% report.bootcamps.forEach((bootcamp) => { %>
            <a class="report-course-tab <%= report.bootcamp && report.bootcamp.id === bootcamp.id ? 'active' : '' %>"
               href="?bootcamp=<%= bootcamp.id %>"><%= bootcamp.name %></a>
          <% }) %>
        </div>
      <% } %>

      <div class="report-overall-grid">
        <!-- الاختبارات -->
        <div class="report-overall-item">
          <%- donutSvg(report.exams.available ? (report.exams.total / report.exams.available) * 100 : 0,
                report.exams.available ? donutTone((report.exams.total / report.exams.available) * 100) : 'none') %>
          <div class="report-overall-text">
            <div class="report-overall-title">📝 الاختبارات</div>
            <div class="report-overall-big"><%= report.exams.total %> <span>من <%= report.exams.available %></span></div>
            <p class="report-overall-line">
              <% if (!report.exams.total) { %>
                لسه مدخلش أي اختبار من الـ<%= report.exams.available %> المتاحين له.
              <% } else { %>
                دخل <b><%= report.exams.total %></b> اختبار من <b><%= report.exams.available %></b> متاحين له<% if (report.exams.average !== null) { %>،
                ومتوسط درجاته <b><%= report.exams.average %>%</b>، وأعلى درجة جابها <b><%= report.exams.best %>%</b><% } %>.
              <% } %>
            </p>
          </div>
        </div>

        <!-- الفيديوهات — بتتحمّل من المنصة بعد ما الصفحة تفتح -->
        <div class="report-overall-item" id="overall-videos">
          <div class="report-donut-placeholder"></div>
          <div class="report-overall-text">
            <div class="report-overall-title">🎬 الفيديوهات</div>
            <div class="report-overall-big">…</div>
            <p class="report-overall-line">جارٍ تحميل المشاهدات من المنصة...</p>
          </div>
        </div>

        <!-- المكالمات -->
        <div class="report-overall-item">
          <%- donutSvg(report.calls.total ? (report.calls.answered / report.calls.total) * 100 : 0,
                report.calls.total ? donutTone((report.calls.answered / report.calls.total) * 100) : 'none') %>
          <div class="report-overall-text">
            <div class="report-overall-title">📞 المكالمات</div>
            <div class="report-overall-big"><%= report.calls.answered %> <span>من <%= report.calls.total %></span></div>
            <p class="report-overall-line">
              <% if (report.bootcamp) { %><span class="report-scope-hint">المكالمات مش مرتبطة بكورس معيّن</span><br><% } %>
              <% if (!report.calls.total) { %>
                لسه ما اتصلناش بيه ولا مرة.
              <% } else { %>
                اتصلنا بيه <b><%= report.calls.total %></b> مرة — رد في <b><%= report.calls.answered %></b>،
                ومردّش في <b><%= report.calls.no_answer %></b><% if (report.calls.wrong_number) { %>،
                و<b><%= report.calls.wrong_number %></b> الرقم فيها كان غلط<% } %>.
              <% } %>
            </p>
          </div>
        </div>

        <!-- الرسايل -->
        <div class="report-overall-item">
          <%- donutSvg(report.engagement.reply_rate || 0,
                report.engagement.messages_sent ? donutTone(report.engagement.reply_rate || 0) : 'none') %>
          <div class="report-overall-text">
            <div class="report-overall-title">💬 الرسايل</div>
            <div class="report-overall-big"><%= report.engagement.replied_to %> <span>من <%= report.engagement.messages_sent %></span></div>
            <p class="report-overall-line">
              <% if (report.bootcamp) { %><span class="report-scope-hint">الرسايل مش مرتبطة بكورس معيّن</span><br><% } %>
              <% if (!report.engagement.messages_sent) { %>
                لسه ما بعتناش له رسايل متابعة على تيليجرام.
              <% } else { %>
                بعتنا له <b><%= report.engagement.messages_sent %></b> رسالة متابعة، رد على
                <b><%= report.engagement.replied_to %></b> منهم، وبيرد في المتوسط خلال
                <b><%= report.engagement.avg_reply_text %></b>.
              <% } %>
            </p>
          </div>
        </div>
      </div>

      <% if (report.bootcamps.length && !report.bootcamp) { %>
        <div class="report-overall-courses">
          <div class="report-overall-title">📚 الكورسات المشترك فيها</div>
          <div class="report-chips">
            <% report.bootcamps.forEach((bootcamp) => { %>
              <span class="report-chip"><%= bootcamp.name %><% if (bootcamp.enrolled_text) { %>
                <em>اشترك <%= bootcamp.enrolled_text %></em><% } %></span>
            <% }) %>
          </div>
        </div>
      <% } %>
    </section>

    <!-- ===================== الاختبارات ===================== -->
    <section class="report-card">
      <h2>📝 تفاصيل الاختبارات</h2>
      <% if (!report.exams.rows.length) { %>
        <p class="report-empty">لسه مدخلش أي اختبار.</p>
      <% } else { %>
        <p class="report-note">
          كل اختبار دخله، بدرجته من النهاية العظمى وتاريخ دخوله.
          الشريط الأخضر معناه ٧٥% فأكتر، والأصفر من ٥٠ لـ ٧٥، والأحمر أقل من ٥٠.
        </p>
        <div class="report-bars">
          <% report.exams.rows.filter((row) => row.percentage !== null).slice(0, 20).forEach((row) => { %>
            <div class="report-bar-row">
              <span class="report-bar-label" title="<%= row.name %>"><%= row.name %></span>
              <span class="report-bar-track">
                <span class="report-bar-fill <%= row.percentage >= 75 ? 'high' : row.percentage >= 50 ? 'mid' : 'low' %>"
                      style="width: <%= Math.max(2, Math.min(100, row.percentage)) %>%"></span>
              </span>
              <span class="report-bar-value"><%= row.percentage %>%</span>
            </div>
          <% }) %>
        </div>
        <div class="report-table-wrap">
          <table>
            <thead><tr><th>الاختبار</th><th>الكورس</th><th>الدرجة</th><th>النسبة</th><th>التاريخ والوقت</th></tr></thead>
            <tbody>
              <% report.exams.rows.forEach((row) => { %>
                <tr>
                  <td><%= row.name %></td>
                  <td class="report-muted"><%= row.bootcamp || '—' %></td>
                  <td class="report-mark"><% if (row.mark === null) { %>—<% } else if (row.max_mark) { %><b><%= row.mark %></b> / <%= row.max_mark %><% } else { %><b><%= row.mark %></b><% } %></td>
                  <td><%= row.percentage === null ? '—' : row.percentage + '%' %></td>
                  <td class="report-muted"><%= row.occurred_text %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <!-- ===================== الفيديوهات ===================== -->
    <section class="report-card">
      <h2>🎬 تفاصيل الفيديوهات</h2>
      <div id="videos-section"><p class="report-empty">جارٍ تحميل المشاهدات من المنصة...</p></div>
    </section>

    <!-- ===================== المكالمات ===================== -->
    <section class="report-card">
      <h2>📞 تفاصيل المكالمات</h2>
      <% if (!report.calls.total) { %>
        <p class="report-empty">لسه ما اتعملتش أي مكالمة متابعة.</p>
      <% } else { %>
        <p class="report-note">
          أول مكالمة كانت <b><%= report.calls.first_call_text %></b>، وآخر واحدة
          <b><%= report.calls.last_call_text %></b>.
        </p>
        <div class="report-table-wrap">
          <table>
            <thead><tr><th>التاريخ والوقت</th><th>حصل إيه</th></tr></thead>
            <tbody>
              <% report.calls.rows.forEach((row) => { %>
                <tr>
                  <td><%= row.called_text %></td>
                  <td><span class="report-tag <%= row.reached ? 'ok' : 'no' %>"><%= row.reached ? '✅' : '❌' %> <%= row.outcome %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <!-- ===================== الرسايل ===================== -->
    <section class="report-card">
      <h2>💬 تفاصيل الرسايل</h2>
      <% if (!report.engagement.messages_sent) { %>
        <p class="report-empty">لسه ما اتبعتلوش رسايل متابعة على تيليجرام.</p>
      <% } else { %>
        <div class="report-stat-grid">
          <div><span class="report-muted">📤 رسايل بعتناها له</span><b><%= report.activity.messages_to_student %></b></div>
          <div><span class="report-muted">📥 رسايل رد بيها</span><b><%= report.activity.messages_from_student %></b></div>
          <div><span class="report-muted">⏱ متوسط وقت رده</span><b><%= report.engagement.avg_reply_text %></b></div>
          <div><span class="report-muted">⏱ الوقت المعتاد لرده</span><b><%= report.engagement.median_reply_text %></b></div>
          <div><span class="report-muted">🕐 أول رسالة منه</span><b><%= report.activity.first_message_text %></b></div>
          <div><span class="report-muted">🕐 آخر رسالة منه</span><b><%= report.activity.last_message_text %></b></div>
        </div>
      <% } %>
    </section>

    <footer class="report-footer">
      التقرير ده خاص بـ <%= report.student.name %> وبيتحدّث تلقائيًا في كل مرة تفتح الصفحة.
    </footer>
  </div>

  <script>
    // كل التقرير معروض من السيرفر ما عدا المشاهدات — دي نداء لحظي للمنصة وبطيء شوية، فبتتحمّل
    // بعد ما الصفحة تبان عشان باقي التقرير ما يستناهاش. بتملا مكانين: سطر التقرير الإجمالي
    // فوق، والقسم المفصّل تحت
    (function loadVideos() {
      var section = document.getElementById('videos-section');
      var overall = document.getElementById('overall-videos');

      function esc(value) {
        return String(value === null || value === undefined ? '' : value)
          .replace(/[&<>'"]/g, function (ch) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[ch];
          });
      }
      // نفس دايرة السيرفر بالظبط — نصف القطر بيخلي محيط الدايرة ١٠٠ فالنسبة بتتكتب زي ما هي
      function donut(percent, tone) {
        var v = Math.max(0, Math.min(100, Math.round(percent || 0)));
        return '<svg viewBox="0 0 42 42" class="report-donut ' + tone + '" role="img" aria-label="' + v + '%">'
          + '<circle class="report-donut-bg" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"></circle>'
          + '<circle class="report-donut-fg" cx="21" cy="21" r="15.9155" fill="none" stroke-width="4"'
          + ' stroke-dasharray="' + v + ' ' + (100 - v) + '" stroke-dashoffset="25" stroke-linecap="round"></circle>'
          + '<text x="21" y="21" class="report-donut-text">' + v + '%</text></svg>';
      }
      function tone(p) { return p >= 70 ? 'good' : p >= 40 ? 'mid' : 'low'; }

      function fillOverall(svg, big, line) {
        overall.innerHTML = svg
          + '<div class="report-overall-text"><div class="report-overall-title">🎬 الفيديوهات</div>'
          + '<div class="report-overall-big">' + big + '</div>'
          + '<p class="report-overall-line">' + line + '</p></div>';
      }

      fetch(location.pathname.replace(/\/$/, '') + '/videos' + location.search)
        .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('failed')); })
        .then(function (data) {
          var views = data.views || [];
          var summary = data.summary || {};
          // "المتاح" = كل الفيديوهات اللي المنصة راجعة له فيها سجل، حتى اللي نسبته صفر — دي
          // فيديوهات كورساته المفتوحة له. و"اتفرّج عليه" = اللي نسبته أكبر من صفر
          var videos = views.filter(function (v) { return v.is_video; });
          var totalVideos = videos.length;
          var watched = videos.filter(function (v) { return Number(v.progress_percentage) > 0; }).length;
          // النسبة بالوقت مش بالعدد: الدقايق اللي اتفرّجها فعلًا ÷ دقايق كل الفيديوهات المتاحة.
          // ده اللي بيقيس المحتوى اللي دخل فعلًا، مش كام فيديو فتحه ولو ثانية
          var pct = summary.time_percentage === null || summary.time_percentage === undefined
            ? 0 : summary.time_percentage;

          if (!totalVideos) {
            fillOverall(donut(0, 'none'), '0 <span>من 0</span>', 'مفيش فيديوهات متاحة له على المنصة لسه.');
            section.innerHTML = '<p class="report-empty">مفيش فيديوهات متاحة له على المنصة لسه.</p>';
            return;
          }

          var line = 'اتفرّج <b>' + esc(summary.watched_text) + '</b> من أصل <b>' + esc(summary.total_text) + '</b>'
            + ' من الفيديوهات المتاحة له، يعني <b>' + pct + '%</b> من المحتوى.'
            + ' فتح <b>' + watched + '</b> فيديو من <b>' + totalVideos + '</b>'
            + (summary.completed_count ? '، وخلّص منهم <b>' + summary.completed_count + '</b> (شافهم ٩٠% فأكتر)' : '') + '.';
          fillOverall(donut(pct, tone(pct)),
            esc(summary.watched_text) + ' <span>من ' + esc(summary.total_text) + '</span>', line);

          var note = '<p class="report-note">كل فيديو ونسبة اللي شافه منه، وقد إيه اتفرّج فعلًا من مدة الفيديو.'
            + (summary.truncated ? ' <span class="report-muted">(معروض أحدث ' + summary.shown + ' من ' + summary.total + ')</span>' : '') + '</p>';

          var bars = '<div class="report-bars">' + videos.filter(function (v) {
            return v.progress_percentage !== null;
          }).slice(0, 20).map(function (v) {
            var p = Math.max(2, Math.min(100, v.progress_percentage));
            var t = v.progress_percentage >= 75 ? 'high' : v.progress_percentage >= 30 ? 'mid' : 'low';
            return '<div class="report-bar-row">'
              + '<span class="report-bar-label" title="' + esc(v.lesson_name) + '">' + esc(v.lesson_name) + '</span>'
              + '<span class="report-bar-track"><span class="report-bar-fill ' + t + '" style="width:' + p + '%"></span></span>'
              + '<span class="report-bar-value">' + v.progress_percentage + '%</span></div>';
          }).join('') + '</div>';

          var VISIBLE = 15;
          var table = '<div class="report-table-wrap"><table><thead><tr>'
            + '<th>الفيديو</th><th>الكورس</th><th>نسبة المشاهدة</th><th>اتفرّج</th><th>التاريخ والوقت</th>'
            + '</tr></thead><tbody>' + views.map(function (v, index) {
              return '<tr' + (index >= VISIBLE ? ' class="report-extra-row"' : '') + '><td>' + esc(v.lesson_name) + '</td>'
                + '<td class="report-muted">' + esc(v.bootcamp_name || '—') + '</td>'
                + '<td>' + (v.progress_percentage === null ? '—' : v.progress_percentage + '%')
                + (v.is_completed ? ' <span class="report-tag ok">✅ خلّصه</span>' : '') + '</td>'
                + '<td class="report-muted">' + esc(v.watched_text) + ' من ' + esc(v.duration_text) + '</td>'
                + '<td class="report-muted">' + esc(v.viewed_text) + '</td></tr>';
            }).join('') + '</tbody></table></div>'
            + (views.length > VISIBLE
              ? '<button type="button" class="report-more-btn" id="show-all-videos">عرض كل الـ' + views.length + ' سطر</button>'
              : '');

          section.innerHTML = note + bars + table;
          var showAll = document.getElementById('show-all-videos');
          if (showAll) {
            showAll.addEventListener('click', function () {
              section.classList.add('show-all');
              showAll.remove();
            });
            // الطباعة لازم تطلع كاملة حتى لو الجدول لسه مطوي على الشاشة
            window.addEventListener('beforeprint', function () { section.classList.add('show-all'); });
          }
        })
        .catch(function () {
          fillOverall(donut(0, 'none'), '—', 'تعذر تحميل المشاهدات من المنصة دلوقتي.');
          section.innerHTML = '<p class="report-empty">تعذر تحميل المشاهدات من المنصة دلوقتي. جرّب تحدّث الصفحة بعد شوية.</p>';
        });
    }());
  </script>
</body>
</html>
