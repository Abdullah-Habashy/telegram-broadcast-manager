<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/layout-head') %>
  <%# **الرقم ده يتغيّر مع أي تعديل على quiz.css.** Cloudflare بيقول للمتصفح يكاش الملف
      ٤ ساعات (max-age=14400)، فالطالب اللي فتح الاختبار قبل التعديل بيفضل على الـ CSS
      القديم طول المدة دي — والرابط الجديد بيتجاوز الكاش فورًا %>
  <link rel="stylesheet" href="/quiz.css?v=20260917a" />
  <title><%= quiz.title %></title>
</head>
<body class="qz-body">
<div class="qz-shell">

  <div class="qz-card qz-head">
    <h1><%= quiz.title %></h1>
    <% if (quiz.description) { %><p><%= quiz.description %></p><% } %>
    <div class="qz-meta">
      <span class="qz-chip"><%= quiz.question_count %> سؤال</span>
      <% if (quiz.time_limit_minutes) { %><span class="qz-chip">⏱️ <%= quiz.time_limit_minutes %> دقيقة</span><% } %>
      <span class="qz-chip">محاولة واحدة</span>
    </div>
  </div>

  <%# ===== بوابة الدخول =====
      الأسئلة مش في الصفحة دي — بتيجي من /start بعد ما الرقم يتطابق. لولا كده كان أي حد
      يفتح مصدر الصفحة يقرا الأسئلة والإجابات الصح من غير ما المؤقت يبدأ %>
<%# معاينة الأدمن: بانر بيقول إن اللي تحته ورقة طالب بعينه مش ورقتك. لو اتشال، الأدمن
    ممكن يفتكر إنه بيشوف الصفحة العامة ويحكم على حاجة مش موجودة فيها أصلًا.
    **`locals.preview` مش `typeof preview`** — EJS بيحل المتغيّرات من `locals`، و
    `typeof preview` بيرمي "preview is not defined" في الصفحة العامة اللي مابتمرّرهوش.
    اتكشف بالاختبار قبل النشر، وكان هيوقّع صفحة الاختبار لكل الطلاب %>
<% if (locals.preview) { %>
  <div class="qz-card qz-preview-banner">
    <b>👁️ معاينة بعين الطالب</b>
    <p>ورقة <b><%= preview.student_name %></b><% if (preview.attempt_no > 1) { %> — محاولة <%= preview.attempt_no %><% } %>. دي نفس الصفحة اللي الطالب بيشوفها بالظبط، وبنفس القيود.</p>
    <% if (!preview.submitted) { %>
      <p class="qz-preview-note">⚠️ الورقة دي لسه بتتحل ومسلّمتش، فمفيش تصحيح يتعاين. المعاينة للأوراق المسلّمة بس.</p>
    <% } else if (preview.answers_hidden) { %>
      <p class="qz-preview-note">⚠️ الطالب <b>مش</b> شايف تصحيح ورقته دلوقتي، والسبب:
        <% if (!preview.show_answers_to_student) { %>خانة «الطالب يشوف تصحيح ورقته» مقفولة في محرر الاختبار.
        <% } else if (preview.answers_after_close && preview.is_open) { %>التصحيح مؤجّل لحد ما الاختبار يتقفل، والاختبار لسه مفتوح.
        <% } else { %>الورقة لسه بتتصحّح.<% } %>
      </p>
    <% } %>
    <% if (preview.score_hidden) { %>
      <p class="qz-preview-note">⚠️ الدرجة مخفية عن الطالب (خانة «الطالب يشوف درجته» مقفولة).</p>
    <% } %>
  </div>
<% } %>

  <div class="qz-card" id="qz-gate" <%= quiz.is_open ? '' : 'style="display:none"' %>>
    <div class="qz-field">
      <label for="qz-phone">رقم الموبايل
        <span class="qz-hint">اللي مسجّل بيه على منصة د. عبدالله حبشي — عشان الدرجة تتحسبلك إنت.</span>
      </label>
      <input class="qz-input" type="tel" inputmode="numeric" id="qz-phone" placeholder="01xxxxxxxxx" autocomplete="tel" />
    </div>

    <%# بيظهروا حسب رد السيرفر بس: قايمة الاختيار لما الرقم مسجّل لأكتر من طالب (إخوات على
        تليفون الأب)، وخانة الاسم لما الرقم مش على المنصة أصلًا %>
    <div class="qz-field" id="qz-pick-field" style="display:none">
      <label>الرقم ده مسجّل لأكتر من طالب — إنت مين فيهم؟</label>
      <div class="qz-pick-list" id="qz-pick-list"></div>
    </div>

    <div class="qz-field" id="qz-name-field" style="display:none">
      <label for="qz-name">اسمك بالكامل
        <span class="qz-hint">رقمك مش لاقينه على المنصة، فمحتاجين اسمك عشان نعرف الورقة بتاعت مين.</span>
      </label>
      <input class="qz-input" type="text" id="qz-name" autocomplete="name" />
    </div>

    <button class="qz-btn" id="qz-start-btn" type="button">ابدأ الاختبار</button>
    <div class="qz-error" id="qz-gate-error" style="display:none"></div>
  </div>

  <% if (!quiz.is_open) { %>
    <div class="qz-card" style="text-align:center">
      <h2 style="margin:0 0 6px">الاختبار ده اتقفل</h2>
      <p style="color:var(--qz-muted); margin:0">لو عندك سؤال، كلّم فريق الدعم على البوت.</p>
    </div>
  <% } %>

  <%# ===== الاختبار نفسه ===== %>
  <div id="qz-exam" style="display:none">
    <%# شريط واحد ثابت فوق طول الامتحان: الوقت، والتقدّم، والتنقّل بين الأسئلة.
        قبل كده كان المؤقت لوحده، ومكانش بيظهر أصلًا في الاختبار اللي من غير مدة —
        فالطالب اللي بيسكرول في ٢٥ سؤال مكانش قدامه أي حاجة ثابتة %>
    <div class="qz-bar" id="qz-bar">
      <div class="qz-bar-row">
        <span class="qz-timer-text" id="qz-timer" style="display:none">⏱️ <span class="qz-clock" id="qz-clock">--:--</span></span>
        <span class="qz-progress-text" id="qz-progress-text">٠ من ٠</span>
        <span class="qz-save-state" id="qz-save-state"></span>
      </div>
      <div class="qz-progress"><div class="qz-progress-fill" id="qz-progress-fill"></div></div>
      <%# مربعات الأسئلة: الضغط بينط للسؤال، واللون بيقول اتجاوب ولا لأ %>
      <div class="qz-nav" id="qz-nav"></div>
    </div>
    <div id="qz-questions"></div>
    <button class="qz-btn" id="qz-submit-btn" type="button">سلّم الإجابات</button>
    <div class="qz-error" id="qz-exam-error" style="display:none"></div>
    <p class="qz-foot">إجاباتك بتتحفظ لوحدها وإنت بتكتب — لو الصفحة قفلت، ارجع بنفس الرقم وكمّل.</p>
  </div>

  <%# ===== النتيجة ===== %>
  <div class="qz-card qz-result" id="qz-result" style="display:none">
    <h2 id="qz-result-title">تم استلام إجاباتك ✅</h2>
    <div class="qz-score" id="qz-result-score" style="display:none"></div>
    <p id="qz-result-note"></p>
    <%# زرار التظلم تحت الدرجة على طول: ده المكان اللي الطالب بيبص فيه أول ما يشوف
        نتيجته، ولو كان تحت الورقة كلها كان محتاج يلف ٤٥ سؤال عشان يلاقيه %>
    <div class="qz-result-actions">
      <%# **الورقة مخفية لحد ما الطالب يطلبها.** أول ما يشوف درجته بيبقى عايز يعرف
          الرقم، والورقة الكاملة تحتيها على طول بتخلي الشاشة حايطة أسئلة — فالزرار
          بيخليه يقرر يراجع امتى %>
      <div id="qz-review-cta" style="display:none">
        <button class="qz-btn" id="qz-review-toggle" type="button">عرض الأخطاء ونموذج الإجابة</button>
      </div>
      <%# **الشرح قبل الضغط مش بعده.** الطالب اللي بيدوّر على زرار تظلم جنب سؤال
          اختياري أو سؤال سابه فاضي ومش لاقيه بيفتكر إن فيه عطل. السطر ده بيقوله
          القاعدة من الأول، فالغياب يبقى مفهوم مش مفاجأة %>
      <div id="qz-appeal-cta" style="display:none">
        <p class="qz-appeal-scope">
          التظلم بيتقدّم على <b>سؤال مقالي حليته</b> وشايف إن تصحيحه غلط.<br>
          أسئلة الاختيار من متعدد والأسئلة اللي سبتها فاضية مالهاش تظلم.
        </p>
        <button class="qz-btn ghost" id="qz-appeal-open" type="button">أتظلم من درجتي</button>
      </div>
    </div>
    <%# الإعادة: بتظهر لما يكون فاضل محاولات والاختبار لسه مفتوح — السيرفر هو اللي
        بيقرر، والزرار بيعرض قراره %>
    <div id="qz-retry-box" style="display:none">
      <p class="qz-attempts-left" id="qz-attempts-left"></p>
      <button class="qz-btn ghost" id="qz-retry-btn" type="button">إعادة المحاولة</button>
    </div>
  </div>

  <%# ===== ورقة التصحيح =====
      بتيجي من السيرفر بعد التسليم والتصحيح بس — الأسئلة والإجابات الصح مش في الصفحة قبل
      كده، زي بوابة الدخول بالظبط. الطالب بيرجع بنفس الرابط ونفس الرقم في أي وقت ويلاقيها %>
  <div id="qz-review"></div>

  <%# ===== تقديم التظلّم =====
      تحت ورقة التصحيح عن قصد: الطالب بيقرا ورقته الأول وبعدين يقرر. المربع بيتفتح
      بزرار من على أي سؤال، وبيعلّم على السؤال اللي اتفتح منه %>
  <div class="qz-card qz-appeal" id="qz-appeal" style="display:none">
    <h2>تقديم تظلّم</h2>
    <p id="qz-appeal-intro"></p>
    <div class="qz-appeal-list" id="qz-appeal-list"></div>
    <label class="qz-appeal-note-label" for="qz-appeal-note">تحب تقول حاجة للمصحّح؟ (اختياري)</label>
    <textarea class="qz-textarea" id="qz-appeal-note" rows="3"
      placeholder="مثلًا: إجابتي نفس المعنى بس بصيغة تانية"></textarea>
    <div class="qz-appeal-actions">
      <button class="qz-btn" id="qz-appeal-submit" type="button">قدّم التظلم</button>
      <button class="qz-btn ghost" id="qz-appeal-cancel" type="button">إلغاء</button>
    </div>
    <div class="qz-error" id="qz-appeal-error" style="display:none"></div>
  </div>

</div>

<script>
  // بيانات المعاينة بتتحط من السيرفر. `null` في الصفحة العامة — القالب الواحد بيخدم
  // الاتنين، فأي تعديل على شكل الورقة بيوصل للمعاينة تلقائيًا ومفيش نسختين يفترقوا
  window.QZ_PREVIEW = <%- locals.preview ? JSON.stringify(locals.preview) : 'null' %>;
</script>
<script>
  (function () {
    var base = window.location.pathname.replace(/\/+$/, '');

    var state = { key: null, questions: [], deadline: null, timer: null, dirty: false, submitting: false };

    // **بيانات التظلم بتتخزّن وقت رسم الورقة.** `labels` بتربط رقم السؤال في القاعدة
    // بالرقم اللي الطالب شايفه («سؤال ٣» / «سؤال ٣ فرع ب») — المربع بيعرض اللي على
    // الشاشة، ورقم القاعدة مالوش أي معنى عند الطالب
    // `limit: null` معناه مفتوح — السيرفر بيبعت الرقم أو null، والصفحة بتتصرف على الأساس ده
    var appeals = { review: [], labels: {}, limit: 3, open: true };

    // حالة عرض ورقة التصحيح. `false` أول ما الصفحة تفتح — الطالب بيشوف درجته الأول
    // وبيقرر هو يراجع امتى. **معرّف هنا مش جنب `toggleReview`** لأن `renderReview`
    // بتقراه، و`var` بيتـhoist بقيمة undefined فالترتيب كان بيخليه يشتغل بالصدفة
    var reviewShown = false;

    function el(id) { return document.getElementById(id); }
    function esc(value) {
      return String(value === null || value === undefined ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function showError(box, message) {
      var node = el(box);
      node.textContent = message;
      node.style.display = message ? 'block' : 'none';
    }

    function post(path, body) {
      return fetch(base + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (response) {
        return response.json().catch(function () { return {}; }).then(function (data) {
          if (!response.ok) throw new Error(data.error || 'حصلت مشكلة، جرّب تاني');
          return data;
        });
      });
    }

    // ---------- الدخول ----------
    var pickedStudentId = null;

    el('qz-start-btn').addEventListener('click', function () {
      var button = el('qz-start-btn');
      showError('qz-gate-error', '');
      button.disabled = true;
      button.textContent = 'بنجهّز الاختبار...';

      post('/start', {
        phone: el('qz-phone').value,
        student_id: pickedStudentId,
        name: el('qz-name').value,
      }).then(function (data) {
        // الرقم مسجّل لأكتر من طالب: بنعرض الأسامي والطالب يختار، وبعدها بيدوس ابدأ تاني
        if (data.needs_pick) {
          el('qz-pick-field').style.display = '';
          el('qz-pick-list').innerHTML = data.students.map(function (student) {
            return '<label class="qz-option"><input type="radio" name="qz-pick" value="' + student.id + '" />'
              + '<span>' + esc(student.name) + '</span></label>';
          }).join('');
          bindPick();
          throw new Error('اختار اسمك من القايمة وبعدين ابدأ');
        }
        if (data.needs_name) {
          el('qz-name-field').style.display = '';
          el('qz-name').focus();
          throw new Error('اكتب اسمك بالكامل وبعدين ابدأ');
        }
        if (data.state === 'submitted') return renderResult(data);
        // رجع بنفس الرقم والتصحيح لسه في الطابور: شاشة الانتظار والسؤال عن الدرجة —
        // من غير ده كان بيتفتحله امتحان فاضي (questions بترجع [] بعد التسليم)
        if (data.state === 'grading') {
          state.key = data.attempt_key;
          renderResult(data);
          return pollResult();
        }
        startExam(data);
      }).catch(function (error) {
        showError('qz-gate-error', error.message);
      }).finally(function () {
        button.disabled = false;
        button.textContent = 'ابدأ الاختبار';
      });
    });

    function bindPick() {
      Array.prototype.forEach.call(document.querySelectorAll('input[name="qz-pick"]'), function (input) {
        input.addEventListener('change', function () {
          pickedStudentId = Number(input.value);
          Array.prototype.forEach.call(document.querySelectorAll('#qz-pick-list .qz-option'), function (option) {
            option.classList.remove('picked');
          });
          input.closest('.qz-option').classList.add('picked');
        });
      });
    }

    // ---------- الأسئلة ----------
    // السؤال ممكن يكون صورة من غير نص (رسم بياني، معادلة) — فالصورة عنصر مستقل مش زينة
    function questionImage(question) {
      if (!question.image) return '';
      return '<img class="qz-q-image" src="' + esc(question.image) + '" alt="" loading="lazy" />';
    }

    // الاختيار ممكن يكون نص أو صورة أو الاتنين
    function answerField(question) {
      if (question.kind !== 'mcq') {
        // **كتابة أو صورة، مش الاتنين.** الطالب بيحل على ورق في الكيمياء (معادلات
        // ورسومات مالهاش طريقة تتكتب في textarea)، والاختيار بينهم بيبان في الشاشة:
        // أول ما يرفع صورة الكتابة بتتخفي، وأول ما يشيلها بترجع
        return '<div class="qz-essay-answer" data-answer="' + question.id + '">'
          + '<textarea class="qz-textarea" data-q="' + question.id + '" placeholder="اكتب إجابتك هنا..."></textarea>'
          + '<div class="qz-essay-alt" data-alt="' + question.id + '">'
          + '<span class="qz-essay-or">أو</span>'
          + '<label class="qz-upload-btn">📷 صوّر إجابتك من الورقة'
          + '<input type="file" accept="image/jpeg,image/png" capture="environment" data-img="'
          + question.id + '" style="display:none" /></label>'
          + '</div>'
          + '<div class="qz-essay-image" data-preview="' + question.id + '" style="display:none">'
          + '<img alt="إجابتك المصوّرة" />'
          + '<div class="qz-essay-image-actions">'
          + '<span class="qz-essay-image-state"></span>'
          + '<button type="button" class="qz-btn ghost" data-remove-img="' + question.id + '">شيل الصورة وارجع اكتب</button>'
          + '</div></div>'
          + '</div>';
      }
      // **القيمة رقم الاختيار الأصلي مش مكانه في القايمة.** الترتيب ممكن يكون متخلط،
      // والرقم اللي بيتبعت للسيرفر لازم يفضل معناه واحد قبل الخلط وبعده
      return question.options.map(function (option) {
        return '<label class="qz-option" data-q="' + question.id + '">'
          + '<input type="radio" name="q' + question.id + '" value="' + option.index + '" />'
          + '<span>' + (option.text ? esc(option.text) : '')
          + (option.image ? '<img class="qz-option-image" src="' + esc(option.image) + '" alt="" loading="lazy" />' : '')
          + '</span></label>';
      }).join('');
    }

    // بتفرد الشجرة: الأب مالوش إجابة، فاللي بيتجمع وبيترجع هو الفروع والأسئلة العادية بس
    function answerableQuestions() {
      var flat = [];
      state.questions.forEach(function (question) {
        if (question.kind === 'group') flat = flat.concat(question.parts || []);
        else flat.push(question);
      });
      return flat;
    }

    function startExam(data) {
      state.key = data.attempt_key;
      state.questions = data.questions || [];
      state.deadline = data.deadline_at ? new Date(data.deadline_at).getTime() : null;

      el('qz-gate').style.display = 'none';
      el('qz-exam').style.display = '';

      el('qz-questions').innerHTML = state.questions.map(function (question, index) {
        var header = '<div class="qz-q-head">'
          + '<span class="qz-q-num">سؤال ' + (index + 1) + ' من ' + state.questions.length + '</span>'
          + (question.kind === 'group' ? '' : '<span class="qz-q-points">' + question.points + ' درجة</span>')
          + '</div>'
          + (question.text ? '<div class="qz-q-text">' + esc(question.text) + '</div>' : '')
          + questionImage(question);

        // رأس وتحته فروع: الرأس عنوان من غير خانة إجابة، وكل فرع جواه خانته ودرجته
        if (question.kind === 'group') {
          return '<div class="qz-card">' + header
            + question.parts.map(function (part) {
              return '<div class="qz-part" id="qz-anchor-' + part.id + '">'
                + '<div class="qz-part-head">'
                + '<span class="qz-part-label">' + esc(part.label || '') + '</span>'
                + '<span class="qz-q-points">' + part.points + ' درجة</span></div>'
                + (part.text ? '<div class="qz-part-text">' + esc(part.text) + '</div>' : '')
                + questionImage(part)
                + answerField(part)
                + '</div>';
            }).join('')
            + '</div>';
        }
        return '<div class="qz-card" id="qz-anchor-' + question.id + '">'
          + header + answerField(question) + '</div>';
      }).join('');

      buildNav();
      restoreSaved(data.saved || {});
      bindAnswerInputs();
      updateProgress();
      if (state.deadline) startTimer();
    }

    // ---------- التنقّل والتقدّم ----------
    //
    // **الترقيم في المربعات هو نفسه اللي مكتوب على السؤال.** الرأس بياخد رقم وفروعه
    // بتاخد رقمه مع حرفها (٣أ، ٣ب)، عشان الطالب اللي بيدوس مربع يلاقي نفسه عند السؤال
    // اللي شايف رقمه، مش عند سؤال تاني
    function navItems() {
      var items = [];
      state.questions.forEach(function (question, index) {
        if (question.kind === 'group') {
          (question.parts || []).forEach(function (part) {
            items.push({ id: part.id, label: (index + 1) + esc(part.label || '') });
          });
        } else {
          items.push({ id: question.id, label: String(index + 1) });
        }
      });
      return items;
    }

    function buildNav() {
      var items = navItems();
      // سؤال واحد؟ التنقّل مالوش لازمة وبياخد مساحة من غير فايدة
      el('qz-nav').innerHTML = items.length < 2 ? '' : items.map(function (item) {
        return '<button type="button" class="qz-nav-item" data-goto="' + item.id + '">'
          + item.label + '</button>';
      }).join('');
      el('qz-nav').addEventListener('click', function (event) {
        var button = event.target.closest('[data-goto]');
        if (!button) return;
        var id = button.getAttribute('data-goto');
        markActiveQuestion(id);
        var anchor = document.getElementById('qz-anchor-' + id);
        if (anchor) anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // الوقوف في خانة إجابة بيعلّم مربعها كمان — الطالب اللي بيكتب في سؤال ١٢ عايز
      // يشوف إنه في ١٢، مش يفضل المربع الأول متعلّم من أول الامتحان
      el('qz-questions').addEventListener('focusin', function (event) {
        var anchor = event.target.closest('[id^="qz-anchor-"]');
        if (anchor) markActiveQuestion(anchor.id.replace('qz-anchor-', ''));
      });

      trackBarHeight();
    }

    // المربعات بتنزل سطور، فطول الشريط اللاصق بيتغيّر مع عدد الأسئلة وعرض الشاشة (ولف
    // الموبايل بالعرض بيقلّل السطور). النط لسؤال بيقف تحت الشريط بالطول ده بالظبط —
    // من غيره السؤال اللي الطالب داس رقمه بيقف ورا الشريط ومايبانش
    function trackBarHeight() {
      var bar = el('qz-bar');
      var sync = function () {
        if (bar.offsetHeight) document.documentElement.style.setProperty('--qz-bar-h', bar.offsetHeight + 'px');
      };
      sync();
      if (window.ResizeObserver) new ResizeObserver(sync).observe(bar);
      else window.addEventListener('resize', sync);
    }

    // المربع المتعلّم = السؤال اللي الطالب واقف عنده دلوقتي. **منفصل عن الأخضر**
    // (اللي معناه "اتجاوب") — الاتنين ممكن يجتمعوا على نفس المربع
    function markActiveQuestion(id) {
      Array.prototype.forEach.call(document.querySelectorAll('.qz-nav-item'), function (button) {
        button.classList.toggle('active', button.getAttribute('data-goto') === String(id));
      });
    }

    // السؤال "متجاوب" بنفس تعريف تحذير التسليم بالظبط: اختيار متحدد أو نص مش فاضي.
    // تعريفين مختلفين معناهم إن الشريط يقول ٢٥ من ٢٥ والتسليم يقول فيه ٣ فاضيين
    function answeredIds() {
      var done = [];
      answerableQuestions().forEach(function (question) {
        if (question.kind === 'mcq') {
          if (document.querySelector('input[name="q' + question.id + '"]:checked')) done.push(question.id);
          return;
        }
        var textarea = document.querySelector('textarea[data-q="' + question.id + '"]');
        // **الصورة إجابة زي الكتابة بالظبط.** من غير السطر ده الطالب اللي صوّر كل
        // إجاباته بيشوف «٠ من ١٥» وشريط تقدّم فاضي، ويفتكر إن مفيش حاجة اتحفظت
        var preview = document.querySelector('[data-preview="' + question.id + '"]');
        var hasImage = preview && preview.style.display !== 'none' && preview.querySelector('img').getAttribute('src');
        if ((textarea && textarea.value.trim()) || hasImage) done.push(question.id);
      });
      return done;
    }

    function updateProgress() {
      var total = answerableQuestions().length;
      var done = answeredIds();
      var map = {};
      done.forEach(function (id) { map[id] = true; });
      el('qz-progress-text').textContent = done.length + ' من ' + total;
      el('qz-progress-fill').style.width = total ? (done.length / total) * 100 + '%' : '0%';
      Array.prototype.forEach.call(document.querySelectorAll('.qz-nav-item'), function (button) {
        button.classList.toggle('answered', Boolean(map[button.getAttribute('data-goto')]));
      });
    }

    // استكمال محاولة مفتوحة: الإجابات المحفوظة بترجع في مكانها زي ما سابها بالظبط
    function restoreSaved(saved) {
      Object.keys(saved).forEach(function (questionId) {
        var answer = saved[questionId];
        if (answer.selected_option !== null && answer.selected_option !== undefined) {
          var radio = document.querySelector('input[name="q' + questionId + '"][value="' + answer.selected_option + '"]');
          if (radio) { radio.checked = true; radio.closest('.qz-option').classList.add('picked'); }
        }
        if (answer.essay_text) {
          var textarea = document.querySelector('textarea[data-q="' + questionId + '"]');
          if (textarea) textarea.value = answer.essay_text;
        }
        // الصورة المرفوعة قبل كده بترجع مكانها، والكتابة بتفضل مخفية زي ما سابها
        if (answer.answer_image) {
          showEssayImage(Number(questionId), answer.answer_image, 'محفوظة');
        }
      });
    }

    function bindAnswerInputs() {
      Array.prototype.forEach.call(document.querySelectorAll('#qz-questions input[type="radio"]'), function (input) {
        input.addEventListener('change', function () {
          Array.prototype.forEach.call(document.querySelectorAll('input[name="' + input.name + '"]'), function (sibling) {
            sibling.closest('.qz-option').classList.remove('picked');
          });
          input.closest('.qz-option').classList.add('picked');
          state.dirty = true;
          updateProgress();
        });
      });
      Array.prototype.forEach.call(document.querySelectorAll('#qz-questions textarea'), function (textarea) {
        textarea.addEventListener('input', function () { state.dirty = true; updateProgress(); });
        // الخروج من الخانة أوضح لحظة للحفظ: الطالب خلص السؤال ده وبيروح للي بعده
        textarea.addEventListener('blur', function () { saveProgress(); });
      });
      // رفع الصورة وشيلها. التفويض على الحاوية لأن الأسئلة بتتولّد
      var questionsBox = el('qz-questions');
      questionsBox.addEventListener('change', function (event) {
        var input = event.target.closest('[data-img]');
        if (!input || !input.files || !input.files[0]) return;
        var questionId = Number(input.getAttribute('data-img'));
        uploadEssayImage(questionId, input.files[0]);
        // بيتفضّى عشان الطالب يقدر يرفع نفس الملف تاني لو المحاولة الأولى فشلت
        input.value = '';
      });
      questionsBox.addEventListener('click', function (event) {
        var button = event.target.closest('[data-remove-img]');
        if (button) removeEssayImage(Number(button.getAttribute('data-remove-img')));
      });

      // **٤٥ ثانية مش ١٥.** الحفظ عند الخروج من كل خانة شغّال برضه، فده شبكة أمان
      // للطالب اللي قاعد في نفس السؤال بيكتب. ١٥ ثانية × آلاف الطلاب = تلات أضعاف
      // الحِمل على السيرفر مقابل ٣٠ ثانية كتابة إضافية في أسوأ حالة
      setInterval(saveProgress, 45000);
    }

    function collectAnswers() {
      return answerableQuestions().map(function (question) {
        if (question.kind === 'mcq') {
          var picked = document.querySelector('input[name="q' + question.id + '"]:checked');
          return { question_id: question.id, selected_option: picked ? Number(picked.value) : null };
        }
        var textarea = document.querySelector('textarea[data-q="' + question.id + '"]');
        return { question_id: question.id, essay_text: textarea ? textarea.value : '' };
      });
    }

    // الحفظ التلقائي بيفشل بصمت عن قصد: رسالة خطأ كل ١٥ ثانية على نت متقطع بتوتّر الطالب
    // من غير فايدة — التسليم نفسه هو اللي بيتكلم لو فشل
    function saveProgress() {
      if (!state.key || !state.dirty || state.submitting) return;
      state.dirty = false;
      el('qz-save-state').textContent = 'بيتحفظ...';
      post('/save', { attempt_key: state.key, answers: collectAnswers() })
        .then(function () { el('qz-save-state').textContent = 'اتحفظ ✓'; })
        .catch(function () { el('qz-save-state').textContent = ''; state.dirty = true; });
    }

    // ---------- المؤقت ----------
    function startTimer() {
      el('qz-timer').style.display = '';
      tick();
      state.timer = setInterval(tick, 1000);
    }

    function tick() {
      var remaining = Math.max(0, Math.floor((state.deadline - Date.now()) / 1000));
      var minutes = String(Math.floor(remaining / 60)).padStart(2, '0');
      var seconds = String(remaining % 60).padStart(2, '0');
      el('qz-clock').textContent = minutes + ':' + seconds;
      // **التحذير بيتلوّن على الشريط مش على النص.** العنصر بقى جوه qz-bar، وكتابة
      // className عليه كانت بتمسح كلاسه الأصلي وتلوّن حاجة مالهاش قواعد — تلوين ساكت
      // مش هيبان غير لما الوقت يقرب يخلص، وساعتها الطالب هو اللي بيدفع التمن
      var bar = el('qz-bar');
      bar.classList.toggle('danger', remaining <= 60);
      bar.classList.toggle('warn', remaining > 60 && remaining <= 300);
      if (remaining === 0) {
        clearInterval(state.timer);
        submit(true);
      }
    }

    // ---------- التسليم ----------
    el('qz-submit-btn').addEventListener('click', function () {
      var unanswered = collectAnswers().filter(function (answer) {
        return answer.selected_option === null && !String(answer.essay_text || '').trim();
      }).length;
      // العدد بيتقال بالفروع مش بالرؤوس — الطالب بيشوف "فيه ٣ من غير إجابة" ويلاقيهم فعلًا
      if (unanswered && !window.confirm('فيه ' + unanswered + ' سؤال من غير إجابة. تسلّم برضه؟')) return;
      submit(false);
    });

    function submit(automatic) {
      if (state.submitting) return;
      state.submitting = true;
      if (state.timer) clearInterval(state.timer);
      var button = el('qz-submit-btn');
      button.disabled = true;
      button.textContent = automatic ? 'الوقت خلص — بنسلّم إجاباتك...' : 'بنصحّح إجاباتك...';
      showError('qz-exam-error', '');

      post('/submit', { attempt_key: state.key, answers: collectAnswers() })
        .then(function (data) {
          el('qz-exam').style.display = 'none';
          el('qz-timer').style.display = 'none';
          renderResult(data);
          // التصحيح بقى في طابور على السيرفر: الإجابات اتسجّلت خلاص، والدرجة بتيجي بعدها
          if (data.state === 'grading') pollResult();
        })
        .catch(function (error) {
          state.submitting = false;
          button.disabled = false;
          button.textContent = 'سلّم الإجابات';
          showError('qz-exam-error', error.message + ' — إجاباتك متحفوظة، جرّب تسلّم تاني.');
        });
    }

    // ---------- السؤال عن الدرجة ----------
    //
    // **التباعد بيكبر مع كل محاولة بدل ما يفضل ثابت.** كل ٤ ثواني لمدة دقيقتين = ٣٠
    // نداء لكل طالب. امتحان بعشرين ألف طالب بيسلّموا في نص ساعة معناه آلاف النداءات في
    // الثانية على عملية Node واحدة — والاستعلام نفسه سريع، لكن عدد الطلبات هو المشكلة.
    //
    // بالتباعد المتزايد (٢ ثانية وبعدين ٣ و٤.٥...) الطالب اللي السيرفر فاضي قدامه بياخد
    // درجته أسرع من الأول، واللي مستني بيسأل ٩ مرات بدل ٣٠ — ٧٠٪ أقل حمل في أسوأ لحظة.
    //
    // **وبتوقف بعد دقيقة ونص مش بتفضل تلف.** الطالب وقتها بياخد رسالة إن إجاباته
    // اتسجّلت، والدرجة بتوصله على تيليجرام لو حسابه مربوط، وأي إعادة فتح للرابط بنفس
    // الرقم بتوريه الدرجة أول ما تجهز
    var POLL_START_MS = 2000;
    var POLL_GROWTH = 1.5;
    var POLL_MAX_MS = 15000;
    var POLL_FOR_MS = 90000;

    function pollResult() {
      var startedAt = Date.now();
      var wait = POLL_START_MS;
      var timer = null;

      function stop(message) {
        clearTimeout(timer);
        if (message) el('qz-result-note').textContent = message;
      }

      function ask() {
        if (Date.now() - startedAt > POLL_FOR_MS) {
          return stop('إجاباتك اتسجّلت ✅ الدرجة بتتحسب دلوقتي — هتوصلك على تيليجرام لو حسابك مربوط، أو افتح الرابط تاني بنفس رقمك.');
        }
        fetch(base + '/result?attempt_key=' + encodeURIComponent(state.key))
          .then(function (response) { return response.json(); })
          .then(function (data) {
            if (data.state !== 'submitted') return schedule();
            stop();
            renderResult(data);
          })
          .catch(function () { schedule(); });
      }

      function schedule() {
        wait = Math.min(wait * POLL_GROWTH, POLL_MAX_MS);
        timer = setTimeout(ask, wait);
      }

      timer = setTimeout(ask, wait);
    }

    function renderResult(data) {
      // **المفتاح بيتحط هنا مش في كل مسار لوحده.** كان متحطوط في `startExam` وفي فرع
      // `grading` بس، والفرع التالت — الطالب بيرجع بالرابط على ورقة مسلّمة — كان بينساه.
      // النتيجة إن أكتر حالة بتحصل (الطالب بيفتح لينكه بعد التصحيح) كانت بتطلّع
      // "المحاولة مش موجودة" عند أي تظلم، لأن الطلب بيروح من غير مفتاح.
      // كل المسارات بتعدّي من هنا، فمكانه الصح هو ده
      if (data.attempt_key) state.key = data.attempt_key;
      appeals.limit = data.appeal_limit || null;
      if (data.appeals_open !== undefined) appeals.open = data.appeals_open !== false;
      el('qz-gate').style.display = 'none';
      el('qz-exam').style.display = 'none';
      el('qz-result').style.display = '';
      if (data.state === 'grading') {
        el('qz-result-title').textContent = 'تم استلام إجاباتك ✅';
        el('qz-result-score').style.display = 'none';
        el('qz-result-note').textContent = 'بنصحّح إجاباتك دلوقتي... الدرجة هتظهر هنا خلال لحظات.';
        el('qz-review').innerHTML = '';
        return;
      }
      if (data.score !== null && data.score !== undefined) {
        el('qz-result-score').style.display = '';
        el('qz-result-score').innerHTML = Math.round(data.score * 100) / 100
          + '<small> / ' + data.max_score + '</small>';
        // **الدرجة لوحدها من غير كلام.** «الدرجة دي مبدئية — الفريق بيراجع» كانت
        // بتخلّي كل طالب يستنى تغيير مش جاي، والتظلم بقى هو الطريق الواضح للي شايف
        // إن فيه غلط — فالجملة اتشالت والزرار مكانها
        el('qz-result-note').textContent = '';
      } else {
        el('qz-result-note').textContent = data.score_hidden
          ? 'الدرجة هتتعلن من الفريق.'
          : 'إجاباتك وصلت والفريق بيصحّحها.';
      }
      renderReview(data.review);
      renderRetry(data);
      renderAppealCta();
    }

    // **المتبقي بيتقال في الحالتين.** الطالب اللي فاضله محاولة محتاج يعرف قبل ما يدوس،
    // واللي خلصت محاولاته محتاج يعرف ليه مفيش زرار — السكوت بيخليه يفضل يفتح الرابط
    function renderRetry(data) {
      var box = el('qz-retry-box');
      var allowed = Number(data.max_attempts) || 1;
      if (allowed < 2) { box.style.display = 'none'; return; }
      box.style.display = '';
      var left = Number(data.attempts_left) || 0;
      el('qz-attempts-left').textContent = left
        ? 'فاضلك ' + left + ' محاولة من ' + allowed
        : 'خلّصت محاولاتك (' + allowed + ' من ' + allowed + ').';
      el('qz-retry-btn').style.display = data.can_retry ? '' : 'none';
    }

    // الإعادة بتعدّي على نفس مسار الدخول بعلم retry: الهوية بتتحدد بنفس الطريقة
    // بالظبط (رقم، واختيار بين إخوات، واسم لو مش على المنصة) — مسار تاني كان معناه
    // تكرار كل ده واحتمال يفترقوا
    el('qz-retry-btn').addEventListener('click', function () {
      var button = el('qz-retry-btn');
      button.disabled = true;
      button.textContent = 'بنجهّز المحاولة...';
      post('/start', {
        phone: el('qz-phone').value,
        student_id: pickedStudentId,
        name: el('qz-name').value,
        retry: true,
      }).then(function (data) {
        if (data.state !== 'open') { renderResult(data); return; }
        el('qz-result').style.display = 'none';
        el('qz-review').innerHTML = '';
        startExam(data);
      }).catch(function (error) {
        showError('qz-gate-error', error.message);
        el('qz-gate').style.display = '';
      }).finally(function () {
        button.disabled = false;
        button.textContent = 'إعادة المحاولة';
      });
    });

    // ---------- ورقة التصحيح ----------
    //
    // **الحكم على السؤال بيتحسب من الدرجة اللي اتحطّت، مش من حكم النموذج.** لو موظف عدّل
    // الدرجة بإيده، حكم النموذج القديم بيفضل مكتوب في القاعدة — والطالب اللي بيشوف "غلط"
    // فوق درجة كاملة بيفتح تذكرة. الدرجة هي اللي بتتجمع في المجموع، فهي مصدر الحقيقة
    function verdictOf(answer) {
      // سؤال اتضاف للاختبار بعد ما الطالب سلّم: مافيش صف إجابة، ومش داخل في مجموعه.
      // عرضه "غلط" ظلم، وعرضه "مستني" كدب — فبيتقال زي ما هو
      if (!answer.answered) return { key: 'pending', icon: '—', label: 'السؤال ده مالوش تصحيح في ورقتك' };
      if (answer.awarded_points === null || answer.awarded_points === undefined) {
        return { key: 'pending', icon: '🕓', label: 'مستني مراجعة الفريق' };
      }
      if (answer.awarded_points >= answer.points) return { key: 'correct', icon: '✅', label: 'إجابة صح' };
      if (answer.awarded_points > 0) return { key: 'partial', icon: '🟡', label: 'إجابة ناقصة' };
      return { key: 'wrong', icon: '❌', label: 'إجابة غلط' };
    }

    // كل سطر في الورقة جملة موجّهة للطالب — الهدف إنه يقرا ورقته كأن حد بيراجعها معاه،
    // مش يفك جدول فيه "إجابتك" و"الإجابة المرجعية". نفس المعلومة بالظبط، صيغة مختلفة
    function say(text, kind) {
      return '<p class="qz-rv-say' + (kind ? ' ' + kind : '') + '">' + text + '</p>';
    }

    // جملة الحكم فوق كل سؤال. الدرجة نفسها في الشارة جنبها، فالجملة بتقول المعنى بس
    function verdictLine(answer, verdict) {
      if (verdict.key === 'pending') {
        return answer.answered
          ? 'الفريق لسه بيراجع السؤال ده — الدرجة ممكن تتغيّر.'
          : 'السؤال ده مالوش تصحيح في ورقتك.';
      }
      if (verdict.key === 'correct') return 'إجابتك صح ✅';
      if (verdict.key === 'partial') return 'إجابتك ناقصة شوية 🟡';
      return 'إجابتك مش صح ❌';
    }

    function reviewMark(answer, verdict) {
      var points = answer.awarded_points === null || answer.awarded_points === undefined
        ? '—' : Math.round(answer.awarded_points * 100) / 100;
      return '<span class="qz-rv-mark ' + verdict.key + '" title="' + esc(verdict.label) + '">'
        + verdict.icon + ' ' + points + ' / ' + answer.points + '</span>';
    }

    // الاختيار ممكن يكون صورة من غير نص، وساعتها مافيش اسم نقوله في الجملة — الصورة
    // نفسها بتتعرض تحت السطر
    function optionName(option) {
      return option && option.text ? '«' + esc(option.text) + '»' : 'الاختيار ده';
    }

    function optionPicture(option) {
      return option && option.image
        ? '<img class="qz-option-image" src="' + esc(option.image) + '" alt="" loading="lazy" />' : '';
    }

    // الاختياري: بدل ما نرصّ الاختيارات الأربعة ونحطّ علامات، بنقوله هو اختار إيه والصح
    // إيه في جملتين. السؤال اللي جاوبه صح بياخد جملة واحدة — مافيش لازمة "والصح كان"
    // لما يكون هو نفسه اللي اختاره
    function reviewOptions(answer) {
      var picked = answer.selected_option === null || answer.selected_option === undefined
        ? null : answer.options[answer.selected_option];
      var right = answer.correct_option === null || answer.correct_option === undefined
        ? null : answer.options[answer.correct_option];
      var gotIt = picked && right && Number(answer.correct_option) === Number(answer.selected_option);

      var body = '';
      if (!picked) body += say('إنت ماخترتش إجابة للسؤال ده.');
      else if (gotIt) body += say('إنت اخترت ' + optionName(picked) + ' وده الصح.') + optionPicture(picked);
      else body += say('إنت اخترت ' + optionName(picked) + '.') + optionPicture(picked);

      if (right && !gotIt) body += say('والصح ' + optionName(right) + '.', 'right') + optionPicture(right);
      return body;
    }

    // المقالي: كلامه هو، وبعده الصح. الطالب محتاج يقارن بنفسه — الدرجة لوحدها
    // مابتعلّمهوش حاجة
    function reviewEssay(answer, verdict) {
      // الإجابة المصوّرة بتتعرض زي ما هي — الطالب لازم يشوف اللي المصحّح شافه بالظبط
      var body = answer.answer_image
        ? say('إجابتك اللي صوّرتها:')
          + '<img class="qz-rv-answer-image" src="' + esc(answer.answer_image) + '" alt="إجابتك المصوّرة" />'
        : answer.essay_text
          ? say('إنت كتبت:') + '<div class="qz-rv-text">' + esc(answer.essay_text) + '</div>'
          : say('إنت سيبت السؤال ده فاضي.');
      if (answer.reference_answer) {
        // اللي جاوب صح بياخدها كـ"إجابة نموذجية" مش "الصح" — هو أصلًا كان صح، والعنوان
        // اللي بيقول "الصح" فوق إجابة اتحسبت كاملة بيلخبطه
        body += say(verdict.key === 'correct' ? 'والإجابة النموذجية:' : 'والصح:', 'right')
          + '<div class="qz-rv-text model">' + esc(answer.reference_answer) + '</div>';
      }
      return body;
    }

    function reviewBody(answer, verdict) {
      var body = say(verdictLine(answer, verdict), 'verdict ' + verdict.key)
        + (answer.kind === 'mcq' ? reviewOptions(answer) : reviewEssay(answer, verdict));
      // كلام المصحّح الآلي بييجي للمقالي بس، ومكتوب بصيغة المخاطب من النموذج نفسه.
      // الموظف اللي عدّل الدرجة بإيده بيوصل كلامه فاضي من السيرفر عن قصد — الكلام
      // القديم بيناقض الدرجة الجديدة
      if (answer.reason) {
        body += '<div class="qz-rv-reason">' + esc(answer.reason) + '</div>';
      }
      body += appealControl(answer);
      return body;
    }

    // **الزرار بيبان على السؤال الناقص بس.** السؤال اللي خد الدرجة كاملة مفيهوش حاجة
    // يتظلم منها، والزرار عليه بيخلي الطالب يفتكر إن فيه مشكلة
    // **المتظلَّم منه لسه في القايمة.** الطالب بيعدّل تظلمه — يشيل سؤال ويحط غيره —
    // طول ما الموظف ماحسمهوش. المحسوم (`resolved`) بيخرج: الموظف بص وحكم، والحكم
    // مابيتسحبش بإعادة تظلم
    // **نفس شرط السيرفر بالحرف** (`APPEALABLE_SQL` في quizPublic.controller.js).
    // المقالي بس: الاختيار من متعدد بيتصحّح بمقارنة رقم، مفيش فيه اجتهاد يتظلم منه.
    // لو الاتنين افترقوا، الطالب بيشوف زرار بيترفض أو مايشوفش زرار هو مستحقه
    function canAppeal(answer) {
      // **`answered` مش كفاية:** معناها إن فيه صف في القاعدة، والصف بيتعمل لكل سؤال
      // وقت التسليم حتى لو الطالب سابه فاضي. `has_answer` هي اللي بتقول إنه كتب فعلًا
      return answer.kind === 'essay'
        && answer.has_answer
        && answer.awarded_points !== null && answer.awarded_points !== undefined
        && answer.awarded_points < answer.points
        && answer.appeal !== 'resolved';
    }

    function appealControl(answer) {
      // **في معاينة الأدمن مفيش أزرار تظلم.** الأدمن مش بيتظلم، والأهم إن `base` في
      // المعاينة بيبقى `/quiz-preview/:id` فالتقديم كان هيروح لمسار مش موجود ويرجع
      // ٤٠٤ مبهم. الحالة بتفضل ظاهرة (⏳ / ✔️) عشان يشوف اللي الطالب شايفه
      if (window.QZ_PREVIEW && !answer.appeal) return '';
      // مقفول: الزرار بيختفي، بس الحالة بتفضل ظاهرة للطالب اللي اتظلم قبل القفل
      if (!appeals.open && !answer.appeal) return '';
      if (answer.appeal === 'open') {
        return '<div class="qz-appeal-mark">⏳ تظلمت من السؤال ده — الفريق هيراجعه</div>'
          + '<button class="qz-btn ghost qz-appeal-btn" type="button" data-appeal="'
          + answer.question_id + '">عدّل تظلمك</button>';
      }
      if (answer.appeal === 'resolved') {
        // **رد الموظف بيتعرض للطالب.** «اتراجع» لوحدها كانت بتسيبه يقارن رقمين
        // ويخمّن؛ والرفض من غير سبب كان بيرجع تاني في صورة سؤال للدعم
        var head = answer.appeal_decision === 'accepted'
          ? '✅ تظلمك اتقبل — الدرجة اتعدّلت'
          : answer.appeal_decision === 'rejected'
            ? '✖️ تظلمك اتراجع والتصحيح سليم'
            : '✔️ تظلمك على السؤال ده اتراجع';
        var note = answer.appeal_staff_note
          ? '<div class="qz-appeal-reply">' + esc(answer.appeal_staff_note) + '</div>'
          : '';
        return '<div class="qz-appeal-mark done">' + head + '</div>' + note;
      }
      if (!canAppeal(answer)) return '';
      return '<button class="qz-btn ghost qz-appeal-btn" type="button" data-appeal="'
        + answer.question_id + '">أتظلم من السؤال ده</button>';
    }

    // الشجرة زي شاشة الحل بالظبط: الأب كارت واحد وفروعه جواه. الفرق إن كل فرع بيتلوّن
    // بحكمه هو — الفروع بتتصحّح كل واحد لوحده
    function renderReview(review) {
      var box = el('qz-review');
      var cta = el('qz-review-cta');
      if (!review || !review.length) {
        box.innerHTML = '';
        box.style.display = 'none';
        if (cta) cta.style.display = 'none';
        el('qz-appeal').style.display = 'none';
        return;
      }
      // **الورقة بتتبني كاملة بس بتفضل مخفية.** البناء مرة واحدة أسهل من إننا نأجّله
      // لحد الضغطة، والإخفاء بـdisplay مش بحذف المحتوى عشان الزرار يوري ويخفي من غير
      // ما يعيد أي شغل — والتظلم اللي جوه الورقة يفضل شغّال
      if (cta) cta.style.display = '';

      appeals.review = review;
      appeals.labels = {};

      var number = 0;
      var open = false;
      // **دليل الألوان جوه كارت المقدمة.** الألوان على الأسئلة موجودة من الأول، بس
      // من غير الدليل الطالب بيخمّن معناها — والأصفر تحديدًا مابيقولش لوحده إنه
      // "صح جزئي" مش "فيه مشكلة". نفس الأربع حالات وبنفس الترتيب في شاشة الأدمن
      var html = '<div class="qz-card qz-rv-head"><h2>يلا نراجع ورقتك مع بعض</h2>'
        + '<p>هنعدّي على كل سؤال: إنت قلت إيه، وإيه الصح، وليه. الأسئلة المقالية ممكن الفريق يراجعها ويعدّل درجتها.</p>'
        + '<div class="qz-legend">'
        + '<span class="qz-legend-item correct">صح كامل</span>'
        + '<span class="qz-legend-item partial">صح جزئي</span>'
        + '<span class="qz-legend-item wrong">غلط</span>'
        + '<span class="qz-legend-item pending">مستني مراجعة الفريق</span>'
        + '</div></div>';

      review.forEach(function (answer) {
        if (answer.kind === 'group') {
          if (open) html += '</div>';
          number += 1;
          html += '<div class="qz-card qz-rv-q">'
            + '<div class="qz-q-head"><span class="qz-q-num">سؤال ' + number + '</span></div>'
            + (answer.text ? '<div class="qz-q-text">' + esc(answer.text) + '</div>' : '')
            + questionImage(answer);
          open = true;
          return;
        }
        var verdict = verdictOf(answer);
        // الفرع بياخد رقم أبوه + حرفه، والسؤال العادي بياخد رقمه. بيتسجّل قبل الرسم
        // عشان المربع يلاقيه جاهز
        appeals.labels[answer.question_id] = answer.is_part
          ? 'سؤال ' + number + ' فرع ' + (answer.label || '')
          : 'سؤال ' + (number + 1);
        if (answer.is_part) {
          html += '<div class="qz-part qz-rv-part ' + verdict.key + '">'
            + '<div class="qz-part-head"><span class="qz-part-label">' + esc(answer.label || '') + '</span>'
            + reviewMark(answer, verdict) + '</div>'
            + (answer.text ? '<div class="qz-part-text">' + esc(answer.text) + '</div>' : '')
            + questionImage(answer) + reviewBody(answer, verdict) + '</div>';
          return;
        }
        if (open) { html += '</div>'; open = false; }
        number += 1;
        html += '<div class="qz-card qz-rv-q ' + verdict.key + '">'
          + '<div class="qz-q-head"><span class="qz-q-num">سؤال ' + number + '</span>'
          + reviewMark(answer, verdict) + '</div>'
          + (answer.text ? '<div class="qz-q-text">' + esc(answer.text) + '</div>' : '')
          + questionImage(answer) + reviewBody(answer, verdict) + '</div>';
      });
      if (open) html += '</div>';
      box.innerHTML = html;
      // بيفضل على حالته: الطالب اللي فتح الورقة وقدّم تظلم مايترجعش لمخفي بعد التحديث
      box.style.display = reviewShown ? '' : 'none';
      syncReviewToggle();
    }


    function syncReviewToggle() {
      var button = el('qz-review-toggle');
      if (!button) return;
      button.textContent = reviewShown ? 'إخفاء نموذج الإجابة' : 'عرض الأخطاء ونموذج الإجابة';
    }

    function toggleReview() {
      var box = el('qz-review');
      reviewShown = !reviewShown;
      box.style.display = reviewShown ? '' : 'none';
      syncReviewToggle();
      if (reviewShown) box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    // ---------- صورة الإجابة المقالية ----------
    //
    // **الضغط في المتصفح مش على السيرفر.** صورة من كاميرا موبايل حديث ٤–٨ ميجا،
    // والنموذج بيقبل ٥ ميجا بعد الـbase64 (اللي بيكبّر الحجم ٣٣٪). والأهم إن الطالب
    // على نت موبايل: رفع ٦ ميجا ممكن ياخد دقيقة ويفشل، و٦٠٠ كيلو بتوصل في ثواني.
    // ١٦٠٠ بكسل كفاية تمامًا لقراءة خط اليد.
    var IMAGE_MAX_SIDE = 1600;
    var IMAGE_QUALITY = 0.85;

    function compressImage(file) {
      return new Promise(function (resolve, reject) {
        var url = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function () {
          URL.revokeObjectURL(url);
          var scale = Math.min(1, IMAGE_MAX_SIDE / Math.max(img.width, img.height));
          var canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob(function (blob) {
            // **الفشل بيرجّع الملف الأصلي مش بيرمي.** متصفح قديم مايعرفش toBlob
            // مايمنعش الطالب من تسليم إجابته — السيرفر حده ١٠ ميجا فأغلب الصور هتعدّي
            resolve(blob || file);
          }, 'image/jpeg', IMAGE_QUALITY);
        };
        img.onerror = function () {
          URL.revokeObjectURL(url);
          reject(new Error('مقدرناش نقرا الصورة — جرّب صورة تانية'));
        };
        img.src = url;
      });
    }

    function essayImageNodes(questionId) {
      return {
        wrap: document.querySelector('[data-answer="' + questionId + '"]'),
        textarea: document.querySelector('textarea[data-q="' + questionId + '"]'),
        alt: document.querySelector('[data-alt="' + questionId + '"]'),
        preview: document.querySelector('[data-preview="' + questionId + '"]'),
      };
    }

    function showEssayImage(questionId, src, stateText) {
      var n = essayImageNodes(questionId);
      if (!n.preview) return;
      if (src) n.preview.querySelector('img').src = src;
      n.preview.querySelector('.qz-essay-image-state').textContent = stateText || '';
      n.preview.style.display = '';
      if (n.textarea) n.textarea.style.display = 'none';
      if (n.alt) n.alt.style.display = 'none';
    }

    function hideEssayImage(questionId) {
      var n = essayImageNodes(questionId);
      if (!n.preview) return;
      n.preview.style.display = 'none';
      n.preview.querySelector('img').removeAttribute('src');
      if (n.textarea) n.textarea.style.display = '';
      if (n.alt) n.alt.style.display = '';
    }

    function uploadEssayImage(questionId, file) {
      showEssayImage(questionId, URL.createObjectURL(file), 'بيترفع...');
      return compressImage(file).then(function (blob) {
        var form = new FormData();
        form.append('image', blob, 'answer.jpg');
        form.append('attempt_key', state.key);
        form.append('question_id', String(questionId));
        return fetch(base + '/answer-image', { method: 'POST', body: form })
          .then(function (response) {
            return response.json().catch(function () { return {}; }).then(function (data) {
              if (!response.ok) throw new Error(data.error || 'مقدرناش نرفع الصورة');
              return data;
            });
          });
      }).then(function (data) {
        showEssayImage(questionId, data.path, 'اتحفظت ✅');
        // الصورة بديل للكتابة، فالنص بيتفضّى — والسيرفر عامل نفس الحاجة في القاعدة
        var n = essayImageNodes(questionId);
        if (n.textarea) n.textarea.value = '';
        state.dirty = true;
        updateProgress();
      }).catch(function (error) {
        hideEssayImage(questionId);
        showError('qz-exam-error', error.message);
      });
    }

    function removeEssayImage(questionId) {
      return fetch(base + '/answer-image/remove', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attempt_key: state.key, question_id: questionId }),
      }).then(function () {
        hideEssayImage(questionId);
        updateProgress();
      });
    }

    // ---------- مربع التظلّم ----------
    //
    // **المربع بيعرض كل الأسئلة القابلة للتظلم مش اللي اتفتح منه بس.** الطالب اللي
    // شايف سؤالين غلط بيحب يقدّمهم مرة واحدة، والزرار على كل سؤال لوحده كان معناه
    // تقديم منفصل لكل واحد — وتلات رسايل عند الأدمن بدل واحدة
    function appealCandidates() {
      return appeals.review.filter(canAppeal);
    }

    // عدد التظلمات المفتوحة دلوقتي — هو اللي بيفرّق بين «قدّم» و«عدّل»
    function openAppealCount() {
      return appeals.review.filter(function (a) { return a.appeal === 'open'; }).length;
    }

    // **زرار واحد بيقول حالته.** الطالب اللي اتظلم ورجع للصفحة تاني محتاج يعرف إن
    // تظلمه موجود، ويقدر يعدّله — زرار «أتظلم» تاني كان هيخليه يفتكر إن الأول ضاع
    function renderAppealCta() {
      var cta = el('qz-appeal-cta');
      var button = el('qz-appeal-open');
      if (!cta || !button) return;
      // في معاينة الأدمن مفيش تقديم — بس الحالة بتفضل ظاهرة في الورقة نفسها
      if (window.QZ_PREVIEW) { cta.style.display = 'none'; return; }
      // الأدمن قافل التظلم على الاختبار ده
      if (!appeals.open) { cta.style.display = 'none'; return; }

      var open = openAppealCount();
      var candidates = appealCandidates().length;
      if (!open && !candidates) { cta.style.display = 'none'; return; }

      cta.style.display = '';
      button.textContent = open
        ? 'عدّل تظلمك (' + open + ')'
        : 'أتظلم من درجتي';
    }

    function openAppealBox(preselectId) {
      var box = el('qz-appeal');
      var list = el('qz-appeal-list');
      var candidates = appealCandidates();

      showError('qz-appeal-error', '');
      var open = openAppealCount();
      // من غير سقف، الجملة مابتقولش رقم — ذكر حد مش موجود بيخوّف الطالب من غير سبب
      // نفس القاعدة مكتوبة تاني جوه المربع: الطالب اللي فتحه من زرار سؤال بعينه
      // مامرش على الشرح اللي فوق
      var capNote = appeals.limit ? ' — الحد الأقصى ' + appeals.limit + ' أسئلة للورقة.' : '.';
      el('qz-appeal-intro').textContent = open
        ? 'دي الأسئلة اللي اتظلمت منها. شيل أو زوّد اللي إنت عايزه وبعدين احفظ' + capNote
        : 'علّم على كل الأسئلة اللي شايف تصحيحها غلط' + capNote;

      // **المتظلَّم منه بييجي متعلّم عليه**، فالمربع بيعرض حالة التظلم الحالية زي ما هي
      // والطالب بيعدّلها — وده معنى «تعديل» بدل «تقديم من أول وجديد»
      list.innerHTML = candidates.map(function (answer) {
        var isOpen = answer.appeal === 'open';
        var checked = (isOpen || answer.question_id === preselectId) ? ' checked' : '';
        return '<label class="qz-appeal-item">'
          + '<input type="checkbox" value="' + answer.question_id + '"' + checked + ' />'
          + '<span class="qz-appeal-item-label">' + esc(appeals.labels[answer.question_id] || 'سؤال')
          + (isOpen ? ' <span class="qz-appeal-item-tag">متظلَّم منه</span>' : '')
          + '</span>'
          + '<span class="qz-appeal-item-score">' + answer.awarded_points + ' / ' + answer.points + '</span>'
          + '</label>';
      }).join('') || '<p class="qz-appeal-empty">مفيش أسئلة متاح التظلم منها.</p>';

      el('qz-appeal-submit').textContent = open ? 'احفظ التعديل' : 'قدّم التظلم';
      el('qz-appeal-submit').disabled = !candidates.length;
      box.style.display = '';
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function selectedAppealIds() {
      return Array.prototype.slice
        .call(document.querySelectorAll('#qz-appeal-list input[type="checkbox"]:checked'))
        .map(function (input) { return Number(input.value); });
    }

    // **بـ.then() مش async/await زي باقي الصفحة.** الصفحة دي بتتفتح على موبايلات
    // الطلاب، ومكتوبة كلها ES5 (var / function / .then) عن قصد للتوافق — فمينفعش
    // سطر واحد يكسر القاعدة دي
    function sendAppeal() {
      // **المعاينة مالهاش مفتاح محاولة.** شاشة الأدمن بتصفّر `attempt_key` عن قصد عشان
      // مايقدرش يتصرّف في ورقة طالب — فالطلب كان بيرجع "المحاولة مش موجودة"، وهي رسالة
      // بتوصف نتيجة الفحص مش سبب المنع
      if (!state.key) {
        return showError('qz-appeal-error',
          'دي معاينة — التظلم بيتقدّم من صفحة الطالب نفسه بس.');
      }
      var ids = selectedAppealIds();
      // **قايمة فاضية = سحب التظلم**، وده تصرف مشروع: الطالب راجع ورقته ولقى نفسه
      // غلطان. الرفض هنا كان هيخليه مضطر يسيب تظلم هو نفسه مش مقتنع بيه
      var resolvedCount = appeals.review.filter(function (a) { return a.appeal === 'resolved'; }).length;
      // نفس حساب السيرفر بالظبط: المحسوم + المختار. الاتنين لازم يتفقوا وإلا الواجهة
      // بتسمح بحاجة السيرفر بيرفضها
      if (appeals.limit && ids.length + resolvedCount > appeals.limit) {
        return showError('qz-appeal-error',
          'الحد الأقصى ' + appeals.limit + ' أسئلة للورقة'
          + (resolvedCount ? ' — و' + resolvedCount + ' منهم اتحسم خلاص.' : '.'));
      }
      var button = el('qz-appeal-submit');
      button.disabled = true;
      showError('qz-appeal-error', '');
      return post('/appeal', {
        attempt_key: state.key,
        question_ids: ids,
        note: el('qz-appeal-note').value,
      }).then(function () {
        // **بنعيد تحميل الورقة من السيرفر مش بنعدّل الشاشة بإيدنا.** حالة التظلم بتيجي
        // مع كل سؤال، فإعادة التحميل بتخلي الشاشة تطابق القاعدة بالظبط — والتعديل
        // اليدوي كان بيخلي الاتنين يفترقوا لو السيرفر رفض واحد من الأسئلة
        return fetch(base + '/result?attempt_key=' + encodeURIComponent(state.key))
          .then(function (response) { return response.json(); });
      }).then(function (data) {
        if (data && data.review) {
          appeals.limit = data.appeal_limit || null;
          if (data.appeals_open !== undefined) appeals.open = data.appeals_open !== false;
          renderReview(data.review);
          renderAppealCta();
        }
        el('qz-appeal').style.display = 'none';
        el('qz-appeal-note').value = '';
      }).catch(function (error) {
        showError('qz-appeal-error', error.message);
        button.disabled = false;
      });
    }

    // تفويض الحدث: أزرار التظلم بتتولّد مع الورقة، فالمستمع على الحاوية مش على كل زرار
    el('qz-review').addEventListener('click', function (event) {
      var button = event.target.closest('[data-appeal]');
      if (button) openAppealBox(Number(button.dataset.appeal));
    });
    el('qz-review-toggle').addEventListener('click', toggleReview);
    el('qz-appeal-open').addEventListener('click', function () { openAppealBox(null); });
    el('qz-appeal-submit').addEventListener('click', sendAppeal);
    el('qz-appeal-cancel').addEventListener('click', function () {
      el('qz-appeal').style.display = 'none';
    });

    // ---------- تشغيل المعاينة ----------
    //
    // **بيعدّي على البوابة كلها.** الطالب بيدخل رقمه عشان نعرف هو مين؛ في المعاينة
    // الأدمن قال مين من اللوحة خلاص، والـpayload جاهز من السيرفر. ومفيش أي نداء
    // للسيرفر من هنا: الصفحة مابتحفظش ومابتسلّمش ومابتسألش عن الدرجة، فمستحيل تلمس
    // ورقة الطالب بأي شكل
    if (window.QZ_PREVIEW) {
      el('qz-gate').style.display = 'none';
      if (window.QZ_PREVIEW.payload) {
        renderResult(window.QZ_PREVIEW.payload);
      }
    }
  }());
</script>
</body>
</html>
