# ===== السيرفر =====
PORT=3000
NODE_ENV=development

# الدومين العام لتطبيقك (لازم يبقى HTTPS في الإنتاج) — يُستخدم لتسجيل Webhook تليجرام
# مثال: https://your-app.onrender.com
PUBLIC_URL=

# ===== قاعدة البيانات (PostgreSQL) =====
# مثال: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ===== الجلسات (Sessions) =====
# نص عشوائي طويل وسري — استخدم: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===== تشفير توكن البوت داخل قاعدة البيانات =====
# مفتاح تشفير بطول 32 بايت (64 حرف hex) — استخدم نفس أمر توليد SESSION_SECRET
ENCRYPTION_KEY=

# ===== ملاحظة عن توكن البوت =====
# توكن البوت نفسه (من BotFather) مش بيتحط هنا — بيتسجل من صفحة الإعدادات
# جوه لوحة التحكم بعد تسجيل الدخول، وبيتخزن مشفّر في قاعدة البيانات.

# ===== إشعارات المتصفح (Web Push) — لإشعار الموظف على تليفونه حتى لو المتصفح مقفول =====
# ولّدهم مرة واحدة بالأمر: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# إيميل تواصل يظهر لمزوّدي الإشعارات (Google/Mozilla) في حال وجود مشكلة — أي إيميل صالح
VAPID_SUBJECT=mailto:admin@example.com
