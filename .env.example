# ===== السيرفر =====
PORT=3000
NODE_ENV=development

# الدومين العام لتطبيقك (لازم يبقى HTTPS في الإنتاج) — يُستخدم لتسجيل Webhook تليجرام
# مثال: https://your-app.onrender.com
PUBLIC_URL=

# ===== قاعدة البيانات (PostgreSQL) =====
# مثال: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ===== الجلسات (Sessions) =====
# نص عشوائي طويل وسري — استخدم: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===== تشفير توكن البوت داخل قاعدة البيانات =====
# مفتاح تشفير بطول 32 بايت (64 حرف hex) — استخدم نفس أمر توليد SESSION_SECRET
ENCRYPTION_KEY=

# ===== ملاحظة عن توكن البوت =====
# توكن البوت نفسه (من BotFather) مش بيتحط هنا — بيتسجل من صفحة الإعدادات
# جوه لوحة التحكم بعد تسجيل الدخول، وبيتخزن مشفّر في قاعدة البيانات.

# ===== إشعارات المتصفح (Web Push) — لإشعار الموظف على تليفونه حتى لو المتصفح مقفول =====
# ولّدهم مرة واحدة بالأمر: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# إيميل تواصل يظهر لمزوّدي الإشعارات (Google/Mozilla) في حال وجود مشكلة — أي إيميل صالح
VAPID_SUBJECT=mailto:admin@example.com

# ---------- دور العملية ----------
# all  = الافتراضي: الطلبات والبوت والجدولة في عملية واحدة (النشر الحالي)
# web  = الطلبات بس — ينفع أكتر من نسخة ورا موزّع أحمال
# jobs = البوت والجدولة — **نسخة واحدة بالظبط**، لأن نسختين معناهم إرسال جماعي
#        ومتابعات مكررة. والويبهوك لازم يتوجّه للنسخة دي.
APP_ROLE=all

# ---------- تخزين الملفات بره القرص (اختياري) ----------
# بيشتغل مع AWS S3 و Cloudflare R2 و DigitalOcean Spaces بنفس الإعدادات — التلاتة نفس
# البروتوكول. سيبها فاضية والملفات بتفضل على قرص السيرفر زي دلوقتي بالظبط.
# الأربعة دول لازم يكونوا موجودين مع بعض عشان التخزين يشتغل:
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# الرابط العام للملفات (دومين الـCDN أو الباكت) — من غيره الملف بيترفع ومحدش يفتحه
S3_PUBLIC_BASE=
# مطلوب لـ R2 و Spaces، وسيبه فاضي لـ AWS S3
S3_ENDPOINT=
S3_REGION=auto
# R2 و Minio محتاجينها true
S3_FORCE_PATH_STYLE=false
